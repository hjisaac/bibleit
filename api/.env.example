# Server port (defaults to 7860)
PORT=

# Directory for local artifacts (defaults to app/public/data)
DATA_DIR=

# Remote artifact base URL (optional, alternative to DATA_DIR)
ARTIFACT_BASE_URL=

# Directory for file logging (optional; writes to stdout when unset)
LOG_DIR=

# Sentry DSN for crash and unhandled exception reporting (optional)
SENTRY_DSN=

# Log level: debug, info, warn, error (defaults to info in production)
LOG_LEVEL=
