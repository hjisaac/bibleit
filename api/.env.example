# Server port (defaults to 7860)
PORT=

# Directory for local artifacts (defaults to app/public/data)
DATA_DIR=

# Remote artifact base URL (optional, alternative to DATA_DIR)
ARTIFACT_BASE_URL=

# Directory for file logging (optional; writes to stdout when unset)
LOG_DIR=

# Sentry DSN for crash and unhandled exception reporting (optional)
SENTRY_DSN=

# Log level: debug, info, warn, error (defaults to info in production)
LOG_LEVEL=

# LLM Providers (for /api/v1/generate - at least one required for generative answering)
# Free tier providers directory: https://github.com/mnfst/awesome-free-llm-apis
# Tier 1 (Primary daily rotation):
GROQ_API_KEY=
GEMINI_API_KEY=

# Tier 2 (Reserve emergency fallback):
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=


