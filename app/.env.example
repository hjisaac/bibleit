# Destination email for feedback & bug reports
VITE_FEEDBACK_EMAIL=

# Public Cloudflare R2 bucket endpoint for heavy WASM runtime (>25MB)
VITE_CLOUDFLARE_R2_URL=

# Backend search API endpoint
VITE_BACKEND_API_URL=

# Multilingual UI support (defaults to true in dev mode, false in production build)
VITE_MULTILINGUAL_ENABLED=false

# Optional PostHog telemetry (anonymous search & relevance feedback; no-op when empty)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
