        "Autogenerated BSB by bsb2usfm"
      ]
    },
    {
      "type": "para",
      "marker": "h",
      "content": [
        "2 Corinthians"
      ]
    },
    {
      "type": "para",
      "marker": "toc1",
      "content": [
        "2 Corinthians"
      ]
    },
    {
      "type": "para",
      "marker": "toc2",
      "content": [
        "2 Corinthians"
      ]
    },
    {
      "type": "para",
      "marker": "toc3",
      "content": [
        "2CO"
      ]
    },
    {
      "type": "para",
      "marker": "mt1",
      "content": [
        "2 Corinthians"
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "1",
      "sid": "2CO 1"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Paul Greets the Corinthians"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ACT 18:1-11",
          "content": [
            "Acts 18:1–11"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "1CO 1:1-3",
          "content": [
            "1 Corinthians 1:1–3"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "2CO 1:1"
        },
        "Paul, an apostle of Christ Jesus by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " will of God, and Timothy ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "our"
          ]
        },
        " brother,"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "To the church of God in Corinth, together with all the saints throughout Achaia:"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "2CO 1:2"
        },
        "Grace and peace to you from God our Father and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord Jesus Christ."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The God of All Comfort"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "2CO 1:3"
        },
        "Blessed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " the God and Father of our Lord Jesus Christ, the Father of compassion and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " God of all comfort, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "2CO 1:4"
        },
        "who comforts us in all our troubles, so that we can comfort those in any trouble with the comfort we ourselves ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "have received"
          ]
        },
        " from God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "2CO 1:5"
        },
        "For just as the sufferings of Christ overflow to us, so also through Christ our comfort overflows."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "2CO 1:6"
        },
        "If we are afflicted, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it is"
          ]
        },
        " for your comfort and salvation; if we are comforted, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it is"
          ]
        },
        " for your comfort, which accomplishes in you patient endurance of the same sufferings we experience. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "2CO 1:7"
        },
        "And our hope for you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " sure, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "because"
          ]
        },
        " we know that just as you share in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "our"
          ]
        },
        " sufferings, so also ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you will share"
          ]
        },
        " in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "our"
          ]
        },
        " comfort."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "2CO 1:8"
        },
        "We do not want you to be unaware, brothers, of the hardships we encountered in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the province of"
          ]
        },
        " Asia.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:8 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "in Asia"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; Asia was a Roman province in what is now western Turkey. "
              ]
            }
          ]
        },
        " We were under a burden far beyond our ability to endure, so that we despaired even of life. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "2CO 1:9"
        },
        "Indeed, we felt we were under the sentence of death, in order that we would not trust in ourselves, but in God, who raises the dead."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "2CO 1:10"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "He"
          ]
        },
        " has delivered us from such a deadly peril, and He will deliver ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "us"
          ]
        },
        ". In ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        " we have placed our hope that He will yet again deliver ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "us"
          ]
        },
        ", ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "2CO 1:11"
        },
        "as you help us by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " prayers. Then many will give thanks on our behalf for the favor shown us in answer to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their prayers "
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Paul’s Change of Plans"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "2CO 1:12"
        },
        "For this is our boast: Our conscience testifies that we have conducted ourselves in the world, and especially in relation to you, in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " holiness and sincerity that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are from"
          ]
        },
        " God — not in worldly",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:12 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "fleshly"
              ]
            }
          ]
        },
        " wisdom, but in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " grace of God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "2CO 1:13"
        },
        "For we do not write you anything that is beyond your ability to read ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " understand. And I hope that you will understand ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "us"
          ]
        },
        " completely, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "2CO 1:14"
        },
        "as you have already understood us in part, that you may boast of us just as we  ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "will boast "
          ]
        },
        " of you in the day of our Lord Jesus.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:14 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "the Lord Jesus"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "2CO 1:15"
        },
        "Confident of this, I planned to visit you first, so that you might receive a double blessing. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "2CO 1:16"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "I wanted"
          ]
        },
        " to visit you on my way to Macedonia, and to return to you from Macedonia, and then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to have"
          ]
        },
        " you help me on my way to Judea."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "2CO 1:17"
        },
        "When I planned this, did I do it carelessly? Or do I make my plans by human standards, so as ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to say"
          ]
        },
        " “Yes, yes” and also “No, no”? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "2CO 1:18"
        },
        "But ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as surely as"
          ]
        },
        " God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " faithful, our message to you is not “Yes” and “No.” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "2CO 1:19"
        },
        "For the Son of God, Jesus Christ, who was proclaimed among you by me and Silvanus",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:19 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "That is, Silas"
              ]
            }
          ]
        },
        " and Timothy, was not “Yes” and “No,” but in Him it has always been “Yes.” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "2CO 1:20"
        },
        "For all ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " promises of God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " “Yes” in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Christ"
          ]
        },
        ". And so through Him, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "our"
          ]
        },
        " “Amen” is spoken to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " glory of God."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "2CO 1:21"
        },
        "Now ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it is"
          ]
        },
        " God who establishes ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "both"
          ]
        },
        " us and you in Christ. He anointed us, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "2CO 1:22"
        },
        "placed His seal on us, and put ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " Spirit in our hearts as a pledge of what is to come. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "2CO 1:23"
        },
        "I call God as my witness that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it was in order"
          ]
        },
        " to spare you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " I did not return to Corinth. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "2CO 1:24"
        },
        "Not that we lord it over your faith, but we are fellow workers with you for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " joy, because ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it is"
          ]
        },
        " by faith ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " you stand firm."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "2",
      "sid": "2CO 2"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Reaffirm Your Love"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "2CO 2:1"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So"
          ]
        },
        " I made up my mind not to make another painful ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "visit"
          ]
        },
        " to you. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "2CO 2:2"
        },
        "For if I grieve you, who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is left"
          ]
        },
        " to cheer me but those ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "whom"
          ]
        },
        " I have grieved? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "2CO 2:3"
        },
        "I wrote as I did so that on my arrival I would not be grieved by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "those"
          ]
        },
        " who ought ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to make"
          ]
        },
        " me rejoice. I had confidence in all of you, that you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "would share"
          ]
        },
        " my joy. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "2CO 2:4"
        },
        "For through many tears I wrote you out of great distress and anguish of heart, not to grieve you but to let you know how much I love you."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "2CO 2:5"
        },
        "Now if anyone has caused grief, he has not grieved me but all of you — to some degree, not to overstate ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "2CO 2:6"
        },
        "The punishment ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "imposed on him"
          ]
        },
        " by the majority ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " sufficient for him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "2CO 2:7"
        },
        "So instead, you ought to forgive and comfort ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "him"
          ]
        },
        ", so that he will not be overwhelmed by excessive sorrow. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "2CO 2:8"
        },
        "Therefore I urge you to reaffirm ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " love for him."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "2CO 2:9"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "My"
          ]
        },
        " purpose in writing ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was"
          ]
        },
        " to see if you would stand the test ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " be obedient in everything. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "2CO 2:10"
        },
        "If you forgive anyone, I also ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "forgive him"
          ]
        },
        ". And if I have forgiven anything, I have forgiven ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " presence of Christ for your sake, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "2CO 2:11"
        },
        "in order that Satan should not outwit us. For we are not unaware of his schemes."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Triumph in Christ"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "2CO 2:12"
        },
        "Now when I went to Troas ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to preach"
          ]
        },
        " the gospel of Christ and a door stood open for me in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "2CO 2:13"
        },
        "I had no peace in my spirit, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "because"
          ]
        },
        " I did not find my brother Titus ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "there"
          ]
        },
        ". ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So"
          ]
        },
        " I said goodbye to them ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " went on to Macedonia."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "2CO 2:14"
        },
        "But thanks ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " to God, who always leads us triumphantly as captives in Christ and through us spreads everywhere the fragrance of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " knowledge of Him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "2CO 2:15"
        },
        "For we are to God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " sweet aroma of Christ among those who are being saved and those who are perishing. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "2CO 2:16"
        },
        "To ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " one ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "we are"
          ]
        },
        " an odor that brings death, to the other a fragrance that brings life.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:16 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "To the one, indeed, an aroma from death to death; but to the other, an aroma from life to life."
              ]
            }
          ]
        },
        " And who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " qualified for such ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "a task"
          ]
        },
        "?"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "2CO 2:17"
        },
        "For we are not like so many others, who peddle the word of God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "for profit"
          ]
        },
        ". On the contrary, in Christ we speak before God with sincerity, as men sent from God."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "3",
      "sid": "2CO 3"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Ministers of a New Covenant"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "2CO 3:1"
        },
        "Are we beginning to commend ourselves again? Or do we need, like some ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "people"
          ]
        },
        ", letters of recommendation to you or from you? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "2CO 3:2"
        },
        "You yourselves are our letter, inscribed on our hearts, known and read by everyone. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "2CO 3:3"
        },
        "It is clear that you are a letter from Christ, the result of our ministry, written not with ink but with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Spirit of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " living God, not on tablets of stone but on tablets of human hearts."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "2CO 3:4"
        },
        "Such confidence before God is ours through Christ. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "2CO 3:5"
        },
        "Not that we are competent in ourselves to claim that anything ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "comes"
          ]
        },
        " from us, but our competence ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "comes"
          ]
        },
        " from God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "2CO 3:6"
        },
        "And He has qualified us ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as"
          ]
        },
        " ministers of a new covenant, not of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " letter but of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Spirit; for the letter kills, but the Spirit gives life."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Glory of the New Covenant"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "EXO 34:10-35",
          "content": [
            "Exodus 34:10–35"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "2CO 3:7"
        },
        "Now if the ministry of death, which was engraved in letters on stone, came with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "such"
          ]
        },
        " glory that the Israelites could not gaze at the face of Moses because of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "its"
          ]
        },
        " fleeting glory, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "2CO 3:8"
        },
        "will not the ministry of the Spirit ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " even more glorious? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "2CO 3:9"
        },
        "For if the ministry of condemnation was glorious, how much more glorious ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " the ministry of righteousness! ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "2CO 3:10"
        },
        "Indeed, what was once glorious has no glory now in comparison to the glory ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " surpasses ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "2CO 3:11"
        },
        "For if what was fading away ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "came"
          ]
        },
        " with glory, how much greater ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is the"
          ]
        },
        " glory of that which endures!"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "2CO 3:12"
        },
        "Therefore, since we have such a hope, we are very bold. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "2CO 3:13"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "We are"
          ]
        },
        " not like Moses, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who"
          ]
        },
        " would put a veil over his face to keep the Israelites ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "from"
          ]
        },
        " gazing at the end of what was fading away."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "2CO 3:14"
        },
        "But their minds were closed. For to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        " day the same veil remains at the reading of the old covenant. It has not been lifted, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "because"
          ]
        },
        " only in Christ can it be removed. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "2CO 3:15"
        },
        "And even to this day when Moses is read, a veil covers their hearts. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "2CO 3:16"
        },
        "But whenever ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "anyone"
          ]
        },
        " turns to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord, the veil is taken away."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "2CO 3:17"
        },
        "Now the Lord is the Spirit, and where the Spirit of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        ", ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "there is"
          ]
        },
        " freedom. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "2CO 3:18"
        },
        "And we, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who"
          ]
        },
        " with unveiled faces all reflect the glory of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord, are being transformed into ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " image with intensifying glory, which comes from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who is the"
          ]
        },
        " Spirit."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "4",
      "sid": "2CO 4"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Light of the Gospel"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "2CO 4:1"
        },
        "Therefore, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "since God"
          ]
        },
        " in His mercy has given us this ministry,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "4:1 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Therefore, having this ministry, as we have received mercy,"
              ]
            }
          ]
        },
        " we do not lose heart. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "2CO 4:2"
        },
        "Instead, we have renounced secret ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " shameful ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "ways"
          ]
        },
        ". We do not practice deceit, nor do we distort the word of God. On the contrary, by open proclamation of the truth, we commend ourselves to every man’s conscience in the sight of God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "2CO 4:3"
        },
        "And even if our gospel is veiled, it is veiled to those who are perishing."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "2CO 4:4"
        },
        "The god of this age has blinded the minds of unbelievers, so they cannot see the light of the gospel of the glory of Christ, who is ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " image of God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "2CO 4:5"
        },
        "For we do not proclaim ourselves, but Jesus Christ ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as"
          ]
        },
        " Lord, and ourselves ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as"
          ]
        },
        " your servants for Jesus’ sake. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "2CO 4:6"
        },
        "For God, who said, “",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Let"
          ]
        },
        " light shine out of darkness,”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "4:6 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "GEN 1:3",
                  "content": [
                    "Genesis 1:3"
                  ]
                }
              ]
            }
          ]
        },
        " made His light shine in our hearts to give us ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " light of the knowledge of the glory of God in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " face of Jesus Christ.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "4:6 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "SBL, NE, and WH "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "in the face of Christ"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Treasure in Jars of Clay"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ROM 6:1-14",
          "content": [
            "Romans 6:1–14"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "2CO 4:7"
        },
        "Now we have this treasure in jars of clay to show that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        " surpassingly great power is from God and not from us. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "2CO 4:8"
        },
        "We are hard pressed on all ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "sides"
          ]
        },
        ", but not crushed; perplexed, but not in despair; ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "2CO 4:9"
        },
        "persecuted, but not forsaken; struck down, but not destroyed."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "2CO 4:10"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "We"
          ]
        },
        " always carry around in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "our"
          ]
        },
        " body the death ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of"
          ]
        },
        " Jesus, so that the life of Jesus ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "may"
          ]
        },
        " also be revealed in our body. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "2CO 4:11"
        },
        "For we who are alive ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " always consigned to death for Jesus’ sake, so that the life of Jesus ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "may"
          ]
        },
        " also be revealed in our mortal body. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "2CO 4:12"
        },
        "So then, death is at work in us, but life ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is at work"
          ]
        },
        " in you."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "2CO 4:13"
        },
        "And in keeping with what is written, “I believed, therefore I have spoken,”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "4:13 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "PSA 116:10",
                  "content": [
                    "Psalm 116:10"
                  ]
                },
                " (see also LXX)"
              ]
            }
          ]
        },
        " we who have the same spirit of faith also believe and therefore speak, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "2CO 4:14"
        },
        "knowing that the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "One who"
          ]
        },
        " raised the Lord Jesus",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "4:14 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "SBL "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "who raised Jesus"
              ]
            }
          ]
        },
        " will also raise us with Jesus and present ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "us"
          ]
        },
        " with you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "in His presence "
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "2CO 4:15"
        },
        "All this ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " for your benefit, so that the grace that is extending to more and more ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "people"
          ]
        },
        " may cause thanksgiving to overflow, to the glory of God."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "2CO 4:16"
        },
        "Therefore we do not lose heart. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Though"
          ]
        },
        " our outer self is wasting away, yet our inner ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "self"
          ]
        },
        " is being renewed day by day. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "2CO 4:17"
        },
        "For our light ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " momentary affliction is producing for us an eternal weight of glory ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that is"
          ]
        },
        " far beyond comparison. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "2CO 4:18"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So"
          ]
        },
        " we fix our eyes not on what is seen, but on what is unseen. For what is seen ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " temporary, but what is unseen ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " eternal."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "5",
      "sid": "2CO 5"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Our Eternal Dwelling"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ROM 8:18-27",
          "content": [
            "Romans 8:18–27"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "2CO 5:1"
        },
        "For we know that if the earthly tent we ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "live in"
          ]
        },
        " is dismantled, we have a building from God, an eternal house in heaven, not built by human hands. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "2CO 5:2"
        },
        "For in this ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "tent"
          ]
        },
        " we groan, longing to be clothed with our heavenly dwelling, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "2CO 5:3"
        },
        "because when we are clothed, we will not be found naked. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "2CO 5:4"
        },
        "For ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "while"
          ]
        },
        " we are in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        " tent, we groan under our burdens, because we do not wish to be unclothed but clothed, so that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "our"
          ]
        },
        " mortality may be swallowed up by life. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "2CO 5:5"
        },
        "And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it is"
          ]
        },
        " God who has prepared us for this very ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "purpose"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " has given us the Spirit as a pledge of what is to come."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "2CO 5:6"
        },
        "Therefore we are always confident, although we know that while we are at home in the body, we are away from the Lord. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "2CO 5:7"
        },
        "For we walk by faith, not by sight. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "2CO 5:8"
        },
        "We are confident, then, and would prefer to be away from the body and at home with the Lord. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "2CO 5:9"
        },
        "So we aspire to please Him, whether we are at home ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "in this body"
          ]
        },
        " or away from it. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "2CO 5:10"
        },
        "For we must all appear before the judgment seat of Christ, that each one may receive his due for the things done in the body, whether good or bad."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Ambassadors for Christ"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "2CO 5:11"
        },
        "Therefore, since we know ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "what it means"
          ]
        },
        " to fear the Lord, we try to persuade men. What we are is clear to God, and I hope it is clear to your conscience as well. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "2CO 5:12"
        },
        "We are not commending ourselves to you again. Instead, we are giving you an occasion to be proud of us, so that you can answer those who take pride in appearances ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "rather than"
          ]
        },
        " in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " heart."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "2CO 5:13"
        },
        "If we are out of our mind, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it is"
          ]
        },
        " for God; if we are of sound mind, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it is"
          ]
        },
        " for you. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "2CO 5:14"
        },
        "For Christ’s love compels us, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "because"
          ]
        },
        " we are convinced that One died for all, therefore all died. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "2CO 5:15"
        },
        "And He died for all, that those who live ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "should"
          ]
        },
        " no longer live for themselves, but for Him ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who"
          ]
        },
        " died for them and was raised again."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "2CO 5:16"
        },
        "So from now on we regard no one according to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " flesh. Although we once regarded Christ ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "in this way"
          ]
        },
        ", ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "we do so"
          ]
        },
        " no longer. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "2CO 5:17"
        },
        "Therefore if anyone ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " in Christ, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "he is"
          ]
        },
        " a new creation.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "5:17 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "a new creature"
              ]
            }
          ]
        },
        " The old has passed away. Behold, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " new has come!"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "2CO 5:18"
        },
        "All this ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " from God, who reconciled us to Himself through Christ and gave us the ministry of reconciliation: ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "2CO 5:19"
        },
        "that God was reconciling ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " world to Himself in Christ, not counting ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "men’s"
          ]
        },
        " trespasses against them. And He has committed to us the message of reconciliation."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "2CO 5:20"
        },
        "Therefore we are ambassadors for Christ, as though God were making His appeal through us. We implore you on behalf of Christ: Be reconciled to God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "2CO 5:21"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "God"
          ]
        },
        " made Him who knew no sin ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to be"
          ]
        },
        " sin",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "5:21 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "a sin offering"
              ]
            }
          ]
        },
        " on our behalf, so that in Him we might become ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " righteousness of God."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "6",
      "sid": "2CO 6"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Paul’s Hardships and God’s Grace"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "2CO 6:1"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "As"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "God’s"
          ]
        },
        " fellow workers,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "6:1 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Now working together"
              ]
            }
          ]
        },
        " then, we urge you not to receive God’s grace in vain. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "2CO 6:2"
        },
        "For He says:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“In the time of favor I heard you,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " day of salvation I helped you.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "6:2 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 49:8",
                  "content": [
                    "Isaiah 49:8"
                  ]
                },
                " (see also LXX)"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Behold, now ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is the"
          ]
        },
        " time of favor; now ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is the"
          ]
        },
        " day of salvation!"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "2CO 6:3"
        },
        "We put no obstacle in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "anyone’s"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "way"
          ]
        },
        ", so that no one can discredit ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "our"
          ]
        },
        " ministry."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "2CO 6:4"
        },
        "Rather, as servants of God we commend ourselves in every way: in great endurance; in troubles, hardships, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " calamities; ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "2CO 6:5"
        },
        "in beatings, imprisonments, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " riots; in labor, sleepless nights, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " hunger; ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "2CO 6:6"
        },
        "in purity, knowledge, patience, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " kindness; in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Holy Spirit ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " in sincere love; ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "2CO 6:7"
        },
        "in truthful speech ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " power of God; with the weapons of righteousness in the right hand and in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " left; ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "2CO 6:8"
        },
        "through glory and dishonor, slander and praise; viewed as imposters, yet genuine; ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "2CO 6:9"
        },
        "unknown, yet well-known; dying, and yet we live on; punished, yet not killed; ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "2CO 6:10"
        },
        "sorrowful, yet always rejoicing; poor, yet ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "making"
          ]
        },
        " many rich; having nothing, and yet possessing everything."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "2CO 6:11"
        },
        "We have spoken freely to you, Corinthians. Our hearts are open wide. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "2CO 6:12"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "It is"
          ]
        },
        " not our affection, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "but"
          ]
        },
        " yours, that is restrained. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "2CO 6:13"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "As"
          ]
        },
        " a fair exchange— I speak as to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "my"
          ]
        },
        " children— open wide your ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "hearts"
          ]
        },
        " also."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Do Not Be Unequally Yoked"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "2CO 6:14"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Do"
          ]
        },
        " not be unequally yoked with unbelievers. For what partnership ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "can"
          ]
        },
        " righteousness ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "have with"
          ]
        },
        " wickedness? Or what fellowship ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "does"
          ]
        },
        " light ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "have"
          ]
        },
        " with darkness? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "2CO 6:15"
        },
        "What harmony ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is there between"
          ]
        },
        " Christ and Belial?",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "6:15 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Scrivener’s TR and PT; many Greek sources "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Beliar"
              ]
            }
          ]
        },
        " Or what ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "does"
          ]
        },
        " a believer have in common with an unbeliever? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "2CO 6:16"
        },
        "What agreement ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "can exist"
          ]
        },
        " between the temple of God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " idols? For we are ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " temple of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " living God. As God has said:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“I will dwell with them"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and walk among ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        ","
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "and I will be their God,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and they will be My people.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "6:16 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "LEV 26:12",
                  "content": [
                    "Leviticus 26:12"
                  ]
                },
                "; Jeremiah 32:38; Ezekiel 37:27"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "2CO 6:17"
        },
        "“Therefore come out from among them"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and be separate, says ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Touch no unclean ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "thing"
          ]
        },
        ","
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and I will receive you.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "6:17 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 52:11",
                  "content": [
                    "Isaiah 52:11"
                  ]
                },
                "; see also Ezekiel 20:34, including LXX."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "2CO 6:18"
        },
        "And:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“I will be a Father to you,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and you will be My sons and daughters,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "says ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord Almighty.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "6:18 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "See ",
                {
                  "type": "ref",
                  "loc": "2SA 7:14",
                  "content": [
                    "2 Samuel 7:14"
                  ]
                },
                "."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "7",
      "sid": "2CO 7"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Paul’s Joy in the Corinthians"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "2CO 7:1"
        },
        "Therefore, beloved, since we have these promises, let us cleanse ourselves from everything that defiles body and spirit, perfecting holiness in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " fear of God."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "2CO 7:2"
        },
        "Make room for us in your hearts. We have wronged no one, we have corrupted no one, we have exploited no one. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "2CO 7:3"
        },
        "I do not say this to condemn ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        ". I have said before that you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "so"
          ]
        },
        " occupy our hearts that we live and die together ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "with you"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "2CO 7:4"
        },
        "Great ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " my confidence in you; great ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " my pride in you; I am filled with encouragement; in all our troubles my joy overflows."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "2CO 7:5"
        },
        "For ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "when"
          ]
        },
        " we arrived in Macedonia, our bodies had no rest, but we were pressed from every ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "direction"
          ]
        },
        " — conflicts on the outside, fears within. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "2CO 7:6"
        },
        "But God, who comforts the downcast, comforted us by the arrival of Titus, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "2CO 7:7"
        },
        "and not only by his arrival, but also by the comfort ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "he had received"
          ]
        },
        " from you. He told us about your longing, your mourning, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " your zeal for me, so that I rejoiced all the more."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "2CO 7:8"
        },
        "Even if I caused you sorrow by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "my"
          ]
        },
        " letter, I do not regret ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        ". Although I did regret ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        "— for I see that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "my"
          ]
        },
        " letter ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "caused"
          ]
        },
        " you sorrow, but only for a short time— ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "2CO 7:9"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "yet"
          ]
        },
        " now I rejoice, not because you were made sorrowful, but because your sorrow led you to repentance. For you felt the sorrow that God had intended, and so were not harmed in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "any way"
          ]
        },
        " by us. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "2CO 7:10"
        },
        "Godly sorrow brings repentance that leads to salvation without regret, but worldly sorrow brings death."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "2CO 7:11"
        },
        "Consider ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "what"
          ]
        },
        " this godly sorrow has produced in you: what earnestness, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "what"
          ]
        },
        " eagerness to clear yourselves, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "what"
          ]
        },
        " indignation, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "what"
          ]
        },
        " alarm, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "what"
          ]
        },
        " longing, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "what"
          ]
        },
        " zeal, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "what"
          ]
        },
        " vindication! In every way you have proved yourselves to be innocent in this matter. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "2CO 7:12"
        },
        "So even though I wrote to you, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it was"
          ]
        },
        " not on account of the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one who"
          ]
        },
        " did wrong ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one who"
          ]
        },
        " was harmed, but rather that your earnestness on our behalf would be made clear to you in the sight of God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "2CO 7:13"
        },
        "On account of this, we are encouraged."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "In addition to our own encouragement, we were even more delighted by the joy of Titus. For his spirit has been refreshed by all of you. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "2CO 7:14"
        },
        "Indeed, I was not embarrassed by anything I had boasted to him about you. But just as everything we said to you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was"
          ]
        },
        " true, so our boasting to Titus has proved to be true as well. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "2CO 7:15"
        },
        "And his affection for you is even greater when he remembers that you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "were"
          ]
        },
        " all obedient ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as"
          ]
        },
        " you welcomed him with fear and trembling. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "2CO 7:16"
        },
        "I rejoice that I can have complete confidence in you."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "8",
      "sid": "2CO 8"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Generosity Commended"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "PHP 4:10-20",
          "content": [
            "Philippians 4:10–20"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "2CO 8:1"
        },
        "Now, brothers, we want you to know about the grace ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " God has given the churches of Macedonia. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "2CO 8:2"
        },
        "In ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " terrible ordeal they suffered, their abundant joy and deep poverty overflowed into rich generosity. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "2CO 8:3"
        },
        "For I testify ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "they gave"
          ]
        },
        " according to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their"
          ]
        },
        " ability and even beyond ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        ". Of their own accord, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "2CO 8:4"
        },
        "they earnestly pleaded with us for the privilege of sharing in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        " service to the saints. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "2CO 8:5"
        },
        "And not ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "only"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "did they do"
          ]
        },
        " as we expected, but they gave themselves first to the Lord and then to us, through ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " will of God."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "2CO 8:6"
        },
        "So we urged Titus to help complete your ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "act of"
          ]
        },
        " grace, just as he had started ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "2CO 8:7"
        },
        "But just as you excel in everything — in faith, in speech, in knowledge, in complete earnestness, and in the love we ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "inspired"
          ]
        },
        " in you",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "8:7 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "in your love for us"
              ]
            }
          ]
        },
        " — ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "see"
          ]
        },
        " that you also excel in this grace of giving. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "2CO 8:8"
        },
        "I am not giving a command, but I am testing the sincerity of your love through the earnestness of others."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "2CO 8:9"
        },
        "For you know the grace of our Lord Jesus Christ, that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "though"
          ]
        },
        " He was rich, yet for your sake He became poor, so that you through ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " poverty might become rich. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "2CO 8:10"
        },
        "And this is my opinion about what is helpful for you in this ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "matter"
          ]
        },
        ": Last year ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you were"
          ]
        },
        " the first not only to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "give"
          ]
        },
        ", but even to have such a desire. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "2CO 8:11"
        },
        "Now finish the work, so that you may complete it with the same eager desire, according to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " means. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "2CO 8:12"
        },
        "For if the eagerness is there, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the gift"
          ]
        },
        " is acceptable according to what one has, not according to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "what"
          ]
        },
        " he does not have."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "2CO 8:13"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "It is not our intention"
          ]
        },
        " that others may be relieved while you are burdened, but ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that there may be"
          ]
        },
        " equality. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "2CO 8:14"
        },
        "At the present time, your surplus will meet their need, so that in turn their surplus will meet your need. This way there will be equality. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "2CO 8:15"
        },
        "As it is written:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“He who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "gathered"
          ]
        },
        " much had no excess,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and he who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "gathered"
          ]
        },
        " little had no shortfall.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "8:15 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "EXO 16:18",
                  "content": [
                    "Exodus 16:18"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Titus Commended"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "TIT 1:1-4",
          "content": [
            "Titus 1:1–4"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "2CO 8:16"
        },
        "But thanks ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " to God, who put into the heart of Titus the same devotion ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "I have"
          ]
        },
        " for you. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "2CO 8:17"
        },
        "For not only did he welcome ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "our"
          ]
        },
        " appeal, but he ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " eagerly coming to you of his own volition."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "2CO 8:18"
        },
        "Along with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Titus"
          ]
        },
        " we are sending the brother who is praised by all the churches ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "for his work"
          ]
        },
        " in the gospel. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "2CO 8:19"
        },
        "More than that, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this brother"
          ]
        },
        " was chosen by the churches to accompany us with the gracious offering we administer",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "8:19 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "See ",
                {
                  "type": "ref",
                  "loc": "1CO 16:3-4",
                  "content": [
                    "1 Corinthians 16:3–4"
                  ]
                },
                "."
              ]
            }
          ]
        },
        " to honor the Lord Himself and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to show"
          ]
        },
        " our eagerness ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to help"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "2CO 8:20"
        },
        "We ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "want to"
          ]
        },
        " avoid any criticism of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the way"
          ]
        },
        " we administer this generous ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "gift "
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "2CO 8:21"
        },
        "For we are taking great care to do what is right, not only in the eyes of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord, but also in the eyes of men."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "2CO 8:22"
        },
        "And we are sending along with them our brother who has proven his earnestness ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to us"
          ]
        },
        " many times ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " in many ways, and now even more ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "so"
          ]
        },
        " by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " great confidence in you. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "2CO 8:23"
        },
        "As for Titus, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "he is"
          ]
        },
        " my partner and fellow worker among you. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "As for"
          ]
        },
        " our brothers, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "they are"
          ]
        },
        " messengers",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "8:23 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "apostles"
              ]
            }
          ]
        },
        " of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " churches, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " glory of Christ. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "2CO 8:24"
        },
        "In full view of the churches, then, show ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "these men"
          ]
        },
        " the proof of your love and the reason for our boasting about you."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "9",
      "sid": "2CO 9"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "God Loves a Cheerful Giver"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "1CO 16:1-4",
          "content": [
            "1 Corinthians 16:1–4"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "2CO 9:1"
        },
        "Now about the service to the saints, there is no need for me to write to you. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "2CO 9:2"
        },
        "For I know your eagerness ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to help"
          ]
        },
        ", ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " I have been boasting to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Macedonians that since last year you in Achaia were prepared ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to give "
          ]
        },
        ". And your zeal has stirred most of them ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to do likewise "
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "2CO 9:3"
        },
        "But I am sending the brothers in order that our boasting about you in this matter should not prove empty, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "but"
          ]
        },
        " that you will be prepared, just as I said. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "2CO 9:4"
        },
        "Otherwise, if ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "any"
          ]
        },
        " Macedonians come with me and find you unprepared, we — to say nothing of you — would be ashamed of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "having been"
          ]
        },
        " so confident. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "2CO 9:5"
        },
        "So I thought ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " necessary to urge the brothers to visit you beforehand and make arrangements for the generous gift you had promised. This way, your ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "gift"
          ]
        },
        " will be prepared generously and not begrudgingly."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "2CO 9:6"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Remember"
          ]
        },
        " this: Whoever sows sparingly ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "will"
          ]
        },
        " also reap sparingly, and whoever sows generously ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "will"
          ]
        },
        " also reap generously. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "2CO 9:7"
        },
        "Each one  ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "should give "
          ]
        },
        " what he has decided in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " heart ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to give "
          ]
        },
        ", not out of regret or compulsion. For God loves a cheerful giver.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "9:7 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "See ",
                {
                  "type": "ref",
                  "loc": "PRO 22:8",
                  "content": [
                    "Proverbs 22:8"
                  ]
                },
                ", LXX addition."
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "2CO 9:8"
        },
        "And God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " able ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to make"
          ]
        },
        " all grace abound to you, so that in all things, at all times, having all that you need, you will abound in every good work. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "2CO 9:9"
        },
        "As it is written:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“He has scattered abroad His gifts to the poor;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "His righteousness endures forever.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "9:9 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "PSA 112:9",
                  "content": [
                    "Psalm 112:9"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "2CO 9:10"
        },
        "Now He who supplies seed to the sower and bread for food will supply and multiply your store of seed and will increase the harvest of your righteousness. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "2CO 9:11"
        },
        "You will be enriched in every way to be generous on every ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "occasion"
          ]
        },
        ", ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " through us ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your generosity"
          ]
        },
        " will produce thanksgiving to God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "2CO 9:12"
        },
        "For this ministry of service is not only supplying the needs of the saints but is also overflowing in many expressions of thanksgiving to God."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "2CO 9:13"
        },
        "Because of the proof this ministry ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "provides"
          ]
        },
        ", ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the saints"
          ]
        },
        " will glorify God for your obedient confession of the gospel of Christ, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "for the"
          ]
        },
        " generosity of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " contribution to them and to all ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the others"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "2CO 9:14"
        },
        "And their prayers for you will express their affection for you, because of the surpassing grace God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "has given"
          ]
        },
        " you. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "2CO 9:15"
        },
        "Thanks ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " to God for His indescribable gift!"
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "10",
      "sid": "2CO 10"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Paul’s Apostolic Authority"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "2CO 10:1"
        },
        "Now by the mildness and gentleness of Christ, I appeal to you — I, Paul, who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "am"
          ]
        },
        " humble when face to face with you, but bold when away. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "2CO 10:2"
        },
        "I beg ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        " that when I come I may not need to be as bold as I expect toward ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "those"
          ]
        },
        " who presume that we live according to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " flesh."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "2CO 10:3"
        },
        "For though we live in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " flesh, we do not wage war according to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " flesh. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "2CO 10:4"
        },
        "The weapons of our warfare ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " not ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the weapons "
          ]
        },
        " of the flesh. Instead, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "they have"
          ]
        },
        " divine power to demolish strongholds. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "2CO 10:5"
        },
        "We demolish arguments and every presumption set up against the knowledge of God; and we take captive every thought to make it obedient to Christ. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "2CO 10:6"
        },
        "And we will be ready to punish every ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "act of"
          ]
        },
        " disobedience, as soon as your obedience is complete."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "2CO 10:7"
        },
        "You are looking at outward appearances. If anyone is confident that he belongs to Christ, he should remind himself that we ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "belong to Christ"
          ]
        },
        " just as much as he ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "does"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "2CO 10:8"
        },
        "For even if I boast somewhat excessively about the authority the Lord gave us for building ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        " up rather than tearing you down, I will not be ashamed."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "2CO 10:9"
        },
        "I do not want to seem to be ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "trying"
          ]
        },
        " to frighten you by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "my"
          ]
        },
        " letters. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "2CO 10:10"
        },
        "For ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "some"
          ]
        },
        " say, “",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " letters ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " weighty and forceful, but his physical presence ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " unimpressive, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " speaking ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " of no account.” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "2CO 10:11"
        },
        "Such ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "people"
          ]
        },
        " should consider that what we are in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "our"
          ]
        },
        " letters when absent, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "we will be"
          ]
        },
        " in our actions when present."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "2CO 10:12"
        },
        "We do not dare to classify or compare ourselves ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "with"
          ]
        },
        " some who commend themselves. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "When"
          ]
        },
        " they measure themselves by themselves and compare themselves with themselves, they show their ignorance. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "2CO 10:13"
        },
        "We, however, will not boast beyond our limits, but only within the field of influence that God has assigned to us — a field that reaches even to you. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "2CO 10:14"
        },
        "We are not overstepping our ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "bounds"
          ]
        },
        ", as if we had not come to you. Indeed, we were the first to reach you with the gospel of Christ."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "2CO 10:15"
        },
        "Neither do we boast beyond our limits in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " labors of others. But we hope that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as"
          ]
        },
        " your faith increases, our area of influence among you will greatly increase ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as well "
          ]
        },
        ", ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "2CO 10:16"
        },
        "so that we can preach the gospel ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "in the regions"
          ]
        },
        " beyond you. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Then"
          ]
        },
        " we will not be boasting in the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "work"
          ]
        },
        " already done in another man’s territory."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "2CO 10:17"
        },
        "Rather, “",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Let"
          ]
        },
        " him who boasts boast in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "10:17 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "JER 9:24",
                  "content": [
                    "Jeremiah 9:24"
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "2CO 10:18"
        },
        "For it is not the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one"
          ]
        },
        " who commends himself ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who is"
          ]
        },
        " approved, but the one whom the Lord commends."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "11",
      "sid": "2CO 11"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Paul and the False Apostles"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "2CO 11:1"
        },
        "I hope you will put up with a little of my foolishness, but ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you are already doing that"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "2CO 11:2"
        },
        "I am jealous for you with a godly jealousy. For I promised you to one husband, to present ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as"
          ]
        },
        " a pure virgin to Christ."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "2CO 11:3"
        },
        "I am afraid, however, that just as Eve was deceived by the serpent’s cunning, your minds may be led astray from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " simple and pure ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "devotion"
          ]
        },
        " to Christ. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "2CO 11:4"
        },
        "For if ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "someone"
          ]
        },
        " comes ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " proclaims ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "a"
          ]
        },
        " Jesus other ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "than the One"
          ]
        },
        " we proclaimed, or if you receive a different spirit ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "than the One"
          ]
        },
        " you received, or a different gospel ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "than the one"
          ]
        },
        " you accepted, you put up with it very easily."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "2CO 11:5"
        },
        "I consider myself in no way inferior to those “super-apostles.” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "2CO 11:6"
        },
        "Although ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "I am"
          ]
        },
        " not a polished speaker, I am certainly not lacking in knowledge. We have made this clear to you in every way possible."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "2CO 11:7"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Was it"
          ]
        },
        " a sin ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "for me"
          ]
        },
        " to humble myself in order to exalt you, because I preached the gospel of God to you free of charge? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "2CO 11:8"
        },
        "I robbed other churches by accepting ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their"
          ]
        },
        " support in order to serve you. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "2CO 11:9"
        },
        "And when I was with you and in need, I was not a burden ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to anyone"
          ]
        },
        "; for the brothers who came from Macedonia supplied my needs. I have refrained from being a burden to you in any way, and I will continue to do so. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "2CO 11:10"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "As surely as the"
          ]
        },
        " truth of Christ is in me, this boasting of mine will not be silenced in the regions of Achaia. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "2CO 11:11"
        },
        "Why? Because I do not love you? God knows ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "I do"
          ]
        },
        "!"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "2CO 11:12"
        },
        "But I will keep on doing what I am doing, in order to undercut those who want an opportunity to be regarded as our equals in the things of which they boast. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "2CO 11:13"
        },
        "For such men ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " false apostles, deceitful workers, masquerading as apostles of Christ. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "2CO 11:14"
        },
        "And no wonder, for Satan himself masquerades as an angel of light. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "2CO 11:15"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "It is"
          ]
        },
        " not surprising, then, if his servants masquerade as servants of righteousness. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Their"
          ]
        },
        " end will correspond to their actions."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Paul’s Suffering and Service"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "COL 1:24-29",
          "content": [
            "Colossians 1:24–29"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "2CO 11:16"
        },
        "I repeat: ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Let"
          ]
        },
        " no one take me for a fool. But if ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you do"
          ]
        },
        ", ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "then"
          ]
        },
        " receive me as a fool, so that I too may boast a little. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "2CO 11:17"
        },
        "In this confident boasting ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of mine"
          ]
        },
        ", I am not speaking as ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "would"
          ]
        },
        ", but as a fool. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "2CO 11:18"
        },
        "Since many are boasting according to the flesh, I too will boast. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "2CO 11:19"
        },
        "For you gladly put up with fools, since you are so wise. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "2CO 11:20"
        },
        "In fact, you even put up with anyone who enslaves you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " exploits ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " takes advantage ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of you"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " exalts himself ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " strikes you in the face. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "2CO 11:21"
        },
        "To ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "my"
          ]
        },
        " shame I concede that we were too weak ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "for that"
          ]
        },
        "!"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Speaking as a fool, however, I can ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "match"
          ]
        },
        " what anyone else dares ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to boast about"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "2CO 11:22"
        },
        "Are they Hebrews? So am I. Are they Israelites? So am I. Are they descendants of Abraham? So am I. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "2CO 11:23"
        },
        "Are they servants of Christ? (I am speaking as if I were out of my mind.) I am so much more: in harder labor, in more imprisonments, in worse beatings, in frequent danger of death. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "2CO 11:24"
        },
        "Five times I received from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Jews ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " forty ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "lashes"
          ]
        },
        " minus one. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "2CO 11:25"
        },
        "Three times I was beaten with rods, once I was stoned, three times I was shipwrecked. I spent a night and a day in the open ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "sea"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "2CO 11:26"
        },
        "In my frequent journeys, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "I have been"
          ]
        },
        " in danger from rivers ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " from bandits, in danger from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "my"
          ]
        },
        " countrymen ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Gentiles, in danger in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " city ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " country, in danger on ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " sea ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " among false brothers, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "2CO 11:27"
        },
        "in labor and toil ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " often without sleep, in hunger and thirst ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " often without food, in cold and exposure."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "2CO 11:28"
        },
        "Apart from these external ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "trials"
          ]
        },
        ", I ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "face"
          ]
        },
        " daily the pressure ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of my"
          ]
        },
        " concern for all the churches. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "2CO 11:29"
        },
        "Who is weak, and I am not weak? Who is led into sin, and I ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do"
          ]
        },
        " not burn with grief?"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "2CO 11:30"
        },
        "If I must boast, I will boast ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of"
          ]
        },
        " the things ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that show"
          ]
        },
        " my weakness. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "2CO 11:31"
        },
        "The God and Father of the Lord Jesus, who is forever worthy of praise,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "11:31 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "forever blessed"
              ]
            }
          ]
        },
        " knows that I am not lying. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "32",
          "sid": "2CO 11:32"
        },
        "In Damascus, the governor under King Aretas secured the city of the Damascenes in order to arrest me. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "2CO 11:33"
        },
        "But I was lowered in a basket through a window in the wall and escaped his grasp."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "12",
      "sid": "2CO 12"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Paul’s Revelation"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "2CO 12:1"
        },
        "I must go on boasting. Although there is nothing to gain, I will go on to visions and revelations from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "2CO 12:2"
        },
        "I know a man in Christ ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who"
          ]
        },
        " fourteen years ago was caught up to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " third heaven. Whether ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it was"
          ]
        },
        " in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " body or out of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " I do not know, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "but"
          ]
        },
        " God knows. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "2CO 12:3"
        },
        "And I know that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        " man— whether in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " body or out of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " I do not know, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "but"
          ]
        },
        " God knows— ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "2CO 12:4"
        },
        "was caught up to Paradise. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The things"
          ]
        },
        " he heard ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "were"
          ]
        },
        " inexpressible, things that man is not permitted to tell."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Paul’s Thorn and God’s Grace"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "2CO 12:5"
        },
        "I will boast about such a man, but I will not boast about myself, except in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "my"
          ]
        },
        " weaknesses. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "2CO 12:6"
        },
        "Even if I wanted to boast, I would not be a fool, because I would be speaking ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " truth. But I refrain, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "so"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "no one"
          ]
        },
        " will credit me with more than he sees in me or hears from me, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "2CO 12:7"
        },
        "or because of these surpassingly great revelations."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "So to keep me from becoming conceited,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "12:7 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Some translators end the previous paragraph after verse 6, and begin verse 7 with "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "So to keep me from becoming conceited because of these surpassingly great revelations,"
              ]
            }
          ]
        },
        " I was given a thorn in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "my"
          ]
        },
        " flesh, a messenger of Satan, to torment me. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "2CO 12:8"
        },
        "Three times I pleaded with the Lord to take it away from me. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "2CO 12:9"
        },
        "But He said to me, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“My grace is sufficient for you, for ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "My"
              ]
            },
            " power is perfected in weakness.”"
          ]
        },
        " Therefore I will boast all the more gladly in my weaknesses, so that the power of Christ may rest on me. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "2CO 12:10"
        },
        "That is why, for the sake of Christ, I delight in weaknesses, in insults, in hardships, in persecutions, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "in"
          ]
        },
        " difficulties. For when I am weak, then I am strong."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Paul’s Concern for the Corinthians"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "2CO 12:11"
        },
        "I have become a fool, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "but"
          ]
        },
        " you drove me ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to it"
          ]
        },
        ". In fact, you should have commended me, since I am in no way inferior to those “super-apostles,” even though I am nothing. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "2CO 12:12"
        },
        "The marks of a true apostle — signs, wonders, and miracles — were performed among you with great perseverance. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "2CO 12:13"
        },
        "In what way were you inferior to the other churches, except that I was not a burden to you? Forgive me this wrong!"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "2CO 12:14"
        },
        "See, I am ready to come to you a third time, and I will not be a burden, because I am not seeking your ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "possessions"
          ]
        },
        ", but you. For children should not have to save up for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their"
          ]
        },
        " parents, but parents for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their"
          ]
        },
        " children. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "2CO 12:15"
        },
        "And for the sake of your souls, I ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "will"
          ]
        },
        " most gladly spend my money and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "myself"
          ]
        },
        ". If I love you more, will ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        " love me less?"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "2CO 12:16"
        },
        "Be that as it may, I was not a burden to you; but crafty as I am, I caught you by trickery. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "2CO 12:17"
        },
        "Did I exploit you by anyone I sent you? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "2CO 12:18"
        },
        "I urged Titus ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to visit you"
          ]
        },
        ", and I sent ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "our"
          ]
        },
        " brother ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "with him"
          ]
        },
        ". ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Did"
          ]
        },
        " Titus exploit you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "in any way"
          ]
        },
        "? Did we not walk in the same Spirit ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and follow"
          ]
        },
        " in the same footsteps?",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "12:18 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Did we not walk in the same Spirit? Not in the same footsteps?"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "2CO 12:19"
        },
        "Have you been thinking all along that we were making a defense to you? We speak before God in Christ, and all of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        ", beloved, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " to build you up. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "2CO 12:20"
        },
        "For I am afraid ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " when I come, I may not find you as I wish, and you may not find ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "me"
          ]
        },
        " as you wish. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "I fear"
          ]
        },
        " that there may be quarreling, jealousy, rage, rivalry, slander, gossip, arrogance, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " disorder. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "2CO 12:21"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "I am afraid that"
          ]
        },
        " when I come again, my God will humble me before you, and I will be grieved over many who have sinned earlier and have not repented of their acts of impurity, sexual immorality, and debauchery."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "13",
      "sid": "2CO 13"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Examine Yourselves"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "2CO 13:1"
        },
        "This ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " third ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "time"
          ]
        },
        " I am coming to you. “Every matter must be established by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " testimony of two or three witnesses.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "13:1 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "DEU 19:15",
                  "content": [
                    "Deuteronomy 19:15"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "2CO 13:2"
        },
        "I already warned ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        " the second time I was ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "with you"
          ]
        },
        ". ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So"
          ]
        },
        " now in my absence I warn those who sinned earlier and everyone else: If I return, I will not spare ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "anyone"
          ]
        },
        ", ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "2CO 13:3"
        },
        "since you are demanding proof that Christ is speaking through me. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "He"
          ]
        },
        " is not weak in dealing with you but is powerful among you. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "2CO 13:4"
        },
        "For He was indeed crucified in weakness, yet He lives by God’s power. For we are also weak in Him, yet by God’s power we will live with Him concerning you."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "2CO 13:5"
        },
        "Examine yourselves ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to see"
          ]
        },
        " whether you are in the faith; test yourselves. Do you not realize that Jesus Christ ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " in you — unless you fail the test? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "2CO 13:6"
        },
        "And I hope you will realize that we have not failed the test."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "2CO 13:7"
        },
        "Now we pray to God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " you will not do ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "anything"
          ]
        },
        " wrong — not that we will appear to have stood the test, but that you will do what ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " right, even if we appear to have failed. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "2CO 13:8"
        },
        "For we cannot do anything against the truth, but only for the truth. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "2CO 13:9"
        },
        "In fact, we rejoice when we are weak but you are strong, and our prayer is for your perfection."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "2CO 13:10"
        },
        "This is why I write these things while absent, so that when I am present I will not need to be severe in my use of the authority that the Lord gave me for building ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        " up, not for tearing ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        " down."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Benediction and Farewell"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "2CO 13:11"
        },
        "Finally, brothers, rejoice! Aim for perfect harmony, encourage one another,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "13:11 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "listen to my appeal"
              ]
            }
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be of"
          ]
        },
        " one mind, live in peace. And the God of love and peace will be with you."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "2CO 13:12"
        },
        "Greet one another with a holy kiss."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "2CO 13:13"
        },
        "All the saints send you greetings."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "2CO 13:14"
        },
        "The grace of the Lord Jesus Christ, and the love of God, and the fellowship of the Holy Spirit ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " with all of you.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "13:14 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Texts vary in verse numbering for the last three verses of this chapter. BYZ ends with "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Amen"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "."
              ]
            }
          ]
        }
      ]
    }
  ]
}