      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "1",
      "sid": "MRK 1"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Mission of John the Baptist"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ISA 40:1-5",
          "content": [
            "Isaiah 40:1–5"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MAT 3:1-17",
          "content": [
            "Matthew 3:1–17"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 3:1-22",
          "content": [
            "Luke 3:1–22"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 1:19-34",
          "content": [
            "John 1:19–34"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MRK 1:1"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "This is the"
          ]
        },
        " beginning of the gospel of Jesus Christ, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Son of God.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:1 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "ECM, NE, BYZ, and TR; SBL and WH "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "the beginning of the gospel of Jesus Christ."
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MRK 1:2"
        },
        "As it is written in Isaiah the prophet:",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:2 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "in the prophets:"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Behold, I will send My messenger ahead of You,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "who will prepare Your way.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:2 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "MAL 3:1",
                  "content": [
                    "Malachi 3:1"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "MRK 1:3"
        },
        "“A voice of one calling in the wilderness,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "‘Prepare the way for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "make straight paths for Him.’”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:3 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 40:3",
                  "content": [
                    "Isaiah 40:3"
                  ]
                },
                " (see also LXX)"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "MRK 1:4"
        },
        "John the Baptist appeared in the wilderness, preaching ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "a"
          ]
        },
        " baptism of repentance for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " forgiveness of sins. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MRK 1:5"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "People"
          ]
        },
        " went out to him from all of Jerusalem and the countryside of Judea. Confessing their sins, they were baptized by him in the Jordan River."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "MRK 1:6"
        },
        "John was clothed in camel’s hair, with a leather belt around his waist. His food was locusts and wild honey. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MRK 1:7"
        },
        "And he proclaimed: “After me will come One more powerful than I, the straps of whose sandals I am not worthy to stoop down ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " untie. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "MRK 1:8"
        },
        "I baptize you with water,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:8 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "in water"
              ]
            }
          ]
        },
        " but He will baptize you with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Holy Spirit.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:8 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "in the Holy Spirit"
              ]
            }
          ]
        },
        "”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MRK 1:9"
        },
        "In those days Jesus came from Nazareth in Galilee and was baptized by John in the Jordan. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "MRK 1:10"
        },
        "As soon ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as Jesus"
          ]
        },
        " came up out of the water, He saw",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:10 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "he saw"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; see ",
                {
                  "type": "ref",
                  "loc": "JHN 1:32-33",
                  "content": [
                    "John 1:32–33"
                  ]
                }
              ]
            }
          ]
        },
        " the heavens breaking open and the Spirit descending on Him like a dove. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "MRK 1:11"
        },
        "And a voice came from heaven: “You are My beloved Son; in You I am well pleased.”"
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Temptation and Preaching of Jesus"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 4:1-17",
          "content": [
            "Matthew 4:1–17"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 4:1-15",
          "content": [
            "Luke 4:1–15"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "MRK 1:12"
        },
        "At once the Spirit drove ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " into the wilderness, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MRK 1:13"
        },
        "and He was ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "there"
          ]
        },
        " for forty days, being tempted by Satan. He was with the wild animals, and the angels ministered to Him."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MRK 1:14"
        },
        "After the arrest of John, Jesus went into Galilee ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " proclaimed the gospel of God.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:14 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "the gospel of the kingdom of God "
              ]
            }
          ]
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "15",
              "sid": "MRK 1:15"
            },
            "“The time is fulfilled,”"
          ]
        },
        " He said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“and the kingdom of God is near. Repent and believe in the gospel!”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The First Disciples"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 4:18-22",
          "content": [
            "Matthew 4:18–22"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 5:1-11",
          "content": [
            "Luke 5:1–11"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 1:35-42",
          "content": [
            "John 1:35–42"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "MRK 1:16"
        },
        "As ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " was walking beside the Sea of Galilee, He saw Simon and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " brother Andrew. They were casting a net into the sea, for they were fishermen. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "17",
              "sid": "MRK 1:17"
            },
            "“Come, follow Me,”"
          ]
        },
        " Jesus said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“and I will make you fishers of men.”"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "MRK 1:18"
        },
        "And at once they left ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their"
          ]
        },
        " nets ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " followed Him."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "MRK 1:19"
        },
        "Going on a little ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "farther"
          ]
        },
        ", He saw James ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "son"
          ]
        },
        " of Zebedee and his brother John. They ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "were"
          ]
        },
        " in a boat, mending ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their"
          ]
        },
        " nets. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "MRK 1:20"
        },
        "Immediately ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " called them, and they left their father Zebedee in the boat with the hired men ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " followed Him."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Expels an Unclean Spirit"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 4:31-37",
          "content": [
            "Luke 4:31–37"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "MRK 1:21"
        },
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus and His companions"
          ]
        },
        " went to Capernaum, and right away ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " entered the synagogue on the Sabbath ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " began to teach. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "MRK 1:22"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The people"
          ]
        },
        " were astonished at His teaching, because He taught as one who had authority, and not as the scribes."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MRK 1:23"
        },
        "Suddenly a man with an unclean spirit cried out in the synagogue: ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "MRK 1:24"
        },
        "“What do You  ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "want "
          ]
        },
        " with us, Jesus of Nazareth? Have You come to destroy us? I know who You are — the Holy ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "One"
          ]
        },
        " of God!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "MRK 1:25"
        },
        "But Jesus rebuked ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the spirit"
          ]
        },
        ". ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Be silent!”"
          ]
        },
        " He said. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Come out of him!”"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "MRK 1:26"
        },
        "At this, the unclean spirit threw ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the man"
          ]
        },
        " into convulsions ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " came out with a loud shriek."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "MRK 1:27"
        },
        "All ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the people"
          ]
        },
        " were amazed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " began to ask one another, “What is this? A new teaching with authority! He commands even the unclean spirits, and they obey Him!” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "MRK 1:28"
        },
        "And the news about ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " spread quickly through the whole region of Galilee."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Heals at Peter’s House"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 8:14-17",
          "content": [
            "Matthew 8:14–17"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 4:38-41",
          "content": [
            "Luke 4:38–41"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "MRK 1:29"
        },
        "As soon as ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus and His companions"
          ]
        },
        " had left the synagogue, they went with James and John to the home of Simon and Andrew. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "MRK 1:30"
        },
        "Simon’s mother-in-law was sick in bed with a fever, and they promptly told ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " about her. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "MRK 1:31"
        },
        "So He went to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "her"
          ]
        },
        ", took her ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "by the"
          ]
        },
        " hand, and helped her up. The fever left her, and she began to serve them."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "32",
          "sid": "MRK 1:32"
        },
        "That evening, after sunset, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "people"
          ]
        },
        " brought to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " all the sick and demon-possessed, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "MRK 1:33"
        },
        "and the whole town gathered at the door. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "34",
          "sid": "MRK 1:34"
        },
        "And He healed many who were ill with various diseases and drove out many demons. But He would not allow the demons to speak, because they knew who He was."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Prays and Preaches"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 4:42-44",
          "content": [
            "Luke 4:42–44"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "35",
          "sid": "MRK 1:35"
        },
        "Early in the morning, while it was still dark, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " got up ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " went out to a solitary place to pray. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "36",
          "sid": "MRK 1:36"
        },
        "Simon and his companions went to look for Him, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "37",
          "sid": "MRK 1:37"
        },
        "and when they found Him, they said, “Everyone is looking for You!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "38",
          "sid": "MRK 1:38"
        },
        "But ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " answered, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Let us go on to the neighboring towns so I can preach there as well, for that is why I have come.”"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "39",
          "sid": "MRK 1:39"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So"
          ]
        },
        " He went throughout Galilee, preaching in their synagogues and driving out demons."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Leper’s Prayer"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LEV 14:1-32",
          "content": [
            "Leviticus 14:1–32"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MAT 8:1-4",
          "content": [
            "Matthew 8:1–4"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 5:12-16",
          "content": [
            "Luke 5:12–16"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "40",
          "sid": "MRK 1:40"
        },
        "Then a leper",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:40 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "A "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "leper "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "was one afflicted with a skin disease. See Leviticus 13."
              ]
            }
          ]
        },
        " came to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        ", begging on his knees: “If You are willing, You can make me clean.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "41",
          "sid": "MRK 1:41"
        },
        "Moved with compassion,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:41 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "SBL "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Moved with indignation"
              ]
            }
          ]
        },
        " Jesus reached out His hand ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " touched ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the man"
          ]
        },
        ". ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“I am willing,”"
          ]
        },
        " He said. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Be clean!”"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "42",
          "sid": "MRK 1:42"
        },
        "And immediately the leprosy left him, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the man"
          ]
        },
        " was cleansed."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "43",
          "sid": "MRK 1:43"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " promptly sent him away with a stern warning: ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "44",
              "sid": "MRK 1:44"
            },
            "“See that you don’t tell ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "anyone"
              ]
            },
            ". But go, show yourself to the priest and present the offering Moses prescribed for your cleansing, as a testimony to them.”",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "1:44 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "See ",
                    {
                      "type": "ref",
                      "loc": "LEV 14:1-32",
                      "content": [
                        "Leviticus 14:1–32"
                      ]
                    },
                    "."
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "45",
          "sid": "MRK 1:45"
        },
        "But the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        " went out ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " openly began to proclaim and spread the news."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Consequently, Jesus could no longer enter a town in plain view, but He stayed out in solitary places. Yet ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "people"
          ]
        },
        " came to Him from every quarter."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "2",
      "sid": "MRK 2"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Heals a Paralytic"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 9:1-8",
          "content": [
            "Matthew 9:1–8"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 5:17-26",
          "content": [
            "Luke 5:17–26"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MRK 2:1"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "A few"
          ]
        },
        " days later ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " went back to Capernaum. And when ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the people"
          ]
        },
        " heard that He was home, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MRK 2:2"
        },
        "they gathered in such large numbers that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "there was"
          ]
        },
        " no more room, not even outside the door, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as Jesus"
          ]
        },
        " spoke the word to them."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "MRK 2:3"
        },
        "Then a paralytic was brought to Him, carried by four ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "men"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "MRK 2:4"
        },
        "Since they were unable to get to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " through the crowd, they uncovered the roof above Him, made an opening, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " lowered the paralytic on ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " mat."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MRK 2:5"
        },
        "When Jesus saw their faith, He said to the paralytic, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Son, your sins are forgiven.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "MRK 2:6"
        },
        "But some of the scribes were sitting there and thinking in their hearts, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MRK 2:7"
        },
        "“Why ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "does"
          ]
        },
        " this ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        " speak like this? He is blaspheming! Who can forgive sins but God alone?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "MRK 2:8"
        },
        "At once Jesus knew in His spirit that they were thinking this way within themselves. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Why are you thinking these things in your hearts?”"
          ]
        },
        " He asked. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "9",
              "sid": "MRK 2:9"
            },
            "“Which is easier: to say to a paralytic, ‘Your sins are forgiven,’ or to say, ‘Get up, pick up your mat, and walk’? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "10",
              "sid": "MRK 2:10"
            },
            "But so that you may know that the Son of Man has authority on earth to forgive sins...”"
          ]
        },
        " He said to the paralytic, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "11",
              "sid": "MRK 2:11"
            },
            "“I tell you, get up, pick up your mat, and go home.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "MRK 2:12"
        },
        "And immediately ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the man"
          ]
        },
        " got up, picked up ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " mat, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " walked out in front of them all. As a result, they were all astounded and glorified God, saying, “We have never seen anything like this!”"
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Calls Levi"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 9:9-13",
          "content": [
            "Matthew 9:9–13"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 5:27-32",
          "content": [
            "Luke 5:27–32"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MRK 2:13"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Once"
          ]
        },
        " again ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " went out beside the sea. All the people came to Him, and He taught them ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "there"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MRK 2:14"
        },
        "As He was walking along, He saw Levi ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "son"
          ]
        },
        " of Alphaeus sitting at the tax booth. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Follow Me,”"
          ]
        },
        " He told him, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Levi"
          ]
        },
        " got up ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " followed Him."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "MRK 2:15"
        },
        "While ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " was dining at ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Levi’s"
          ]
        },
        " house, many tax collectors and sinners were eating with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        " and His disciples — for there were many who followed Him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "MRK 2:16"
        },
        "When the scribes who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "were"
          ]
        },
        " Pharisees saw ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " eating with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "these people"
          ]
        },
        ", they asked His disciples, “Why ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "does"
          ]
        },
        " He eat",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:16 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "and drink"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; see ",
                {
                  "type": "ref",
                  "loc": "LUK 5:30",
                  "content": [
                    "Luke 5:30"
                  ]
                },
                "."
              ]
            }
          ]
        },
        " with tax collectors and sinners?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "MRK 2:17"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "On"
          ]
        },
        " hearing this, Jesus told them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "It is"
              ]
            },
            " not the healthy ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "who"
              ]
            },
            " need a doctor, but the sick. I have not come to call the righteous, but sinners.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Questions about Fasting"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 9:14-15",
          "content": [
            "Matthew 9:14–15"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 5:33-35",
          "content": [
            "Luke 5:33–35"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "MRK 2:18"
        },
        "Now John’s disciples and the Pharisees were often fasting. So ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "people"
          ]
        },
        " came to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " and asked, “Why don’t Your disciples fast ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "like"
          ]
        },
        " John’s disciples and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "those"
          ]
        },
        " of the Pharisees?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "MRK 2:19"
        },
        "Jesus replied, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“How can the guests of the bridegroom fast while ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "He"
              ]
            },
            " is with them? As long as ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "He is"
              ]
            },
            " with them, they cannot fast. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "20",
              "sid": "MRK 2:20"
            },
            "But the time will come when the bridegroom will be taken from them; then they will fast."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Patches and the Wineskins"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 9:16-17",
          "content": [
            "Matthew 9:16–17"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 5:36-39",
          "content": [
            "Luke 5:36–39"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "MRK 2:21"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "No one sews a patch of unshrunk cloth on an old garment. If he does, the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "new"
              ]
            },
            " piece will pull away from ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " old, and a worse tear will result."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "MRK 2:22"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "And no one pours new wine into old wineskins. If he does, the wine will burst the skins, and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "both"
              ]
            },
            " the wine and the wineskins will be ruined. Instead, new wine ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is poured"
              ]
            },
            " into new wineskins.”",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "2:22 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Tischendorf does not include "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "Instead, new wine is poured into new wineskins"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "."
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Lord of the Sabbath"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "1SA 21:1-7",
          "content": [
            "1 Samuel 21:1–7"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MAT 12:1-8",
          "content": [
            "Matthew 12:1–8"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 6:1-5",
          "content": [
            "Luke 6:1–5"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MRK 2:23"
        },
        "One Sabbath ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " was passing through the grainfields, and His disciples began to pick the heads of grain ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as"
          ]
        },
        " they walked along. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "MRK 2:24"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So"
          ]
        },
        " the Pharisees said to Him, “Look, why are they doing what is unlawful on the Sabbath?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "MRK 2:25"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " replied, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Have you never read what David did when he and his companions were hungry and in need? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "26",
              "sid": "MRK 2:26"
            },
            "During the high priesthood of Abiathar, he entered the house of God and ate the consecrated bread,",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "2:26 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "the Bread of the Presence"
                  ]
                }
              ]
            },
            " which was lawful only for the priests. And he gave ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "some"
              ]
            },
            " to his companions as well.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "MRK 2:27"
        },
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " declared, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“The Sabbath was made for man, not man for the Sabbath. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "28",
              "sid": "MRK 2:28"
            },
            "Therefore, the Son of Man is Lord even of the Sabbath.”"
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "3",
      "sid": "MRK 3"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Heals on the Sabbath"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 12:9-14",
          "content": [
            "Matthew 12:9–14"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 6:6-11",
          "content": [
            "Luke 6:6–11"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MRK 3:1"
        },
        "Once again ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " entered the synagogue, and a man with a withered hand was there. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MRK 3:2"
        },
        "In order to accuse ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        ", they were watching ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to see"
          ]
        },
        " if He would heal on the Sabbath."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "MRK 3:3"
        },
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " said to the man with the withered hand, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Stand up among ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "us"
              ]
            },
            ".”"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "MRK 3:4"
        },
        "And He asked them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Which is lawful on the Sabbath: to do good or to do evil, to save life or to destroy ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            "?”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "But they were silent."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MRK 3:5"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " looked around at them with anger ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " sorrow at ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their"
          ]
        },
        " hardness of heart. Then He said to the man, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Stretch out your hand.”"
          ]
        },
        " So he stretched ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " out, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " was restored."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "MRK 3:6"
        },
        "At this, the Pharisees went out ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " began plotting with the Herodians how they might kill ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Heals the Multitudes"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 4:23-25",
          "content": [
            "Matthew 4:23–25"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 6:17-19",
          "content": [
            "Luke 6:17–19"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MRK 3:7"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So"
          ]
        },
        " Jesus withdrew with His disciples to the sea, accompanied by a large crowd from Galilee, Judea, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "MRK 3:8"
        },
        "Jerusalem, Idumea, the region beyond the Jordan, and the vicinity of Tyre and Sidon. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The"
          ]
        },
        " large crowd came to Him when they heard what great things He was doing."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MRK 3:9"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " asked His disciples to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "have"
          ]
        },
        " a boat ready for Him so that the crowd would not crush Him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "MRK 3:10"
        },
        "For He had healed so many that all who had diseases were pressing forward to touch Him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "MRK 3:11"
        },
        "And when the unclean spirits saw Him, they fell down before Him and cried out, “You are the Son of God!” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "MRK 3:12"
        },
        "But He warned them sternly not to make Him known."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Twelve Apostles"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 10:1-4",
          "content": [
            "Matthew 10:1–4"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 6:12-16",
          "content": [
            "Luke 6:12–16"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MRK 3:13"
        },
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " went up on the mountain and called for those He wanted, and they came to Him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MRK 3:14"
        },
        "He appointed twelve ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of them"
          ]
        },
        ", ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "whom"
          ]
        },
        " He designated as apostles,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:14 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "SBL and WH; ECM, SBL, NE, BYZ, and TR do not include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "whom He designated as apostles"
              ]
            }
          ]
        },
        " to accompany Him, to be sent out to preach, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "MRK 3:15"
        },
        "and to have authority",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:15 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "to heal sicknesses, and"
              ]
            }
          ]
        },
        " to drive out demons."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "MRK 3:16"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "These are"
          ]
        },
        " the twelve He appointed:",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:16 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "SBL, NE, and WH; ECM, BYZ, and TR do not include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "These are the twelve He appointed"
              ]
            }
          ]
        },
        " Simon (whom He named Peter), ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "MRK 3:17"
        },
        "James ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "son"
          ]
        },
        " of Zebedee and his brother John (",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "whom"
          ]
        },
        " He named Boanerges, meaning “Sons of Thunder”), ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "MRK 3:18"
        },
        "Andrew, Philip, Bartholomew, Matthew, Thomas, James ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "son"
          ]
        },
        " of Alphaeus, Thaddaeus, Simon the Zealot,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:18 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Greek "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Simon the Cananean"
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "MRK 3:19"
        },
        "and Judas Iscariot, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who"
          ]
        },
        " betrayed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        ".",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:19 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "who also betrayed Him"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "A House Divided"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 12:22-30",
          "content": [
            "Matthew 12:22–30"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 11:14-23",
          "content": [
            "Luke 11:14–23"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "MRK 3:20"
        },
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " went home,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:20 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Then He comes to a house"
              ]
            }
          ]
        },
        " and once again a crowd gathered, so that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "He and His disciples"
          ]
        },
        " could not even eat. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "MRK 3:21"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "When"
          ]
        },
        " His family heard ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "about this"
          ]
        },
        ", they went out to take custody of Him, saying, “He is out of His mind.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "MRK 3:22"
        },
        "And the scribes who had come down from Jerusalem were saying, “He is possessed by Beelzebul,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:22 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "WH "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Beezeboul"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; Vulgate "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Beelzebub"
              ]
            }
          ]
        },
        "” and, “By the prince of the demons He drives out demons.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MRK 3:23"
        },
        "So ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " called them together ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " began to speak to them in parables: ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“How can Satan drive out Satan? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "24",
              "sid": "MRK 3:24"
            },
            "If a kingdom is divided against itself, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            " cannot stand. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "25",
              "sid": "MRK 3:25"
            },
            "If a house is divided against itself, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            " cannot stand. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "26",
              "sid": "MRK 3:26"
            },
            "And if Satan is divided and rises against himself, he cannot stand; ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "his"
              ]
            },
            " end has come. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "27",
              "sid": "MRK 3:27"
            },
            "Indeed, no one can enter a strong man’s house to steal his possessions unless he first ties up the strong man. Then he can plunder his house."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Unpardonable Sin"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 12:31-32",
          "content": [
            "Matthew 12:31–32"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "MRK 3:28"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Truly I tell you, the sons of men will be forgiven all sins and blasphemies, as many as they utter. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "29",
              "sid": "MRK 3:29"
            },
            "But whoever blasphemes against the Holy Spirit ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "will"
              ]
            },
            " never be forgiven; he is guilty ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "of"
              ]
            },
            " eternal sin.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "MRK 3:30"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus made this statement "
          ]
        },
        " because they were saying, “He has an unclean spirit.”"
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus’ Mother and Brothers"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 12:46-50",
          "content": [
            "Matthew 12:46–50"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 8:19-21",
          "content": [
            "Luke 8:19–21"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "MRK 3:31"
        },
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus’"
          ]
        },
        " mother and brothers came and stood outside. They sent ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "someone"
          ]
        },
        " in to summon Him, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "32",
          "sid": "MRK 3:32"
        },
        "and a crowd was sitting around Him. “Look,” He was told, “Your mother and brothers",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:32 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "ECM, SBL, WH, and TR; NE and BYZ include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "and Your sisters"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "."
              ]
            }
          ]
        },
        " are outside, asking for You.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "MRK 3:33"
        },
        "But ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " replied, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Who are My mother and My brothers?”"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "34",
          "sid": "MRK 3:34"
        },
        "Looking at those seated in a circle around Him, He said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Here ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "are"
              ]
            },
            " My mother and My brothers! ",
            {
              "type": "verse",
              "marker": "v",
              "number": "35",
              "sid": "MRK 3:35"
            },
            "For whoever does the will of God is My brother and sister and mother.”"
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "4",
      "sid": "MRK 4"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Parable of the Sower"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 13:1-9",
          "content": [
            "Matthew 13:1–9"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 8:4-8",
          "content": [
            "Luke 8:4–8"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MRK 4:1"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Once"
          ]
        },
        " again ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " began to teach beside the sea, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "such"
          ]
        },
        " a large crowd gathered around Him that He got into a boat ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " sat in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        ", while all the people crowded along the shore."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MRK 4:2"
        },
        "And He taught them many things in parables, and in His teaching He said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "3",
              "sid": "MRK 4:3"
            },
            "“Listen! A farmer went out to sow his seed. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "4",
              "sid": "MRK 4:4"
            },
            "And as he was sowing, some ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "seed"
              ]
            },
            " fell along the path, and the birds came and devoured it."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MRK 4:5"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Some fell on rocky ground, where it did not have much soil. It sprang up quickly because the soil was shallow. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "6",
              "sid": "MRK 4:6"
            },
            "But when the sun rose, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the seedlings"
              ]
            },
            " were scorched, and they withered because they had no root."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MRK 4:7"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Other ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "seed "
              ]
            },
            " fell among thorns, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "which"
              ]
            },
            " grew up and choked ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the seedlings"
              ]
            },
            ", and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "they"
              ]
            },
            " yielded no crop."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "MRK 4:8"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Still other ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "seed"
              ]
            },
            " fell on good soil, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "where it"
              ]
            },
            " sprouted, grew up, and produced a crop — one bearing thirtyfold, another sixtyfold, and another a hundredfold.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MRK 4:9"
        },
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“He who has ears to hear, let him hear.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Purpose of Jesus’ Parables"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ISA 6:1-13",
          "content": [
            "Isaiah 6:1–13"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MAT 13:10-17",
          "content": [
            "Matthew 13:10–17"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 8:9-10",
          "content": [
            "Luke 8:9–10"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "MRK 4:10"
        },
        "As soon as ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " was alone ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "with"
          ]
        },
        " the Twelve and those around Him, they asked Him ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "about"
          ]
        },
        " the parable."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "MRK 4:11"
        },
        "He replied, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“The mystery of the kingdom of God has been given to you, but to those on the outside everything is expressed in parables, ",
            {
              "type": "verse",
              "marker": "v",
              "number": "12",
              "sid": "MRK 4:12"
            },
            "so that,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "‘they may be ever seeing ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "but"
              ]
            },
            " never perceiving,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "and ever hearing ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "but"
              ]
            },
            " never understanding;"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "otherwise they might turn"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "and be forgiven.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "4:12 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "ISA 6:9-10",
                      "content": [
                        "Isaiah 6:9–10"
                      ]
                    },
                    " (see also LXX)"
                  ]
                }
              ]
            },
            "”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Parable of the Sower Explained"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 13:18-23",
          "content": [
            "Matthew 13:18–23"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 8:11-15",
          "content": [
            "Luke 8:11–15"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MRK 4:13"
        },
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " said to them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Do you not understand this parable? Then how will you understand ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "any of"
              ]
            },
            " the parables?"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MRK 4:14"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "The farmer sows the word. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "15",
              "sid": "MRK 4:15"
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "Some"
              ]
            },
            " are like the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "seeds"
              ]
            },
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "4:15 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "the word"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "; similarly in verses 16, 18, and 20; literally "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "Now these are the ones"
                  ]
                }
              ]
            },
            " along the path, where the word is sown. As soon as they hear ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            ", Satan comes and takes away the word that was sown in them."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "MRK 4:16"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            {
              "type": "char",
              "marker": "add",
              "content": [
                "Some"
              ]
            },
            " are like the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "seeds"
              ]
            },
            " sown on rocky ground. ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "They"
              ]
            },
            " hear the word ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " at once receive it with joy. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "17",
              "sid": "MRK 4:17"
            },
            "But they themselves have no root, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " they remain for only a season. When trouble or persecution comes because of the word, they quickly fall away."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "MRK 4:18"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            {
              "type": "char",
              "marker": "add",
              "content": [
                "Others"
              ]
            },
            " are like the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "seeds"
              ]
            },
            " sown among the thorns. ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "They"
              ]
            },
            " hear the word, ",
            {
              "type": "verse",
              "marker": "v",
              "number": "19",
              "sid": "MRK 4:19"
            },
            "but the worries of this life, the deceitfulness of wealth, and the desire for other things come in ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " choke the word, and it becomes unfruitful."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "MRK 4:20"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Still ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "others"
              ]
            },
            " are like the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "seeds"
              ]
            },
            " sown on good soil. ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "They"
              ]
            },
            " hear the word, receive ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            ", and produce a crop — thirtyfold, sixtyfold, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "or"
              ]
            },
            " a hundredfold.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Lesson of the Lamp"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 8:16-18",
          "content": [
            "Luke 8:16–18"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "MRK 4:21"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " also said to them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Does ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "anyone"
              ]
            },
            " bring in a lamp to put ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            " under a basket or under a bed? Doesn’t he set it on a stand? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "22",
              "sid": "MRK 4:22"
            },
            "For there is nothing hidden that will not be disclosed, and nothing concealed that will ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "not"
              ]
            },
            " be brought to light."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MRK 4:23"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "If anyone has ears to hear, let him hear.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "MRK 4:24"
        },
        "He went on to say, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Pay attention to what you hear. With ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " measure you ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "use"
              ]
            },
            ", it will be measured to you, and even more will be added to you. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "25",
              "sid": "MRK 4:25"
            },
            "For whoever has will be given ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "more"
              ]
            },
            ". ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "But"
              ]
            },
            " whoever does not have, even what he has will be taken away from him.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Seed Growing Secretly"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "MRK 4:26"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " also said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“The kingdom of God is like a man who scatters seed on the ground. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "27",
              "sid": "MRK 4:27"
            },
            "Night and day he sleeps and wakes, and the seed sprouts and grows, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "though"
              ]
            },
            " he knows not how. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "28",
              "sid": "MRK 4:28"
            },
            "All by itself the earth produces a crop— first ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " stalk, then ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " head, then grain ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "that"
              ]
            },
            " ripens within. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "29",
              "sid": "MRK 4:29"
            },
            "And as soon as the grain is ripe, he swings the sickle, because the harvest has come.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "4:29 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "See ",
                    {
                      "type": "ref",
                      "loc": "JOL 3:13",
                      "content": [
                        "Joel 3:13"
                      ]
                    },
                    ", including LXX."
                  ]
                }
              ]
            },
            "”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Parable of the Mustard Seed"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 13:31-32",
          "content": [
            "Matthew 13:31–32"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 13:18-19",
          "content": [
            "Luke 13:18–19"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "MRK 4:30"
        },
        "Then He asked, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“To what can we compare the kingdom of God? With what parable shall we present it? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "31",
              "sid": "MRK 4:31"
            },
            "It is like a mustard seed, which is ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " smallest of all seeds sown upon the earth. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "32",
              "sid": "MRK 4:32"
            },
            "But after it is planted, it grows to be the largest of all garden plants and puts forth great branches, so that the birds of the air nest in its shade.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "MRK 4:33"
        },
        "With many such parables ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " spoke the word to them, to the extent that they could understand. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "34",
          "sid": "MRK 4:34"
        },
        "He did not tell them ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "anything"
          ]
        },
        " without using a parable. But privately He explained everything to His own disciples."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Calms the Storm"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "PSA 107:1-43",
          "content": [
            "Psalm 107:1–43"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MAT 8:23-27",
          "content": [
            "Matthew 8:23–27"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 8:22-25",
          "content": [
            "Luke 8:22–25"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "35",
          "sid": "MRK 4:35"
        },
        "When that evening came, He said to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His disciples"
          ]
        },
        ", ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Let us cross to the other side.”"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "36",
          "sid": "MRK 4:36"
        },
        "After they had dismissed the crowd, they took ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " with them, since He was already in the boat. And there were other boats with Him."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "37",
          "sid": "MRK 4:37"
        },
        "Soon a violent windstorm came up, and the waves were breaking over the boat, so that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " was being swamped. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "38",
          "sid": "MRK 4:38"
        },
        "But ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " was in the stern, sleeping on the cushion. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So"
          ]
        },
        " they woke Him and said, “Teacher, don’t You care that we are perishing?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "39",
          "sid": "MRK 4:39"
        },
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " got up ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " rebuked the wind and the sea. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Silence!”"
          ]
        },
        " He commanded. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Be still!”"
          ]
        },
        " And the wind died down, and it was perfectly calm."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "40",
              "sid": "MRK 4:40"
            },
            "“Why are you so afraid?”"
          ]
        },
        " He asked. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Do you still have no faith?”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "41",
          "sid": "MRK 4:41"
        },
        "Overwhelmed with fear, they asked one another, “Who is this, that even the wind and the sea obey Him?”"
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "5",
      "sid": "MRK 5"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Demons and the Pigs"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 8:28-34",
          "content": [
            "Matthew 8:28–34"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 8:26-39",
          "content": [
            "Luke 8:26–39"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MRK 5:1"
        },
        "On the other side of the sea, they arrived in the region of the Gerasenes.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "5:1 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Gadarenes"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; PT "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Gergesenes"
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MRK 5:2"
        },
        "As soon as ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " got out of the boat, He was met by a man with an unclean spirit, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who was"
          ]
        },
        " coming from the tombs. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "MRK 5:3"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "This man"
          ]
        },
        " had been living in the tombs and could no longer be restrained, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "even"
          ]
        },
        " with chains. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "MRK 5:4"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Though"
          ]
        },
        " he ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was"
          ]
        },
        " often bound with chains and shackles, he had broken the chains and shattered the shackles. Now ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "there was"
          ]
        },
        " no one with the strength to subdue him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MRK 5:5"
        },
        "Night and day in the tombs and in the mountains he kept crying out and cutting himself with stones."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "MRK 5:6"
        },
        "When ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the man"
          ]
        },
        " saw Jesus from a distance, he ran and fell on his knees before Him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MRK 5:7"
        },
        "And he shouted in a loud voice, “What do You ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "want"
          ]
        },
        " with me, Jesus, Son of the Most High God? I beg You before God not to torture me!” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "MRK 5:8"
        },
        "For ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " had already declared, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Come out of ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "this"
              ]
            },
            " man, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "you"
              ]
            },
            " unclean spirit!”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "9",
              "sid": "MRK 5:9"
            },
            "“What ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " your name?”"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " asked."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "“My name ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " Legion,” he replied, “for we are many.” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "MRK 5:10"
        },
        "And he begged ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " repeatedly not to send them out of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " region."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "MRK 5:11"
        },
        "There on the nearby hillside a large herd of pigs was feeding. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "MRK 5:12"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the demons"
          ]
        },
        " begged ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        ", “Send us to the pigs, so that we may enter them.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MRK 5:13"
        },
        "He gave them permission, and the unclean spirits came out ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " went into the pigs, and the herd of about two thousand rushed down the steep bank into the sea and drowned in the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "water"
          ]
        },
        ".",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "5:13 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "and were drowned in the sea"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MRK 5:14"
        },
        "Those tending ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the pigs"
          ]
        },
        " ran off and reported ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        " in the town and countryside, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the people"
          ]
        },
        " went out to see what had happened. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "MRK 5:15"
        },
        "When they came to Jesus, they saw the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        " who had been possessed by the legion ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of demons"
          ]
        },
        " sitting ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "there"
          ]
        },
        ", clothed and in his right mind; and they were afraid."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "MRK 5:16"
        },
        "Those who had seen ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " described what had happened to the demon-possessed man and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "also to"
          ]
        },
        " the pigs. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "MRK 5:17"
        },
        "And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the people"
          ]
        },
        " began to beg ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " to leave their region."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "MRK 5:18"
        },
        "As He was getting into the boat, the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        " who had been possessed by the demons begged to go with Him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "MRK 5:19"
        },
        "But ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " would not allow him. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Go home to your own ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "people"
              ]
            },
            ",”"
          ]
        },
        " He said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“and tell them how much the Lord has done for you, and what mercy He has shown you.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "MRK 5:20"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the man"
          ]
        },
        " went away and began to proclaim throughout the Decapolis",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "5:20 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "That is, the Ten Cities"
              ]
            }
          ]
        },
        " how much Jesus had done for him. And everyone was amazed."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Healing Touch of Jesus"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 9:18-26",
          "content": [
            "Matthew 9:18–26"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 8:40-56",
          "content": [
            "Luke 8:40–56"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "MRK 5:21"
        },
        "When Jesus had again crossed by boat to the other side, a large crowd gathered around Him beside the sea. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "MRK 5:22"
        },
        "A synagogue leader named Jairus arrived, and seeing ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        ", he fell at His feet ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MRK 5:23"
        },
        "and pleaded with Him urgently, “My little daughter is near death. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Please"
          ]
        },
        " come ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " place ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Your"
          ]
        },
        " hands on her, so that she will be healed and live.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "MRK 5:24"
        },
        "So ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " went with him, and a large crowd followed and pressed around Him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "MRK 5:25"
        },
        "And a woman ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was there"
          ]
        },
        " who had suffered from bleeding for twelve years. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "MRK 5:26"
        },
        "She had borne much ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "agony"
          ]
        },
        " under the care of many physicians and had spent all she had, but to no avail. Instead, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "her condition"
          ]
        },
        " had only grown worse."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "MRK 5:27"
        },
        "When ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the woman"
          ]
        },
        " heard about Jesus, she came up through the crowd behind ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " touched His cloak. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "MRK 5:28"
        },
        "For she kept saying, “If only I touch His garments, I will be healed.” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "MRK 5:29"
        },
        "Immediately her bleeding stopped, and she sensed in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "her"
          ]
        },
        " body that she was healed of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "her"
          ]
        },
        " affliction."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "MRK 5:30"
        },
        "At once Jesus was aware ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " power had gone out from Him. Turning to the crowd, He asked, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Who touched My garments?”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "MRK 5:31"
        },
        "His disciples answered, “You can see the crowd pressing in on You, and yet You ask, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "‘Who touched Me?’"
          ]
        },
        "”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "32",
          "sid": "MRK 5:32"
        },
        "But He kept looking around to see who had done this. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "MRK 5:33"
        },
        "Then the woman, knowing what had happened to her, came and fell down before Him trembling in fear, and she told Him the whole truth."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "34",
              "sid": "MRK 5:34"
            },
            "“Daughter,”"
          ]
        },
        " said ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        ", ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“your faith has healed you. Go in peace and be free of your affliction.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "35",
          "sid": "MRK 5:35"
        },
        "While He was still speaking,  ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "messengers "
          ]
        },
        " from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the house of Jairus"
          ]
        },
        " arrived ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, “Your daughter is dead; why bother the Teacher anymore?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "36",
          "sid": "MRK 5:36"
        },
        "But Jesus overheard",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "5:36 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "ignored"
              ]
            }
          ]
        },
        " their conversation and said to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jairus"
          ]
        },
        ", ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "Do"
              ]
            },
            " not be afraid; just believe.”"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "37",
          "sid": "MRK 5:37"
        },
        "And He did not allow anyone to accompany Him except Peter, James, and John the brother of James."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "38",
          "sid": "MRK 5:38"
        },
        "When they arrived at the house of the synagogue leader, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " saw ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " commotion and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the people"
          ]
        },
        " weeping and wailing loudly. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "39",
          "sid": "MRK 5:39"
        },
        "He went inside ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " asked, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Why all this commotion and weeping? The child is not dead, but asleep.”"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "40",
          "sid": "MRK 5:40"
        },
        "And they laughed at Him."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "add",
          "content": [
            "After"
          ]
        },
        " He had put them all outside, He took the child’s father and mother and His own companions, and went in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to see"
          ]
        },
        " the child. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "41",
          "sid": "MRK 5:41"
        },
        "Taking ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "her"
          ]
        },
        " by the hand, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Talitha koum!”"
          ]
        },
        " which means, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Little girl, I say to you, get up!”"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "42",
          "sid": "MRK 5:42"
        },
        "Immediately the girl got up and began to walk around (she was twelve years old). And at once they were utterly astounded. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "43",
          "sid": "MRK 5:43"
        },
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " gave strict orders that no one should know about this, and He told ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        " to give her ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "something"
          ]
        },
        " to eat."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "6",
      "sid": "MRK 6"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Rejection at Nazareth"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 13:53-58",
          "content": [
            "Matthew 13:53–58"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 4:16-30",
          "content": [
            "Luke 4:16–30"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MRK 6:1"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " went on from there and came to His hometown, accompanied by His disciples. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MRK 6:2"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "When"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Sabbath came, He began to teach in the synagogue, and many who heard ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        " were astonished. “Where ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "did"
          ]
        },
        " this ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man get"
          ]
        },
        " these ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "ideas"
          ]
        },
        "?” they asked. “What ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        " wisdom He has been given? And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "how can"
          ]
        },
        " He perform such miracles? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "MRK 6:3"
        },
        "Isn’t this the carpenter, the son of Mary and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " brother of James, Joses,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "6:3 "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Joses "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "is a variant of "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Joseph"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; see ",
                {
                  "type": "ref",
                  "loc": "MAT 13:55",
                  "content": [
                    "Matthew 13:55"
                  ]
                },
                "."
              ]
            }
          ]
        },
        " Judas, and Simon? Aren’t His sisters here with us as well?” And they took offense at Him."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "MRK 6:4"
        },
        "Then Jesus said to them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Only in his hometown, among his relatives, and in his ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "own"
              ]
            },
            " household is a prophet without honor.”"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MRK 6:5"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So"
          ]
        },
        " He could not perform ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "any"
          ]
        },
        " miracles there, except to lay ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " hands on a few of the sick ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " heal ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "MRK 6:6"
        },
        "And He was amazed at their unbelief."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "And He went around from village to village, teaching ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the people"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Ministry of the Twelve"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 10:5-15",
          "content": [
            "Matthew 10:5–15"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 9:1-6",
          "content": [
            "Luke 9:1–6"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MRK 6:7"
        },
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " called the Twelve ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to Him"
          ]
        },
        " and began to send them out two ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "by"
          ]
        },
        " two, giving them authority over unclean spirits. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "MRK 6:8"
        },
        "He instructed them to take nothing but a staff for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " journey — no bread, no bag, no money",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "6:8 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "copper coins"
              ]
            }
          ]
        },
        " in their belts — ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MRK 6:9"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " to wear sandals, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "but"
          ]
        },
        " not a second tunic."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "MRK 6:10"
        },
        "And He told them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“When you enter a house, stay there until you leave that area. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "11",
              "sid": "MRK 6:11"
            },
            "If anyone will not welcome you or listen to you, shake the dust off your feet when you leave that place, as a testimony against them.”"
          ]
        },
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "6:11 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Truly I tell you, it will be more tolerable for Sodom and Gomorrah on the day of judgment than for that town"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; see ",
                {
                  "type": "ref",
                  "loc": "MAT 10:15",
                  "content": [
                    "Matthew 10:15"
                  ]
                },
                "."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "MRK 6:12"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So"
          ]
        },
        " they set out ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " preached that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the people"
          ]
        },
        " should repent. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MRK 6:13"
        },
        "They also drove out many demons and healed many of the sick, anointing ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        " with oil."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Beheading of John"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 14:1-12",
          "content": [
            "Matthew 14:1–12"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 9:7-9",
          "content": [
            "Luke 9:7–9"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MRK 6:14"
        },
        "Now King Herod heard about this, for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus’"
          ]
        },
        " name had become well known, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "people"
          ]
        },
        " were saying,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "6:14 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "they were saying"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; some manuscripts "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "he was saying"
              ]
            }
          ]
        },
        " “John the Baptist has risen from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " dead! That is why miraculous powers are at work in him.” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "MRK 6:15"
        },
        "Others were saying, “He is Elijah,” and still others, “",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "He is"
          ]
        },
        " a prophet, like one of the prophets ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of old"
          ]
        },
        ".”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "MRK 6:16"
        },
        "But when Herod heard this, he said, “John, whom I beheaded, has risen ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "from the dead"
          ]
        },
        "!” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "MRK 6:17"
        },
        "For Herod himself had ordered that John be arrested and bound ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " imprisoned, on account of his brother Philip’s wife Herodias, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "whom"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Herod"
          ]
        },
        " had married. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "MRK 6:18"
        },
        "For John had been telling Herod, “It is not lawful for you to have your brother’s wife!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "MRK 6:19"
        },
        "So Herodias held a grudge against ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "John"
          ]
        },
        " and wanted to kill him. But she had been unable, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "MRK 6:20"
        },
        "because Herod feared John and protected him, knowing ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " he ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was"
          ]
        },
        " a righteous and holy man. When he heard ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "John’s words"
          ]
        },
        ", he was greatly perplexed; yet he listened to him gladly."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "MRK 6:21"
        },
        "On ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Herod’s"
          ]
        },
        " birthday, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "her"
          ]
        },
        " opportunity arose. Herod held a banquet for his nobles and military commanders and the leading ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "men"
          ]
        },
        " of Galilee. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "MRK 6:22"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "When"
          ]
        },
        " the daughter of Herodias",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "6:22 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Some early manuscripts "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "When his daughter Herodias"
              ]
            }
          ]
        },
        " came and danced, she pleased Herod and his guests, and the king said to the girl, “Ask me for whatever you wish, and I will give ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " to you.” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MRK 6:23"
        },
        "And he swore to her, “Whatever you ask of me, I will give you, up to half my kingdom!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "MRK 6:24"
        },
        "Then she went out ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " asked her mother, “What should I request?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "her mother"
          ]
        },
        " answered, “The head of John the Baptist.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "MRK 6:25"
        },
        "At once ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the girl"
          ]
        },
        " hurried back to the king with her request: “I want you to give me the head of John the Baptist on a platter immediately.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "MRK 6:26"
        },
        "The king was consumed with sorrow, but because of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " oaths and his guests, he did not want to refuse her. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "MRK 6:27"
        },
        "So without delay, the king commanded that John’s head be brought in. He sent an executioner, who went ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " beheaded him in the prison. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "MRK 6:28"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The man"
          ]
        },
        " brought ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "John’s"
          ]
        },
        " head on a platter and presented it to the girl, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who"
          ]
        },
        " gave it to her mother."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "MRK 6:29"
        },
        "When ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "John’s"
          ]
        },
        " disciples heard about ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        ", they came and took his body and placed it in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "a"
          ]
        },
        " tomb."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Feeding of the Five Thousand"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 14:13-21",
          "content": [
            "Matthew 14:13–21"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 9:10-17",
          "content": [
            "Luke 9:10–17"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 6:1-15",
          "content": [
            "John 6:1–15"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "MRK 6:30"
        },
        "Meanwhile, the apostles gathered around Jesus and brought Him news of all they had done and taught. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "MRK 6:31"
        },
        "And He said to them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Come with Me privately to ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "a"
              ]
            },
            " solitary place, and let us rest for a while.”"
          ]
        },
        " For many ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "people"
          ]
        },
        " were coming and going, and they did not even have time to eat."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "32",
          "sid": "MRK 6:32"
        },
        "So they went away in a boat by themselves to a solitary place. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "MRK 6:33"
        },
        "But many ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "people"
          ]
        },
        " saw them leaving and recognized ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        ". They ran together on foot from all the towns and arrived before them. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "34",
          "sid": "MRK 6:34"
        },
        "When ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " stepped ashore ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " saw a large crowd, He had compassion on them, because they were like sheep without a shepherd. And He began to teach them many things."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "35",
          "sid": "MRK 6:35"
        },
        "By now the hour was already late. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So"
          ]
        },
        " the disciples came to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, “This is a desolate place, and the hour ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " already late. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "36",
          "sid": "MRK 6:36"
        },
        "Dismiss ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the crowd"
          ]
        },
        " so they can go to the surrounding countryside and villages ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " buy themselves something to eat.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "37",
          "sid": "MRK 6:37"
        },
        "But ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " told them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“You give them ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "something"
              ]
            },
            " to eat.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "They asked Him, “Should we go out ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " spend two hundred denarii",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "6:37 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "A denarius was customarily a day’s wage for a laborer; see ",
                {
                  "type": "ref",
                  "loc": "MAT 20:2",
                  "content": [
                    "Matthew 20:2"
                  ]
                },
                "."
              ]
            }
          ]
        },
        " to give all of them bread to eat?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "38",
              "sid": "MRK 6:38"
            },
            "“Go ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " see how many loaves you have,”"
          ]
        },
        " He told them."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "And after checking, they said, “Five — and two fish.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "39",
          "sid": "MRK 6:39"
        },
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " directed them to have ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the people"
          ]
        },
        " sit in groups on the green grass. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "40",
          "sid": "MRK 6:40"
        },
        "So they sat down in groups of hundreds and fifties."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "41",
          "sid": "MRK 6:41"
        },
        "Taking the five loaves and the two fish ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " looking up to heaven, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " spoke a blessing and broke the loaves. Then He gave ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        " to His disciples to set before ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the people"
          ]
        },
        ". And He divided the two fish among them all."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "42",
          "sid": "MRK 6:42"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "They"
          ]
        },
        " all ate and were satisfied, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "43",
          "sid": "MRK 6:43"
        },
        "and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the disciples"
          ]
        },
        " picked up twelve basketfuls of broken pieces of bread and fish. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "44",
          "sid": "MRK 6:44"
        },
        "And there were five thousand men who had eaten the loaves."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Walks on Water"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 14:22-33",
          "content": [
            "Matthew 14:22–33"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 6:16-21",
          "content": [
            "John 6:16–21"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "45",
          "sid": "MRK 6:45"
        },
        "Immediately ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " made His disciples get into the boat and go on ahead of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        " to Bethsaida, while He dismissed the crowd. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "46",
          "sid": "MRK 6:46"
        },
        "After bidding them farewell, He went up on the mountain to pray."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "47",
          "sid": "MRK 6:47"
        },
        "When evening came, the boat was in the middle of the sea, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus was"
          ]
        },
        " alone on land. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "48",
          "sid": "MRK 6:48"
        },
        "He could see that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the disciples"
          ]
        },
        " were straining to row, because the wind was against them. About ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " fourth watch of the night,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "6:48 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "That is, between three and six in the morning"
              ]
            }
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " went out to them, walking on the sea. He intended to pass by them, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "49",
          "sid": "MRK 6:49"
        },
        "but when they saw Him walking on the sea, they cried out, thinking ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "He"
          ]
        },
        " was a ghost — ",
        {
          "type": "verse",
          "marker": "v",
          "number": "50",
          "sid": "MRK 6:50"
        },
        "for they all saw Him and were terrified."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "But ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " spoke up at once: ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Take courage! ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "It"
              ]
            },
            " is I. ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "Do"
              ]
            },
            " not be afraid.”"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "51",
          "sid": "MRK 6:51"
        },
        "Then He climbed into the boat with them, and the wind died down. And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the disciples were"
          ]
        },
        " utterly astounded, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "52",
          "sid": "MRK 6:52"
        },
        "for they had not understood about the loaves, but their hearts had been hardened."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Heals at Gennesaret"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 14:34-36",
          "content": [
            "Matthew 14:34–36"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "53",
          "sid": "MRK 6:53"
        },
        "When they had crossed over, they landed at Gennesaret and moored ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the boat"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "54",
          "sid": "MRK 6:54"
        },
        "As soon as they got out of the boat, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the people"
          ]
        },
        " recognized ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "55",
          "sid": "MRK 6:55"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " ran through that whole region, carrying the sick on mats to wherever they heard He was. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "56",
          "sid": "MRK 6:56"
        },
        "And wherever He went — villages ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " towns ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " countrysides — they laid the sick in the marketplaces and begged Him just to let them touch the fringe of His cloak. And all who touched Him were healed."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "7",
      "sid": "MRK 7"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Tradition of the Elders"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 15:1-9",
          "content": [
            "Matthew 15:1–9"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MRK 7:1"
        },
        "Then the Pharisees and some of the scribes who had come from Jerusalem gathered around ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        ", ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MRK 7:2"
        },
        "and they saw some of His disciples eating ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "with"
          ]
        },
        " hands ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that were"
          ]
        },
        " defiled— that is, unwashed."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "MRK 7:3"
        },
        "Now in holding to the tradition of the elders, the Pharisees and all the Jews ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do"
          ]
        },
        " not eat until they wash ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their"
          ]
        },
        " hands ceremonially.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "7:3 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "until they have washed their hands to the fist"
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "MRK 7:4"
        },
        "And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "on returning"
          ]
        },
        " from the market, they do not eat unless they wash. And there are many other traditions for them to observe, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "including"
          ]
        },
        " the washing of cups, pitchers, kettles, and couches for dining.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "7:4 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "NE and WH "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "cups, pitchers, and kettles."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MRK 7:5"
        },
        "So the Pharisees and scribes questioned ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        ": “Why ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do"
          ]
        },
        " Your disciples not walk according to the tradition of the elders? Instead, they eat with defiled hands.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "MRK 7:6"
        },
        "Jesus answered them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Isaiah prophesied correctly about you hypocrites, as it is written:"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "‘These people honor Me with ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "their"
              ]
            },
            " lips,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "but their hearts are far from Me."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MRK 7:7"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "They worship Me in vain;"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "they teach ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "as"
              ]
            },
            " doctrine ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " precepts of men.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "7:7 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "ISA 29:13",
                      "content": [
                        "Isaiah 29:13"
                      ]
                    },
                    " (see also LXX)"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "MRK 7:8"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "You have disregarded the commandment of God to keep the tradition of men.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "7:8 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "BYZ and TR include "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "—washings of pots and cups and many such things like these."
                  ]
                }
              ]
            },
            "”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MRK 7:9"
        },
        "He went on to say, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“You neatly set aside the command of God to maintain",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "7:9 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "NA "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "establish"
                  ]
                }
              ]
            },
            " your ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "own"
              ]
            },
            " tradition. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "10",
              "sid": "MRK 7:10"
            },
            "For Moses said, ‘Honor your father and your mother’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "7:10 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "EXO 20:12",
                      "content": [
                        "Exodus 20:12"
                      ]
                    },
                    "; Deuteronomy 5:16"
                  ]
                }
              ]
            },
            " and ‘Anyone who curses ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "his"
              ]
            },
            " father or mother must be put to death.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "7:10 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "EXO 21:17",
                      "content": [
                        "Exodus 21:17"
                      ]
                    },
                    "; Leviticus 20:9"
                  ]
                }
              ]
            },
            {
              "type": "verse",
              "marker": "v",
              "number": "11",
              "sid": "MRK 7:11"
            },
            "But you say that if a man says to ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "his"
              ]
            },
            " father or mother, ‘Whatever you would have received from me ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " Corban’ (that is, a gift devoted ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "to God"
              ]
            },
            "), ",
            {
              "type": "verse",
              "marker": "v",
              "number": "12",
              "sid": "MRK 7:12"
            },
            "he ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " no longer permitted to do anything for his father or mother. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "13",
              "sid": "MRK 7:13"
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "Thus"
              ]
            },
            " you nullify the word of God by ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " tradition you have handed down. And you do so in many such ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "matters"
              ]
            },
            ".”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "What Defiles a Man"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 15:10-20",
          "content": [
            "Matthew 15:10–20"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MRK 7:14"
        },
        "Once again ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " called the crowd ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to Him"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“All of you, listen to Me and understand: ",
            {
              "type": "verse",
              "marker": "v",
              "number": "15",
              "sid": "MRK 7:15"
            },
            "Nothing that enters a man from the outside can defile him; but the things that come out of a man, these are what defile ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "him"
              ]
            },
            ".”"
          ]
        },
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "7:15 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                {
                  "type": "char",
                  "marker": "fv",
                  "content": [
                    "16"
                  ]
                },
                "If anyone has ears to hear, let him hear."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "MRK 7:17"
        },
        "After ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " had left the crowd ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and gone"
          ]
        },
        " into ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " house, His disciples inquired about the parable."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "18",
              "sid": "MRK 7:18"
            },
            "“Are you still so dull?”"
          ]
        },
        " He asked. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Do you not understand? Nothing that enters a man from the outside can defile him, ",
            {
              "type": "verse",
              "marker": "v",
              "number": "19",
              "sid": "MRK 7:19"
            },
            "because it does not enter his heart, but ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it goes"
              ]
            },
            " into the stomach and then is eliminated.”"
          ]
        },
        " (",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Thus"
          ]
        },
        " all foods are clean.)",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "7:19 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "and then is eliminated, thereby expelling all foods.”"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "MRK 7:20"
        },
        "He continued: ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“What comes out of a man, that ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is what"
              ]
            },
            " defiles ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "him"
              ]
            },
            ". ",
            {
              "type": "verse",
              "marker": "v",
              "number": "21",
              "sid": "MRK 7:21"
            },
            "For from within the hearts of men come evil thoughts, sexual immorality, theft, murder, adultery,",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "7:21 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Many texts move "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "adultery "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "to verse 22."
                  ]
                }
              ]
            },
            {
              "type": "verse",
              "marker": "v",
              "number": "22",
              "sid": "MRK 7:22"
            },
            "greed, wickedness, deceit, debauchery, envy, slander, arrogance, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " foolishness. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "23",
              "sid": "MRK 7:23"
            },
            "All these evils come from within, and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "these are what"
              ]
            },
            " defile a man.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Faith of the Gentile Woman"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 15:21-28",
          "content": [
            "Matthew 15:21–28"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "MRK 7:24"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " left that place ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " went to the region of Tyre.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "7:24 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "WH, BYZ, and TR include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "and Sidon"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; see ",
                {
                  "type": "ref",
                  "loc": "MAT 15:21",
                  "content": [
                    "Matthew 15:21"
                  ]
                },
                "."
              ]
            }
          ]
        },
        " Not wanting anyone to know ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "He was there"
          ]
        },
        ", He entered ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "a"
          ]
        },
        " house, but was unable to escape their notice. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "MRK 7:25"
        },
        "Instead, a woman whose little daughter had ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "an"
          ]
        },
        " unclean spirit soon heard about Jesus, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " she came ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " fell at His feet. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "MRK 7:26"
        },
        "Now she was a Greek woman of Syrophoenician origin, and she kept asking ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " to drive the demon out of her daughter."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "27",
              "sid": "MRK 7:27"
            },
            "“First let the children have their fill,”"
          ]
        },
        " He said. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“For it is not right to take the children’s bread and toss ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            " to the dogs.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "MRK 7:28"
        },
        "“Yes, Lord,” she replied, “even the dogs",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "7:28 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "puppies"
              ]
            }
          ]
        },
        " under the table eat the children’s crumbs.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "MRK 7:29"
        },
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " told her, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Because of this answer, you may go. The demon has left your daughter.”"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "MRK 7:30"
        },
        "And she went home ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " found ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "her"
          ]
        },
        " child lying on the bed, and the demon was gone."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Deaf and Mute Man"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 9:27-34",
          "content": [
            "Matthew 9:27–34"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "MRK 7:31"
        },
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " left the region of Tyre ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " went through Sidon to the Sea of Galilee ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " into the region of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Decapolis.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "7:31 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "That is, the Ten Cities"
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "32",
          "sid": "MRK 7:32"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Some people"
          ]
        },
        " brought to Him a man who was deaf and hardly able to speak, and they begged ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " to place ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " hand on him."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "MRK 7:33"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " took him aside privately, away from the crowd, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " put His fingers into ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the man’s"
          ]
        },
        " ears. Then He spit ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " touched ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the man’s"
          ]
        },
        " tongue. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "34",
          "sid": "MRK 7:34"
        },
        "And looking up to heaven, He sighed deeply and said to him, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Ephphatha!”"
          ]
        },
        " (which means, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Be opened!”"
          ]
        },
        "). ",
        {
          "type": "verse",
          "marker": "v",
          "number": "35",
          "sid": "MRK 7:35"
        },
        "Immediately",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "7:35 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "ECM, WH, and SBL do not include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Immediately"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "."
              ]
            }
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the man’s"
          ]
        },
        " ears were opened and his tongue was released, and he began to speak plainly."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "36",
          "sid": "MRK 7:36"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " ordered them not to tell anyone. But the more He ordered them, the more widely they proclaimed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "37",
          "sid": "MRK 7:37"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The people"
          ]
        },
        " were utterly astonished ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, “He has done all things well! He makes even the deaf hear and the mute speak!”"
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "8",
      "sid": "MRK 8"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Feeding of the Four Thousand"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "2KI 4:42-44",
          "content": [
            "2 Kings 4:42–44"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MAT 15:29-39",
          "content": [
            "Matthew 15:29–39"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MRK 8:1"
        },
        "In those days ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " crowd once again became very large, and they had nothing to eat. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " called the disciples ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to Him"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "2",
              "sid": "MRK 8:2"
            },
            "“I have compassion for ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "this"
              ]
            },
            " crowd, because they have already been with Me three days and have nothing to eat. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "3",
              "sid": "MRK 8:3"
            },
            "If I send them home hungry, they will faint along the way. For some of them have come a great distance.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "MRK 8:4"
        },
        "His disciples replied, “Where in this desolate place could anyone ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "find enough"
          ]
        },
        " bread to feed all these ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "people"
          ]
        },
        "?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "5",
              "sid": "MRK 8:5"
            },
            "“How many loaves do you have?”"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " asked."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "“Seven,” they replied."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "MRK 8:6"
        },
        "And He instructed the crowd to sit down on the ground. Then He took the seven loaves, gave thanks ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " broke ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        ", and gave ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        " to His disciples to set before ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the people"
          ]
        },
        ". And they distributed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        " to the crowd. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MRK 8:7"
        },
        "They also had a few small fish, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " blessed them ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " ordered that these be set before ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        " as well."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "MRK 8:8"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The people"
          ]
        },
        " ate and were satisfied, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the disciples"
          ]
        },
        " picked up seven basketfuls of broken pieces that were left over. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MRK 8:9"
        },
        "And about four thousand ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "men"
          ]
        },
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "8:9 "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Men"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "is implied here, that is, in addition to women and children; see ",
                {
                  "type": "ref",
                  "loc": "MAT 15:38",
                  "content": [
                    "Matthew 15:38"
                  ]
                },
                "."
              ]
            }
          ]
        },
        " were  ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "present "
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "And when ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " had dismissed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the crowd"
          ]
        },
        ", ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "MRK 8:10"
        },
        "He immediately got into the boat with His disciples ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " went to the district of Dalmanutha."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Demand for a Sign"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 16:1-4",
          "content": [
            "Matthew 16:1–4"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 12:54-56",
          "content": [
            "Luke 12:54–56"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "MRK 8:11"
        },
        "Then the Pharisees came and began to argue with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        ", testing Him ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "by"
          ]
        },
        " demanding from Him a sign from heaven."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "MRK 8:12"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " sighed deeply in His spirit ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Why ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "does"
              ]
            },
            " this generation demand a sign? Truly I tell you, no sign will be given to this generation.”"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MRK 8:13"
        },
        "And He left them, got back into the boat, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " crossed to the other side."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Leaven of the Pharisees and of Herod"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 16:5-12",
          "content": [
            "Matthew 16:5–12"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 12:1-3",
          "content": [
            "Luke 12:1–3"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MRK 8:14"
        },
        "Now ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the disciples"
          ]
        },
        " had forgotten to take bread, except for one loaf they had with them in the boat. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "15",
              "sid": "MRK 8:15"
            },
            "“Watch out!”"
          ]
        },
        " He cautioned them. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Beware of the leaven of the Pharisees and of Herod.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "MRK 8:16"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So"
          ]
        },
        " they began to discuss with one another the fact that they had no bread."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "MRK 8:17"
        },
        "Aware of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their conversation"
          ]
        },
        ", ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " asked them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Why are you debating about having no bread? Do you still not see or understand? Do you have such hard hearts? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "18",
              "sid": "MRK 8:18"
            },
            "‘Having eyes, do you not see? And having ears, do you not hear?’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "8:18 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "See ",
                    {
                      "type": "ref",
                      "loc": "DEU 29:4",
                      "content": [
                        "Deuteronomy 29:4"
                      ]
                    },
                    ", Isaiah 42:20, Jeremiah 5:21, and Ezekiel 12:2."
                  ]
                }
              ]
            },
            " And do you not remember? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "19",
              "sid": "MRK 8:19"
            },
            "When I broke the five loaves for the five thousand, how many basketfuls of broken pieces did you collect?”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "“Twelve,” they answered."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "20",
              "sid": "MRK 8:20"
            },
            "“And when ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "I broke"
              ]
            },
            " the seven ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "loaves"
              ]
            },
            " for the four thousand, how many basketfuls of broken pieces did you collect?”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "“Seven,” they said."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "MRK 8:21"
        },
        "Then He asked them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Do you still not understand?”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Blind Man at Bethsaida"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "MRK 8:22"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "When"
          ]
        },
        " they arrived at Bethsaida, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "some people"
          ]
        },
        " brought a blind ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        " and begged ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " to touch him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MRK 8:23"
        },
        "So He took the blind ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        " by the hand ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " led him out of the village. Then He spit on ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the man’s"
          ]
        },
        " eyes ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " placed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " hands on him. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Can you see anything?”"
          ]
        },
        " He asked."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "MRK 8:24"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The man"
          ]
        },
        " looked up ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, “I can see the people, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "but"
          ]
        },
        " they look like trees walking around.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "MRK 8:25"
        },
        "Once again ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " placed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " hands on ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the man’s"
          ]
        },
        " eyes, and when he opened them ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his sight"
          ]
        },
        " was restored, and he could see everything clearly. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "MRK 8:26"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " sent him home ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Do not go back into the village.”"
          ]
        },
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "8:26 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "“Do not go and tell anyone in the village.”"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Peter’s Confession of Christ"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 16:13-20",
          "content": [
            "Matthew 16:13–20"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 9:18-20",
          "content": [
            "Luke 9:18–20"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 6:67-71",
          "content": [
            "John 6:67–71"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "MRK 8:27"
        },
        "Then Jesus and His disciples went on to the villages around Caesarea Philippi. On the way, He questioned His disciples: ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Who ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "do"
              ]
            },
            " people say I am?”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "MRK 8:28"
        },
        "They replied, “",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Some say"
          ]
        },
        " John the Baptist; others ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "say"
          ]
        },
        " Elijah; and still others, one of the prophets.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "29",
              "sid": "MRK 8:29"
            },
            "“But ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "what about"
              ]
            },
            " you?”"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " asked. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Who do you say I am?”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Peter answered, “You are the Christ.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "MRK 8:30"
        },
        "And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " warned them not to tell anyone about Him."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Christ’s Passion Foretold"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 16:21-23",
          "content": [
            "Matthew 16:21–23"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 9:21-22",
          "content": [
            "Luke 9:21–22"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "MRK 8:31"
        },
        "Then He began to teach them that the Son of Man must suffer many things and be rejected by the elders, chief priests, and scribes, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " He must be killed and after three days rise ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "again"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "32",
          "sid": "MRK 8:32"
        },
        "He spoke ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        " message quite frankly, and Peter took Him aside ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " began to rebuke Him."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "MRK 8:33"
        },
        "But ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        ", turning and looking at His disciples, rebuked Peter and said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Get behind Me, Satan! For you do not have in mind the things of God, but the things of men.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Take Up Your Cross"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 16:24-28",
          "content": [
            "Matthew 16:24–28"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 9:23-27",
          "content": [
            "Luke 9:23–27"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "34",
          "sid": "MRK 8:34"
        },
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " called the crowd ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to Him"
          ]
        },
        " along with His disciples, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " He told them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“If anyone wants to come after Me, he must deny himself and take up his cross and follow Me. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "35",
              "sid": "MRK 8:35"
            },
            "For whoever wants to save his life will lose it, but whoever loses his life for My sake and for the gospel will save it."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "36",
          "sid": "MRK 8:36"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "What does it profit a man to gain the whole world, yet forfeit his soul? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "37",
              "sid": "MRK 8:37"
            },
            "Or what ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "can"
              ]
            },
            " a man give in exchange for his soul? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "38",
              "sid": "MRK 8:38"
            },
            "If anyone is ashamed of Me and My words in this adulterous and sinful generation, the Son of Man will also be ashamed of him when He comes in His Father’s glory with the holy angels.”"
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "9",
      "sid": "MRK 9"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Transfiguration"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 17:1-13",
          "content": [
            "Matthew 17:1–13"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 9:28-36",
          "content": [
            "Luke 9:28–36"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "2PE 1:16-21",
          "content": [
            "2 Peter 1:16–21"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MRK 9:1"
        },
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " said to them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Truly I tell you, there are some standing here who will not taste death before they see the kingdom of God arrive with power.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MRK 9:2"
        },
        "After six days Jesus took with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        " Peter, James, and John, and led them up a high mountain ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "by"
          ]
        },
        " themselves. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "There"
          ]
        },
        " He was transfigured before them. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "MRK 9:3"
        },
        "His clothes became radiantly white, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "brighter than"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "any"
          ]
        },
        " launderer on earth could bleach them. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "MRK 9:4"
        },
        "And Elijah ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " Moses appeared before them, talking with Jesus."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MRK 9:5"
        },
        "Peter said to Jesus, “Rabbi, it is good for us to be here. Let us put up three shelters",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "9:5 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "three tabernacles"
              ]
            }
          ]
        },
        "— one for You, one for Moses, and one for Elijah.” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "MRK 9:6"
        },
        "For they were all so terrified that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Peter"
          ]
        },
        " did not know what else to say."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MRK 9:7"
        },
        "Then a cloud appeared ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " enveloped them, and a voice came from the cloud: “This is My beloved Son. Listen to Him!” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "MRK 9:8"
        },
        "Suddenly, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "when"
          ]
        },
        " they looked around, they saw no one with them except Jesus."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MRK 9:9"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "As"
          ]
        },
        " they were coming down the mountain, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " admonished them not to tell anyone what they had seen until the Son of Man had risen from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " dead. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "MRK 9:10"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So"
          ]
        },
        " they kept this matter to themselves, discussing what it meant to rise from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " dead. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "MRK 9:11"
        },
        "And they asked ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        ", “",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Why do"
          ]
        },
        " the scribes say that Elijah must come first?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "MRK 9:12"
        },
        "He replied, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Elijah ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "does"
              ]
            },
            " indeed come first, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " he restores all things. Why then is it written that the Son of Man must suffer many things and be rejected? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "13",
              "sid": "MRK 9:13"
            },
            "But I tell you that Elijah has indeed come, and they have done to him whatever they wished, just as it is written about him.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Boy with an Evil Spirit"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 17:14-18",
          "content": [
            "Matthew 17:14–18"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 9:37-42",
          "content": [
            "Luke 9:37–42"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MRK 9:14"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "When"
          ]
        },
        " they returned to the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "other"
          ]
        },
        " disciples, they saw a large crowd around them, and scribes arguing with them. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "MRK 9:15"
        },
        "As soon as all the people saw ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        ", they were filled with awe and ran to greet Him."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "16",
              "sid": "MRK 9:16"
            },
            "“What are you disputing with them?”"
          ]
        },
        " He asked."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "MRK 9:17"
        },
        "Someone in the crowd replied, “Teacher, I brought You my son, who has a spirit ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that makes him"
          ]
        },
        " mute. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "MRK 9:18"
        },
        "Whenever it seizes him, it throws him to the ground. He foams at the mouth, gnashes his teeth, and becomes rigid.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "9:18 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "and is withering away"
              ]
            }
          ]
        },
        " I asked Your disciples to drive it out, but they were unable.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "19",
              "sid": "MRK 9:19"
            },
            "“O unbelieving generation!”"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " replied. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“How long must I remain with you? How long must I put up with you? Bring ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the boy"
              ]
            },
            " to Me.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "MRK 9:20"
        },
        "So they brought him, and seeing ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        ", the spirit immediately threw ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the boy"
          ]
        },
        " into a convulsion. He fell to the ground ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " rolled around, foaming at the mouth."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "MRK 9:21"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " asked ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the boy’s"
          ]
        },
        " father, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“How long ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "has"
              ]
            },
            " this been with him?”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "“From childhood,” he said. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "MRK 9:22"
        },
        "“It often throws him into ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " fire ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " into ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " water, trying to kill him. But if You can ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do"
          ]
        },
        " anything, have compassion on us ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " help us.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "23",
              "sid": "MRK 9:23"
            },
            "“If You can?”"
          ]
        },
        " echoed Jesus. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“All things are possible to him who believes!”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "MRK 9:24"
        },
        "Immediately the boy’s father cried out,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "9:24 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "cried out with tears"
              ]
            }
          ]
        },
        " “I do believe; help my unbelief!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "MRK 9:25"
        },
        "When Jesus saw that a crowd had come running, He rebuked the unclean spirit. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "You"
              ]
            },
            " deaf and mute spirit,”"
          ]
        },
        " He said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“I command you to come out and never enter him ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "again"
              ]
            },
            ".”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "MRK 9:26"
        },
        "After shrieking and convulsing him violently, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the spirit"
          ]
        },
        " came out. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The boy"
          ]
        },
        " became like a corpse, so that many said, “He is dead.” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "MRK 9:27"
        },
        "But Jesus took him by the hand ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " helped him to his feet, and he stood up."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "MRK 9:28"
        },
        "After ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " had gone into ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " house, His disciples asked Him privately, “Why couldn’t we drive it out?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "MRK 9:29"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " answered, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“This kind cannot come out, except by prayer.”"
          ]
        },
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "9:29 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "prayer and fasting"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Second Prediction of the Passion"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 17:22-23",
          "content": [
            "Matthew 17:22–23"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 9:43-45",
          "content": [
            "Luke 9:43–45"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "MRK 9:30"
        },
        "Going on from there, they passed through Galilee. But ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " did not want anyone to know, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "MRK 9:31"
        },
        "because He was teaching His disciples. He told them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“The Son of Man will be delivered into ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " hands of men. They will kill Him, and after three days He will rise.”"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "32",
          "sid": "MRK 9:32"
        },
        "But they did not understand this statement, and they were afraid to ask Him ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "about it"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Greatest in the Kingdom"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 18:1-5",
          "content": [
            "Matthew 18:1–5"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 9:46-50",
          "content": [
            "Luke 9:46–50"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "MRK 9:33"
        },
        "Then they came to Capernaum. While ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " was in the house, He asked them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“What were you discussing on the way?”"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "34",
          "sid": "MRK 9:34"
        },
        "But they were silent, for on the way they had been arguing about which ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of them was"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " greatest."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "35",
          "sid": "MRK 9:35"
        },
        "Sitting down, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " called the Twelve and said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“If anyone wants to be first, he must be ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " last of all and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " servant of all.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "36",
          "sid": "MRK 9:36"
        },
        "Then He had a little child ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "stand"
          ]
        },
        " among them. Taking ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the child"
          ]
        },
        " in His arms, He said to them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "37",
              "sid": "MRK 9:37"
            },
            "“Whoever welcomes one of these little children in My name welcomes Me, and whoever welcomes Me welcomes not only Me, but the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "One"
              ]
            },
            " who sent Me.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "38",
          "sid": "MRK 9:38"
        },
        "John said to Him, “Teacher, we saw someone else driving out demons in Your name, and we tried to stop him, because he does not accompany us.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "39",
              "sid": "MRK 9:39"
            },
            "“",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "Do"
              ]
            },
            " not stop him,”"
          ]
        },
        " Jesus replied. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“For no one who performs a miracle in My name can turn around and speak evil of Me. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "40",
              "sid": "MRK 9:40"
            },
            "For whoever is not against us is for us. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "41",
              "sid": "MRK 9:41"
            },
            "Indeed, if anyone gives you ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "even"
              ]
            },
            " a cup of water because you bear the name of Christ, truly I tell you, he will never lose his reward."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Temptations and Trespasses"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 18:6-9",
          "content": [
            "Matthew 18:6–9"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 17:1-4",
          "content": [
            "Luke 17:1–4"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "42",
          "sid": "MRK 9:42"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "But if anyone causes one of these little ones who believe in Me ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "to stumble"
              ]
            },
            ", it would be better for him to have a large millstone hung around his neck and to be thrown into the sea."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "43",
          "sid": "MRK 9:43"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "If your hand causes you to sin, cut it off. It is better for you to enter life crippled than to have two hands ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " go into hell,",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "9:43 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Greek "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "Gehenna"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "; also in verses 45 and 47"
                  ]
                }
              ]
            },
            " into the unquenchable fire.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "9:43 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "BYZ and TR include "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    {
                      "type": "char",
                      "marker": "fv",
                      "content": [
                        "44"
                      ]
                    },
                    "where their worm never dies, and the fire is never quenched"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "; see verse 48 and ",
                    {
                      "type": "ref",
                      "loc": "ISA 66:24",
                      "content": [
                        "Isaiah 66:24"
                      ]
                    },
                    "."
                  ]
                }
              ]
            },
            {
              "type": "verse",
              "marker": "v",
              "number": "45",
              "sid": "MRK 9:45"
            },
            "If your foot causes you to sin, cut it off. It is better for you to enter life lame than to have two feet ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " be thrown into hell.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "9:45 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "BYZ and TR include "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    {
                      "type": "char",
                      "marker": "fv",
                      "content": [
                        "46"
                      ]
                    },
                    "where their worm never dies, and the fire is never quenched"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "; see verse 48 and ",
                    {
                      "type": "ref",
                      "loc": "ISA 66:24",
                      "content": [
                        "Isaiah 66:24"
                      ]
                    },
                    "."
                  ]
                }
              ]
            },
            {
              "type": "verse",
              "marker": "v",
              "number": "47",
              "sid": "MRK 9:47"
            },
            "And if your eye causes you to sin, pluck it out. It is better for you to enter the kingdom of God with one eye than to have two eyes ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " be thrown into hell, ",
            {
              "type": "verse",
              "marker": "v",
              "number": "48",
              "sid": "MRK 9:48"
            },
            "where  ‘their worm never dies, and the fire is never quenched.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "9:48 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "ISA 66:24",
                      "content": [
                        "Isaiah 66:24"
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Good Salt"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 5:13-16",
          "content": [
            "Matthew 5:13–16"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 14:34-35",
          "content": [
            "Luke 14:34–35"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "49",
          "sid": "MRK 9:49"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "For everyone will be salted with fire.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "9:49 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "BYZ and TR include "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "and every sacrifice will be salted with salt"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "."
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "50",
          "sid": "MRK 9:50"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Salt ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " good, but if the salt loses its saltiness, with what will you season it? Have salt among yourselves, and be at peace with one another.”"
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "10",
      "sid": "MRK 10"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Teachings about Divorce"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 19:1-12",
          "content": [
            "Matthew 19:1–12"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MRK 10:1"
        },
        "Then Jesus left that place ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " went into the region of Judea, beyond the Jordan. Again ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " crowds came to Him and He taught them, as was His custom."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MRK 10:2"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Some"
          ]
        },
        " Pharisees came to test Him. “Is it lawful for a man to divorce his wife?” they inquired."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "3",
              "sid": "MRK 10:3"
            },
            "“What ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "did"
              ]
            },
            " Moses command you?”"
          ]
        },
        " He replied."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "MRK 10:4"
        },
        "They answered, “Moses permitted ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "a man"
          ]
        },
        " to write ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his wife"
          ]
        },
        " a certificate of divorce and send ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "her"
          ]
        },
        " away.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "10:4 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "See ",
                {
                  "type": "ref",
                  "loc": "DEU 24:1",
                  "content": [
                    "Deuteronomy 24:1"
                  ]
                },
                "."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MRK 10:5"
        },
        "But Jesus told them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "Moses"
              ]
            },
            " wrote this commandment for you because of your hardness of heart. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "6",
              "sid": "MRK 10:6"
            },
            "However, from ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " beginning of creation, ‘",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "God"
              ]
            },
            " made them male and female.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "10:6 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "GEN 1:27",
                      "content": [
                        "Genesis 1:27"
                      ]
                    },
                    "; Genesis 5:2"
                  ]
                }
              ]
            },
            {
              "type": "verse",
              "marker": "v",
              "number": "7",
              "sid": "MRK 10:7"
            },
            "‘For this reason a man will leave his father and mother and be united to his wife,",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "10:7 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "NE and WH do not include "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "and be united to his wife."
                  ]
                }
              ]
            },
            {
              "type": "verse",
              "marker": "v",
              "number": "8",
              "sid": "MRK 10:8"
            },
            "and the two will become one flesh.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "10:8 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "GEN 2:24",
                      "content": [
                        "Genesis 2:24"
                      ]
                    },
                    " (see also LXX)"
                  ]
                }
              ]
            },
            " So they are no longer two, but one flesh. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "9",
              "sid": "MRK 10:9"
            },
            "Therefore what God has joined together, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "let"
              ]
            },
            " man not separate.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "MRK 10:10"
        },
        "When ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "they were"
          ]
        },
        " back inside the house, the disciples asked ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " about this matter. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "MRK 10:11"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So"
          ]
        },
        " He told them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Whoever divorces his wife and marries another ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "woman"
              ]
            },
            " commits adultery against her. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "12",
              "sid": "MRK 10:12"
            },
            "And if a woman divorces her husband ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " marries another ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "man"
              ]
            },
            ", she commits adultery.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Blesses the Children"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 19:13-15",
          "content": [
            "Matthew 19:13–15"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 18:15-17",
          "content": [
            "Luke 18:15–17"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MRK 10:13"
        },
        "Now ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "people"
          ]
        },
        " were bringing ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " little children to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " for Him to place His hands on them, and the disciples rebuked ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "those who brought them"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MRK 10:14"
        },
        "But ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "when"
          ]
        },
        " Jesus saw this, He was indignant and told them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Let the little children come to Me, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "do"
              ]
            },
            " not hinder them! For the kingdom of God belongs to such ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "as these"
              ]
            },
            ". ",
            {
              "type": "verse",
              "marker": "v",
              "number": "15",
              "sid": "MRK 10:15"
            },
            "Truly I tell you, anyone who does not receive the kingdom of God like a little child will never enter it.”"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "MRK 10:16"
        },
        "And He took ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the children"
          ]
        },
        " in His arms, placed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " hands on them, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " blessed them."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Rich Young Man"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 19:16-30",
          "content": [
            "Matthew 19:16–30"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 18:18-30",
          "content": [
            "Luke 18:18–30"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "MRK 10:17"
        },
        "As ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " started on His way, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "a man"
          ]
        },
        " ran up and knelt before Him. “Good Teacher,” he asked, “what must I do to inherit eternal life?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "18",
              "sid": "MRK 10:18"
            },
            "“Why do you call Me good?”"
          ]
        },
        " Jesus replied. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“No one ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " good except God alone. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "19",
              "sid": "MRK 10:19"
            },
            "You know the commandments: ‘",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "Do"
              ]
            },
            " not murder, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "do"
              ]
            },
            " not commit adultery, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "do"
              ]
            },
            " not steal, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "do"
              ]
            },
            " not bear false witness, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "do"
              ]
            },
            " not cheat ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "others"
              ]
            },
            ", honor your father and mother.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "10:19 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "EXO 20:12-16",
                      "content": [
                        "Exodus 20:12–16"
                      ]
                    },
                    "; Deuteronomy 5:16–20"
                  ]
                }
              ]
            },
            "”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "MRK 10:20"
        },
        "“Teacher,” he replied, “all these I have kept from my youth.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "MRK 10:21"
        },
        "Jesus looked at him, loved him, and said to him, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "There is"
              ]
            },
            " one thing you lack: Go, sell everything you own and give to the poor, and you will have treasure in heaven. Then come, follow Me.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "10:21 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "BYZ and TR "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "Then come, take up the cross, and follow Me."
                  ]
                }
              ]
            },
            "”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "MRK 10:22"
        },
        "But ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the man"
          ]
        },
        " was saddened by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "these"
          ]
        },
        " words ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " went away in sorrow, because he had great wealth."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MRK 10:23"
        },
        "Then Jesus looked around ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said to His disciples, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“How hard ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it is"
              ]
            },
            " for the rich to enter the kingdom of God!”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "MRK 10:24"
        },
        "And the disciples were amazed at His words."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "But Jesus said to them again, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Children, how hard it is to enter",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "10:24 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "BYZ and TR "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "how hard it is for those who trust in riches to enter"
                  ]
                }
              ]
            },
            " the kingdom of God! ",
            {
              "type": "verse",
              "marker": "v",
              "number": "25",
              "sid": "MRK 10:25"
            },
            "It is easier ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "for"
              ]
            },
            " a camel to pass through the eye of a needle than ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "for"
              ]
            },
            " a rich man to enter the kingdom of God.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "MRK 10:26"
        },
        "They were even more astonished ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said to one another, “Who then can be saved?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "MRK 10:27"
        },
        "Jesus looked at them ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“With man ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "this is"
              ]
            },
            " impossible, but not with God. For all things ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "are"
              ]
            },
            " possible with God.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "MRK 10:28"
        },
        "Peter began to say to Him, “Look, we have left everything and followed You.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "29",
              "sid": "MRK 10:29"
            },
            "“Truly I tell you,”"
          ]
        },
        " Jesus replied, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“no one who has left home or brothers or sisters or mother or father or children or fields for My sake and for the gospel ",
            {
              "type": "verse",
              "marker": "v",
              "number": "30",
              "sid": "MRK 10:30"
            },
            "will fail to receive a hundredfold in the present age — houses and brothers and sisters and mothers and children and fields, along with persecutions — and in the age to come, eternal life. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "31",
              "sid": "MRK 10:31"
            },
            "But many ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "who are"
              ]
            },
            " first will be last, and the last ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "will be"
              ]
            },
            " first.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Third Prediction of the Passion"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 20:17-19",
          "content": [
            "Matthew 20:17–19"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 18:31-34",
          "content": [
            "Luke 18:31–34"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "32",
          "sid": "MRK 10:32"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "As"
          ]
        },
        " they were going up the road to Jerusalem, Jesus was walking ahead of them. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The disciples"
          ]
        },
        " were amazed, but those who followed were afraid. Again ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " took the Twelve ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "aside"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " began to tell them what was going to happen to Him: ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "33",
              "sid": "MRK 10:33"
            },
            "“Look, we are going up to Jerusalem, and the Son of Man will be delivered over to the chief priests and scribes. They will condemn Him to death and will deliver Him ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "over"
              ]
            },
            " to the Gentiles, ",
            {
              "type": "verse",
              "marker": "v",
              "number": "34",
              "sid": "MRK 10:34"
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "who"
              ]
            },
            " will mock Him and spit on Him and flog ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "Him"
              ]
            },
            " and kill Him. And after three days He will rise again.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Request of James and John"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 20:20-28",
          "content": [
            "Matthew 20:20–28"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "35",
          "sid": "MRK 10:35"
        },
        "Then James and John, the sons of Zebedee, came to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " declared, “Teacher, we want You to do for us whatever we ask.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "36",
              "sid": "MRK 10:36"
            },
            "“What do you want Me to do for you?”"
          ]
        },
        " He inquired."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "37",
          "sid": "MRK 10:37"
        },
        "They answered, “Grant that one of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "us"
          ]
        },
        " may sit at Your right hand and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the other"
          ]
        },
        " at Your left in Your glory.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "38",
              "sid": "MRK 10:38"
            },
            "“You do not know what you are asking,”"
          ]
        },
        " Jesus replied. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Can you drink the cup I will drink, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "or"
              ]
            },
            " be baptized ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "with"
              ]
            },
            " the baptism ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "I will undergo"
              ]
            },
            "?”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "39",
          "sid": "MRK 10:39"
        },
        "“We can,” ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the brothers"
          ]
        },
        " answered."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“You will drink the cup that I drink,”"
          ]
        },
        " Jesus said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“and you will be baptized ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "with"
              ]
            },
            " the baptism that I ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "undergo"
              ]
            },
            ". ",
            {
              "type": "verse",
              "marker": "v",
              "number": "40",
              "sid": "MRK 10:40"
            },
            "But to sit at My right or left is not Mine to grant. ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "These seats belong to those "
              ]
            },
            " for whom",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "10:40 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Literally "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "Mine to grant, but for whom"
                  ]
                }
              ]
            },
            " they have been prepared.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "41",
          "sid": "MRK 10:41"
        },
        "When the ten heard about ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        ", they became indignant with James and John. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "42",
          "sid": "MRK 10:42"
        },
        "So Jesus called them together ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“You know that those regarded as rulers of the Gentiles lord it over them, and their superiors exercise authority over them. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "43",
              "sid": "MRK 10:43"
            },
            "But it shall not be this way among you. Instead, whoever wants to become great among you must be your servant, ",
            {
              "type": "verse",
              "marker": "v",
              "number": "44",
              "sid": "MRK 10:44"
            },
            "and whoever wants to be first must be ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " slave of all. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "45",
              "sid": "MRK 10:45"
            },
            "For even the Son of Man did not come to be served, but to serve, and to give His life ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "as"
              ]
            },
            " a ransom for many.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Heals Bartimaeus"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 20:29-34",
          "content": [
            "Matthew 20:29–34"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 18:35-43",
          "content": [
            "Luke 18:35–43"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "46",
          "sid": "MRK 10:46"
        },
        "Next, they came to Jericho. And as ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " and His disciples were leaving Jericho with a large crowd, a blind beggar ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "named"
          ]
        },
        " Bartimaeus, the son of Timaeus, was sitting beside the road. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "47",
          "sid": "MRK 10:47"
        },
        "When he heard that it was Jesus of Nazareth, he began to cry out, “Jesus, Son of David, have mercy on me!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "48",
          "sid": "MRK 10:48"
        },
        "Many ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "people"
          ]
        },
        " admonished him to be silent, but he cried out all the louder, “Son of David, have mercy on me!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "49",
          "sid": "MRK 10:49"
        },
        "Jesus stopped ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Call him.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "So they called the blind ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        ". “Take courage!” they said. “Get up! He is calling for you.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "50",
          "sid": "MRK 10:50"
        },
        "Throwing off his cloak, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Bartimaeus"
          ]
        },
        " jumped up ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " came to Jesus."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "51",
              "sid": "MRK 10:51"
            },
            "“What do you want Me to do for you?”"
          ]
        },
        " Jesus asked."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "“Rabboni,” said the blind ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        ", “let me see again.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "52",
              "sid": "MRK 10:52"
            },
            "“Go,”"
          ]
        },
        " said Jesus, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“your faith has healed you.”"
          ]
        },
        " And immediately he received his sight and followed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " along the road."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "11",
      "sid": "MRK 11"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Triumphal Entry"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ZEC 9:9-13",
          "content": [
            "Zechariah 9:9–13"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MAT 21:1-11",
          "content": [
            "Matthew 21:1–11"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 19:28-40",
          "content": [
            "Luke 19:28–40"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 12:12-19",
          "content": [
            "John 12:12–19"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MRK 11:1"
        },
        "As they approached Jerusalem ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and came"
          ]
        },
        " to Bethphage and Bethany at the Mount of Olives, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " sent out two of His disciples ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MRK 11:2"
        },
        "and said to them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Go into the village ahead of you, and as soon as you enter it, you will find a colt tied ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "there"
              ]
            },
            ", on which no one has ever sat. Untie it and bring ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it here"
              ]
            },
            ". ",
            {
              "type": "verse",
              "marker": "v",
              "number": "3",
              "sid": "MRK 11:3"
            },
            "If anyone asks, ‘Why are you doing this?’ tell ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "him"
              ]
            },
            ", ‘The Lord needs it and will return it shortly.’”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "MRK 11:4"
        },
        "So they went and found ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " colt outside in the street, tied at a doorway. They untied it, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MRK 11:5"
        },
        "and some who were standing there asked, “Why are you untying the colt?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "MRK 11:6"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The disciples"
          ]
        },
        " answered as Jesus had instructed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        ", and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the people"
          ]
        },
        " gave them permission. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MRK 11:7"
        },
        "Then they led the colt to Jesus and threw their cloaks over it, and He sat on it."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "MRK 11:8"
        },
        "Many  ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "in the crowd "
          ]
        },
        " spread their cloaks on the road, while others ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "spread"
          ]
        },
        " branches they had cut from the fields. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MRK 11:9"
        },
        "The ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "ones who"
          ]
        },
        " went ahead and those who followed were shouting:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Hosanna!”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "11:9 "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Hosanna "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "is a transliteration of the Hebrew "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Hosia-na"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                ", meaning "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Save, we pray "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Save now"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                ", which became a shout of praise; see ",
                {
                  "type": "ref",
                  "loc": "PSA 118:25",
                  "content": [
                    "Psalm 118:25"
                  ]
                },
                "."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Blessed is He ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who"
          ]
        },
        " comes in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " name of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord!”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "11:9 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "PSA 118:26",
                  "content": [
                    "Psalm 118:26"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "MRK 11:10"
        },
        "“Blessed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " the coming kingdom of our father David!”"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Hosanna in the highest!”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "11:10 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "“Hosanna in the highest heaven!”"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "See ",
                {
                  "type": "ref",
                  "loc": "PSA 118:25",
                  "content": [
                    "Psalm 118:25"
                  ]
                },
                " and Psalm 148:1."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "MRK 11:11"
        },
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " entered Jerusalem ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and went"
          ]
        },
        " into the temple ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "courts"
          ]
        },
        ".",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "11:11 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "the temple"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; also in verses 15, 16, and 27"
              ]
            }
          ]
        },
        " He looked around at everything, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "but since"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " was already late, He went out to Bethany with the Twelve."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Curses the Fig Tree"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 21:18-22",
          "content": [
            "Matthew 21:18–22"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MRK 11:20-25",
          "content": [
            "Mark 11:20–25"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "MRK 11:12"
        },
        "The next day, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "when"
          ]
        },
        " they had left Bethany, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " was hungry. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MRK 11:13"
        },
        "Seeing in the distance a fig tree in leaf, He went to see if there was any ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "fruit"
          ]
        },
        " on it. But when He reached it, He found nothing ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "on it"
          ]
        },
        " except leaves, since it was not the season for figs. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MRK 11:14"
        },
        "Then He said to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the tree"
          ]
        },
        ", ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "May"
              ]
            },
            " no one ever eat of your fruit ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "again"
              ]
            },
            ".”"
          ]
        },
        " And His disciples heard ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this statement"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Cleanses the Temple"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 21:12-17",
          "content": [
            "Matthew 21:12–17"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 19:45-48",
          "content": [
            "Luke 19:45–48"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 2:12-25",
          "content": [
            "John 2:12–25"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "MRK 11:15"
        },
        "When they arrived in Jerusalem, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " entered the temple ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "courts"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " began to drive out those who were buying and selling ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "there"
          ]
        },
        ". He overturned the tables of the money changers and the seats of those selling doves. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "MRK 11:16"
        },
        "And He would not allow anyone to carry merchandise through the temple ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "courts"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "MRK 11:17"
        },
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " began to teach them, and He declared, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Is it not written: ‘My house will be called a house of prayer for all the nations’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "11:17 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "ISA 56:7",
                      "content": [
                        "Isaiah 56:7"
                      ]
                    }
                  ]
                }
              ]
            },
            "? But you have made it ‘a den of robbers.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "11:17 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "JER 7:11",
                      "content": [
                        "Jeremiah 7:11"
                      ]
                    }
                  ]
                }
              ]
            },
            "”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "MRK 11:18"
        },
        "When the chief priests and scribes heard ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        ", they looked for a way to kill Him. For they were afraid of Him, because the whole crowd was astonished at His teaching."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "MRK 11:19"
        },
        "And when evening came, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus and His disciples"
          ]
        },
        " went",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "11:19 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "they went"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "He went"
              ]
            }
          ]
        },
        " out of the city."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Withered Fig Tree"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 21:18-22",
          "content": [
            "Matthew 21:18–22"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MRK 11:12-14",
          "content": [
            "Mark 11:12–14"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "MRK 11:20"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "As"
          ]
        },
        " they were walking back in the morning, they saw the fig tree withered from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "its"
          ]
        },
        " roots. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "MRK 11:21"
        },
        "Peter remembered ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, “Look, Rabbi! The fig tree You cursed has withered.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "22",
              "sid": "MRK 11:22"
            },
            "“Have faith in God,”"
          ]
        },
        " Jesus said to them. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "23",
              "sid": "MRK 11:23"
            },
            "“Truly I tell you that if anyone says to this mountain, ‘Be lifted up and thrown into the sea,’ and has no doubt in his heart but believes that ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            " will happen, it will be done for him. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "24",
              "sid": "MRK 11:24"
            },
            "Therefore I tell you, whatever you ask for in prayer, believe that you have received ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            ", and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            " will be yours."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "MRK 11:25"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "And when you stand to pray, if you hold anything against ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "another"
              ]
            },
            ", forgive ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            ", so that your Father in heaven will forgive your trespasses as well.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "11:25 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "BYZ and TR include "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    {
                      "type": "char",
                      "marker": "fv",
                      "content": [
                        "26"
                      ]
                    },
                    "But if you do not forgive, neither will your Father in heaven forgive your trespasses"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "; see ",
                    {
                      "type": "ref",
                      "loc": "MAT 6:15",
                      "content": [
                        "Matthew 6:15"
                      ]
                    },
                    "."
                  ]
                }
              ]
            },
            "”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus’ Authority Challenged"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 21:23-27",
          "content": [
            "Matthew 21:23–27"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 20:1-8",
          "content": [
            "Luke 20:1–8"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "MRK 11:27"
        },
        "After their return to Jerusalem, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " was walking in the temple ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "courts"
          ]
        },
        ", ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " the chief priests, scribes, and elders came up to Him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "MRK 11:28"
        },
        "“By what authority are You doing these things?” they asked. “",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "And"
          ]
        },
        " who gave You the authority to do ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        "?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "29",
              "sid": "MRK 11:29"
            },
            "“I will ask you one question,”"
          ]
        },
        " Jesus replied, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "if"
              ]
            },
            " you answer Me, I will tell you by what authority I am doing these things. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "30",
              "sid": "MRK 11:30"
            },
            "John’s baptism — was it from heaven or from men? Answer Me!”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "MRK 11:31"
        },
        "They deliberated among themselves what they should answer: “If we say, ‘From heaven,’ He will ask, ‘Why then did you not believe him?’ ",
        {
          "type": "verse",
          "marker": "v",
          "number": "32",
          "sid": "MRK 11:32"
        },
        "But if we say, ‘From men’ ...” they were afraid of the people, for they all held that John truly was a prophet. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "MRK 11:33"
        },
        "So they answered, “We do not know.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "And Jesus replied, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Neither ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "will"
              ]
            },
            " I tell you by what authority I am doing these things.”"
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "12",
      "sid": "MRK 12"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Parable of the Wicked Tenants"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 21:33-46",
          "content": [
            "Matthew 21:33–46"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 20:9-18",
          "content": [
            "Luke 20:9–18"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MRK 12:1"
        },
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " began to speak to them in parables: ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“A man planted a vineyard. He put a wall ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "around it"
              ]
            },
            ", dug a wine vat, and built a watchtower. Then he rented it out to ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "some"
              ]
            },
            " tenants and went away on a journey."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MRK 12:2"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "At harvest time, he sent a servant to the tenants to collect ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "his share"
              ]
            },
            " of the fruit of the vineyard. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "3",
              "sid": "MRK 12:3"
            },
            "But they seized ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the servant"
              ]
            },
            ", beat ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "him"
              ]
            },
            ", and sent ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "him"
              ]
            },
            " away empty-handed."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "MRK 12:4"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Then he sent them another servant, and they struck ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "him"
              ]
            },
            " over the head and treated ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "him"
              ]
            },
            " shamefully."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MRK 12:5"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "He sent still another, and this one they killed."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            {
              "type": "char",
              "marker": "add",
              "content": [
                "He sent"
              ]
            },
            " many others; some they beat and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "others"
              ]
            },
            " they killed."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "MRK 12:6"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Finally, having one beloved son, he sent him to them. ‘They will respect my son,’ he said."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MRK 12:7"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "But ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " tenants said to one another, ‘This is the heir. Come, let us kill him, and the inheritance will be ours.’ ",
            {
              "type": "verse",
              "marker": "v",
              "number": "8",
              "sid": "MRK 12:8"
            },
            "So they seized ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the son"
              ]
            },
            ", killed him, and threw him out of the vineyard."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MRK 12:9"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "What then ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "will"
              ]
            },
            " the owner of the vineyard do? He will come and kill ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "those"
              ]
            },
            " tenants and give the vineyard to others. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "10",
              "sid": "MRK 12:10"
            },
            "Have you never read this Scripture:"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "‘",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "The"
              ]
            },
            " stone the builders rejected"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "has become the cornerstone."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "MRK 12:11"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "This is from ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " Lord,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "and it is marvelous in our eyes’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "12:11 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "PSA 118:22-23",
                      "content": [
                        "Psalm 118:22–23"
                      ]
                    }
                  ]
                }
              ]
            },
            "?”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "MRK 12:12"
        },
        "At this, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the leaders"
          ]
        },
        " sought",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "12:12 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "they sought"
              ]
            }
          ]
        },
        " to arrest ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        ", for they knew that He had spoken ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        " parable against them. But fearing the crowd, they left Him ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " went away."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Paying Taxes to Caesar"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 22:15-22",
          "content": [
            "Matthew 22:15–22"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 20:19-26",
          "content": [
            "Luke 20:19–26"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MRK 12:13"
        },
        "Later, they sent some of the Pharisees and Herodians to catch ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " words. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MRK 12:14"
        },
        "“Teacher,” they said, “we know that You are honest and seek favor from no one. Indeed, You are impartial ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " teach the way of God in accordance with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " truth. Is it lawful to pay taxes to Caesar or not? Should we pay ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        " or not?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "MRK 12:15"
        },
        "But ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " saw through their hypocrisy ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Why are you testing Me? Bring Me a denarius",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "12:15 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "A denarius was customarily a day’s wage for a laborer; see ",
                    {
                      "type": "ref",
                      "loc": "MAT 20:2",
                      "content": [
                        "Matthew 20:2"
                      ]
                    },
                    "."
                  ]
                }
              ]
            },
            " to inspect.”"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "MRK 12:16"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So"
          ]
        },
        " they brought ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        ", and He asked them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Whose image ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " this? And ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "whose"
              ]
            },
            " inscription?”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "“Caesar’s,” they answered."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "MRK 12:17"
        },
        "Then Jesus told them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Give to Caesar what is Caesar’s, and to God what is God’s.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "And they marveled at Him."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Sadducees and the Resurrection"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 22:23-33",
          "content": [
            "Matthew 22:23–33"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 20:27-40",
          "content": [
            "Luke 20:27–40"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "MRK 12:18"
        },
        "Then the Sadducees, who say there is no resurrection, came to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " and questioned Him: ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "MRK 12:19"
        },
        "“Teacher, Moses wrote for us that if a man’s brother dies and leaves a wife but no children, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the man"
          ]
        },
        " is to marry ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his brother’s"
          ]
        },
        " widow and raise up offspring for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "him"
          ]
        },
        ".",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "12:19 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "DEU 25:5",
                  "content": [
                    "Deuteronomy 25:5"
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "MRK 12:20"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Now"
          ]
        },
        " there were seven brothers. The first ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one"
          ]
        },
        " married and died, leaving no children. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "MRK 12:21"
        },
        "Then the second ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one"
          ]
        },
        " married ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the widow"
          ]
        },
        ", ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "but"
          ]
        },
        " he also died ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " left no children. And the third ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "did"
          ]
        },
        " likewise. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "MRK 12:22"
        },
        "In this way, none of the seven left ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "any"
          ]
        },
        " children. And last of all, the woman died. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MRK 12:23"
        },
        "In the resurrection, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "then"
          ]
        },
        ",",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "12:23 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "In the resurrection, when they rise,"
              ]
            }
          ]
        },
        " whose wife will she be? For ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "all"
          ]
        },
        " seven were married to her.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "MRK 12:24"
        },
        "Jesus said to them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Aren’t you mistaken, because you do not know the Scriptures ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "or"
              ]
            },
            " the power of God? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "25",
              "sid": "MRK 12:25"
            },
            "When the dead rise, they will neither marry nor be given in marriage. Instead, they will be like ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " angels in heaven."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "MRK 12:26"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "But concerning the dead rising, have you not read about the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "burning"
              ]
            },
            " bush in the Book of Moses, how God told him, ‘I ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "am"
              ]
            },
            " the God of Abraham, the God of Isaac, and the God of Jacob’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "12:26 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "EXO 3:6",
                      "content": [
                        "Exodus 3:6"
                      ]
                    }
                  ]
                }
              ]
            },
            "? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "27",
              "sid": "MRK 12:27"
            },
            "He is not ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " God of ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " dead, but of ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " living. You are badly mistaken!”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Greatest Commandment"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "DEU 6:1-19",
          "content": [
            "Deuteronomy 6:1–19"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MAT 22:34-40",
          "content": [
            "Matthew 22:34–40"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "MRK 12:28"
        },
        "Now one of the scribes had come up and heard their debate. Noticing how well ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " had answered them, he asked Him, “Which commandment is ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " most important of all?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "MRK 12:29"
        },
        "Jesus replied, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“This is the most important: ‘Hear, O Israel, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " Lord our God, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " Lord is One. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "30",
              "sid": "MRK 12:30"
            },
            "Love ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " Lord your God with all your heart and with all your soul and with all your mind and with all your strength.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "12:30 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "DEU 6:4-5",
                      "content": [
                        "Deuteronomy 6:4–5"
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "verse",
              "marker": "v",
              "number": "31",
              "sid": "MRK 12:31"
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "The"
              ]
            },
            " second ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " this: ‘Love your neighbor as yourself.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "12:31 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "LEV 19:18",
                      "content": [
                        "Leviticus 19:18"
                      ]
                    }
                  ]
                }
              ]
            },
            " No other commandment is greater than these.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "32",
          "sid": "MRK 12:32"
        },
        "“Right, Teacher,” the scribe replied. “You have stated correctly that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "God"
          ]
        },
        " is One and there is no other but Him, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "MRK 12:33"
        },
        "and to love Him with all ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " heart and with all ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " understanding and with all ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " strength, and to love ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " neighbor as yourself. This is more important than all burnt offerings and sacrifices.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "34",
          "sid": "MRK 12:34"
        },
        "When Jesus saw that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the man"
          ]
        },
        " had answered wisely, He said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“You are not far from the kingdom of God.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "And no one dared to question Him ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "any"
          ]
        },
        " further."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Whose Son Is the Christ?"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 22:41-46",
          "content": [
            "Matthew 22:41–46"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 20:41-44",
          "content": [
            "Luke 20:41–44"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "35",
          "sid": "MRK 12:35"
        },
        "While ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " was teaching in the temple ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "courts"
          ]
        },
        ",",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "12:35 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "the temple"
              ]
            }
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "He"
          ]
        },
        " asked, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“How ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "can"
              ]
            },
            " the scribes say that the Christ is ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " Son of David? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "36",
              "sid": "MRK 12:36"
            },
            "Speaking by the Holy Spirit, David himself declared:"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "‘",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "The"
              ]
            },
            " Lord said to my Lord,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Sit at My right hand"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "until I put Your enemies"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "under Your feet.”’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "12:36 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "PSA 110:1",
                      "content": [
                        "Psalm 110:1"
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "37",
          "sid": "MRK 12:37"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "David himself calls Him ‘Lord.’ So how can He be ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "David’s"
              ]
            },
            " son?”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "And the large crowd listened to Him with delight."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Beware of the Scribes"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 20:45-47",
          "content": [
            "Luke 20:45–47"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "38",
          "sid": "MRK 12:38"
        },
        "In His teaching ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " also said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Watch out for the scribes. They like to walk around in long robes, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "to receive"
              ]
            },
            " greetings in the marketplaces, ",
            {
              "type": "verse",
              "marker": "v",
              "number": "39",
              "sid": "MRK 12:39"
            },
            "and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "to have"
              ]
            },
            " the chief seats in the synagogues and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " places of honor at banquets. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "40",
              "sid": "MRK 12:40"
            },
            "They defraud widows ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "of their"
              ]
            },
            " houses,",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "12:40 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Literally "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "They devour widows’ houses"
                  ]
                }
              ]
            },
            " and for a show make lengthy prayers. These ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "men"
              ]
            },
            " will receive greater condemnation.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Widow’s Offering"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 21:1-4",
          "content": [
            "Luke 21:1–4"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "41",
          "sid": "MRK 12:41"
        },
        "As ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " was sitting opposite the treasury, He watched the crowd putting money into ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        ". And many rich ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "people"
          ]
        },
        " put in large amounts. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "42",
          "sid": "MRK 12:42"
        },
        "Then one poor widow came ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " put ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "in"
          ]
        },
        " two small copper coins, which amounted to a small fraction of a denarius.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "12:42 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Greek "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "put in two lepta, which is a kodrantēs"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; a lepton was a Jewish coin of bronze or copper worth about 1/128 of a denarius."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "43",
          "sid": "MRK 12:43"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " called His disciples ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to Him"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Truly I tell you, this poor widow has put more than all the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "others"
              ]
            },
            " into the treasury. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "44",
              "sid": "MRK 12:44"
            },
            "For they all contributed out of their surplus, but she out of her poverty has put ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "in"
              ]
            },
            " all she had to live on.”"
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "13",
      "sid": "MRK 13"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Temple Destruction and Other Signs"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 24:1-8",
          "content": [
            "Matthew 24:1–8"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 21:5-9",
          "content": [
            "Luke 21:5–9"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MRK 13:1"
        },
        "As ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " was leaving the temple, one of His disciples said to Him, “Teacher, look at ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the magnificent"
          ]
        },
        " stones and buildings!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "2",
              "sid": "MRK 13:2"
            },
            "“Do you see ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "all"
              ]
            },
            " these great buildings?”"
          ]
        },
        " Jesus replied. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Not ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "one"
              ]
            },
            " stone here will be left on ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "another"
              ]
            },
            "; ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "every one"
              ]
            },
            " will be thrown down.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "MRK 13:3"
        },
        "While ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " was sitting on the Mount of Olives opposite the temple, Peter, James, John, and Andrew asked Him privately, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "MRK 13:4"
        },
        "“Tell us, when ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "will"
          ]
        },
        " these things happen? And what ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "will be"
          ]
        },
        " the sign that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "they"
          ]
        },
        " are about to be fulfilled?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MRK 13:5"
        },
        "Jesus began by telling them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“See to it ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "that"
              ]
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "no one"
              ]
            },
            " deceives you. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "6",
              "sid": "MRK 13:6"
            },
            "Many will come in My name, claiming, ‘I am ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "He"
              ]
            },
            ",’ and will deceive many. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "7",
              "sid": "MRK 13:7"
            },
            "When you hear of wars and rumors of wars, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "do"
              ]
            },
            " not be alarmed. ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "These things "
              ]
            },
            " must happen, but the end ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " still to come. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "8",
              "sid": "MRK 13:8"
            },
            "Nation will rise against nation, and kingdom against kingdom. There will be earthquakes in various places, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "as well as"
              ]
            },
            " famines. These ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "are"
              ]
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " beginning of birth pains."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Witnessing to All Nations"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 24:9-14",
          "content": [
            "Matthew 24:9–14"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 21:10-19",
          "content": [
            "Luke 21:10–19"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MRK 13:9"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            {
              "type": "char",
              "marker": "add",
              "content": [
                "So"
              ]
            },
            " be on your guard. You will be delivered over to ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " councils and beaten in ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " synagogues. On My account you will stand before governors and kings as witnesses to them. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "10",
              "sid": "MRK 13:10"
            },
            "And the gospel must first be proclaimed to all the nations. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "11",
              "sid": "MRK 13:11"
            },
            "But when they arrest you ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " hand ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "you"
              ]
            },
            " over, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "do"
              ]
            },
            " not worry beforehand what to say. Instead, speak whatever you are given at that time, for it will not be you speaking, but the Holy Spirit."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "MRK 13:12"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Brother will betray brother to death, and a father ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "his"
              ]
            },
            " child. Children will rise against ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "their"
              ]
            },
            " parents and have them put to death. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "13",
              "sid": "MRK 13:13"
            },
            "You will be hated by everyone because of My name, but the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "one who"
              ]
            },
            " perseveres to ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " end will be saved."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Abomination of Desolation"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 24:15-25",
          "content": [
            "Matthew 24:15–25"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 21:20-24",
          "content": [
            "Luke 21:20–24"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MRK 13:14"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "So when you see the abomination of desolation",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "13:14 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "See ",
                    {
                      "type": "ref",
                      "loc": "DAN 9:27",
                      "content": [
                        "Daniel 9:27"
                      ]
                    },
                    ", Daniel 11:31, and Daniel 12:11; BYZ and TR include "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "spoken of by Daniel the prophet"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "."
                  ]
                }
              ]
            },
            " standing where it should not be",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "13:14 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "where he should not be"
                  ]
                }
              ]
            },
            " (",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "let"
              ]
            },
            " the reader understand), then ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "let"
              ]
            },
            " those who are in Judea flee to the mountains. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "15",
              "sid": "MRK 13:15"
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "Let"
              ]
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "no one"
              ]
            },
            " on the housetop go back inside to retrieve anything from his house. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "16",
              "sid": "MRK 13:16"
            },
            "And ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "let"
              ]
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "no one"
              ]
            },
            " in the field return for his cloak."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "MRK 13:17"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            {
              "type": "char",
              "marker": "add",
              "content": [
                "How"
              ]
            },
            " miserable those days ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "will be"
              ]
            },
            " for pregnant and nursing ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "mothers"
              ]
            },
            "! ",
            {
              "type": "verse",
              "marker": "v",
              "number": "18",
              "sid": "MRK 13:18"
            },
            "Pray that this will not occur in the winter. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "19",
              "sid": "MRK 13:19"
            },
            "For those will be days of tribulation unseen from ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " beginning of God’s creation until now, and never to be ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "seen again"
              ]
            },
            ". ",
            {
              "type": "verse",
              "marker": "v",
              "number": "20",
              "sid": "MRK 13:20"
            },
            "If ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " Lord had not cut short those days, nobody would be saved. But for the sake of the elect, whom He has chosen, He has cut them short."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "MRK 13:21"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "At that time if anyone says to you, ‘Look, here ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " the Christ!’ ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "or"
              ]
            },
            " ‘There ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "He is"
              ]
            },
            "!’ do not believe ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            ". ",
            {
              "type": "verse",
              "marker": "v",
              "number": "22",
              "sid": "MRK 13:22"
            },
            "For false Christs and false prophets will appear and perform signs and wonders to deceive ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "even"
              ]
            },
            " the elect, if ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "that were"
              ]
            },
            " possible. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "23",
              "sid": "MRK 13:23"
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "So"
              ]
            },
            " be on your guard; I have told you everything ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "in advance"
              ]
            },
            "."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Return of the Son of Man"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 24:26-31",
          "content": [
            "Matthew 24:26–31"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 21:25-28",
          "content": [
            "Luke 21:25–28"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "MRK 13:24"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "But in those days, after that tribulation:"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "‘The sun will be darkened,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "and the moon will not give its light;"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "MRK 13:25"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "the stars will fall from the sky,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "and the powers of the heavens will be shaken.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "13:25 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "and the celestial bodies will be shaken"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "; see ",
                    {
                      "type": "ref",
                      "loc": "ISA 13:10",
                      "content": [
                        "Isaiah 13:10"
                      ]
                    },
                    ", Isaiah 34:4, and Joel 2:10."
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "MRK 13:26"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "At that time they will see the Son of Man coming in ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " clouds with great power and glory.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "13:26 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "See ",
                    {
                      "type": "ref",
                      "loc": "DAN 7:13-14",
                      "content": [
                        "Daniel 7:13–14"
                      ]
                    },
                    "."
                  ]
                }
              ]
            },
            {
              "type": "verse",
              "marker": "v",
              "number": "27",
              "sid": "MRK 13:27"
            },
            "And He will send out the angels to gather His elect from the four winds, from ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " ends of ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " earth to ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " ends of heaven."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Lesson of the Fig Tree"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 24:32-35",
          "content": [
            "Matthew 24:32–35"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 21:29-33",
          "content": [
            "Luke 21:29–33"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "MRK 13:28"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Now learn this lesson",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "13:28 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "this parable"
                  ]
                }
              ]
            },
            " from the fig tree: As soon as its branches become tender and sprout leaves, you know that summer is near. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "29",
              "sid": "MRK 13:29"
            },
            "So also, when you see these things happening, know that He is near,",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "13:29 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "it is near"
                  ]
                }
              ]
            },
            " right at ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " door. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "30",
              "sid": "MRK 13:30"
            },
            "Truly I tell you, this generation will not pass away until all these things have happened. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "31",
              "sid": "MRK 13:31"
            },
            "Heaven and earth will pass away, but My words will never pass away."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Readiness at Any Hour"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 24:36-51",
          "content": [
            "Matthew 24:36–51"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 12:35-48",
          "content": [
            "Luke 12:35–48"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "32",
          "sid": "MRK 13:32"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "No one knows about that day or hour, not even the angels in heaven, nor the Son, but only the Father. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "33",
              "sid": "MRK 13:33"
            },
            "Be on your guard ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " stay alert!",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "13:33 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "BYZ and TR "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "Be on your guard, stay alert, and pray!"
                  ]
                }
              ]
            },
            " For you do not know when the appointed time will come."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "34",
          "sid": "MRK 13:34"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            {
              "type": "char",
              "marker": "add",
              "content": [
                "It is"
              ]
            },
            " like a man going on a journey ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "who"
              ]
            },
            " left his house, put each servant in charge of his ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "own"
              ]
            },
            " task, and instructed the doorkeeper to keep watch. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "35",
              "sid": "MRK 13:35"
            },
            "Therefore keep watch, because you do not know when the master of the house will return — whether in the evening, at midnight, when the rooster crows, or in the morning. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "36",
              "sid": "MRK 13:36"
            },
            "Otherwise, he may arrive without notice ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " find you sleeping. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "37",
              "sid": "MRK 13:37"
            },
            "And what I say to you, I say to everyone: Keep watch!”"
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "14",
      "sid": "MRK 14"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Plot to Kill Jesus"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 26:1-5",
          "content": [
            "Matthew 26:1–5"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 22:1-2",
          "content": [
            "Luke 22:1–2"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 11:45-57",
          "content": [
            "John 11:45–57"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MRK 14:1"
        },
        "Now the Passover and the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Feast of"
          ]
        },
        " Unleavened Bread",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "14:1 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "and the Unleavened"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; see ",
                {
                  "type": "ref",
                  "loc": "EXO 12:14-20",
                  "content": [
                    "Exodus 12:14–20"
                  ]
                },
                "."
              ]
            }
          ]
        },
        " were two days away, and the chief priests and scribes were looking for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "a"
          ]
        },
        " covert way to arrest ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " kill ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MRK 14:2"
        },
        "“",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "But"
          ]
        },
        " not during the feast,” they said, “or there may be a riot among the people.”"
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Anointed at Bethany"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 26:6-13",
          "content": [
            "Matthew 26:6–13"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 7:36-50",
          "content": [
            "Luke 7:36–50"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 12:1-8",
          "content": [
            "John 12:1–8"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "MRK 14:3"
        },
        "While ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " was in Bethany reclining at the table in the home of Simon the Leper,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "14:3 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Aramaic "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Simon the Potter "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Simon the Jar Maker"
              ]
            }
          ]
        },
        " a woman came ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "with"
          ]
        },
        " an alabaster jar of expensive perfume, made of pure nard. She broke open the jar ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " poured ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " on ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus’"
          ]
        },
        " head."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "MRK 14:4"
        },
        "Some ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of"
          ]
        },
        " those present, however, expressed their indignation to one another: “Why this waste of perfume? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MRK 14:5"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "It"
          ]
        },
        " could have been sold for over three hundred denarii",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "14:5 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "A denarius was customarily a day’s wage for a laborer; see ",
                {
                  "type": "ref",
                  "loc": "MAT 20:2",
                  "content": [
                    "Matthew 20:2"
                  ]
                },
                "."
              ]
            }
          ]
        },
        " and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the money"
          ]
        },
        " given to the poor.” And they scolded her."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "MRK 14:6"
        },
        "But Jesus said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Leave her alone; why are you bothering her? She has done a beautiful deed to Me. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "7",
              "sid": "MRK 14:7"
            },
            "The poor you will always have with you,",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "14:7 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "See ",
                    {
                      "type": "ref",
                      "loc": "DEU 15:11",
                      "content": [
                        "Deuteronomy 15:11"
                      ]
                    },
                    "."
                  ]
                }
              ]
            },
            " and you can help them whenever you want. But ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "you will"
              ]
            },
            " not always have Me. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "8",
              "sid": "MRK 14:8"
            },
            "She has done what she could to anoint My body in advance of ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "My"
              ]
            },
            " burial. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "9",
              "sid": "MRK 14:9"
            },
            "And truly I tell you, wherever the gospel is preached in all the world, what ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "she"
              ]
            },
            " has done will also be told in memory of her.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Judas Agrees to Betray Jesus"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 26:14-16",
          "content": [
            "Matthew 26:14–16"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 22:3-6",
          "content": [
            "Luke 22:3–6"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "MRK 14:10"
        },
        "Then Judas Iscariot, one of the Twelve, went to the chief priests to betray ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " to them. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "MRK 14:11"
        },
        "They were delighted to hear ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        ", and they promised to give him money."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "So ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Judas"
          ]
        },
        " began to look for an opportunity to betray ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Preparing the Passover"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 26:17-19",
          "content": [
            "Matthew 26:17–19"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 22:7-13",
          "content": [
            "Luke 22:7–13"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "MRK 14:12"
        },
        "On the first day of the Feast of Unleavened ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Bread"
          ]
        },
        ",",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "14:12 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "On the first day of the Unleavened"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; see ",
                {
                  "type": "ref",
                  "loc": "EXO 12:14-20",
                  "content": [
                    "Exodus 12:14–20"
                  ]
                },
                "."
              ]
            }
          ]
        },
        " when the Passover lamb was to be sacrificed, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus’"
          ]
        },
        " disciples asked Him, “Where do You want us to prepare for You to eat the Passover?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MRK 14:13"
        },
        "So He sent two of His disciples and told them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Go into the city, and a man carrying a jug of water will meet you. Follow him, ",
            {
              "type": "verse",
              "marker": "v",
              "number": "14",
              "sid": "MRK 14:14"
            },
            "and whichever ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "house"
              ]
            },
            " he enters, say to the owner, ‘The Teacher asks: Where is My guest room, where I may eat the Passover with My disciples?’ ",
            {
              "type": "verse",
              "marker": "v",
              "number": "15",
              "sid": "MRK 14:15"
            },
            "And he will show you a large upper room, furnished ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " ready. Make preparations for us there.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "MRK 14:16"
        },
        "So the disciples left and went into the city, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "where"
          ]
        },
        " they found ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "everything"
          ]
        },
        " as ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " had described. And they prepared the Passover."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Last Supper"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 26:20-30",
          "content": [
            "Matthew 26:20–30"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 22:14-23",
          "content": [
            "Luke 22:14–23"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "1CO 11:17-34",
          "content": [
            "1 Corinthians 11:17–34"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "MRK 14:17"
        },
        "When evening came, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " arrived with the Twelve. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "MRK 14:18"
        },
        "And while they were reclining and eating, Jesus said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Truly I tell you, one of you who is eating with Me will betray Me.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "MRK 14:19"
        },
        "They began to be grieved and to ask Him one after another, “Surely not I?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "MRK 14:20"
        },
        "He answered, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "It is"
              ]
            },
            " one of the Twelve — the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "one who"
              ]
            },
            " is dipping ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "his hand "
              ]
            },
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "14:20 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Literally "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "the one who is dipping"
                  ]
                }
              ]
            },
            " into the bowl with Me. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "21",
              "sid": "MRK 14:21"
            },
            "The Son of Man will go just as it is written about Him, but woe to that man by whom ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "He"
              ]
            },
            " is betrayed! ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "It would be"
              ]
            },
            " better for him if ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "he"
              ]
            },
            " had not been born.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "MRK 14:22"
        },
        "While they were eating, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " took bread, spoke a blessing ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " broke it, and gave ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the disciples"
          ]
        },
        ", saying, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Take ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            "; this is My body.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MRK 14:23"
        },
        "Then He took the cup, gave thanks, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " gave it to them, and they all drank from it. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "MRK 14:24"
        },
        "He said to them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“This is My blood of the covenant,",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "14:24 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "BYZ and TR "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "the new covenant"
                  ]
                }
              ]
            },
            " which is poured out for many. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "25",
              "sid": "MRK 14:25"
            },
            "Truly I tell you, I will no longer drink of the fruit of the vine until that day when I drink it anew in the kingdom of God.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "MRK 14:26"
        },
        "And when they had sung a hymn, they went out to the Mount of Olives."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Predicts Peter’s Denial"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ZEC 13:7-9",
          "content": [
            "Zechariah 13:7–9"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MAT 26:31-35",
          "content": [
            "Matthew 26:31–35"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 22:31-38",
          "content": [
            "Luke 22:31–38"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 13:36-38",
          "content": [
            "John 13:36–38"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "MRK 14:27"
        },
        "Then Jesus said to them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“You will all fall away,",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "14:27 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "BYZ and TR include "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "on account of Me this night"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "; see ",
                    {
                      "type": "ref",
                      "loc": "MAT 26:31",
                      "content": [
                        "Matthew 26:31"
                      ]
                    },
                    "."
                  ]
                }
              ]
            },
            " for it is written:"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "‘I will strike the Shepherd,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "and the sheep will be scattered.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "14:27 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "ZEC 13:7",
                      "content": [
                        "Zechariah 13:7"
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "MRK 14:28"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "But after I have risen, I will go ahead of you into Galilee.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "MRK 14:29"
        },
        "Peter declared, “Even if all fall away, I never ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "will"
          ]
        },
        ".”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "30",
              "sid": "MRK 14:30"
            },
            "“Truly I tell you,”"
          ]
        },
        " Jesus replied, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“this very night, before ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " rooster crows twice, you will deny Me three times.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "MRK 14:31"
        },
        "But ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Peter"
          ]
        },
        " kept insisting, “Even if I have to die with You, I will never deny You.” And all the others said the same thing."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Prays at Gethsemane"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 26:36-46",
          "content": [
            "Matthew 26:36–46"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 22:39-46",
          "content": [
            "Luke 22:39–46"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "32",
          "sid": "MRK 14:32"
        },
        "Then they came to a place called Gethsemane, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " told His disciples, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Sit here while I pray.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "MRK 14:33"
        },
        "He took with Him Peter, James, and John, and began to be deeply troubled and distressed. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "34",
          "sid": "MRK 14:34"
        },
        "Then He said to them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“My soul is consumed with sorrow to the point of death. Stay here and keep watch.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "35",
          "sid": "MRK 14:35"
        },
        "Going a little farther, He fell to the ground and prayed that, if it were possible, the hour would pass from Him. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "36",
              "sid": "MRK 14:36"
            },
            "“Abba, Father,”"
          ]
        },
        " He said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“all things ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "are"
              ]
            },
            " possible for You. Take this cup from Me. Yet not what I will, but what You ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "will"
              ]
            },
            ".”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "37",
          "sid": "MRK 14:37"
        },
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " returned and found them sleeping. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Simon, are you asleep?”"
          ]
        },
        " He asked. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Were you not able to keep watch for one hour? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "38",
              "sid": "MRK 14:38"
            },
            "Watch and pray so that you will not enter into temptation. For the spirit ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " willing, but the body ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " weak.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "39",
          "sid": "MRK 14:39"
        },
        "Again He went away ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " prayed, saying the same thing. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "40",
          "sid": "MRK 14:40"
        },
        "And again ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " returned ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " found them sleeping, for their eyes were heavy. And they did not know what to answer Him."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "41",
          "sid": "MRK 14:41"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "When"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " returned the third time, He said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Are you still sleeping and resting? That is enough! The hour has come. Look, the Son of Man is betrayed into the hands of sinners. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "42",
              "sid": "MRK 14:42"
            },
            "Rise, let us go. See, My betrayer is approaching!”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Betrayal of Jesus"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 26:47-56",
          "content": [
            "Matthew 26:47–56"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 22:47-53",
          "content": [
            "Luke 22:47–53"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 18:1-14",
          "content": [
            "John 18:1–14"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "43",
          "sid": "MRK 14:43"
        },
        "While ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " was still speaking, Judas, one of the Twelve, arrived, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "accompanied by"
          ]
        },
        " a crowd ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "armed"
          ]
        },
        " with swords and clubs, sent from the chief priests, scribes, and elders."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "44",
          "sid": "MRK 14:44"
        },
        "Now the betrayer had arranged a signal with them: “The One I kiss is ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the man"
          ]
        },
        "; arrest Him and lead ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        " away securely.” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "45",
          "sid": "MRK 14:45"
        },
        "Going directly to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        ", he said, “Rabbi!” and kissed Him."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "46",
          "sid": "MRK 14:46"
        },
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the men"
          ]
        },
        " seized ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " and arrested Him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "47",
          "sid": "MRK 14:47"
        },
        "And one of the bystanders drew ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " sword ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " struck the servant of the high priest, cutting off his ear."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "48",
          "sid": "MRK 14:48"
        },
        "Jesus asked ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the crowd"
          ]
        },
        ", ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Have you come out with swords and clubs to arrest Me as ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "you would"
              ]
            },
            " an outlaw? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "49",
              "sid": "MRK 14:49"
            },
            "Every day I was with you, teaching in the temple ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "courts"
              ]
            },
            ",",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "14:49 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Literally "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "the temple"
                  ]
                }
              ]
            },
            " and you did not arrest Me. But ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "this has happened"
              ]
            },
            " that the Scriptures would be fulfilled.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "50",
          "sid": "MRK 14:50"
        },
        "Then everyone deserted Him ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " fled. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "51",
          "sid": "MRK 14:51"
        },
        "One young man who had been following ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " was wearing a linen cloth around ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his body"
          ]
        },
        ". They caught hold of him, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "52",
          "sid": "MRK 14:52"
        },
        "but he pulled free of the linen cloth and ran away naked."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus before the Sanhedrin"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 26:57-68",
          "content": [
            "Matthew 26:57–68"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 22:66-71",
          "content": [
            "Luke 22:66–71"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 18:19-24",
          "content": [
            "John 18:19–24"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "53",
          "sid": "MRK 14:53"
        },
        "They led Jesus ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "away"
          ]
        },
        " to the high priest, and all the chief priests, elders, and scribes assembled. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "54",
          "sid": "MRK 14:54"
        },
        "Peter followed Him at a distance, right into the courtyard of the high priest. And he sat with the officers and warmed himself by the fire."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "55",
          "sid": "MRK 14:55"
        },
        "Now the chief priests and the whole Sanhedrin",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "14:55 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "the whole Council"
              ]
            }
          ]
        },
        " were seeking testimony against Jesus to put Him to death, but they did not find ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "any"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "56",
          "sid": "MRK 14:56"
        },
        "For many bore false witness against ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        ", but their testimony was inconsistent."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "57",
          "sid": "MRK 14:57"
        },
        "Then some ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "men"
          ]
        },
        " stood up ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " testified falsely against Him: ",
        {
          "type": "verse",
          "marker": "v",
          "number": "58",
          "sid": "MRK 14:58"
        },
        "“We heard Him say, ‘I will destroy this man-made temple, and in three days I will build another ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that is"
          ]
        },
        " made without hands.’” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "59",
          "sid": "MRK 14:59"
        },
        "But even their testimony was inconsistent."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "60",
          "sid": "MRK 14:60"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So"
          ]
        },
        " the high priest stood up before them ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " questioned Jesus, “Have You no answer? What ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " these ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "men"
          ]
        },
        " testifying against You?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "61",
          "sid": "MRK 14:61"
        },
        "But ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " remained silent and made no reply."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Again the high priest questioned Him, “Are You the Christ, the Son of the Blessed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "One"
          ]
        },
        "?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "62",
              "sid": "MRK 14:62"
            },
            "“I am,”"
          ]
        },
        " said Jesus, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“and you will see the Son of Man sitting at ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " right hand of Power",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "14:62 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "the right hand of the Mighty One"
                  ]
                }
              ]
            },
            " and coming with the clouds of heaven.”"
          ]
        },
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "14:62 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "See ",
                {
                  "type": "ref",
                  "loc": "PSA 110:1",
                  "content": [
                    "Psalm 110:1"
                  ]
                },
                " and Daniel 7:13."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "63",
          "sid": "MRK 14:63"
        },
        "At this, the high priest tore his clothes ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " declared, “Why do we need any more witnesses? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "64",
          "sid": "MRK 14:64"
        },
        "You have heard the blasphemy. What is your verdict?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "And they all condemned Him as deserving of death."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "65",
          "sid": "MRK 14:65"
        },
        "Then some ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of them"
          ]
        },
        " began to spit on Him. They blindfolded Him, struck Him with their fists, and said to Him, “Prophesy!” And the officers received Him with slaps in His face."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Peter Denies Jesus"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 26:69-75",
          "content": [
            "Matthew 26:69–75"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 22:54-62",
          "content": [
            "Luke 22:54–62"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 18:15-18",
          "content": [
            "John 18:15–18"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "66",
          "sid": "MRK 14:66"
        },
        "While Peter was in the courtyard below, one of the servant girls of the high priest came down ",
        {
          "type": "verse",
          "marker": "v",
          "number": "67",
          "sid": "MRK 14:67"
        },
        "and saw ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "him"
          ]
        },
        " warming himself ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "there"
          ]
        },
        ". She looked at ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Peter"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, “You also were with Jesus the Nazarene.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "68",
          "sid": "MRK 14:68"
        },
        "But he denied ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        ". “I do not know or even understand what you are talking about,” he said. Then he went out to the gateway, and the rooster crowed.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "14:68 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "NE and WH do not include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "and the rooster crowed"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "69",
          "sid": "MRK 14:69"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "There"
          ]
        },
        " the servant girl saw him ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " again said to those standing nearby, “This ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        " is ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one"
          ]
        },
        " of them.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "70",
          "sid": "MRK 14:70"
        },
        "But he denied ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " again."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "After a little while, those standing nearby said once more to Peter, “Surely you are one of them, for you too are a Galilean.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "14:70 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "and your speech is similar"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "71",
          "sid": "MRK 14:71"
        },
        "But he began to curse and swear, “I do not know this man of whom you speak!” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "72",
          "sid": "MRK 14:72"
        },
        "And immediately ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " rooster crowed a second time."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Then Peter remembered the word that Jesus had spoken to him: ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Before ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " rooster crows twice, you will deny Me three times.”"
          ]
        },
        " And he broke down ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " wept."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "15",
      "sid": "MRK 15"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Delivered to Pilate"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 27:1-2",
          "content": [
            "Matthew 27:1–2"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MRK 15:1"
        },
        "Early in the morning, the chief priests, elders, scribes, and the whole Sanhedrin",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "15:1 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "the whole Council"
              ]
            }
          ]
        },
        " devised a plan. They bound Jesus, led ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        " away, and handed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        " over to Pilate."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MRK 15:2"
        },
        "So Pilate questioned Him, “Are You the King of the Jews?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“You have said so,”"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " replied."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "MRK 15:3"
        },
        "And the chief priests began to accuse Him of many things."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "MRK 15:4"
        },
        "Then Pilate questioned Him again, “Have You no answer? Look how many charges they are bringing against You!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MRK 15:5"
        },
        "But to Pilate’s amazement, Jesus made no further reply."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Crowd Chooses Barabbas"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 27:15-23",
          "content": [
            "Matthew 27:15–23"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 23:13-25",
          "content": [
            "Luke 23:13–25"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "MRK 15:6"
        },
        "Now ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it was Pilate’s custom"
          ]
        },
        " at ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " feast to release to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the people"
          ]
        },
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "15:6 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Now at the feast he would release to them"
              ]
            }
          ]
        },
        " a prisoner of their choosing. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MRK 15:7"
        },
        "And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "a man"
          ]
        },
        " named Barabbas was imprisoned with the rebels who had committed murder during the insurrection. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "MRK 15:8"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So"
          ]
        },
        " the crowd went up ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " began asking ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Pilate"
          ]
        },
        " to keep his custom."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MRK 15:9"
        },
        "“Do you want me to release to you the King of the Jews?” Pilate asked. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "MRK 15:10"
        },
        "For he knew ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it was"
          ]
        },
        " out of envy that the chief priests had handed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " over."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "MRK 15:11"
        },
        "But the chief priests stirred up the crowd to have him release Barabbas to them instead."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Pilate Delivers Up Jesus"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 27:24-26",
          "content": [
            "Matthew 27:24–26"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "MRK 15:12"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So"
          ]
        },
        " Pilate asked them again, “What then do you want me to do with the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "One"
          ]
        },
        " you call the King of the Jews?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MRK 15:13"
        },
        "And they shouted back, “Crucify Him!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MRK 15:14"
        },
        "“Why?” asked Pilate. “What evil has He done?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "But they shouted all the louder, “Crucify Him!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "MRK 15:15"
        },
        "And wishing to satisfy the crowd, Pilate released Barabbas to them. But ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "he had"
          ]
        },
        " Jesus flogged, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " handed Him over to be crucified."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Soldiers Mock Jesus"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ISA 50:4-11",
          "content": [
            "Isaiah 50:4–11"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MAT 27:27-31",
          "content": [
            "Matthew 27:27–31"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 22:63-65",
          "content": [
            "Luke 22:63–65"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 19:1-15",
          "content": [
            "John 19:1–15"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "MRK 15:16"
        },
        "Then the soldiers led ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " away into the palace (that is, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Praetorium) and called the whole company ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "together"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "MRK 15:17"
        },
        "They dressed Him in a purple robe, twisted together a crown of thorns, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " set ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " on His ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "head"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "MRK 15:18"
        },
        "And they began to salute Him: “Hail, King of the Jews!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "MRK 15:19"
        },
        "They kept striking His head with a staff and spitting on Him. And they knelt down ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " bowed before Him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "MRK 15:20"
        },
        "After they had mocked Him, they removed the purple ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "robe"
          ]
        },
        " and put His own clothes ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "back"
          ]
        },
        " on Him. Then they led Him out to crucify Him."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Crucifixion"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "PSA 22:1-31",
          "content": [
            "Psalm 22:1–31"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MAT 27:32-44",
          "content": [
            "Matthew 27:32–44"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 23:26-43",
          "content": [
            "Luke 23:26–43"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 19:16-27",
          "content": [
            "John 19:16–27"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "MRK 15:21"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Now"
          ]
        },
        " Simon of Cyrene, the father of Alexander and Rufus, was passing by on his way in from the country, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the soldiers"
          ]
        },
        " forced ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "him"
          ]
        },
        " to carry the cross of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "MRK 15:22"
        },
        "They brought ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " to a place ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "called"
          ]
        },
        " Golgotha, which means ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The"
          ]
        },
        " Place of the Skull. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MRK 15:23"
        },
        "There they offered Him wine mixed with myrrh, but He did not take ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "MRK 15:24"
        },
        "And they crucified Him."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "They also divided His garments by casting lots to decide what ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "each of them"
          ]
        },
        " would take.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "15:24 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "See ",
                {
                  "type": "ref",
                  "loc": "PSA 22:18",
                  "content": [
                    "Psalm 22:18"
                  ]
                },
                "."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "MRK 15:25"
        },
        "It was ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " third hour",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "15:25 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "That is, nine in the morning"
              ]
            }
          ]
        },
        " when they crucified Him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "MRK 15:26"
        },
        "And the charge inscribed against Him read:"
      ]
    },
    {
      "type": "para",
      "marker": "pc",
      "content": [
        "THE KING OF THE JEWS."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "MRK 15:27"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Along"
          ]
        },
        " with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        ", they crucified two robbers,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "15:27 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "insurrectionists"
              ]
            }
          ]
        },
        " one on ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " right and one on His left.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "15:27 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                {
                  "type": "char",
                  "marker": "fv",
                  "content": [
                    "28"
                  ]
                },
                "So the Scripture was fulfilled that says, “And He was numbered with the transgressors.”"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "See ",
                {
                  "type": "ref",
                  "loc": "ISA 53:12",
                  "content": [
                    "Isaiah 53:12"
                  ]
                },
                " and Luke 22:37."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "MRK 15:29"
        },
        "And those who passed by heaped abuse on Him, shaking their heads and saying, “Aha! You who are going to destroy the temple and rebuild ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " in three days, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "MRK 15:30"
        },
        "come down from the cross ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " save Yourself!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "MRK 15:31"
        },
        "In the same way, the chief priests and scribes mocked ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        " among themselves, saying, “He saved others, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "but"
          ]
        },
        " He cannot save Himself! ",
        {
          "type": "verse",
          "marker": "v",
          "number": "32",
          "sid": "MRK 15:32"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Let"
          ]
        },
        " the Christ, the King of Israel, come down now from the cross, so that we may see and believe!” And even those who were crucified with Him berated Him."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Death of Jesus"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "PSA 22:1-31",
          "content": [
            "Psalm 22:1–31"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MAT 27:45-56",
          "content": [
            "Matthew 27:45–56"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 23:44-49",
          "content": [
            "Luke 23:44–49"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 19:28-30",
          "content": [
            "John 19:28–30"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "MRK 15:33"
        },
        "From ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " sixth hour until ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " ninth hour",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "15:33 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "That is, from noon until three in the afternoon"
              ]
            }
          ]
        },
        " darkness came over all the land. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "34",
          "sid": "MRK 15:34"
        },
        "At the ninth hour, Jesus cried out in a loud voice, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Eloi, Eloi, lema sabachthani?”"
          ]
        },
        " which means, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“My God, My God, why have You forsaken Me?”"
          ]
        },
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "15:34 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "PSA 22:1",
                  "content": [
                    "Psalm 22:1"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "35",
          "sid": "MRK 15:35"
        },
        "When some of those standing nearby heard ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        ", they said, “Behold, He is calling Elijah.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "36",
          "sid": "MRK 15:36"
        },
        "And someone ran and filled a sponge with sour wine.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "15:36 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "a sponge with wine vinegar"
              ]
            }
          ]
        },
        " He put ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " on a reed and held it up for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " to drink,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "15:36 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "See ",
                {
                  "type": "ref",
                  "loc": "PSA 69:21",
                  "content": [
                    "Psalm 69:21"
                  ]
                },
                "."
              ]
            }
          ]
        },
        " saying, “Leave ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        " alone. Let us see if Elijah comes to take Him down.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "37",
          "sid": "MRK 15:37"
        },
        "But Jesus let out a loud cry ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " breathed His last. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "38",
          "sid": "MRK 15:38"
        },
        "And the veil of the temple was torn in two from top to bottom."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "39",
          "sid": "MRK 15:39"
        },
        "When the centurion standing there in front of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " saw ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "how"
          ]
        },
        " He had breathed His last,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "15:39 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "saw how, having cried out, He had breathed His last"
              ]
            }
          ]
        },
        " he said, “Truly this man was ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Son of God!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "40",
          "sid": "MRK 15:40"
        },
        "And there were also women watching from a distance. Among them ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "were"
          ]
        },
        " Mary Magdalene, Mary the mother of James the younger and of Joses,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "15:40 "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Joses "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "is a variant of "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Joseph"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; see ",
                {
                  "type": "ref",
                  "loc": "MAT 27:56",
                  "content": [
                    "Matthew 27:56"
                  ]
                },
                "."
              ]
            }
          ]
        },
        " and Salome. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "41",
          "sid": "MRK 15:41"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "These women"
          ]
        },
        " had followed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " and ministered to Him while He was in Galilee, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "there were"
          ]
        },
        " many other ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "women"
          ]
        },
        " who had come up to Jerusalem with Him."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Burial of Jesus"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ISA 53:9-12",
          "content": [
            "Isaiah 53:9–12"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MAT 27:57-61",
          "content": [
            "Matthew 27:57–61"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 23:50-56",
          "content": [
            "Luke 23:50–56"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 19:38-42",
          "content": [
            "John 19:38–42"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "42",
          "sid": "MRK 15:42"
        },
        "Now it was already evening. Since it was Preparation Day (that is, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the day"
          ]
        },
        " before the Sabbath), ",
        {
          "type": "verse",
          "marker": "v",
          "number": "43",
          "sid": "MRK 15:43"
        },
        "Joseph of Arimathea, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "a"
          ]
        },
        " prominent Council member who himself was waiting for the kingdom of God, boldly went to Pilate to ask for the body of Jesus."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "44",
          "sid": "MRK 15:44"
        },
        "Pilate was surprised ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to hear"
          ]
        },
        " that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " was already dead, so he summoned the centurion to ask if ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this was so"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "45",
          "sid": "MRK 15:45"
        },
        "When ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Pilate"
          ]
        },
        " had confirmed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " with the centurion, he granted the body to Joseph."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "46",
          "sid": "MRK 15:46"
        },
        "So ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Joseph"
          ]
        },
        " bought a linen cloth, took down ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the body of Jesus"
          ]
        },
        ", wrapped ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " in the cloth, and placed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " in a tomb that had been cut out of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " rock. Then he rolled a stone against the entrance to the tomb. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "47",
          "sid": "MRK 15:47"
        },
        "Mary Magdalene and Mary the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "mother"
          ]
        },
        " of Joseph",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "15:47 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Joses"
              ]
            }
          ]
        },
        " saw where ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His body"
          ]
        },
        " was placed."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "16",
      "sid": "MRK 16"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Resurrection"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 28:1-10",
          "content": [
            "Matthew 28:1–10"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 24:1-12",
          "content": [
            "Luke 24:1–12"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 20:1-9",
          "content": [
            "John 20:1–9"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MRK 16:1"
        },
        "When the Sabbath was over, Mary Magdalene, Mary the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "mother"
          ]
        },
        " of James, and Salome bought spices so they could go ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " anoint ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the body of Jesus"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MRK 16:2"
        },
        "Very early on the first ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "day"
          ]
        },
        " of the week,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "16:2 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "And very early on the first of the Sabbaths,"
              ]
            }
          ]
        },
        " just after sunrise, they went to the tomb. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "MRK 16:3"
        },
        "They were asking one another, “Who will roll away the stone from the entrance of the tomb?” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "MRK 16:4"
        },
        "But when they looked up, they saw that the stone had been rolled away, even though it was extremely large."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MRK 16:5"
        },
        "When they entered the tomb, they saw a young man dressed in a white robe sitting on the right side, and they were alarmed. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "MRK 16:6"
        },
        "But he said to them, “",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Do"
          ]
        },
        " not be alarmed. You are looking for Jesus the Nazarene, who was crucified. He has risen! He is not here! See the place where they put Him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MRK 16:7"
        },
        "But go, tell His disciples and Peter, ‘He is going ahead of you into Galilee. There you will see Him, just as He told you.’”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "MRK 16:8"
        },
        "So ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the women"
          ]
        },
        " left the tomb and ran away, trembling and bewildered. And in their fear they did not say ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "a word to anyone"
          ]
        },
        ".",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "16:8 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Some early manuscripts end the Gospel of Mark after verse 8. Other manuscripts contain only a short ending, a version of the following: "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                {
                  "type": "char",
                  "marker": "fv",
                  "content": [
                    "9"
                  ]
                },
                "But they quickly reported all these instructions to Peter’s companions. Afterward, Jesus Himself, through them, sent out from east to west the sacred and imperishable proclamation of eternal salvation. Amen."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Appears to Mary Magdalene"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "JHN 20:10-18",
          "content": [
            "John 20:10–18"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MRK 16:9"
        },
        "Early ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "on the"
          ]
        },
        " first ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "day"
          ]
        },
        " of the week, after ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " had risen,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "16:9 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "After Jesus had risen early on the first day of the week"
              ]
            }
          ]
        },
        " He appeared first to Mary Magdalene, from whom He had driven out seven demons. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "MRK 16:10"
        },
        "She went ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " told those who had been with Him, who were mourning and weeping. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "MRK 16:11"
        },
        "And when they heard that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " was alive and she had seen Him, they did not believe ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Appears to Two Disciples"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 24:13-35",
          "content": [
            "Luke 24:13–35"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "MRK 16:12"
        },
        "After ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        ", ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " appeared in a different form to two of them as they walked along in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " country."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MRK 16:13"
        },
        "And they went back and reported ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " to the rest, but they did not believe them either."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Great Commission"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 28:16-20",
          "content": [
            "Matthew 28:16–20"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MRK 16:14"
        },
        "Later, as they were eating, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " appeared to the Eleven and rebuked them for their unbelief and hardness of heart, because they did not believe those who had seen Him after He had risen."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "MRK 16:15"
        },
        "And He said to them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Go into all the world ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " preach the gospel to every creature. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "16",
              "sid": "MRK 16:16"
            },
            "Whoever believes and is baptized will be saved, but whoever does not believe will be condemned. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "17",
              "sid": "MRK 16:17"
            },
            "And these signs will accompany those who believe: In My name they will drive out demons; they will speak in new tongues;",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "16:17 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "WH "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "in tongues"
                  ]
                }
              ]
            },
            {
              "type": "verse",
              "marker": "v",
              "number": "18",
              "sid": "MRK 16:18"
            },
            "they will pick up snakes with their hands, and if they drink any deadly poison, it will not harm them; they will lay ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "their"
              ]
            },
            " hands on ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " sick, and they will be made well.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Ascension"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 24:50-53",
          "content": [
            "Luke 24:50–53"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "ACT 1:6-11",
          "content": [
            "Acts 1:6–11"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "MRK 16:19"
        },
        "After the Lord Jesus",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "16:19 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "ECM, BYZ, and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "After the LORD"
              ]
            }
          ]
        },
        " had spoken to them, He was taken up into heaven and sat down at ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " right hand of God."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "MRK 16:20"
        },
        "And they went out ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " preached everywhere, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " the Lord worked through ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        ", confirming ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " word by the signs that accompanied ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        "."
      ]
    }
  ]
}