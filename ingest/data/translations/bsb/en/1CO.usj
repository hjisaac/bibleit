        "1 Corinthians"
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "1",
      "sid": "1CO 1"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Greetings from Paul and Sosthenes"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ACT 18:1-11",
          "content": [
            "Acts 18:1–11"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "2CO 1:1-2",
          "content": [
            "2 Corinthians 1:1–2"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "1CO 1:1"
        },
        "Paul, called ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to be"
          ]
        },
        " an apostle of Christ Jesus by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " will of God, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "our"
          ]
        },
        " brother Sosthenes,"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "1CO 1:2"
        },
        "To the church of God in Corinth, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to those"
          ]
        },
        " sanctified in Christ Jesus ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " called ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to be"
          ]
        },
        " holy, together with all those everywhere ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who"
          ]
        },
        " call on the name of our Lord Jesus Christ, their ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Lord"
          ]
        },
        " and ours:"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "1CO 1:3"
        },
        "Grace and peace to you from God our Father and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord Jesus Christ."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Thanksgiving"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "PHP 1:3-11",
          "content": [
            "Philippians 1:3–11"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "COL 1:3-14",
          "content": [
            "Colossians 1:3–14"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "1CO 1:4"
        },
        "I always thank my God for you because of the grace ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "He"
          ]
        },
        " has given you in Christ Jesus. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "1CO 1:5"
        },
        "For in Him you have been enriched in every way, in all speech and all knowledge, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "1CO 1:6"
        },
        "because ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "our"
          ]
        },
        " testimony about Christ was confirmed in you."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "1CO 1:7"
        },
        "Therefore you do not lack ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "any"
          ]
        },
        " spiritual gift as you eagerly await the revelation of our Lord Jesus Christ. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "1CO 1:8"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "He"
          ]
        },
        " will sustain you to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " end, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "so that you will be"
          ]
        },
        " blameless on the day of our Lord Jesus Christ. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "1CO 1:9"
        },
        "God, who has called you into fellowship with His Son Jesus Christ our Lord, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " faithful."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Unity in the Church"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "PSA 133:1-3",
          "content": [
            "Psalm 133:1–3"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "EPH 4:1-16",
          "content": [
            "Ephesians 4:1–16"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "1CO 1:10"
        },
        "I appeal to you, brothers, in the name of our Lord Jesus Christ, that all of you agree together, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "so that"
          ]
        },
        " there may be no divisions among you and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " you may be united in mind and conviction. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "1CO 1:11"
        },
        "My brothers, some from Chloe’s household have informed me that there are quarrels among you. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "1CO 1:12"
        },
        "What I mean ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " this: Individuals among you are saying, “I ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "follow"
          ]
        },
        " Paul,” “I ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "follow"
          ]
        },
        " Apollos,” “I ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "follow"
          ]
        },
        " Cephas,”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:12 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "That is, Peter"
              ]
            }
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " “I ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "follow"
          ]
        },
        " Christ.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "1CO 1:13"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Is"
          ]
        },
        " Christ divided? ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Was"
          ]
        },
        " Paul crucified for you? Were you baptized into the name of Paul? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "1CO 1:14"
        },
        "I thank God that I did not baptize any of you except Crispus and Gaius, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "1CO 1:15"
        },
        "so no one can say that you were baptized into my name. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "1CO 1:16"
        },
        "Yes, I also baptized the household of Stephanas; beyond that I do not remember if I baptized anyone else. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "1CO 1:17"
        },
        "For Christ ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "did"
          ]
        },
        " not send me to baptize, but to preach the gospel, not with words of wisdom, lest the cross of Christ be emptied of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "its"
          ]
        },
        " power."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Message of the Cross"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "1CO 1:18"
        },
        "For the message of the cross is foolishness to those who are perishing, but to us who are being saved it is ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " power of God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "1CO 1:19"
        },
        "For it is written:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“I will destroy the wisdom of the wise;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "the intelligence of the intelligent I will frustrate.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:19 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 29:14",
                  "content": [
                    "Isaiah 29:14"
                  ]
                },
                " (see also LXX)"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "1CO 1:20"
        },
        "Where ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is the"
          ]
        },
        " wise ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        "? Where ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " scribe? Where ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " philosopher of this age? ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Has"
          ]
        },
        " not God made foolish the wisdom of the world? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "1CO 1:21"
        },
        "For since in the wisdom of God the world through ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "its"
          ]
        },
        " wisdom ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "did"
          ]
        },
        " not know ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        ", God was pleased through the foolishness of what was preached to save those who believe."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "1CO 1:22"
        },
        "Jews demand signs and Greeks search for wisdom, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "1CO 1:23"
        },
        "but we preach Christ crucified, a stumbling block to Jews and foolishness to Gentiles,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:23 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "to Greeks"
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "1CO 1:24"
        },
        "but to those who are called, both Jews and Greeks, Christ ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " power of God and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " wisdom of God."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "1CO 1:25"
        },
        "For the foolishness of God is wiser than man’s ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "wisdom"
          ]
        },
        ",",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:25 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "than men"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; twice in this verse"
              ]
            }
          ]
        },
        " and the weakness of God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " stronger than man’s ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "strength"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Wisdom from God"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "1CO 1:26"
        },
        "Brothers, consider  ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the time of "
          ]
        },
        " your calling: Not many ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of you"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "were"
          ]
        },
        " wise by human standards; not many ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "were"
          ]
        },
        " powerful; not many ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "were"
          ]
        },
        " of noble birth. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "1CO 1:27"
        },
        "But God chose the foolish things of the world to shame the wise; God chose the weak things of the world to shame the strong. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "1CO 1:28"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "He"
          ]
        },
        " chose the lowly and despised things of the world, and the things that are not, to nullify the things that are, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "1CO 1:29"
        },
        "so that no ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one"
          ]
        },
        " may boast in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " presence."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "1CO 1:30"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "It is"
          ]
        },
        " because of Him ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " you are in Christ Jesus, who has become for us wisdom from God: ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "our"
          ]
        },
        " righteousness, holiness, and redemption. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "1CO 1:31"
        },
        "Therefore, as it is written: “",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Let"
          ]
        },
        " him who boasts boast in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:31 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "JER 9:24",
                  "content": [
                    "Jeremiah 9:24"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "2",
      "sid": "1CO 2"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Paul’s Message by the Spirit’s Power"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "1CO 2:1"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "When"
          ]
        },
        " I came to you, brothers, I did not come with eloquence or wisdom ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as"
          ]
        },
        " I proclaimed to you the testimony about God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "1CO 2:2"
        },
        "For I resolved to know nothing ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "while I was"
          ]
        },
        " with you except Jesus Christ and Him crucified. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "1CO 2:3"
        },
        "I came to you in weakness and fear, and with much trembling. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "1CO 2:4"
        },
        "My message and my preaching ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "were"
          ]
        },
        " not with persuasive words of wisdom, but with a demonstration of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Spirit’s power, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "1CO 2:5"
        },
        "so that your faith would not rest on men’s wisdom, but on God’s power."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Spiritual Wisdom"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "EPH 1:15-23",
          "content": [
            "Ephesians 1:15–23"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "1CO 2:6"
        },
        "Among the mature, however, we speak a message of wisdom — but not ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " wisdom of this age ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " of the rulers of this age, who are coming to nothing. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "1CO 2:7"
        },
        "No, we speak of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " mysterious ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " hidden wisdom of God,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:7 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "we speak God’s wisdom in a mystery"
              ]
            }
          ]
        },
        " which ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "He"
          ]
        },
        " destined for our glory before time ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "began"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "1CO 2:8"
        },
        "None of the rulers of this age understood ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        ". For if they had, they would not have crucified the Lord of glory. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "1CO 2:9"
        },
        "Rather, as it is written:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“No eye has seen,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "no ear has heard,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "no heart has imagined,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "what God has prepared for those who love Him.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:9 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 64:4",
                  "content": [
                    "Isaiah 64:4"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "1CO 2:10"
        },
        "But God has revealed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " to us by the Spirit."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "The Spirit searches all things, even the deep ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "things "
          ]
        },
        " of God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "1CO 2:11"
        },
        "For who among men knows the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "thoughts"
          ]
        },
        " of man except ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his own"
          ]
        },
        " spirit within him? So too, no one knows the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "thoughts"
          ]
        },
        " of God except the Spirit of God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "1CO 2:12"
        },
        "We have not received the spirit of the world, but the Spirit who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " from God, that we may understand what God has freely given us. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "1CO 2:13"
        },
        "And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this is"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "what"
          ]
        },
        " we speak, not in words taught ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "us"
          ]
        },
        " by human wisdom, but in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "words"
          ]
        },
        " taught by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Spirit, expressing spiritual truths in spiritual ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "words"
          ]
        },
        ".",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:13 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "to spiritual people"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "1CO 2:14"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The"
          ]
        },
        " natural man ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "does"
          ]
        },
        " not accept the things that come from the Spirit of God. For they are foolishness to him, and he cannot understand ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        ", because ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "they are"
          ]
        },
        " spiritually discerned. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "1CO 2:15"
        },
        "The spiritual ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        " judges all things, but he himself is not subject to anyone’s judgment. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "1CO 2:16"
        },
        "“For who has known ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " mind of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "so as"
          ]
        },
        " to instruct Him?”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:16 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 40:13",
                  "content": [
                    "Isaiah 40:13"
                  ]
                },
                " (see also LXX)"
              ]
            }
          ]
        },
        " But we have ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " mind of Christ."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "3",
      "sid": "1CO 3"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "God’s Fellow Workers"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "HEB 5:11-14",
          "content": [
            "Hebrews 5:11–14"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "1CO 3:1"
        },
        "Brothers, I could not address you as spiritual, but as worldly — as infants in Christ. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "1CO 3:2"
        },
        "I gave you milk, not solid food, for you were not yet ready ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "for solid food"
          ]
        },
        ". In fact, you are still not ready, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "1CO 3:3"
        },
        "for you are still worldly. For since ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "there is"
          ]
        },
        " jealousy and dissension among you, are you not worldly? ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Are you not "
          ]
        },
        " walking in the way of man? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "1CO 3:4"
        },
        "For when one ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of you"
          ]
        },
        " says, “I ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "follow"
          ]
        },
        " Paul,” and another, “I ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "follow"
          ]
        },
        " Apollos,” are you not mere men?"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "1CO 3:5"
        },
        "What then is Apollos? And what is Paul? ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "They are"
          ]
        },
        " servants through whom you believed, as the Lord has assigned to each ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his role "
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "1CO 3:6"
        },
        "I planted ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the seed"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " Apollos watered ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        ", but God made ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it "
          ]
        },
        " grow. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "1CO 3:7"
        },
        "So neither he who plants nor he who waters is anything, but ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "only"
          ]
        },
        " God, who makes ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "things"
          ]
        },
        " grow. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "1CO 3:8"
        },
        "He who plants and he who waters are one  ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "in purpose "
          ]
        },
        ",",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:8 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "are one"
              ]
            }
          ]
        },
        " and each will be rewarded according to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " own labor. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "1CO 3:9"
        },
        "For we are God’s fellow workers; you are God’s field, God’s building."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Christ Our Foundation"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ISA 28:14-22",
          "content": [
            "Isaiah 28:14–22"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "EPH 2:19-22",
          "content": [
            "Ephesians 2:19–22"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "1PE 2:1-8",
          "content": [
            "1 Peter 2:1–8"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "1CO 3:10"
        },
        "By the grace God has given me, I laid ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "a"
          ]
        },
        " foundation as an expert builder, and someone else is building on ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        ". But each one must be careful how he builds. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "1CO 3:11"
        },
        "For no one can lay a foundation other than the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one"
          ]
        },
        " already laid, which is Jesus Christ."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "1CO 3:12"
        },
        "If anyone builds on ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        " foundation ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "using"
          ]
        },
        " gold, silver, precious stones, wood, hay, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " straw, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "1CO 3:13"
        },
        "his workmanship will be evident, because the Day will bring it to light. It will be revealed with fire, and the fire will prove the quality of each ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man’s"
          ]
        },
        " work. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "1CO 3:14"
        },
        "If what he has built survives, he will receive a reward. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "1CO 3:15"
        },
        "If ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " is burned up, he will suffer loss. He himself will be saved, but only as if through ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " flames."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "God’s Temple and God’s Wisdom"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ROM 12:1-8",
          "content": [
            "Romans 12:1–8"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "1CO 6:18-20",
          "content": [
            "1 Corinthians 6:18–20"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "1CO 3:16"
        },
        "Do you not know that you yourselves are God’s temple, and that God’s Spirit dwells in",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:16 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "among"
              ]
            }
          ]
        },
        " you? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "1CO 3:17"
        },
        "If anyone destroys God’s temple, God will destroy him; for God’s temple is holy, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " you are ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that temple"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "1CO 3:18"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Let"
          ]
        },
        " no one deceive himself. If any of you thinks he is wise in this age, he should become a fool, so that he may become wise. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "1CO 3:19"
        },
        "For the wisdom of this world is foolishness in God’s sight. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "As"
          ]
        },
        " it is written: “He catches the wise in their craftiness.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:19 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "JOB 5:13",
                  "content": [
                    "Job 5:13"
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "1CO 3:20"
        },
        "And again, “",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The"
          ]
        },
        " Lord knows that the thoughts of the wise are futile.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:20 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "PSA 94:11",
                  "content": [
                    "Psalm 94:11"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "1CO 3:21"
        },
        "Therefore, stop boasting in men. All things are yours, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "1CO 3:22"
        },
        "whether Paul or Apollos or Cephas",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:22 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "That is, Peter"
              ]
            }
          ]
        },
        " or ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " world or life or death or the present or the future. All ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of them"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "belong to"
          ]
        },
        " you, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "1CO 3:23"
        },
        "and you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "belong to"
          ]
        },
        " Christ, and Christ ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "belongs to"
          ]
        },
        " God."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "4",
      "sid": "1CO 4"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Servants of Christ"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "1CO 4:1"
        },
        "So then, men ought to regard us as servants of Christ and stewards of the mysteries of God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "1CO 4:2"
        },
        "Now it is required of stewards that they be found faithful."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "1CO 4:3"
        },
        "I care very little, however, if I am judged by you or by any human court. In fact, I do not even judge myself. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "1CO 4:4"
        },
        "My conscience is clear, but that does not vindicate me. It is ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord who judges me."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "1CO 4:5"
        },
        "Therefore judge nothing before ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " appointed time; ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "wait"
          ]
        },
        " until the Lord comes. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "He"
          ]
        },
        " will bring to light what is hidden in darkness and will expose the motives of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "men’s "
          ]
        },
        " hearts. At that time each will receive ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " praise from God."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "1CO 4:6"
        },
        "Brothers, I have applied these things to myself and Apollos for your benefit, so that you may learn from us not ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to go"
          ]
        },
        " beyond what is written. Then you will not take pride in one ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        " over another. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "1CO 4:7"
        },
        "For who makes you so superior? What do you have that you did not receive? And if you did receive ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        ", why do you boast as though ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you did not"
          ]
        },
        "?"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "1CO 4:8"
        },
        "Already you have all you want. Already you have become rich. Without us, you have become kings. How I wish you really were kings, so that we might be kings with you! ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "1CO 4:9"
        },
        "For it seems to me that God has displayed us apostles at the end  ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of the procession "
          ]
        },
        ", like ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "prisoners "
          ]
        },
        " appointed for death. We have become a spectacle to the whole world, to angels as well as to men."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "1CO 4:10"
        },
        "We ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " fools for Christ, but you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " wise in Christ. We ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " weak, but you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " strong. You ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " honored, but we ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " dishonored. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "1CO 4:11"
        },
        "To ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        " very hour we are hungry and thirsty, we are poorly clothed, we are brutally treated, we are homeless. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "1CO 4:12"
        },
        "We work hard with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "our"
          ]
        },
        " own hands. When we are vilified, we bless; when we are persecuted, we endure ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        "; ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "1CO 4:13"
        },
        "when we are slandered, we answer gently. Up to this moment we have become ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " scum of the earth, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " refuse of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the world"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Paul’s Fatherly Warning"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "1CO 4:14"
        },
        "I am not writing this to shame you, but to warn you as my beloved children. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "1CO 4:15"
        },
        "Even if you have ten thousand guardians in Christ, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you do"
          ]
        },
        " not ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "have"
          ]
        },
        " many fathers; for in Christ Jesus I became your father through the gospel. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "1CO 4:16"
        },
        "Therefore I urge you to imitate me. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "1CO 4:17"
        },
        "That is why I have sent you Timothy, my beloved and faithful child in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "He"
          ]
        },
        " will remind you of my way of life in Christ Jesus,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "4:17 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "my way of life in Christ,"
              ]
            }
          ]
        },
        " which is exactly what I teach everywhere in every church."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "1CO 4:18"
        },
        "Some ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of you"
          ]
        },
        " have become arrogant, as if I were not coming to you. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "1CO 4:19"
        },
        "But I will come to you shortly, if the Lord is willing, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "then"
          ]
        },
        " I will find out not ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "only"
          ]
        },
        " what these arrogant ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "people"
          ]
        },
        " are saying, but what power ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "they have"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "1CO 4:20"
        },
        "For the kingdom of God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " not a matter of talk but of power. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "1CO 4:21"
        },
        "Which do you prefer? Shall I come to you with a rod, or in love and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "with"
          ]
        },
        " a gentle spirit?"
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "5",
      "sid": "1CO 5"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Immorality Rebuked"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LEV 20:10-21",
          "content": [
            "Leviticus 20:10–21"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "PRO 5:1-23",
          "content": [
            "Proverbs 5:1–23"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "1CO 5:1"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "It is"
          ]
        },
        " actually reported ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that there is"
          ]
        },
        " sexual immorality among you, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of a kind"
          ]
        },
        " that is intolerable even among pagans: A man has ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " father’s wife. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "1CO 5:2"
        },
        "And you are proud! Shouldn’t you rather have been stricken with grief ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " have removed from your ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "fellowship"
          ]
        },
        " the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man who"
          ]
        },
        " did this?"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "1CO 5:3"
        },
        "Although I am absent  ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "from you "
          ]
        },
        " in body, I am present ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "with you "
          ]
        },
        " in spirit, and I have already pronounced judgment on the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who"
          ]
        },
        " did this, just as if I were present. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "1CO 5:4"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "When"
          ]
        },
        " you are assembled in the name of our Lord Jesus",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "5:4 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "In the name of our Lord Jesus, when you are assembled"
              ]
            }
          ]
        },
        " and I ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "am with you"
          ]
        },
        " in spirit, along with the power of the Lord Jesus, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "1CO 5:5"
        },
        "hand this man ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "over"
          ]
        },
        " to Satan for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " destruction of the flesh, so that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " spirit may be saved on the Day of the Lord.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "5:5 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "the Lord Jesus"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "1CO 5:6"
        },
        "Your boasting ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " not good. Do you not know that a little leaven works through the whole batch ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of dough"
          ]
        },
        "? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "1CO 5:7"
        },
        "Get rid of the old leaven, that you may be a new unleavened batch, as you really are. For Christ, our Passover lamb, has been sacrificed. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "1CO 5:8"
        },
        "Therefore let us keep the feast, not with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " old bread, leavened with malice and wickedness, but with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " unleavened ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "bread"
          ]
        },
        " of sincerity and of truth."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Expel the Immoral Brother"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "1CO 5:9"
        },
        "I wrote you in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "my"
          ]
        },
        " letter not to associate with sexually immoral ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "people"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "1CO 5:10"
        },
        "I was not ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "including "
          ]
        },
        " the sexually immoral of this world, or the greedy and swindlers, or idolaters. In that case you would have to leave ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        " world. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "1CO 5:11"
        },
        "But now I am writing you not to associate with anyone who claims to be a brother ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "but"
          ]
        },
        " is sexually immoral or greedy, an idolater or a verbal abuser, a drunkard or a swindler. With such a man ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do"
          ]
        },
        " not even eat."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "1CO 5:12"
        },
        "What business of mine ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is it"
          ]
        },
        " to judge those outside ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the church "
          ]
        },
        "? ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Are"
          ]
        },
        " you not to judge those inside? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "1CO 5:13"
        },
        "God will judge those outside. “Expel the wicked ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        " from among you.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "5:13 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Expel the evil from among you"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; ",
                {
                  "type": "ref",
                  "loc": "DEU 13:5",
                  "content": [
                    "Deuteronomy 13:5"
                  ]
                },
                ", 17:7, 19:19, 21:21, 22:21, 22:24, and 24:7"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "6",
      "sid": "1CO 6"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Lawsuits among Believers"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "1CO 6:1"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "If"
          ]
        },
        " any of you has a grievance against another, how dare he go to law before the unrighteous ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "instead of"
          ]
        },
        " before the saints! ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "1CO 6:2"
        },
        "Do you not know that the saints will judge the world? And if you are to judge the world, are you not competent  ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to judge "
          ]
        },
        " trivial cases? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "1CO 6:3"
        },
        "Do you not know that we will judge angels? How much more the things of this life!"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "1CO 6:4"
        },
        "So if you need to settle everyday matters, do you appoint ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as judges"
          ]
        },
        " those of no standing in the church? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "1CO 6:5"
        },
        "I say this to your shame. Is there really no one among you wise ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "enough"
          ]
        },
        " to arbitrate between his brothers? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "1CO 6:6"
        },
        "Instead, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one"
          ]
        },
        " brother goes to law against ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "another"
          ]
        },
        ", and this in front of unbelievers!"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "1CO 6:7"
        },
        "The very fact that you have lawsuits among you means ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " thoroughly defeated already. Why not rather be wronged? Why not rather be cheated? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "1CO 6:8"
        },
        "Instead, you yourselves cheat and do wrong, even ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "against your own"
          ]
        },
        " brothers!",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "6:8 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "do wrong, and this to brothers!"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Members of Christ"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "1CO 6:9"
        },
        "Do you not know that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " wicked will not inherit ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " kingdom of God? ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Do"
          ]
        },
        " not be deceived: Neither the sexually immoral, nor idolaters, nor adulterers, nor men who submit to or perform homosexual acts, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "1CO 6:10"
        },
        "nor thieves, nor the greedy, nor drunkards, nor verbal abusers, nor swindlers, will inherit ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " kingdom of God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "1CO 6:11"
        },
        "And that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is what"
          ]
        },
        " some ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of"
          ]
        },
        " you were. But you were washed, you were sanctified, you were justified, in the name of the Lord Jesus Christ and by the Spirit of our God."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "1CO 6:12"
        },
        "“Everything is permissible for me,” but not everything is beneficial. “Everything is permissible for me,” but I will not be mastered by anything. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "1CO 6:13"
        },
        "“Food for the stomach and the stomach for food,” but God will destroy them both. The body ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " not ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "intended"
          ]
        },
        " for sexual immorality, but for the Lord, and the Lord for the body. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "1CO 6:14"
        },
        "By His power God raised the Lord ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "from the dead"
          ]
        },
        ", and He will raise us ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "also"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "1CO 6:15"
        },
        "Do you not know that your bodies are members of Christ? Shall I then take the members of Christ and unite ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        " with a prostitute? Never! ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "1CO 6:16"
        },
        "Or don’t you know that he who unites himself with a prostitute is one ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "with her"
          ]
        },
        " in body? For it is said, “The two will become one flesh.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "6:16 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "GEN 2:24",
                  "content": [
                    "Genesis 2:24"
                  ]
                },
                " (see also LXX)"
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "1CO 6:17"
        },
        "But he who unites himself with the Lord is one ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "with Him"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "in"
          ]
        },
        " spirit."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Temple of the Holy Spirit"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ROM 12:1-8",
          "content": [
            "Romans 12:1–8"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "1CO 3:16-23",
          "content": [
            "1 Corinthians 3:16–23"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "1CO 6:18"
        },
        "Flee from sexual immorality. Every ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "other"
          ]
        },
        " sin a man can commit is outside ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " body, but he who sins sexually sins against ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " own body. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "1CO 6:19"
        },
        "Do you not know that your body ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " a temple of the Holy Spirit ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who"
          ]
        },
        " is in you, whom you have ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "received"
          ]
        },
        " from God? You are not your own; ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "1CO 6:20"
        },
        "you were bought at a price. Therefore glorify God with your body.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "6:20 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "and with your spirit, which belong to God"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "7",
      "sid": "1CO 7"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Principles of Marriage"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "1CO 7:1"
        },
        "Now for the matters you wrote about: ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "It is"
          ]
        },
        " good to abstain from sexual relations.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "7:1 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "It is good for a man not to touch a woman."
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "1CO 7:2"
        },
        "But because ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "there is so much"
          ]
        },
        " sexual immorality, each man should have his ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "own"
          ]
        },
        " wife, and each woman ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "her"
          ]
        },
        " own husband."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "1CO 7:3"
        },
        "The husband should fulfill ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "marital"
          ]
        },
        " duty to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " wife, and likewise the wife to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "her"
          ]
        },
        " husband. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "1CO 7:4"
        },
        "The wife ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "does"
          ]
        },
        " not have authority over ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "her"
          ]
        },
        " own body, but the husband. Likewise the husband ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "does"
          ]
        },
        " not have authority over ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " own body, but the wife."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "1CO 7:5"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Do"
          ]
        },
        " not deprive each other, except by mutual consent ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " for a time, so you may devote yourselves to prayer. Then come together again, so that Satan will not tempt you through your lack of self-control. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "1CO 7:6"
        },
        "I say this as a concession, not as a command. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "1CO 7:7"
        },
        "I wish that all men were as I am. But each ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        " has his own gift from God; one ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "has"
          ]
        },
        " this ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "gift"
          ]
        },
        ", another ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "has"
          ]
        },
        " that."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "1CO 7:8"
        },
        "Now to the unmarried and widows I say ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        ": ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "It is"
          ]
        },
        " good for them to remain ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "unmarried"
          ]
        },
        ", as I am. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "1CO 7:9"
        },
        "But if they cannot control themselves, let them marry. For it is better to marry than to burn with passion."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "1CO 7:10"
        },
        "To the married I give this command (not I, but the Lord): A wife must not separate from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "her"
          ]
        },
        " husband. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "1CO 7:11"
        },
        "But if she ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "does"
          ]
        },
        ", she must remain unmarried or else be reconciled to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "her"
          ]
        },
        " husband. And a husband must not divorce ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " wife."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "1CO 7:12"
        },
        "To the rest I say this (",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "I,"
          ]
        },
        " not the Lord): If a brother has an unbelieving wife and she is willing to live with him, he must not divorce her. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "1CO 7:13"
        },
        "And if a woman has an unbelieving husband and he is willing to live with her, she must not divorce ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "him"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "1CO 7:14"
        },
        "For the unbelieving husband is sanctified through ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "believing"
          ]
        },
        " wife, and the unbelieving wife is sanctified through ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "her"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "believing"
          ]
        },
        " husband. Otherwise your children would be unclean, but now they are holy."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "1CO 7:15"
        },
        "But if the unbeliever leaves, let him go. The  ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "believing "
          ]
        },
        " brother or sister is not bound in such ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "cases"
          ]
        },
        ". God has called you",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "7:15 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "SBL, BYZ, and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "us"
              ]
            }
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to live"
          ]
        },
        " in peace. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "1CO 7:16"
        },
        "How do you know, wife, whether you will save ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " husband? Or how do you know, husband, whether you will save ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " wife?"
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Live Your Calling"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "1CO 7:17"
        },
        "Regardless, each one should lead  ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the life "
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " the Lord has assigned ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to him"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and to which"
          ]
        },
        " God has called ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "him"
          ]
        },
        ". This ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is what"
          ]
        },
        " I prescribe in all the churches. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "1CO 7:18"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Was"
          ]
        },
        " a man already circumcised when he was called? He should not become uncircumcised. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Was"
          ]
        },
        " a man still uncircumcised when called? He should not be circumcised. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "1CO 7:19"
        },
        "Circumcision is nothing and uncircumcision is nothing. Keeping God’s commandments ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is what counts"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "1CO 7:20"
        },
        "Each ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one"
          ]
        },
        " should remain in the situation ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "he was"
          ]
        },
        " in when he was called. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "1CO 7:21"
        },
        "Were you a slave when you were called? Do not let it concern you— but if you can gain ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " freedom, take the opportunity. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "1CO 7:22"
        },
        "For he who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was"
          ]
        },
        " a slave when he was called by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord is ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord’s freedman. Conversely, he who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was"
          ]
        },
        " a free man when he was called is Christ’s slave."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "1CO 7:23"
        },
        "You were bought at a price; ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do"
          ]
        },
        " not become slaves of men. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "1CO 7:24"
        },
        "Brothers, each one should remain in the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "situation"
          ]
        },
        " he was in when God called him."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Unmarried and Widowed"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "1CO 7:25"
        },
        "Now about virgins, I have no command from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord, but I give a judgment as ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one who"
          ]
        },
        " by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord’s mercy is trustworthy. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "1CO 7:26"
        },
        "Because of the present",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "7:26 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "impending"
              ]
            }
          ]
        },
        " crisis, I think ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " is good for a man to remain as ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "he is"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "1CO 7:27"
        },
        "Are you committed to a wife? ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Do"
          ]
        },
        " not seek to be released. Are you free of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "commitment"
          ]
        },
        "? ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Do"
          ]
        },
        " not look for a wife. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "1CO 7:28"
        },
        "But if you do marry, you have not sinned. And if a virgin marries, she has not sinned. But ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "those who marry"
          ]
        },
        " will face troubles in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        " life, and I ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "want to"
          ]
        },
        " spare you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "1CO 7:29"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "What"
          ]
        },
        " I am saying, brothers, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " that the time is short. From now on those who have wives should live as if they had none; ",
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "1CO 7:30"
        },
        "those who weep, as if they ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "did not"
          ]
        },
        "; those who are joyful, as if they were not; those who make a purchase, as if they had nothing; ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "1CO 7:31"
        },
        "and those who use the things of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        " world, as if not dependent on them. For this world ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "in its"
          ]
        },
        " present form is passing away."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "32",
          "sid": "1CO 7:32"
        },
        "I want you to be free from concern. The unmarried man is concerned about the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "work"
          ]
        },
        " of the Lord, how he can please the Lord. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "1CO 7:33"
        },
        "But the married man is concerned about the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "affairs"
          ]
        },
        " of this world, how he can please ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " wife, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "34",
          "sid": "1CO 7:34"
        },
        "and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his interests"
          ]
        },
        " are divided. The unmarried woman ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " virgin is concerned about the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "work"
          ]
        },
        " of the Lord, how she can be holy in both body and spirit. But the married woman is concerned about the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "affairs"
          ]
        },
        " of this world, how she can please ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "her"
          ]
        },
        " husband."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "35",
          "sid": "1CO 7:35"
        },
        "I am saying this for your own good, not to restrict you, but in order to promote proper decorum and undivided devotion to the Lord."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "36",
          "sid": "1CO 7:36"
        },
        "However, if someone thinks he is acting inappropriately toward his betrothed, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " if she is beyond ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "her"
          ]
        },
        " youth and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "they"
          ]
        },
        " ought ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to marry"
          ]
        },
        ",",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "7:36 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "and it ought to be so"
              ]
            }
          ]
        },
        " let him do as he wishes; he is not sinning; they should get married. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "37",
          "sid": "1CO 7:37"
        },
        "But the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man who"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " firmly established in his heart ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " under no constraint, with control over ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " will and resolve in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " heart ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "not to marry"
          ]
        },
        " the virgin,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "7:37 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "in his heart to keep the virgin "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "in his heart to keep the betrothed"
              ]
            }
          ]
        },
        " he will do well."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "38",
          "sid": "1CO 7:38"
        },
        "So then, he who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "marries"
          ]
        },
        " the virgin does well, but he who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "does"
          ]
        },
        " not marry ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "her"
          ]
        },
        " does even better."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "39",
          "sid": "1CO 7:39"
        },
        "A wife is bound to her husband as long as he lives. But if ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "her"
          ]
        },
        " husband dies, she is free to marry anyone she wishes, as long as ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "he"
          ]
        },
        " belongs to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "7:39 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "she is free to be married to whom she wishes, only in the Lord"
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "40",
          "sid": "1CO 7:40"
        },
        "In my judgment, however, she is happier if she remains as she is. And I think that I too have ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Spirit of God."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "8",
      "sid": "1CO 8"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Food Sacrificed to Idols"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "EZK 14:1-11",
          "content": [
            "Ezekiel 14:1–11"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "ROM 14:13-23",
          "content": [
            "Romans 14:13–23"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "1CO 8:1"
        },
        "Now about ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "food"
          ]
        },
        " sacrificed to idols: We know that we all have knowledge. Knowledge puffs up, but love builds up. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "1CO 8:2"
        },
        "The one who thinks he knows something does not yet know as he ought to know. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "1CO 8:3"
        },
        "But the one who loves God is known by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "God"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "1CO 8:4"
        },
        "So about eating food sacrificed to idols: We know that an idol ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " nothing at all in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " world, and that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "there is"
          ]
        },
        " no God but one. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "1CO 8:5"
        },
        "For even if there are so-called gods, whether in heaven or on earth (as there are many  ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "so-called "
          ]
        },
        " gods and lords), ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "1CO 8:6"
        },
        "yet for us  ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "there is but "
          ]
        },
        " one God, the Father, from whom all things ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "came"
          ]
        },
        " and for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "whom"
          ]
        },
        " we ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "exist"
          ]
        },
        ". And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "there is but "
          ]
        },
        " one Lord, Jesus Christ, through whom all things ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "came"
          ]
        },
        " and through ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "whom"
          ]
        },
        " we ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "exist"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "1CO 8:7"
        },
        "But not everyone ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "has"
          ]
        },
        " this knowledge. Some ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "people"
          ]
        },
        " are still so accustomed to idols ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " they eat ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "such food"
          ]
        },
        " as if it were sacrificed to an idol. And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "since"
          ]
        },
        " their conscience is weak, it is defiled. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "1CO 8:8"
        },
        "But food does not bring us closer to God: We are no worse if we do not eat, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " no ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "better"
          ]
        },
        " if we do."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "1CO 8:9"
        },
        "Be careful, however, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " your freedom does not become a stumbling block to the weak. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "1CO 8:10"
        },
        "For if someone ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "with"
          ]
        },
        " a weak conscience sees you who are well informed eating in an idol’s temple, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "will he"
          ]
        },
        " not be encouraged to eat ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "food"
          ]
        },
        " sacrificed to idols? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "1CO 8:11"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        " weak brother, for whom Christ died, is destroyed by your knowledge. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "1CO 8:12"
        },
        "By sinning against ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " brothers in this way and wounding their weak conscience, you sin against Christ."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "1CO 8:13"
        },
        "Therefore, if ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "what I eat"
          ]
        },
        " causes my brother ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to stumble"
          ]
        },
        ", I will never eat meat ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "again"
          ]
        },
        ", so that I will not cause ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "him"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to stumble"
          ]
        },
        "."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "9",
      "sid": "1CO 9"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Rights of an Apostle"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "DEU 18:1-8",
          "content": [
            "Deuteronomy 18:1–8"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "1CO 9:1"
        },
        "Am I not free? Am I not an apostle? Have I not seen Jesus our Lord? Are you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "yourselves"
          ]
        },
        " not my workmanship in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "1CO 9:2"
        },
        "Even if I am not an apostle to others, surely I am to you. For you are the seal of my apostleship in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "1CO 9:3"
        },
        "This is my defense to those who scrutinize me: ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "1CO 9:4"
        },
        "Have we no right to food and to drink? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "1CO 9:5"
        },
        "Have we no right to take along a believing wife,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "9:5 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "take along a sister—a wife—"
              ]
            }
          ]
        },
        " as ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do"
          ]
        },
        " the other apostles and the Lord’s brothers and Cephas?",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "9:5 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "That is, Peter"
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "1CO 9:6"
        },
        "Or ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " Barnabas and I the only ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "apostles "
          ]
        },
        " who must work for a living?",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "9:6 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Or is it only Barnabas and I who do not have authority not to work?"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "1CO 9:7"
        },
        "Who serves as a soldier at his own expense? Who plants a vineyard and does not eat of its fruit? Who tends a flock and does not drink of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "its"
          ]
        },
        " milk?"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "1CO 9:8"
        },
        "Do I say this from a human perspective? Doesn’t ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Law say the same thing? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "1CO 9:9"
        },
        "For it is written in the Law of Moses: “Do not muzzle an ox ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "while it is"
          ]
        },
        " treading out the grain.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "9:9 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "DEU 25:4",
                  "content": [
                    "Deuteronomy 25:4"
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Is it"
          ]
        },
        " about oxen ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " God is concerned? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "1CO 9:10"
        },
        "Isn’t He actually speaking on our behalf? Indeed, this was written for us, because ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "when"
          ]
        },
        " the plowman plows and the thresher ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "threshes "
          ]
        },
        ", ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "they"
          ]
        },
        " should ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "also"
          ]
        },
        " expect to share in the harvest."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "1CO 9:11"
        },
        "If we have sown spiritual ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "seed"
          ]
        },
        " among you, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is it"
          ]
        },
        " too much for us to reap a material ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "harvest"
          ]
        },
        " from you? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "1CO 9:12"
        },
        "If others have ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        " right to your ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "support"
          ]
        },
        ", shouldn’t we ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "have it"
          ]
        },
        " all the more? But we did not exercise this right. Instead, we put up with anything rather than hinder the gospel of Christ."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "1CO 9:13"
        },
        "Do you not know that those who work in the temple eat of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "its food"
          ]
        },
        ", ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " those who serve at the altar partake of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "its"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "offerings"
          ]
        },
        "? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "1CO 9:14"
        },
        "In the same way, the Lord has prescribed that those who preach the gospel should receive their living from the gospel. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "1CO 9:15"
        },
        "But I have not used ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "any"
          ]
        },
        " of these ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "rights"
          ]
        },
        ". And I am not writing this to suggest that something be done for me. Indeed, I would rather die than ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "let"
          ]
        },
        " anyone nullify my boast."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "1CO 9:16"
        },
        "Yet when I preach the gospel, I have no reason to boast, because I am obligated ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to preach"
          ]
        },
        ". Woe to me if I do not preach the gospel! ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "1CO 9:17"
        },
        "If my ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "preaching"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " voluntary, I have a reward. But if ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it is"
          ]
        },
        " not voluntary, I am ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "still"
          ]
        },
        " entrusted with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "a"
          ]
        },
        " responsibility. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "1CO 9:18"
        },
        "What then is my reward? That in preaching the gospel I may offer ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " free of charge, and so not use up my rights in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "preaching"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Paul the Servant to All"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "1CO 9:19"
        },
        "Though I am free of obligation to anyone, I make myself a slave to everyone, to win as many as possible. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "1CO 9:20"
        },
        "To the Jews I became like a Jew, to win ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Jews. To those under ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "I became like one"
          ]
        },
        " under ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law (",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "though I"
          ]
        },
        " myself am not under ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law), to win those under ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "1CO 9:21"
        },
        "To those without ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "I became like one"
          ]
        },
        " without ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law (",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "though I"
          ]
        },
        " am not outside ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law of God but ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "am"
          ]
        },
        " under ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law of Christ), to win those without ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "1CO 9:22"
        },
        "To the weak I became weak, to win the weak. I have become all things to all ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "people"
          ]
        },
        " so that by all possible means I might save some."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "1CO 9:23"
        },
        "I do all ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        " for the sake of the gospel, so that I may share in its ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "blessings"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Run Your Race to Win"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "1CO 9:24"
        },
        "Do you not know that in a race all the runners run, but only one receives the prize? Run in such a way as to take ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the prize"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "1CO 9:25"
        },
        "Everyone who competes in the games trains with strict discipline. They ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do it"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "for"
          ]
        },
        " a crown ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that is"
          ]
        },
        " perishable, but we ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do it for a crown "
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that is"
          ]
        },
        " imperishable. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "1CO 9:26"
        },
        "Therefore I do not run aimlessly; I do not fight like I am beating ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " air. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "1CO 9:27"
        },
        "No, I discipline my body and make it my slave, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "so that"
          ]
        },
        " after I have preached to others, I myself will not be disqualified."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "10",
      "sid": "1CO 10"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Warnings from Israel’s Past"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "NUM 16:41-50",
          "content": [
            "Numbers 16:41–50"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "NUM 25:1-5",
          "content": [
            "Numbers 25:1–5"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "1CO 10:1"
        },
        "I do not want you to be unaware, brothers, that our forefathers were all under the cloud, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " they all passed through the sea. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "1CO 10:2"
        },
        "They were all baptized into Moses in the cloud and in the sea. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "1CO 10:3"
        },
        "They all ate the same spiritual food ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "1CO 10:4"
        },
        "and drank the same spiritual drink; for they drank from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " spiritual rock that accompanied them, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " rock was Christ. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "1CO 10:5"
        },
        "Nevertheless, God was not pleased with most of them, for they were struck down in the wilderness."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "1CO 10:6"
        },
        "These things took place as examples to keep us from craving evil things as they ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "did"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "1CO 10:7"
        },
        "Do not be idolaters, as some of them ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "were"
          ]
        },
        ". As it is written: “The people sat down to eat and drink and got up to indulge in revelry.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "10:7 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "to play"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; ",
                {
                  "type": "ref",
                  "loc": "EXO 32:6",
                  "content": [
                    "Exodus 32:6"
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "1CO 10:8"
        },
        "We should not commit sexual immorality, as some of them ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "did"
          ]
        },
        ", and in one day twenty-three thousand ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of them"
          ]
        },
        " died. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "1CO 10:9"
        },
        "We should not test Christ,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "10:9 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "WH, NE, and Tischendorf "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "test the Lord"
              ]
            }
          ]
        },
        " as some of them ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "did"
          ]
        },
        ", and were killed by snakes. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "1CO 10:10"
        },
        "And do not complain, as some of them ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "did"
          ]
        },
        ", and were killed by the destroying angel.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "10:10 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "the destroyer"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "1CO 10:11"
        },
        "Now these things happened to them ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as"
          ]
        },
        " examples and were written down as warnings for us, on whom the fulfillment of the ages has come. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "1CO 10:12"
        },
        "So the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one who"
          ]
        },
        " thinks he is standing firm should be careful not to fall. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "1CO 10:13"
        },
        "No temptation has seized you except what is common to man. And God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " faithful; ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "He"
          ]
        },
        " will not let you be tempted beyond what you can bear. But when ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you are"
          ]
        },
        " tempted, He will also provide an escape, so that you can stand up under ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Flee from Idolatry"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "EXO 20:22-26",
          "content": [
            "Exodus 20:22–26"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "1CO 10:14"
        },
        "Therefore, my beloved, flee from idolatry. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "1CO 10:15"
        },
        "I speak to reasonable ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "people"
          ]
        },
        "; judge for yourselves what I say. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "1CO 10:16"
        },
        "Is not the cup of blessing that we bless a participation in the blood of Christ? ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "And"
          ]
        },
        " is not the bread that we break a participation in the body of Christ? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "1CO 10:17"
        },
        "Because ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "there is"
          ]
        },
        " one loaf, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "we who are"
          ]
        },
        " many are one body; for we all partake of the one loaf."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "1CO 10:18"
        },
        "Consider the people of Israel: Are not those who eat the sacrifices fellow partakers in the altar? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "1CO 10:19"
        },
        "Am I suggesting, then, that food sacrificed to an idol is anything, or that an idol is anything? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "1CO 10:20"
        },
        "No, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "but"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " sacrifices of pagans are offered to demons, not to God. And I do not want you to be participants with demons. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "1CO 10:21"
        },
        "You cannot drink ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " cup of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " cup of demons ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "too"
          ]
        },
        "; you cannot partake in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " table of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " table of demons ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "too"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "1CO 10:22"
        },
        "Are we trying to provoke the Lord ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to jealousy"
          ]
        },
        "? Are we stronger than He?"
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "All to God’s Glory"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "1PE 4:1-11",
          "content": [
            "1 Peter 4:1–11"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "1CO 10:23"
        },
        "“Everything is permissible,”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "10:23 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "“All things are lawful,” "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "twice in this verse"
              ]
            }
          ]
        },
        " but not everything is beneficial. “Everything is permissible,” but not everything is edifying. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "1CO 10:24"
        },
        "No one should seek his own ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "good"
          ]
        },
        ", but ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the good"
          ]
        },
        " of others."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "1CO 10:25"
        },
        "Eat anything sold in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " meat market without raising questions of conscience, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "1CO 10:26"
        },
        "for, “The earth ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " the Lord’s, and the fullness thereof.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "10:26 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "PSA 24:1",
                  "content": [
                    "Psalm 24:1"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "1CO 10:27"
        },
        "If an unbeliever invites you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to a meal"
          ]
        },
        " and you want to go, eat anything set before you without raising questions of conscience. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "1CO 10:28"
        },
        "But if someone tells you, “This ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "food"
          ]
        },
        " was offered to idols,” ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "then do"
          ]
        },
        " not eat ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        ", for the sake of the one who told ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        " and for the sake of conscience —",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "10:28 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "and for the sake of conscience—for the earth is the Lord’s, and the fullness thereof—"
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "1CO 10:29"
        },
        "the other ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one’s"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "conscience "
          ]
        },
        ", I mean, not your own. For why ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "should"
          ]
        },
        " my freedom be determined by someone else’s conscience? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "1CO 10:30"
        },
        "If I partake ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "in the meal"
          ]
        },
        " with thankfulness, why am I denounced because of that for which I give thanks?"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "1CO 10:31"
        },
        "So whether you eat or drink or whatever you do, do it all to the glory of God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "32",
          "sid": "1CO 10:32"
        },
        "Do not become a stumbling block, whether to Jews ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " Greeks ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " the church of God— ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "1CO 10:33"
        },
        "as I also ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "try to"
          ]
        },
        " please everyone in all ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "I do"
          ]
        },
        ". ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "For"
          ]
        },
        " I am not seeking my ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "own"
          ]
        },
        " good, but ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the good"
          ]
        },
        " of many, that they may be saved."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "11",
      "sid": "1CO 11"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Roles in Worship"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "1CO 11:1"
        },
        "You are to imitate me, just as I ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "imitate"
          ]
        },
        " Christ."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "1CO 11:2"
        },
        "Now I commend you for remembering me in everything and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "for"
          ]
        },
        " maintaining the traditions, just as I passed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        " on to you. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "1CO 11:3"
        },
        "But I want you to understand that the head of every man is Christ, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " head of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " woman ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " man, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " head of Christ ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " God."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "1CO 11:4"
        },
        "Every man ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who"
          ]
        },
        " prays or prophesies with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " head covered dishonors his head. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "1CO 11:5"
        },
        "And every woman ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who"
          ]
        },
        " prays or prophesies with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "her"
          ]
        },
        " head uncovered dishonors her head, for it is just ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as if"
          ]
        },
        " her head were shaved. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "1CO 11:6"
        },
        "If a woman ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "does"
          ]
        },
        " not cover her head, she should have her hair cut off. And if ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it is"
          ]
        },
        " shameful for a woman to have her hair cut or shaved off, she should cover her head."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "1CO 11:7"
        },
        "A man ought not to cover ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " head, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "since"
          ]
        },
        " he is ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " image and glory of God; but the woman is ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " glory of man. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "1CO 11:8"
        },
        "For man did not come from woman, but woman from man. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "1CO 11:9"
        },
        "Neither ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was"
          ]
        },
        " man created for woman, but woman for man. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "1CO 11:10"
        },
        "For this reason a woman ought to have a sign of authority on",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "11:10 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "have authority over"
              ]
            }
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "her"
          ]
        },
        " head, because of the angels."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "1CO 11:11"
        },
        "In ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord, however, woman ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " not independent ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of"
          ]
        },
        " man, nor ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " man independent of woman. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "1CO 11:12"
        },
        "For just as woman ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "came"
          ]
        },
        " from man, so also man ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " born of woman. But everything ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "comes"
          ]
        },
        " from God."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "1CO 11:13"
        },
        "Judge for yourselves: Is it proper for a woman to pray to God with her head uncovered? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "1CO 11:14"
        },
        "Doesn’t nature itself teach you that if a man has long hair, it is a disgrace to him, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "1CO 11:15"
        },
        "but ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " if a woman has long hair, it is her glory? For long hair is given to her as a covering. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "1CO 11:16"
        },
        "If anyone is inclined to dispute ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        ", we have no ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "other"
          ]
        },
        " practice, nor ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do"
          ]
        },
        " the churches of God."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Sharing in the Lord’s Supper"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 26:20-30",
          "content": [
            "Matthew 26:20–30"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MRK 14:17-26",
          "content": [
            "Mark 14:17–26"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 22:14-23",
          "content": [
            "Luke 22:14–23"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "1CO 11:17"
        },
        "In the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "following"
          ]
        },
        " instructions I have no praise to offer, because your gatherings do more harm than good. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "1CO 11:18"
        },
        "First of all, I hear that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "when"
          ]
        },
        " you come together as a church, there are divisions among you, and in part I believe it. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "1CO 11:19"
        },
        "And indeed, there must be differences among you to show which of you are approved."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "1CO 11:20"
        },
        "Now then, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "when"
          ]
        },
        " you come together, it is not ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord’s Supper you eat. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "1CO 11:21"
        },
        "For as you eat, each ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of you"
          ]
        },
        " goes ahead without sharing his meal.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "11:21 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "each one takes first his own meal."
              ]
            }
          ]
        },
        " While ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one"
          ]
        },
        " remains hungry, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "another"
          ]
        },
        " gets drunk. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "1CO 11:22"
        },
        "Don’t you have ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your own"
          ]
        },
        " homes in which to eat and drink? Or do you despise the church of God and humiliate those who have nothing? What can I say to you? Shall I praise you for this? No, I will not!"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "1CO 11:23"
        },
        "For I received from the Lord what I also passed on to you: The Lord Jesus, on the night He was betrayed, took bread, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "1CO 11:24"
        },
        "and when He had given thanks, He broke ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " and said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“This is My body, which ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " for you;",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "11:24 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "BYZ and TR "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "which is broken for you"
                  ]
                }
              ]
            },
            " do this in remembrance of Me.”"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "1CO 11:25"
        },
        "In the same way, after supper ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "He took"
          ]
        },
        " the cup, saying, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“This cup is the new covenant in My blood; do this, as often as you drink ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            ", in remembrance of Me.”"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "1CO 11:26"
        },
        "For as often as you eat this bread and drink ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        " cup, you proclaim the Lord’s death until He comes."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "1CO 11:27"
        },
        "Therefore, whoever eats the bread or drinks the cup of the Lord in an unworthy manner will be guilty of sinning against the",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "11:27 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "will be responsible for the"
              ]
            }
          ]
        },
        " body and blood of the Lord. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "1CO 11:28"
        },
        "Each one must examine himself ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "before"
          ]
        },
        " he eats of the bread and drinks of the cup. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "1CO 11:29"
        },
        "For anyone who eats and drinks without recognizing the body",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "11:29 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "the body of the Lord"
              ]
            }
          ]
        },
        " eats and drinks judgment on himself. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "1CO 11:30"
        },
        "That is why many among you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " weak and sick, and a number ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of you"
          ]
        },
        " have fallen asleep."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "1CO 11:31"
        },
        "Now if we judged ourselves ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "properly"
          ]
        },
        ", we would not come under judgment. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "32",
          "sid": "1CO 11:32"
        },
        "But when we are judged by the Lord, we are being disciplined so that we will not be condemned with the world."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "1CO 11:33"
        },
        "So, my brothers, when you come together to eat, wait for one another. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "34",
          "sid": "1CO 11:34"
        },
        "If anyone is hungry, he should eat at home, so that when you come together ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it will not result"
          ]
        },
        " in judgment. And when I come, I will give instructions about the remaining matters."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "12",
      "sid": "1CO 12"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Spiritual Gifts"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "1CO 12:1"
        },
        "Now about spiritual ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "gifts"
          ]
        },
        ", brothers, I do not want you to be uninformed. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "1CO 12:2"
        },
        "You know that when you were pagans, you were influenced ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " led astray to mute idols. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "1CO 12:3"
        },
        "Therefore I inform you that no one who is speaking by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Spirit of God says, “Jesus ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " cursed,” and no one can say, “Jesus ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " Lord,” except by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Holy Spirit."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "1CO 12:4"
        },
        "There are different gifts, but the same Spirit. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "1CO 12:5"
        },
        "There are different ministries, but the same Lord. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "1CO 12:6"
        },
        "There are different ways of working, but the same God works all things in all ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "people"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "1CO 12:7"
        },
        "Now to each one the manifestation of the Spirit is given for the common good. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "1CO 12:8"
        },
        "To one there is given through the Spirit ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " message of wisdom, to another ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " message of knowledge by the same Spirit, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "1CO 12:9"
        },
        "to another faith by the same Spirit, to another gifts of healing by that one Spirit, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "1CO 12:10"
        },
        "to another ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " working of miracles, to another prophecy, to another distinguishing between spirits, to another speaking in various tongues, and to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "still"
          ]
        },
        " another ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " interpretation of tongues. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "1CO 12:11"
        },
        "All these are the work of one and the same Spirit, who apportions ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        " to each one as He determines."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Body of Christ"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "1CO 12:12"
        },
        "The body is a unit, though it is composed of many parts. And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "although"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "its"
          ]
        },
        " parts are many, they all form one body. So ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it is"
          ]
        },
        " with Christ. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "1CO 12:13"
        },
        "For in one Spirit we were all baptized into one body, whether Jews or Greeks, slave or free, and we were all given one Spirit ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to drink"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "1CO 12:14"
        },
        "For the body does not consist of one part, but of many. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "1CO 12:15"
        },
        "If the foot should say, “Because I am not a hand, I do not belong to the body,” that would not  ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "make it any less "
          ]
        },
        " a part of the body. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "1CO 12:16"
        },
        "And if the ear should say, “Because I am not an eye, I do not belong to the body,” that would not  ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "make it any less "
          ]
        },
        " a part of the body. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "1CO 12:17"
        },
        "If the whole body ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "were"
          ]
        },
        " an eye, where ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "would"
          ]
        },
        " the sense of hearing ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        "? If ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " whole ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "body"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "were"
          ]
        },
        " an ear, where ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "would"
          ]
        },
        " the sense of smell ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        "?"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "1CO 12:18"
        },
        "But in fact, God has arranged the members of the body, every one of them, according to His design. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "1CO 12:19"
        },
        "If they were all one part, where ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "would"
          ]
        },
        " the body ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        "? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "1CO 12:20"
        },
        "As it is, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "there are"
          ]
        },
        " many parts, but one body."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "1CO 12:21"
        },
        "The eye cannot say to the hand, “I do not need you.” ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Nor can"
          ]
        },
        " the head ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "say"
          ]
        },
        " to the feet, “I do not need you.” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "1CO 12:22"
        },
        "On the contrary, the parts of the body that seem to be weaker are indispensable, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "1CO 12:23"
        },
        "and the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "parts"
          ]
        },
        " we consider less honorable, we treat with greater honor. And our unpresentable ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "parts"
          ]
        },
        " are treated with special modesty, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "1CO 12:24"
        },
        "whereas our presentable ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "parts"
          ]
        },
        " have no ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "such"
          ]
        },
        " need."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "But God has composed the body ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " has given greater honor to the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "parts"
          ]
        },
        " that lacked it, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "1CO 12:25"
        },
        "so that there should be no division in the body, but that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "its"
          ]
        },
        " members ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "should have"
          ]
        },
        " mutual concern for one another. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "1CO 12:26"
        },
        "If one part suffers, every part suffers with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        "; if one part is honored, every part rejoices with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Greater Gifts"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "1CO 12:27"
        },
        "Now you are ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " body of Christ, and each of you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " a member ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of it"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "1CO 12:28"
        },
        "And in the church God has appointed first of all apostles, second prophets, third teachers, then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "workers of"
          ]
        },
        " miracles, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "those with"
          ]
        },
        " gifts of healing, helping, administration, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " various tongues. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "1CO 12:29"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Are"
          ]
        },
        " all apostles? ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Are"
          ]
        },
        " all prophets? ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Are"
          ]
        },
        " all teachers? ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Do"
          ]
        },
        " all ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "work"
          ]
        },
        " miracles? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "1CO 12:30"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Do"
          ]
        },
        " all have gifts of healing? ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Do"
          ]
        },
        " all speak in tongues? ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Do"
          ]
        },
        " all interpret? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "1CO 12:31"
        },
        "But eagerly desire the greater gifts."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "And now I will show you the most excellent way."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "13",
      "sid": "1CO 13"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Love"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "1CO 13:1"
        },
        "If I speak in the tongues of men and of angels, but have not love, I am ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "only a"
          ]
        },
        " ringing gong or ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "a"
          ]
        },
        " clanging cymbal. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "1CO 13:2"
        },
        "If I have the gift of prophecy and can fathom all mysteries and all knowledge, and if I have absolute faith so as to move mountains, but have not love, I am nothing. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "1CO 13:3"
        },
        "If I give all I possess ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to the poor"
          ]
        },
        " and exult in the surrender of my body,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "13:3 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "SBL, NE, BYZ, and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "surrender my body to be burned"
              ]
            }
          ]
        },
        " but have not love, I gain nothing."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "1CO 13:4"
        },
        "Love is patient, love is kind. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "It"
          ]
        },
        " does not envy, it does not boast, it is not proud. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "1CO 13:5"
        },
        "It is not rude, it is not self-seeking, it is not easily angered, it keeps no account of wrongs. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "1CO 13:6"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Love"
          ]
        },
        " takes no pleasure in evil, but rejoices in the truth. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "1CO 13:7"
        },
        "It bears all things, believes all things, hopes all things, endures all things."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "1CO 13:8"
        },
        "Love never fails. But where ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "there are"
          ]
        },
        " prophecies, they will cease; where ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "there are"
          ]
        },
        " tongues, they will be restrained; where ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "there is"
          ]
        },
        " knowledge, it will be dismissed. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "1CO 13:9"
        },
        "For we know in part and we prophesy in part, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "1CO 13:10"
        },
        "but when the perfect comes, the partial passes away."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "1CO 13:11"
        },
        "When I was a child, I talked like a child, I thought like a child, I reasoned like a child. When I became a man, I set aside childish ways. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "1CO 13:12"
        },
        "Now we see but a dim reflection as in a mirror; then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "we shall see"
          ]
        },
        " face to face. Now I know in part; then I shall know fully, even as I am fully known."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "1CO 13:13"
        },
        "And now these three remain: faith, hope, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " love; but ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " greatest of these ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " love."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "14",
      "sid": "1CO 14"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Prophecy and Tongues"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "1CO 14:1"
        },
        "Earnestly pursue love and eagerly desire spiritual gifts, especially ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the gift"
          ]
        },
        " of prophecy. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "1CO 14:2"
        },
        "For he who speaks in a tongue does not speak to men, but to God. Indeed, no one understands ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "him"
          ]
        },
        "; he utters mysteries in the Spirit. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "1CO 14:3"
        },
        "But he who prophesies speaks to men ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "for their"
          ]
        },
        " edification, encouragement, and comfort. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "1CO 14:4"
        },
        "The ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one who"
          ]
        },
        " speaks in a tongue edifies himself, but the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one who"
          ]
        },
        " prophesies edifies ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " church."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "1CO 14:5"
        },
        "I wish that all of you could speak in tongues, but ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "I would"
          ]
        },
        " rather have you prophesy. He who prophesies ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " greater than ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one who"
          ]
        },
        " speaks in tongues, unless he interprets so that the church may be edified."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "1CO 14:6"
        },
        "Now, brothers, if I come to you speaking in tongues, how will I benefit you, unless I ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "bring"
          ]
        },
        " you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "some"
          ]
        },
        " revelation or knowledge or prophecy or teaching? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "1CO 14:7"
        },
        "Even in the case of lifeless instruments, such as ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " flute or harp, how will ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "anyone"
          ]
        },
        " recognize ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the tune"
          ]
        },
        " they are playing unless the notes are distinct? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "1CO 14:8"
        },
        "Again, if ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " trumpet sounds a muffled call, who will prepare for battle? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "1CO 14:9"
        },
        "So ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it is"
          ]
        },
        " with you. Unless you speak intelligible words with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " tongue, how will ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "anyone"
          ]
        },
        " know what you are saying? You will ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "just "
          ]
        },
        " be speaking into ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " air."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "1CO 14:10"
        },
        "Assuredly, there are many different languages in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " world, yet none ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of them is"
          ]
        },
        " without meaning. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "1CO 14:11"
        },
        "If, then, I do not know the meaning of someone’s language, I am a foreigner",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "14:11 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "a barbarian"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; twice in this verse"
              ]
            }
          ]
        },
        " to the speaker, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "he is"
          ]
        },
        " a foreigner to me."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "1CO 14:12"
        },
        "It is the same with you. Since you are eager to have spiritual gifts, strive to excel ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "in gifts that"
          ]
        },
        " build up the church. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "1CO 14:13"
        },
        "Therefore, the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one who"
          ]
        },
        " speaks in a tongue should pray that he may interpret. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "1CO 14:14"
        },
        "For if I pray in a tongue, my spirit prays, but my mind is unfruitful."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "1CO 14:15"
        },
        "What then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "shall I do"
          ]
        },
        "? I will pray with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "my"
          ]
        },
        " spirit, but I will also pray with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "my"
          ]
        },
        " mind. I will sing with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "my"
          ]
        },
        " spirit, but I will also sing with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "my"
          ]
        },
        " mind. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "1CO 14:16"
        },
        "Otherwise, if you speak a blessing in spirit,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "14:16 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "in the Spirit"
              ]
            }
          ]
        },
        " how ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "can"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "someone"
          ]
        },
        " who is uninstructed say “Amen” to your thanksgiving, since he does not know what you are saying? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "1CO 14:17"
        },
        "You ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "may"
          ]
        },
        " be giving thanks well enough, but the other one is not edified."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "1CO 14:18"
        },
        "I thank God that I speak in tongues more than all of you. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "1CO 14:19"
        },
        "But in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " church, I would rather speak five coherent words to instruct others than ten thousand words in a tongue."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "1CO 14:20"
        },
        "Brothers, stop thinking like children. In ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "regard to"
          ]
        },
        " evil be infants, but in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " thinking be mature. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "1CO 14:21"
        },
        "It is written in the Law:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“By strange tongues and foreign lips"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "I will speak to this people,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        {
          "type": "char",
          "marker": "add",
          "content": [
            "but"
          ]
        },
        " even then they will ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "not"
          ]
        },
        " listen to Me,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "says ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "14:21 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 28:11-12",
                  "content": [
                    "Isaiah 28:11–12"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "1CO 14:22"
        },
        "Tongues, then, are a sign, not for believers, but for unbelievers. Prophecy, however, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " for believers, not for unbelievers."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "1CO 14:23"
        },
        "So if the whole church comes together and everyone speaks in tongues, and some who are uninstructed or some unbelievers come in, will they not say that you are out of your minds? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "1CO 14:24"
        },
        "But if an unbeliever or uninstructed person comes in while everyone is prophesying, he will be convicted ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " called to account by all, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "1CO 14:25"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " the secrets of his heart will be made known. So he will fall facedown ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " worship God, proclaiming, “God is truly among you!”"
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Orderly Worship"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "1CO 14:26"
        },
        "What then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "shall we say"
          ]
        },
        ", brothers? When you come together, everyone has a psalm ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " a teaching, a revelation, a tongue, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " an interpretation. All ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of these"
          ]
        },
        " must be done to build up ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the church "
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "1CO 14:27"
        },
        "If anyone speaks in a tongue, two, or ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "at"
          ]
        },
        " most three, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "should speak"
          ]
        },
        " in turn, and someone must interpret. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "1CO 14:28"
        },
        "But if there is no interpreter, he should remain silent in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " church and speak ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "only"
          ]
        },
        " to himself and God."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "1CO 14:29"
        },
        "Two or three prophets should speak, and the others should weigh carefully ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "what is said"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "1CO 14:30"
        },
        "And if a revelation comes to someone who is seated, the first ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "speaker"
          ]
        },
        " should stop. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "1CO 14:31"
        },
        "For you can all prophesy in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "turn"
          ]
        },
        " so that everyone may be instructed and encouraged. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "32",
          "sid": "1CO 14:32"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The"
          ]
        },
        " spirits of prophets are subject to prophets. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "1CO 14:33"
        },
        "For ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "God"
          ]
        },
        " is not a God of disorder, but of peace— as in all the churches of the saints.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "14:33 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "of peace. As in all the churches of the saints: "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Thus, some translators begin the new paragraph after "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "peace"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "34",
          "sid": "1CO 14:34"
        },
        "Women are to be silent in the churches. They are not permitted to speak, but must be in submission, as the law says. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "35",
          "sid": "1CO 14:35"
        },
        "If they wish to inquire about something, they are to ask ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their"
          ]
        },
        " own husbands at home; for it is dishonorable for a woman to speak in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " church.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "14:35 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Some manuscripts place verses 34–35 after verse 40."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "36",
          "sid": "1CO 14:36"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Did"
          ]
        },
        " the word of God originate with you? Or ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " you the only ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "ones"
          ]
        },
        " it has reached? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "37",
          "sid": "1CO 14:37"
        },
        "If anyone considers ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "himself"
          ]
        },
        " a prophet or spiritual person, let him acknowledge that what I am writing you is ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord’s command. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "38",
          "sid": "1CO 14:38"
        },
        "But if anyone ignores this, he himself will be ignored.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "14:38 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "let him be ignorant"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "39",
          "sid": "1CO 14:39"
        },
        "So, my brothers, be eager to prophesy, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do"
          ]
        },
        " not forbid speaking in tongues. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "40",
          "sid": "1CO 14:40"
        },
        "But everything must be done in a proper and orderly ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "manner"
          ]
        },
        "."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "15",
      "sid": "1CO 15"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Resurrection of Christ"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "1CO 15:1"
        },
        "Now, brothers, I want to remind you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of"
          ]
        },
        " the gospel I preached to you, which you received, and in which you stand firm. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "1CO 15:2"
        },
        "By ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this gospel"
          ]
        },
        " you are saved, if you hold firmly to the word I preached to you. Otherwise, you have believed in vain."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "1CO 15:3"
        },
        "For what I received I passed on to you as of first importance: that Christ died for our sins according to the Scriptures, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "1CO 15:4"
        },
        "that He was buried, that He was raised on the third day according to the Scriptures, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "1CO 15:5"
        },
        "and that He appeared to Cephas",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "15:5 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "That is, Peter"
              ]
            }
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " then to the Twelve. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "1CO 15:6"
        },
        "After that, He appeared to more than five hundred brothers at once, most of whom are still living, though some have fallen asleep. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "1CO 15:7"
        },
        "Then He appeared to James, then to all the apostles. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "1CO 15:8"
        },
        "And last of all He appeared to me also, as to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one"
          ]
        },
        " of untimely birth."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "1CO 15:9"
        },
        "For I am the least of the apostles ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " am unworthy to be called an apostle, because I persecuted the church of God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "1CO 15:10"
        },
        "But ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "by the"
          ]
        },
        " grace of God I am what I am, and His grace to me was not in vain. No, I worked harder than all of them — yet not I, but the grace of God that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was"
          ]
        },
        " with me. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "1CO 15:11"
        },
        "Whether, then, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it was"
          ]
        },
        " I or they, this is what we preach, and this is what you believed."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Resurrection of the Dead"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "1CO 15:12"
        },
        "But if it is preached that Christ has been raised from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " dead, how ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "can"
          ]
        },
        " some of you say that there is no resurrection of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " dead? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "1CO 15:13"
        },
        "If there is no resurrection of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " dead, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "then"
          ]
        },
        " not even Christ has been raised. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "1CO 15:14"
        },
        "And if Christ has not been raised, our preaching ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " worthless, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "so is"
          ]
        },
        " your faith. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "1CO 15:15"
        },
        "In that case, we are also exposed as false witnesses about God. For we have testified about God that He raised Christ ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "from the dead"
          ]
        },
        ", ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "but"
          ]
        },
        " He did not raise ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        " if in fact ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " dead are not raised."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "1CO 15:16"
        },
        "For if ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " dead are not raised, then not even Christ has been raised. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "1CO 15:17"
        },
        "And if Christ has not been raised, your faith is futile; you are still in your sins. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "1CO 15:18"
        },
        "Then those also ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who"
          ]
        },
        " have fallen asleep in Christ have perished. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "1CO 15:19"
        },
        "If our hope in Christ ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " for this life alone, we are to be pitied more than all men."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Order of Resurrection"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "1CO 15:20"
        },
        "But Christ ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "has"
          ]
        },
        " indeed been raised from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " dead, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " firstfruits of those who have fallen asleep. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "1CO 15:21"
        },
        "For since death ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "came"
          ]
        },
        " through a man, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " resurrection of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " dead ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "comes"
          ]
        },
        " also through a man. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "1CO 15:22"
        },
        "For as in Adam all die, so in Christ all will be made alive. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "1CO 15:23"
        },
        "But each in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " own turn: Christ ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " firstfruits; then at His coming, those who belong to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "1CO 15:24"
        },
        "Then the end ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "will come"
          ]
        },
        ", when He hands over the kingdom to God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Father after He has destroyed all dominion, authority, and power. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "1CO 15:25"
        },
        "For He must reign until He has put all ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " enemies under His feet. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "1CO 15:26"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The"
          ]
        },
        " last enemy to be destroyed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " death. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "1CO 15:27"
        },
        "For “",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "God"
          ]
        },
        " has put everything under His feet.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "15:27 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "PSA 8:6",
                  "content": [
                    "Psalm 8:6"
                  ]
                }
              ]
            }
          ]
        },
        " Now when it says that everything has been put under Him, this clearly ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "does"
          ]
        },
        " not include the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "One who"
          ]
        },
        " put everything under Him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "1CO 15:28"
        },
        "And when all things have been subjected to Him, then the Son Himself will be made subject to Him who put all things ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "under"
          ]
        },
        " Him, so that God may be all in all."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "1CO 15:29"
        },
        "If ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "these things are"
          ]
        },
        " not so, what will those do who are baptized for the dead? If ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " dead are not raised at all, why are ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "people"
          ]
        },
        " baptized for them? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "1CO 15:30"
        },
        "And why ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do"
          ]
        },
        " we endanger ourselves every hour? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "1CO 15:31"
        },
        "I face death every day, brothers, as surely as I boast about you in Christ Jesus our Lord. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "32",
          "sid": "1CO 15:32"
        },
        "If I fought wild beasts in Ephesus for human ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "motives"
          ]
        },
        ", what did I gain? If ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " dead are not raised,"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Let us eat and drink,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "for tomorrow we die.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "15:32 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 22:13",
                  "content": [
                    "Isaiah 22:13"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "1CO 15:33"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Do"
          ]
        },
        " not be deceived: “Bad company corrupts good character.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "15:33 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Probably a quote from the Greek comedy "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Thais "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "by Menander"
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "34",
          "sid": "1CO 15:34"
        },
        "Sober up as you ought, and stop sinning; for some  ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of you "
          ]
        },
        " are ignorant of God. I say this to your shame."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Resurrection Body"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "35",
          "sid": "1CO 15:35"
        },
        "But someone will ask, “How ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " the dead raised? With what kind of body will they come?” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "36",
          "sid": "1CO 15:36"
        },
        "You fool! What you sow does not come to life unless it dies. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "37",
          "sid": "1CO 15:37"
        },
        "And what you sow ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " not the body that will be, but ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "just"
          ]
        },
        " a seed, perhaps of wheat or something else. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "38",
          "sid": "1CO 15:38"
        },
        "But God gives it a body as He has designed, and to each ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "kind"
          ]
        },
        " of seed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "He gives"
          ]
        },
        " its own body."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "39",
          "sid": "1CO 15:39"
        },
        "Not all flesh ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " the same: Men ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "have"
          ]
        },
        " one ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "kind of"
          ]
        },
        " flesh, animals ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "have"
          ]
        },
        " another, birds another, and fish another. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "40",
          "sid": "1CO 15:40"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "There are"
          ]
        },
        " also heavenly bodies and earthly bodies. But the splendor of the heavenly ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "bodies"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is of"
          ]
        },
        " one ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "degree"
          ]
        },
        ", and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the splendor"
          ]
        },
        " of the earthly ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "bodies"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is of"
          ]
        },
        " another. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "41",
          "sid": "1CO 15:41"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The"
          ]
        },
        " sun ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "has"
          ]
        },
        " one ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "degree of"
          ]
        },
        " splendor, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " moon another, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " stars another; and star differs from star in splendor."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "42",
          "sid": "1CO 15:42"
        },
        "So ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "will it be"
          ]
        },
        " with the resurrection of the dead: What is sown ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " perishable; it is raised imperishable. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "43",
          "sid": "1CO 15:43"
        },
        "It is sown in dishonor; it is raised in glory. It is sown in weakness; it is raised in power. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "44",
          "sid": "1CO 15:44"
        },
        "It is sown a natural body; it is raised a spiritual body. If there is a natural body, there is also a spiritual ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "body"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "45",
          "sid": "1CO 15:45"
        },
        "So it is written: “The first man Adam became a living being”;",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "15:45 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "GEN 2:7",
                  "content": [
                    "Genesis 2:7"
                  ]
                }
              ]
            }
          ]
        },
        " the last Adam a life-giving spirit."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "46",
          "sid": "1CO 15:46"
        },
        "The spiritual, however, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was"
          ]
        },
        " not first, but the natural, and then the spiritual. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "47",
          "sid": "1CO 15:47"
        },
        "The first man ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was"
          ]
        },
        " of the dust of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " earth, the second man from heaven. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "48",
          "sid": "1CO 15:48"
        },
        "As ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was"
          ]
        },
        " the earthly ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        ", so also ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " those who are of the earth; and as ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " the heavenly ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        ", so also ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " those who are of heaven. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "49",
          "sid": "1CO 15:49"
        },
        "And just as we have borne the likeness of the earthly ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        ", so also shall we bear the likeness of the heavenly ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Where, O Death, Is Your Victory?"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "HOS 13:9-14",
          "content": [
            "Hosea 13:9–14"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "50",
          "sid": "1CO 15:50"
        },
        "Now I declare ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to you"
          ]
        },
        ", brothers, that flesh and blood cannot inherit ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " kingdom of God, nor ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "does"
          ]
        },
        " the perishable inherit the imperishable."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "51",
          "sid": "1CO 15:51"
        },
        "Listen, I tell you a mystery: ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "We will"
          ]
        },
        " not all sleep, but we will all be changed — ",
        {
          "type": "verse",
          "marker": "v",
          "number": "52",
          "sid": "1CO 15:52"
        },
        "in an instant, in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " twinkling of an eye, at the last trumpet. For the trumpet will sound, the dead will be raised imperishable, and we will be changed. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "53",
          "sid": "1CO 15:53"
        },
        "For the perishable must be clothed",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "15:53 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "clothe itself"
              ]
            }
          ]
        },
        " with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " imperishable, and the mortal ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "with"
          ]
        },
        " immortality."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "54",
          "sid": "1CO 15:54"
        },
        "When the perishable has been clothed with the imperishable and the mortal ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "with"
          ]
        },
        " immortality,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "15:54 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "WH does not include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "and the mortal with immortality"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "."
              ]
            }
          ]
        },
        " then the saying that is written will come to pass: “Death has been swallowed up in victory.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "15:54 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 25:8",
                  "content": [
                    "Isaiah 25:8"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "55",
          "sid": "1CO 15:55"
        },
        "“Where, O Death, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " your victory?"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "Where, O Death, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " your sting?”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "15:55 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "HOS 13:14",
                  "content": [
                    "Hosea 13:14"
                  ]
                },
                " (see also LXX); BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "“Where, O Death, is your sting? Where, O Hades, is your victory?”"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "56",
          "sid": "1CO 15:56"
        },
        "The sting of death ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " sin, and the power of sin ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " the law. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "57",
          "sid": "1CO 15:57"
        },
        "But thanks ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " to God, who gives us the victory through our Lord Jesus Christ!"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "58",
          "sid": "1CO 15:58"
        },
        "Therefore, my beloved brothers, be steadfast ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " immovable. Always excel in the work of the Lord, because you know that your labor in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord is not in vain."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "16",
      "sid": "1CO 16"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Collection for the Saints"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "2CO 9:1-15",
          "content": [
            "2 Corinthians 9:1–15"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "1CO 16:1"
        },
        "Now about the collection for the saints, you are to do as I directed the churches of Galatia: ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "1CO 16:2"
        },
        "On the first ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "day"
          ]
        },
        " of every week, each of you should set aside a portion of his income, saving it up, so that when I come no collections will be needed. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "1CO 16:3"
        },
        "Then, on my arrival, I will send letters with those you recommend to carry your gift to Jerusalem. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "1CO 16:4"
        },
        "And if it is advisable for me to go ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "also"
          ]
        },
        ", they can travel with me."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Paul’s Travel Plans"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ROM 15:23-33",
          "content": [
            "Romans 15:23–33"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "1CO 16:5"
        },
        "After I go through Macedonia, however, I will come to you; for I will be going through Macedonia. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "1CO 16:6"
        },
        "Perhaps I will stay with you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "awhile"
          ]
        },
        ", or even spend the winter, so that you can help me ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "on my journey"
          ]
        },
        ", wherever I go. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "1CO 16:7"
        },
        "For I do not want to see you now ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "only"
          ]
        },
        " in passing; I hope to spend some time with you, if the Lord permits. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "1CO 16:8"
        },
        "But I will stay in Ephesus until Pentecost,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "16:8 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "That is, Shavuot, the late spring feast of pilgrimage to Jerusalem; it is also known as "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "the Feast of Harvest"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "(see ",
                {
                  "type": "ref",
                  "loc": "EXO 23:16",
                  "content": [
                    "Exodus 23:16"
                  ]
                },
                ") or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "the Feast of Weeks"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "(see ",
                {
                  "type": "ref",
                  "loc": "EXO 34:22",
                  "content": [
                    "Exodus 34:22"
                  ]
                },
                ")."
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "1CO 16:9"
        },
        "because a great door ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "for"
          ]
        },
        " effective ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "work"
          ]
        },
        " has opened to me, even though many oppose ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "me"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Timothy and Apollos"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "PHP 2:19-30",
          "content": [
            "Philippians 2:19–30"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "1CO 16:10"
        },
        "If Timothy comes, see to it that he has nothing to fear ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "while he is"
          ]
        },
        " with you, for he is doing the work of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord, just as I am. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "1CO 16:11"
        },
        "No one, then, should treat him with contempt. Send him ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "on his way"
          ]
        },
        " in peace so that he can return to me, for I am expecting him along with the brothers."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "1CO 16:12"
        },
        "Now about ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "our"
          ]
        },
        " brother Apollos: I strongly urged him to go to you with the brothers. He was not at all inclined to go now, but he will go when he has the opportunity."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Concluding Exhortations"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "1CO 16:13"
        },
        "Be on the alert. Stand firm in the faith. Be men of courage. Be strong. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "1CO 16:14"
        },
        "Do everything in love."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "1CO 16:15"
        },
        "You know that Stephanas ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and his"
          ]
        },
        " household were ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " first converts in Achaia, and they have devoted themselves to the service of the saints. Now I urge you, brothers, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "1CO 16:16"
        },
        "to submit to such as these, and to every fellow worker and laborer."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "1CO 16:17"
        },
        "I am glad that Stephanas, Fortunatus, and Achaicus have arrived, because they have supplied what was lacking from you. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "1CO 16:18"
        },
        "For they refreshed my spirit and yours ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as well"
          ]
        },
        ". Show your appreciation, therefore, to such men."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Signature and Final Greetings"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "COL 4:15-18",
          "content": [
            "Colossians 4:15–18"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "2TH 3:16-18",
          "content": [
            "2 Thessalonians 3:16–18"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "1CO 16:19"
        },
        "The churches in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the province of"
          ]
        },
        " Asia",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "16:19 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "in Asia"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; Asia was a Roman province in what is now western Turkey. "
              ]
            }
          ]
        },
        " send you greetings."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Aquila and Prisca",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "16:19 "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Prisca "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "is a variant of "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Priscilla"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; see ",
                {
                  "type": "ref",
                  "loc": "ACT 18:2",
                  "content": [
                    "Acts 18:2"
                  ]
                },
                "."
              ]
            }
          ]
        },
        " greet you warmly in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord, and so does the church ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that meets"
          ]
        },
        " at their house."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "1CO 16:20"
        },
        "All the brothers ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "here"
          ]
        },
        " send you greetings. Greet one another with a holy kiss."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "1CO 16:21"
        },
        "This greeting ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is in my"
          ]
        },
        " own hand — Paul."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "1CO 16:22"
        },
        "If anyone ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "does"
          ]
        },
        " not love the Lord, let him be under a curse. Come, O Lord!",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "16:22 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Greek "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Marana Tha! "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "from a transliteration of the Aramaic, an exclamation of approaching divine judgment"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "1CO 16:23"
        },
        "The grace of the Lord Jesus ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " with you."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "1CO 16:24"
        },
        "My love ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " with all of you in Christ Jesus."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Amen.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "16:24 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "SBL, WH, and NA do not include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Amen."
              ]
            }
          ]
        }
      ]
    }
  ]
}