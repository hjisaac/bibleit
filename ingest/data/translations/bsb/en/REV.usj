{
  "type": "USJ",
  "version": "3.0",
  "content": [
    {
      "type": "book",
      "marker": "id",
      "code": "REV",
      "content": [
        "Autogenerated BSB by bsb2usfm"
      ]
    },
    {
      "type": "para",
      "marker": "h",
      "content": [
        "Revelation"
      ]
    },
    {
      "type": "para",
      "marker": "toc1",
      "content": [
        "Revelation"
      ]
    },
    {
      "type": "para",
      "marker": "toc2",
      "content": [
        "Revelation"
      ]
    },
    {
      "type": "para",
      "marker": "toc3",
      "content": [
        "REV"
      ]
    },
    {
      "type": "para",
      "marker": "mt1",
      "content": [
        "Revelation"
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "1",
      "sid": "REV 1"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Prologue"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "DAN 12:1-13",
          "content": [
            "Daniel 12:1–13"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "REV 1:1"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "This is the "
          ]
        },
        " revelation of Jesus Christ, which God gave Him to show His servants what must soon",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:1 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "suddenly "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "quickly"
              ]
            }
          ]
        },
        " come to pass. He made it known by sending His angel to His servant John, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "REV 1:2"
        },
        "who testifies to everything he saw. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "This is"
          ]
        },
        " the word of God and the testimony of Jesus Christ."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "REV 1:3"
        },
        "Blessed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one who"
          ]
        },
        " reads aloud the words of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        " prophecy, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "blessed are "
          ]
        },
        " those who hear and obey what is written in it, because the time ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " near."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "John Greets the Seven Churches"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "REV 1:4"
        },
        "John,"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "To the seven churches in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the province of"
          ]
        },
        " Asia:",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:4 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "in Asia"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; Asia was a Roman province in what is now western Turkey. "
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Grace and peace to you from Him who is and was and is to come, and from the seven spirits",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:4 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "the sevenfold Spirit"
              ]
            }
          ]
        },
        " before His throne, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "REV 1:5"
        },
        "and from Jesus Christ, the faithful witness, the firstborn from the dead, and the ruler of the kings of the earth."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "To Him who loves us and has released us from our sins by His blood, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "REV 1:6"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who"
          ]
        },
        " has made us ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to be"
          ]
        },
        " a kingdom, priests to His God and Father — to Him ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " the glory and power forever ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " ever! Amen."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "REV 1:7"
        },
        "Behold, He is coming with the clouds, and every eye will see Him — even those who pierced Him. And all the tribes of the earth will mourn because of Him. So shall it be! Amen."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "REV 1:8"
        },
        "“I am the Alpha and the Omega,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:8 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "the Alpha and the Omega, the Beginning and the End"
              ]
            }
          ]
        },
        "” says ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord God, who is and was and is to come — the Almighty."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "John’s Vision on Patmos"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "REV 1:9"
        },
        "I, John, your brother and partner in the tribulation and kingdom and perseverance ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that are"
          ]
        },
        " in Jesus, was on the island of Patmos because of the word of God and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "my"
          ]
        },
        " testimony about Jesus. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "REV 1:10"
        },
        "On the Lord’s day I was in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Spirit, and I heard behind me a loud voice like a trumpet, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "REV 1:11"
        },
        "saying,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:11 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "saying, “I am the Alpha and the Omega, the First and the Last,” and, "
              ]
            }
          ]
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Write on a scroll what you see and send ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            " to the seven churches: to Ephesus, Smyrna, Pergamum, Thyatira, Sardis, Philadelphia, and Laodicea.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "REV 1:12"
        },
        "Then I turned to see the voice that was speaking with me. And having turned, I saw seven golden lampstands, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "REV 1:13"
        },
        "and among the lampstands ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was One"
          ]
        },
        " like ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Son of Man,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:13 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "one like a son of man"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; see ",
                {
                  "type": "ref",
                  "loc": "DAN 7:13",
                  "content": [
                    "Daniel 7:13"
                  ]
                },
                "."
              ]
            }
          ]
        },
        " dressed in a long robe, with a golden sash around ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " chest. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "REV 1:14"
        },
        "The hair of His head ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was"
          ]
        },
        " white like wool, as white as snow, and His eyes ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "were"
          ]
        },
        " like a blazing fire. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "REV 1:15"
        },
        "His feet ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "were"
          ]
        },
        " like polished bronze refined in a furnace, and His voice ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was"
          ]
        },
        " like ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " roar of many waters. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "REV 1:16"
        },
        "He held in His right hand seven stars, and a sharp double-edged sword came from His mouth. His face ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was"
          ]
        },
        " like the sun shining at its brightest."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "REV 1:17"
        },
        "When I saw Him, I fell at His feet like a dead ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        ". ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "But"
          ]
        },
        " He placed His right hand on me ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "Do"
              ]
            },
            " not be afraid. I am the First and the Last, ",
            {
              "type": "verse",
              "marker": "v",
              "number": "18",
              "sid": "REV 1:18"
            },
            "the Living ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "One"
              ]
            },
            ". I was dead, and behold, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "now"
              ]
            },
            " I am alive forever ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " ever! And I hold the keys of Death and of Hades."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "REV 1:19"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Therefore write down the things you have seen, the things that are, and the things that will happen after this. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "20",
              "sid": "REV 1:20"
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "This is"
              ]
            },
            " the mystery of the seven stars you saw in My right hand and of the seven golden lampstands: The seven stars are ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " angels of the seven churches, and the seven lampstands are ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " seven churches.’’"
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "2",
      "sid": "REV 2"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "To the Church in Ephesus"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ACT 19:8-12",
          "content": [
            "Acts 19:8–12"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "EPH 1:1-2",
          "content": [
            "Ephesians 1:1–2"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "REV 2:1"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            {
              "type": "char",
              "marker": "add",
              "content": [
                "“"
              ]
            },
            "To the angel of the church in Ephesus write:"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "lf",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "These ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "are"
              ]
            },
            " the words of Him who holds the seven stars in His right hand ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " walks among the seven golden lampstands."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "lf",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "REV 2:2"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "I know your deeds, your labor, and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "your"
              ]
            },
            " perseverance. ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "I know"
              ]
            },
            " that you cannot tolerate ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "those who are"
              ]
            },
            " evil, and you have tested and exposed as liars those who falsely claim to be apostles. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "3",
              "sid": "REV 2:3"
            },
            "Without growing weary, you have persevered and endured many things for the sake of My name."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "lf",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "REV 2:4"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "But I have this against you: You have abandoned your first love. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "5",
              "sid": "REV 2:5"
            },
            "Therefore, keep in mind how far you have fallen. Repent and perform the deeds ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "you did"
              ]
            },
            " at first. But if you do not repent, I will come to you and remove your lampstand from its place."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "lf",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "REV 2:6"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "But you have this ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "to your credit"
              ]
            },
            ": You hate the works of the Nicolaitans, which I also hate."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "lf",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "REV 2:7"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "He who has an ear, let him hear what the Spirit says to the churches. To the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "one who"
              ]
            },
            " overcomes, I will grant ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the right"
              ]
            },
            " to eat from the tree of life in the Paradise of God."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "To the Church in Smyrna"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "REV 2:8"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "To the angel of the church in Smyrna write:"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "lf",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "These ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "are"
              ]
            },
            " the words of the First and the Last, who died and returned to life."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "lf",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "REV 2:9"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "I know your affliction and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "your"
              ]
            },
            " poverty — though you are rich! And ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "I am aware of"
              ]
            },
            " the slander of those who falsely claim to be Jews, but ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "are in fact"
              ]
            },
            " a synagogue of Satan."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "lf",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "REV 2:10"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            {
              "type": "char",
              "marker": "add",
              "content": [
                "Do"
              ]
            },
            " not fear what you are about to suffer. Behold, the devil is about to throw ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "some"
              ]
            },
            " of you into prison to test you, and you will suffer tribulation ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "for"
              ]
            },
            " ten days. Be faithful ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "even"
              ]
            },
            " unto death, and I will give you the crown of life."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "lf",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "REV 2:11"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "He who has an ear, let him hear what the Spirit says to the churches. The ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "one who"
              ]
            },
            " overcomes will not be harmed by the second death."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "To the Church in Pergamum"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "REV 2:12"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "To the angel of the church in Pergamum write:"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "lf",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "These ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "are"
              ]
            },
            " the words of the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "One who"
              ]
            },
            " holds the sharp, double-edged sword."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "lf",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "REV 2:13"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "I know where you live, where the throne of Satan ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "sits"
              ]
            },
            ", yet you hold fast to My name. You did not deny ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "your"
              ]
            },
            " faith in Me, even in the days of My faithful witness Antipas, who was killed among you where Satan dwells."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "lf",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "REV 2:14"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "But I have a few things against you, because ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "some"
              ]
            },
            " of you hold to the teaching of Balaam, who taught Balak to place a stumbling block before the Israelites so they would eat food sacrificed to idols and commit sexual immorality. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "15",
              "sid": "REV 2:15"
            },
            "In the same way, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "some of"
              ]
            },
            " you also hold to the teaching of the Nicolaitans. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "16",
              "sid": "REV 2:16"
            },
            "Therefore repent! Otherwise I will come to you shortly and wage war against them with the sword of My mouth."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "lf",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "REV 2:17"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "He who has an ear, let him hear what the Spirit says to the churches. To ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the one"
              ]
            },
            " who overcomes, I will give the hidden manna. I will also give him a white stone inscribed ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "with"
              ]
            },
            " a new name, known only to the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "one who"
              ]
            },
            " receives ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            "."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "To the Church in Thyatira"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ACT 16:11-15",
          "content": [
            "Acts 16:11–15"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "REV 2:18"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "To ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " angel of the church in Thyatira write:"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "lf",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "These ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "are"
              ]
            },
            " the words of the Son of God, whose eyes ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "are"
              ]
            },
            " like a blazing fire and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "whose"
              ]
            },
            " feet ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "are"
              ]
            },
            " like polished bronze."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "lf",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "REV 2:19"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "I know your deeds — your love, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "your"
              ]
            },
            " faith, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "your"
              ]
            },
            " service, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "your"
              ]
            },
            " perseverance — and your latest deeds ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "are"
              ]
            },
            " greater than ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "your"
              ]
            },
            " first."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "lf",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "REV 2:20"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "But I have ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "this"
              ]
            },
            " against you: You tolerate that woman Jezebel, who calls herself a prophetess. By her teaching she misleads My servants to be sexually immoral and to eat food sacrificed to idols. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "21",
              "sid": "REV 2:21"
            },
            "Even ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "though"
              ]
            },
            " I have given her time to repent of her immorality, she is unwilling."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "lf",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "REV 2:22"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Behold, I will cast her onto a bed of sickness, and those who commit adultery with her ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "will suffer"
              ]
            },
            " great tribulation unless they repent of her deeds. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "23",
              "sid": "REV 2:23"
            },
            "Then I will strike her children dead, and all the churches will know that I am the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "One who"
              ]
            },
            " searches minds and hearts, and I will repay each of you according to your deeds."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "lf",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "REV 2:24"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "But I say to ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " rest of you in Thyatira, who ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "do"
              ]
            },
            " not hold to ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "her"
              ]
            },
            " teaching ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "have"
              ]
            },
            " not learned the so-called deep things of Satan: I will place no further burden upon you ",
            {
              "type": "verse",
              "marker": "v",
              "number": "25",
              "sid": "REV 2:25"
            },
            "than to hold fast to what you have until I come. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "26",
              "sid": "REV 2:26"
            },
            "And to the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "one who"
              ]
            },
            " overcomes and continues ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "in"
              ]
            },
            " My work until ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " end, I will give authority over the nations. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "27",
              "sid": "REV 2:27"
            },
            "He will rule them with an iron scepter ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " shatter ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "them"
              ]
            },
            " like pottery",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "2:27 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "PSA 2:9",
                      "content": [
                        "Psalm 2:9"
                      ]
                    },
                    " (see also LXX)"
                  ]
                }
              ]
            },
            " — just as I have received ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "authority"
              ]
            },
            " from My Father. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "28",
              "sid": "REV 2:28"
            },
            "And I will give him the morning star."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "lf",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "REV 2:29"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "He who has an ear, let him hear what the Spirit says to the churches.’’"
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "3",
      "sid": "REV 3"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "To the Church in Sardis"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "REV 3:1"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            {
              "type": "char",
              "marker": "add",
              "content": [
                "“"
              ]
            },
            "To the angel of the church in Sardis write:"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "lf",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "These ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "are"
              ]
            },
            " the words of the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "One who"
              ]
            },
            " holds the seven spirits",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "3:1 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "the sevenfold Spirit"
                  ]
                }
              ]
            },
            " of God and the seven stars."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "lf",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "I know your deeds; you have ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "a"
              ]
            },
            " reputation for being alive, yet you are dead. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "2",
              "sid": "REV 3:2"
            },
            "Wake up and strengthen what remains, which is about to die; for I have found your deeds incomplete in the sight of My God. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "3",
              "sid": "REV 3:3"
            },
            "Remember, then, what you have received and heard. Keep ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            " and repent. If you do not wake up, I will come like a thief, and you will not know the hour when I will come upon you."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "lf",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "REV 3:4"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "But you do have a few people in Sardis who have not soiled their garments, and because they are worthy, they will walk with Me in white. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "5",
              "sid": "REV 3:5"
            },
            "Like ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "them"
              ]
            },
            ", he who overcomes will be dressed in white. And I will never blot out",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "3:5 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "scrape off"
                  ]
                }
              ]
            },
            " his name from the Book of Life, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "but"
              ]
            },
            " I will confess his name before My Father and His angels."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "lf",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "REV 3:6"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "He who has an ear, let him hear what the Spirit says to the churches."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "To the Church in Philadelphia"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "REV 3:7"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "To ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " angel of the church in Philadelphia write:"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "lf",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "These ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "are"
              ]
            },
            " the words of the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "One who is"
              ]
            },
            " holy ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " true, who holds the key of David. What He opens no one can shut, and what He shuts no one can open.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "3:7 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "See ",
                    {
                      "type": "ref",
                      "loc": "ISA 22:22",
                      "content": [
                        "Isaiah 22:22"
                      ]
                    },
                    "."
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "lf",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "REV 3:8"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "I know your deeds. Behold, I have placed before you an open door, which no one can shut. ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "I know that"
              ]
            },
            " you have only a little strength, yet you have kept My word and have not denied My name. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "9",
              "sid": "REV 3:9"
            },
            "As for ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "those who belong"
              ]
            },
            " to the synagogue of Satan, who claim to be Jews ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "but"
              ]
            },
            " are liars instead, I will make them come and bow down at your feet, and they will know that I love you."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "lf",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "REV 3:10"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Because you have kept My command to persevere, I will also keep you from the hour of testing that is about to come upon the whole world, to test those who dwell on the earth. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "11",
              "sid": "REV 3:11"
            },
            "I am coming soon.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "3:11 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "suddenly "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "quickly"
                  ]
                }
              ]
            },
            " Hold fast to what you have, so that no one will take your crown. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "12",
              "sid": "REV 3:12"
            },
            "The ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "one who"
              ]
            },
            " overcomes I will make a pillar in the temple of My God, and he will never again leave ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            ". Upon him I will write the name of My God, and the name of the city of My God (the new Jerusalem that comes down out of heaven from My God), and My new name."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "lf",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "REV 3:13"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "He who has an ear, let him hear what the Spirit says to the churches."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "To the Church in Laodicea"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "COL 2:1-5",
          "content": [
            "Colossians 2:1–5"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "REV 3:14"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "To the angel of the church in Laodicea write:"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "lf",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "These ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "are"
              ]
            },
            " the words of the Amen, the faithful and true Witness, the Originator",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "3:14 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "Beginning "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "Ruler"
                  ]
                }
              ]
            },
            " of God’s creation."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "lf",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "REV 3:15"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "I know your deeds; you are neither cold nor hot. ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "How"
              ]
            },
            " I wish you were ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "one"
              ]
            },
            " or ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the other"
              ]
            },
            "! ",
            {
              "type": "verse",
              "marker": "v",
              "number": "16",
              "sid": "REV 3:16"
            },
            "So because you are lukewarm — neither hot nor cold — I am about to vomit you out of My mouth!"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "lf",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "REV 3:17"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "You say, ‘I am rich; I have grown wealthy and need nothing.’ ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "But"
              ]
            },
            " you do not realize that you are wretched, pitiful, poor, blind, and naked. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "18",
              "sid": "REV 3:18"
            },
            "I counsel you to buy from Me gold refined by fire so that you may become rich, white garments so that you may be clothed and your shameful nakedness not exposed, and salve to anoint your eyes so that you may see. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "19",
              "sid": "REV 3:19"
            },
            "Those I love I rebuke and discipline. Therefore be earnest and repent."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "lf",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "REV 3:20"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Behold, I stand at the door and knock. If anyone hears My voice and opens the door, I will come in and dine with him, and he with Me. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "21",
              "sid": "REV 3:21"
            },
            "To ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the one"
              ]
            },
            " who overcomes, I will grant ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the right"
              ]
            },
            " to sit with Me on My throne, just as I overcame and sat down with My Father on His throne."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "lf",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "REV 3:22"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "He who has an ear, let him hear what the Spirit says to the churches.”"
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "4",
      "sid": "REV 4"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Throne in Heaven"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "REV 4:1"
        },
        "After this I looked and saw a door standing open in heaven. And the voice I had previously heard speak to me like a trumpet was saying, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Come up here, and I will show you what must happen after these things.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "REV 4:2"
        },
        "At once I was in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Spirit, and I saw a throne standing in heaven, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "with"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "someone"
          ]
        },
        " seated on ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "REV 4:3"
        },
        "The ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "One"
          ]
        },
        " seated there looked like jasper and carnelian, and a rainbow that gleamed like an emerald encircled the throne. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "REV 4:4"
        },
        "Surrounding the throne ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "were"
          ]
        },
        " twenty-four other thrones, and on these thrones sat twenty-four elders dressed in white, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "with"
          ]
        },
        " golden crowns on their heads."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Worship of the Creator"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "REV 4:5"
        },
        "From the throne came flashes of lightning, rumblings, and peals of thunder. Before the throne burned seven torches of fire. These are the seven spirits",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "4:5 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "This is the sevenfold Spirit"
              ]
            }
          ]
        },
        " of God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "REV 4:6"
        },
        "And before the throne ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was something"
          ]
        },
        " like a sea of glass, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as clear as"
          ]
        },
        " crystal. In ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " center, around the throne, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "were"
          ]
        },
        " four living creatures, covered with eyes in front and back. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "REV 4:7"
        },
        "The first living creature ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was"
          ]
        },
        " like a lion, the second like a calf, the third had a face like a man, and the fourth ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was"
          ]
        },
        " like an eagle in flight. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "REV 4:8"
        },
        "And each ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of"
          ]
        },
        " the four living creatures had six wings ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and was"
          ]
        },
        " covered with eyes all around and within. Day and night they never stop saying:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Holy, Holy, Holy,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is the"
          ]
        },
        " Lord God Almighty,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "who was and is and is to come!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "REV 4:9"
        },
        "And whenever the living creatures give glory, honor, and thanks to the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "One"
          ]
        },
        " seated on the throne, who lives forever ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " ever, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "REV 4:10"
        },
        "the twenty-four elders fall down before the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "One"
          ]
        },
        " seated on the throne, and they worship Him who lives forever ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " ever. They cast their crowns before the throne, saying:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "REV 4:11"
        },
        "“Worthy are You, our Lord and God,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "to receive glory and honor and power,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "for You created all things;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "by Your will they exist and were created.”"
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "5",
      "sid": "REV 5"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Lamb Takes the Scroll"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "REV 5:1"
        },
        "Then I saw a scroll in the right hand of the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "One"
          ]
        },
        " seated on the throne. It had writing on both sides ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and was"
          ]
        },
        " sealed with seven seals. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "REV 5:2"
        },
        "And I saw a mighty angel proclaiming in a loud voice, “Who is worthy to break the seals and open the scroll?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "REV 5:3"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "But"
          ]
        },
        " no one in heaven ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " on earth ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " under the earth was able to open the scroll ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " look inside it. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "REV 5:4"
        },
        "And I began to weep bitterly, because no one was found worthy to open the scroll ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " look inside it."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "REV 5:5"
        },
        "Then one of the elders said to me, “",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Do"
          ]
        },
        " not weep! Behold, the Lion of the tribe of Judah, the Root of David, has triumphed to open the scroll and its seven seals.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "REV 5:6"
        },
        "Then I saw a Lamb who appeared to have been slain, standing in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " center of the throne, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "encircled by"
          ]
        },
        " the four living creatures and the elders. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The Lamb"
          ]
        },
        " had seven horns and seven eyes, which represent the seven spirits",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "5:6 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "the sevenfold Spirit"
              ]
            }
          ]
        },
        " of God sent out into all the earth. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "REV 5:7"
        },
        "And He came and took ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the scroll"
          ]
        },
        " from the right hand of the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "One"
          ]
        },
        " seated on the throne."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "REV 5:8"
        },
        "When He had taken the scroll, the four living creatures and the twenty-four elders fell down before the Lamb. Each one had a harp, and they were holding golden bowls full of incense, which are the prayers of the saints. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "REV 5:9"
        },
        "And they sang a new song:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Worthy are You to take the scroll and open its seals,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "because You were slain,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "and by Your blood You purchased for God"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "add",
          "content": [
            "those"
          ]
        },
        " from every tribe and tongue and people and nation."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "REV 5:10"
        },
        "You have made them ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to be"
          ]
        },
        " a kingdom"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and priests to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "serve "
          ]
        },
        " our God,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and they will reign upon",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "5:10 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "they will reign over"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; WH "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "they reign upon"
              ]
            }
          ]
        },
        " the earth.”"
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Lamb Exalted"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "REV 5:11"
        },
        "Then I looked, and I heard ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " voices of many angels encircling the throne, and the living creatures and the elders. And their number was myriads of myriads and thousands of thousands. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "REV 5:12"
        },
        "In a loud voice they were saying:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Worthy is the Lamb who was slain,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "to receive power and riches"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "and wisdom and strength"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and honor and glory and blessing!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "REV 5:13"
        },
        "And I heard every creature in heaven and on earth and under the earth and in the sea, and all that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " in them, saying:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“To Him who sits on the throne"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and to the Lamb"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "be praise and honor and glory and power"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "forever ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " ever!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "REV 5:14"
        },
        "And the four living creatures said, “Amen,” and the elders fell down and worshiped.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "5:14 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "TR includes "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Him who lives for ever and ever"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "6",
      "sid": "REV 6"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The First Seal: The White Horse"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "REV 6:1"
        },
        "Then I watched as the Lamb opened one of the seven seals, and I heard one of the four living creatures say in a voice like thunder, “Come!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "REV 6:2"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So"
          ]
        },
        " I looked and saw a white horse, and its rider held a bow. And he was given a crown, and he rode out to overcome and conquer."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Second Seal: War"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "REV 6:3"
        },
        "And when ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the Lamb"
          ]
        },
        " opened the second seal, I heard the second living creature say, “Come!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "REV 6:4"
        },
        "Then another horse went forth. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "It was"
          ]
        },
        " bright red, and its rider was granted permission to take away peace from the earth and to make ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "men"
          ]
        },
        " slay one another. And he was given a great sword."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Third Seal: Famine"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "REV 6:5"
        },
        "And when ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the Lamb"
          ]
        },
        " opened the third seal, I heard the third living creature say, “Come!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Then I looked and saw a black horse, and its rider held in his hand a pair of scales. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "REV 6:6"
        },
        "And I heard  ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "what sounded "
          ]
        },
        " like a voice from among the four living creatures, saying, “A quart of wheat for a denarius,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "6:6 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Greek "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "A choenix of wheat for a denarius."
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "A choenix was a Greek dry measure equivalent to 1.92 pints or 0.91 liters. A denarius was customarily a day’s wage for a laborer; see ",
                {
                  "type": "ref",
                  "loc": "MAT 20:2",
                  "content": [
                    "Matthew 20:2"
                  ]
                },
                "."
              ]
            }
          ]
        },
        " and three quarts of barley for a denarius, and do not harm the oil and wine.”"
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Fourth Seal: Death"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "REV 6:7"
        },
        "And when ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the Lamb"
          ]
        },
        " opened the fourth seal, I heard ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " voice of the fourth living creature say, “Come!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "REV 6:8"
        },
        "Then I looked and saw a pale green horse. Its rider’s name ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was"
          ]
        },
        " Death, and Hades followed close behind. And they were given authority over a fourth of the earth, to kill by sword, by famine, by plague, and by the beasts of the earth."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Fifth Seal: The Martyrs"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "REV 6:9"
        },
        "And when ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the Lamb"
          ]
        },
        " opened the fifth seal, I saw under the altar the souls of those who had been slain for the word of God and for the testimony they had upheld. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "REV 6:10"
        },
        "And they cried out in a loud voice, “How long, O Lord, holy and true, until You judge those who dwell upon the earth and avenge our blood?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "REV 6:11"
        },
        "Then each of them was given a white robe and told to rest a little while longer until the full number of their fellow servants, their brothers, were killed, just as they ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "had been killed"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Sixth Seal: Terror"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "REV 6:12"
        },
        "And I watched as ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the Lamb"
          ]
        },
        " opened the sixth seal, and there was a great earthquake, and the sun became black like sackcloth ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of goat"
          ]
        },
        " hair, and the whole moon turned blood red, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "REV 6:13"
        },
        "and the stars of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " sky fell to the earth like unripe figs dropping from a tree shaken by a great wind. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "REV 6:14"
        },
        "The sky receded like a scroll being rolled up, and every mountain and island was moved from its place."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "REV 6:15"
        },
        "Then the kings of the earth, the nobles, the commanders, the rich, the mighty, and every slave and free ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        " hid in the caves and among the rocks of the mountains. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "REV 6:16"
        },
        "And they said to the mountains and the rocks, “Fall on us and hide us",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "6:16 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "See ",
                {
                  "type": "ref",
                  "loc": "HOS 10:8",
                  "content": [
                    "Hosea 10:8"
                  ]
                },
                "."
              ]
            }
          ]
        },
        " from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " face of the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "One"
          ]
        },
        " seated on the throne, and from the wrath of the Lamb. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "REV 6:17"
        },
        "For the great day of Their",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "6:17 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "His"
              ]
            }
          ]
        },
        " wrath has come, and who is able to withstand ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        "?”"
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "7",
      "sid": "REV 7"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "144,000 Sealed"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "REV 7:1"
        },
        "After this I saw four angels standing at the four corners of the earth, holding back ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "its"
          ]
        },
        " four winds so that no wind would blow on land ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " sea ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " on any tree. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "REV 7:2"
        },
        "And I saw another angel ascending from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " east, with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " seal of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " living God. And he called out in a loud voice to the four angels who had been given ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "power"
          ]
        },
        " to harm the land and the sea: ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "REV 7:3"
        },
        "“",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Do"
          ]
        },
        " not harm the land ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " sea ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " trees until we have placed a seal on the foreheads of the servants of our God.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "REV 7:4"
        },
        "And I heard the number of those who were sealed, 144,000  from all the tribes of Israel:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "REV 7:5"
        },
        "From ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " tribe of Judah 12,000 were sealed,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " tribe of Reuben 12,000,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " tribe of Gad 12,000,"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "REV 7:6"
        },
        "from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " tribe of Asher 12,000,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " tribe of Naphtali 12,000,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " tribe of Manasseh 12,000,"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "REV 7:7"
        },
        "from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " tribe of Simeon 12,000,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " tribe of Levi 12,000,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " tribe of Issachar 12,000,"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "REV 7:8"
        },
        "from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " tribe of Zebulun 12,000,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " tribe of Joseph 12,000,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " tribe of Benjamin 12,000 ."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Praise from the Great Multitude"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "REV 7:9"
        },
        "After this I looked and saw a multitude too large to count, from every nation and tribe and people and tongue, standing before the throne and before the Lamb. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "They were"
          ]
        },
        " wearing white robes and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "holding"
          ]
        },
        " palm branches in their hands. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "REV 7:10"
        },
        "And they cried out in a loud voice:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Salvation to our God,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "who sits on the throne,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and to the Lamb!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "REV 7:11"
        },
        "And all the angels stood around the throne and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "around"
          ]
        },
        " the elders and the four living creatures. And they fell facedown before the throne and worshiped God, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "REV 7:12"
        },
        "saying, “Amen! Blessing and glory and wisdom and thanks and honor and power and strength ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " to our God forever ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " ever! Amen.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "REV 7:13"
        },
        "Then one of the elders addressed me: “These in white robes,” he asked, “who are they, and where have they come ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "from"
          ]
        },
        "?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "REV 7:14"
        },
        "“Sir,” I answered, “you know.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So"
          ]
        },
        " he replied, “These are the ones who have come out of the great tribulation; they have washed their robes and made them white in the blood of the Lamb. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "REV 7:15"
        },
        "For this reason,"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "they are before the throne of God"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and serve Him day and night in His temple;"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "and the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "One"
          ]
        },
        " seated on the throne"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "will spread His tabernacle over them."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "REV 7:16"
        },
        "‘Never again will they hunger,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and never"
          ]
        },
        " will they thirst;"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "nor ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "will"
          ]
        },
        " the sun beat down upon them,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "nor any scorching heat.’",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "7:16 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 49:10",
                  "content": [
                    "Isaiah 49:10"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "REV 7:17"
        },
        "For the Lamb in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " center of the throne"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "will be their shepherd.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "7:17 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "See ",
                {
                  "type": "ref",
                  "loc": "PSA 23:1",
                  "content": [
                    "Psalm 23:1"
                  ]
                },
                "."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "‘He will lead them to springs of living water,’",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "7:17 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 49:10",
                  "content": [
                    "Isaiah 49:10"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and ‘God will wipe away every tear from their eyes.’",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "7:17 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 25:8",
                  "content": [
                    "Isaiah 25:8"
                  ]
                }
              ]
            }
          ]
        },
        "”"
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "8",
      "sid": "REV 8"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Seventh Seal"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "REV 8:1"
        },
        "When ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the Lamb"
          ]
        },
        " opened the seventh seal, there was silence in heaven for about half an hour. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "REV 8:2"
        },
        "And I saw the seven angels who stand before God, and they were given seven trumpets."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "REV 8:3"
        },
        "Then another angel, who had a golden censer, came and stood at the altar. He was given much incense to offer, along with the prayers of all the saints, on the golden altar before the throne. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "REV 8:4"
        },
        "And the smoke of the incense, together with the prayers of the saints, rose up before God from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " hand of the angel."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "REV 8:5"
        },
        "Then the angel took the censer, filled it with fire from the altar, and hurled ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " to the earth; and there were peals of thunder, rumblings, flashes of lightning, and an earthquake."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The First Four Trumpets"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "REV 8:6"
        },
        "And the seven angels with the seven trumpets prepared to sound ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "REV 8:7"
        },
        "Then the first ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "angel"
          ]
        },
        " sounded ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " trumpet, and hail and fire mixed with blood were hurled down upon the earth. A third of the earth was burned up, along with a third of the trees and all ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " green grass."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "REV 8:8"
        },
        "Then the second angel sounded ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " trumpet, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "something"
          ]
        },
        " like a great mountain burning with fire was thrown into the sea. A third of the sea turned to blood, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "REV 8:9"
        },
        "a third of the living creatures in the sea died, and a third of the ships were destroyed."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "REV 8:10"
        },
        "Then the third angel sounded ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " trumpet, and a great star burning like a torch fell from heaven and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "landed"
          ]
        },
        " on a third of the rivers and on the springs of water. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "REV 8:11"
        },
        "The name of the star ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " Wormwood. A third of the waters turned ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "bitter"
          ]
        },
        " like wormwood oil,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "8:11 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "became wormwood"
              ]
            }
          ]
        },
        " and many people died from the bitter waters."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "REV 8:12"
        },
        "Then the fourth angel sounded ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " trumpet, and a third of the sun and moon and stars were struck. A third of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the stars"
          ]
        },
        " were darkened, a third of the day was without light, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "a third of"
          ]
        },
        " the night as well."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "REV 8:13"
        },
        "And as I observed, I heard an eagle flying overhead, calling in a loud voice, “Woe! Woe! Woe to those who dwell on the earth, because of the trumpet blasts about to be sounded by the remaining three angels!”"
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "9",
      "sid": "REV 9"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Fifth Trumpet"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "REV 9:1"
        },
        "Then the fifth angel sounded ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " trumpet, and I saw a star that had fallen from heaven to earth, and it was given the key to the pit of the Abyss. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "REV 9:2"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The star"
          ]
        },
        " opened the pit of the Abyss, and smoke rose out of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " like ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " smoke of a great furnace, and the sun and the air were darkened by the smoke from the pit."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "REV 9:3"
        },
        "And out of the smoke, locusts descended on the earth, and they were given power like ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that of"
          ]
        },
        " the scorpions of the earth. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "REV 9:4"
        },
        "They were told not to harm the grass of the earth ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " any plant ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " tree, but only those who did not have the seal of God on ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their"
          ]
        },
        " foreheads. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "REV 9:5"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The locusts"
          ]
        },
        " were not given power to kill them, but only to torment ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "for"
          ]
        },
        " five months, and their torment ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was"
          ]
        },
        " like the stinging of a scorpion. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "REV 9:6"
        },
        "In those days men will seek death and will not find it; they will long to die, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "but"
          ]
        },
        " death will escape them."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "REV 9:7"
        },
        "And the locusts looked like horses prepared for battle, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "with something"
          ]
        },
        " like crowns of gold on their heads; and their faces ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "were"
          ]
        },
        " like ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " faces of men. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "REV 9:8"
        },
        "They had hair like ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " of women, and teeth like ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "those"
          ]
        },
        " of lions. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "REV 9:9"
        },
        "They also had breastplates like breastplates of iron, and the sound of their wings ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was"
          ]
        },
        " like ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " roar of many horses ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " chariots rushing into battle. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "REV 9:10"
        },
        "They had tails with stingers like scorpions, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "which"
          ]
        },
        " had the power to injure people for five months. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "REV 9:11"
        },
        "They were ruled by a king, the angel of the Abyss. His name in Hebrew ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " Abaddon,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "9:11 "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Abaddon "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "means "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Destruction"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "."
              ]
            }
          ]
        },
        " and in Greek ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it is"
          ]
        },
        " Apollyon.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "9:11 "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Apollyon "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "means "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Destroyer"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "REV 9:12"
        },
        "The first woe has passed. Behold, two woes ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " still to follow."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Sixth Trumpet"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "REV 9:13"
        },
        "Then the sixth angel sounded ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " trumpet, and I heard a voice from the four horns of the golden altar before God ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "REV 9:14"
        },
        "saying to the sixth angel with the trumpet, “Release the four angels who are bound at the great river Euphrates.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "REV 9:15"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So"
          ]
        },
        " the four angels who had been prepared for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        " hour and day and month and year were released to kill a third of mankind. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "REV 9:16"
        },
        "And the number of mounted troops ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was"
          ]
        },
        " two hundred million; I heard their number."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "REV 9:17"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Now"
          ]
        },
        " the horses and riders in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "my"
          ]
        },
        " vision looked like this: ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The riders"
          ]
        },
        " had breastplates ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the colors of"
          ]
        },
        " fire, sapphire, and sulfur. The heads of the horses ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "were"
          ]
        },
        " like ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " heads of lions, and out of their mouths proceeded fire, smoke, and sulfur. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "REV 9:18"
        },
        "A third of mankind was killed by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " three plagues of fire, smoke, and sulfur that proceeded from their mouths. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "REV 9:19"
        },
        "For the power of the horses was in their mouths and in their tails; indeed, their tails ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "were"
          ]
        },
        " like snakes, having heads with which to inflict harm."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "REV 9:20"
        },
        "Now the rest of mankind who were not killed by these plagues still did not repent of the works of their hands. They did not stop worshiping demons and idols of gold, silver, bronze, stone, and wood, which cannot see ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " hear ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " walk. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "REV 9:21"
        },
        "Furthermore, they did not repent of their murder, sorcery, sexual immorality, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " theft."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "10",
      "sid": "REV 10"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Angel and the Small Scroll"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "EZK 3:1-15",
          "content": [
            "Ezekiel 3:1–15"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "REV 10:1"
        },
        "Then I saw another mighty angel coming down from heaven, wrapped in a cloud, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "with"
          ]
        },
        " a rainbow above his head. His face ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was"
          ]
        },
        " like the sun, and his legs ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "were"
          ]
        },
        " like pillars of fire. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "REV 10:2"
        },
        "He held in his hand a small scroll, which lay open. He placed his right foot on the sea and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " left ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "foot"
          ]
        },
        " on the land. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "REV 10:3"
        },
        "Then he cried out in a loud voice like the roar of a lion. And when he cried out, the seven thunders sounded their voices."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "REV 10:4"
        },
        "When the seven thunders had spoken, I was about to put it in writing. But I heard a voice from heaven saying, “Seal up what the seven thunders have said, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do"
          ]
        },
        " not write it ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "down"
          ]
        },
        ".”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "REV 10:5"
        },
        "Then the angel I had seen standing on the sea and on the land lifted up his right hand to heaven. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "REV 10:6"
        },
        "And he swore by Him who lives forever ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " ever, who created heaven and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "everything"
          ]
        },
        " in it, the earth and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "everything"
          ]
        },
        " in it, and the sea and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "everything"
          ]
        },
        " in it: “There will be no more delay! ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "REV 10:7"
        },
        "But in the days of the voice of the seventh angel, when he begins to sound ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " trumpet, the mystery of God will be fulfilled, just as He proclaimed to His servants the prophets.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "REV 10:8"
        },
        "Then the voice that I had heard from heaven spoke to me again, saying, “Go, take the small scroll that lies open in the hand of the angel standing on the sea and on the land.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "REV 10:9"
        },
        "And I went to the angel ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, “Give me the small scroll.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "“Take ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " and eat it,” he said. “It will make your stomach ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "bitter"
          ]
        },
        ", but in your mouth it will be as sweet as honey.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "10:9 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "See ",
                {
                  "type": "ref",
                  "loc": "NUM 5:24",
                  "content": [
                    "Numbers 5:24"
                  ]
                },
                " and Ezekiel 3:3."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "REV 10:10"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So"
          ]
        },
        " I took the small scroll from the angel’s hand and ate it, and it was as sweet as honey in my mouth. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "But"
          ]
        },
        " when I had eaten it, my stomach turned bitter."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "REV 10:11"
        },
        "And they told me, “You must prophesy again about many peoples and nations and tongues and kings.”"
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "11",
      "sid": "REV 11"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Two Witnesses"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "REV 11:1"
        },
        "Then I was given a measuring rod like a staff ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " was told, “Go and measure the temple of God and the altar, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "count the number "
          ]
        },
        " of worshipers ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "there"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "REV 11:2"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "But"
          ]
        },
        " exclude the courtyard outside the temple. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Do"
          ]
        },
        " not measure it, because it has been given ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "over"
          ]
        },
        " to the nations, and they will trample the holy city for 42 months. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "REV 11:3"
        },
        "And I will empower my two witnesses, and they will prophesy for 1,260 days, clothed in sackcloth.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "REV 11:4"
        },
        "These ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "witnesses"
          ]
        },
        " are the two olive trees and the two lampstands that stand before the Lord of the earth.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "11:4 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "See ",
                {
                  "type": "ref",
                  "loc": "ZEC 4:14",
                  "content": [
                    "Zechariah 4:14"
                  ]
                },
                "."
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "REV 11:5"
        },
        "If anyone wants to harm them, fire proceeds from their mouths and devours their enemies. In this way, anyone who wants to harm them must be killed. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "REV 11:6"
        },
        "These ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "witnesses"
          ]
        },
        " have power to shut the sky so that no rain will fall during the days of their prophecy, and power to turn the waters into blood and to strike the earth with every kind of plague as often as they wish."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Witnesses Killed and Raised"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "REV 11:7"
        },
        "When ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the two witnesses"
          ]
        },
        " have finished their testimony, the beast that comes up from the Abyss will wage war with them, and will overpower and kill them. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "REV 11:8"
        },
        "Their bodies ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "will lie"
          ]
        },
        " in the street of the great city — figuratively called Sodom and Egypt — where their Lord was also crucified. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "REV 11:9"
        },
        "For three and a half days all peoples and tribes and tongues and nations will view their bodies and will not permit ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        " to be laid in a tomb. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "REV 11:10"
        },
        "And those who dwell on the earth will gloat over them and celebrate and send one another gifts, because these two prophets had tormented ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "REV 11:11"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "But"
          ]
        },
        " after the three and a half days, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " breath of life from God entered ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the two witnesses"
          ]
        },
        ", and they stood on their feet, and great fear fell upon those who saw them. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "REV 11:12"
        },
        "And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the witnesses"
          ]
        },
        " heard a loud voice from heaven saying, “Come up here.” And they went up to heaven in a cloud ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as"
          ]
        },
        " their enemies watched them."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "REV 11:13"
        },
        "And in that hour there was a great earthquake, and a tenth of the city collapsed. Seven thousand were killed in the quake, and the rest were terrified and gave glory to the God of heaven."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "REV 11:14"
        },
        "The second woe has passed. Behold, the third woe is coming shortly."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Seventh Trumpet"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "REV 11:15"
        },
        "Then the seventh angel sounded ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " trumpet, and loud voices called out in heaven:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“The kingdom of the world"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "has become ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the kingdom"
          ]
        },
        " of our Lord"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "and of His Christ,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and He will reign forever ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " ever.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "REV 11:16"
        },
        "And the twenty-four elders who sit on their thrones before God fell on their faces and worshiped God, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "REV 11:17"
        },
        "saying:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“We give thanks to You, O Lord God Almighty,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "One who"
          ]
        },
        " is and who was,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "11:17 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "TR includes "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "and who is to come"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "because You have taken Your great power"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and have begun to reign."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "REV 11:18"
        },
        "The nations were enraged,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "11:18 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "See ",
                {
                  "type": "ref",
                  "loc": "PSA 2:1",
                  "content": [
                    "Psalm 2:1"
                  ]
                },
                "."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and Your wrath has come."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "The time ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "has come"
          ]
        },
        " to judge the dead",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "11:18 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "See ",
                {
                  "type": "ref",
                  "loc": "DAN 12:2",
                  "content": [
                    "Daniel 12:2"
                  ]
                },
                "."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and to reward Your servants the prophets,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "as well as the saints and those who fear Your name,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "add",
          "content": [
            "both"
          ]
        },
        " small and great—"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and to destroy those who destroy the earth.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "REV 11:19"
        },
        "Then the temple of God in heaven was opened, and the ark of His covenant appeared in His temple. And there were flashes of lightning, rumblings, peals of thunder, an earthquake, and a great hailstorm."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "12",
      "sid": "REV 12"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Woman and the Dragon"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "REV 12:1"
        },
        "And a great sign appeared in heaven: a woman clothed in the sun, with the moon under her feet and a crown of twelve stars on her head. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "REV 12:2"
        },
        "She was pregnant and crying out in the pain and agony of giving birth."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "REV 12:3"
        },
        "Then another sign appeared in heaven: a huge red dragon ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "with"
          ]
        },
        " seven heads, ten horns, and seven royal crowns on his heads. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "REV 12:4"
        },
        "His tail swept a third of the stars from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " sky, hurling them to the earth. And the dragon stood before the woman who was about to give birth, ready to devour her child as soon as she gave birth."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "REV 12:5"
        },
        "And she gave birth to a son, a male child, who will rule all the nations with an iron scepter.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "12:5 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "See ",
                {
                  "type": "ref",
                  "loc": "PSA 2:9",
                  "content": [
                    "Psalm 2:9"
                  ]
                },
                " (see also LXX)."
              ]
            }
          ]
        },
        " And her child was caught up to God and to His throne. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "REV 12:6"
        },
        "And the woman fled into the wilderness, where God had prepared a place for her to be nourished for 1,260 days."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The War in Heaven"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "REV 12:7"
        },
        "Then a war broke out in heaven: Michael and his angels fought against the dragon, and the dragon and his angels fought ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "back"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "REV 12:8"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "But"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the dragon"
          ]
        },
        " was not strong enough, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " no longer ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was"
          ]
        },
        " any place found in heaven for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "him and his angels"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "REV 12:9"
        },
        "And the great dragon was hurled down — that ancient serpent called ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " devil and Satan, the deceiver of the whole ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "world"
          ]
        },
        ". He was hurled to the earth, and his angels with him."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "REV 12:10"
        },
        "And I heard a loud voice in heaven saying:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Now have come the salvation and the power"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and the kingdom of our God,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and the authority of His Christ."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "For the accuser of our brothers has been thrown down —"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "he who accuses them day and night before our God."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "REV 12:11"
        },
        "They have conquered him by the blood of the Lamb"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and by the word of their testimony."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "And they did not love their lives"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "so as to shy away from death."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "REV 12:12"
        },
        "Therefore rejoice, O heavens,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you who"
          ]
        },
        " dwell in them!"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        {
          "type": "char",
          "marker": "add",
          "content": [
            "But"
          ]
        },
        " woe to the earth and the sea;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "with great fury the devil has come down to you,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "knowing he has only a short time.”"
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Woman Persecuted"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "REV 12:13"
        },
        "And when the dragon saw that he had been thrown to the earth, he pursued the woman who had given birth to the male ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "child"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "REV 12:14"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "But"
          ]
        },
        " the woman was given two wings of a great eagle to fly from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " presence of the serpent to her place in the wilderness, where she was nourished for a time, and times, and half a time."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "REV 12:15"
        },
        "Then from his mouth the serpent spewed water like a river to overtake the woman ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " sweep her away in the torrent. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "REV 12:16"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "But"
          ]
        },
        " the earth helped the woman and opened its mouth to swallow up the river that the dragon had poured from his mouth. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "REV 12:17"
        },
        "And the dragon was enraged at the woman and went to make war with the rest of her children, who keep the commandments of God and hold to the testimony of Jesus."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the dragon"
          ]
        },
        " stood on the shore of the sea.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "12:17 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "And he stood on the sand of the sea. "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "And I stood on the sand of the sea."
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Some texts number this sentence as verse 18; others include it with ",
                {
                  "type": "ref",
                  "loc": "REV 13:1",
                  "content": [
                    "Revelation 13:1"
                  ]
                },
                "."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "13",
      "sid": "REV 13"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Beast from the Sea"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "DAN 7:1-8",
          "content": [
            "Daniel 7:1–8"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "REV 13:1"
        },
        "Then I saw a beast with ten horns and seven heads rising out of the sea. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "There were"
          ]
        },
        " ten royal crowns on its horns and blasphemous names on its heads. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "REV 13:2"
        },
        "The beast I saw was like a leopard, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "with"
          ]
        },
        " the feet of a bear and the mouth of a lion. And the dragon gave ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the beast"
          ]
        },
        " his power and his throne and great authority."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "REV 13:3"
        },
        "One of the heads of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the beast"
          ]
        },
        " appeared to have been mortally wounded. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "But"
          ]
        },
        " the mortal wound was healed, and the whole world marveled ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " followed the beast. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "REV 13:4"
        },
        "They worshiped the dragon who had given authority to the beast, and they worshiped the beast, saying, “Who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " like the beast, and who can wage war against it?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "REV 13:5"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The beast"
          ]
        },
        " was given a mouth to speak arrogant and blasphemous ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "words"
          ]
        },
        ", and authority to act for 42 months. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "REV 13:6"
        },
        "And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the beast"
          ]
        },
        " opened its mouth to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "speak"
          ]
        },
        " blasphemies against God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " to slander His name and His tabernacle — those who dwell in heaven."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "REV 13:7"
        },
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the beast"
          ]
        },
        " was permitted to wage war against the saints and to conquer them, and it was given authority over every tribe and people and tongue and nation. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "REV 13:8"
        },
        "And all who dwell on the earth will worship ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the beast"
          ]
        },
        " — ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "all"
          ]
        },
        " whose names have not been written from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " foundation of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " world in the Book of Life belonging to the Lamb who was slain.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "13:8 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "written in the Book of Life belonging to the Lamb who was slain from the foundation of the world."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "REV 13:9"
        },
        "He who has an ear, let him hear:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "REV 13:10"
        },
        "“If anyone ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is destined for"
          ]
        },
        " captivity,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "into captivity he will go;"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "if anyone is to die",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "13:10 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "NE, WH, and BYZ "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "if anyone kills"
              ]
            }
          ]
        },
        " by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " sword,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " sword he must be killed.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "13:10 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "See ",
                {
                  "type": "ref",
                  "loc": "JER 15:2",
                  "content": [
                    "Jeremiah 15:2"
                  ]
                },
                "."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Here is ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "a call for"
          ]
        },
        " the perseverance and faith of the saints."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Beast from the Earth"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "REV 13:11"
        },
        "Then I saw another beast rising out of the earth. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "This beast"
          ]
        },
        " had two horns like a lamb, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "but"
          ]
        },
        " spoke like a dragon. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "REV 13:12"
        },
        "And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this beast"
          ]
        },
        " exercised all the authority of the first beast and caused the earth and those who dwell in it to worship the first beast, whose mortal wound had been healed."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "REV 13:13"
        },
        "And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the second beast"
          ]
        },
        " performed great signs, even causing fire from heaven to come down to earth in the presence of the people. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "REV 13:14"
        },
        "Because of the signs it was given to perform on behalf of the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "first"
          ]
        },
        " beast, it deceived those who dwell on the earth, telling ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        " to make an image to the beast that had been wounded by the sword and yet had lived. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "REV 13:15"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The second beast"
          ]
        },
        " was permitted to give breath to the image of the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "first"
          ]
        },
        " beast, so that the image could speak and cause all who refused to worship ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " to be killed."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Mark of the Beast"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "REV 13:16"
        },
        "And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the second beast"
          ]
        },
        " required all ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "people"
          ]
        },
        ", small and great, rich and poor, free and slave, to receive a mark on their right hand or on their forehead, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "REV 13:17"
        },
        "so that no one could buy or sell unless he had the mark — the name of the beast or the number of its name."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "REV 13:18"
        },
        "Here is ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "a call for"
          ]
        },
        " wisdom: ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Let"
          ]
        },
        " the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one who"
          ]
        },
        " has insight calculate the number of the beast, for it is ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " number of a man, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " number ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " 666 .",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "13:18 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Some manuscripts "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "616"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "14",
      "sid": "REV 14"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Lamb and the 144,000"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "REV 14:1"
        },
        "Then I looked and saw the Lamb standing on Mount Zion, and with Him 144,000  who had His name and His Father’s name written on their foreheads. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "REV 14:2"
        },
        "And I heard a sound from heaven like ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " roar of many waters and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " loud rumbling of thunder. And the sound I heard ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was"
          ]
        },
        " like harpists strumming their harps."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "REV 14:3"
        },
        "And they sang a new song before the throne and before the four living creatures and the elders. And no one could learn the song except the 144,000  who had been redeemed from the earth. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "REV 14:4"
        },
        "These are the ones who have not been defiled with women, for they are virgins. They follow the Lamb wherever He goes. They have been redeemed from among men ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as"
          ]
        },
        " firstfruits to God and to the Lamb. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "REV 14:5"
        },
        "And no lie was found in their mouths; they are blameless.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "14:5 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "TR includes "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "before the throne of God"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Three Angels and Babylon’s Fall"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "REV 14:6"
        },
        "Then I saw another angel flying overhead, with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " eternal gospel to proclaim to those who dwell on the earth — to every nation and tribe and tongue and people. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "REV 14:7"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "And"
          ]
        },
        " he said in a loud voice, “Fear God and give Him glory, because the hour of His judgment has come. Worship the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "One who"
          ]
        },
        " made the heavens and the earth and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " sea and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " springs of waters.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "REV 14:8"
        },
        "Then a second angel followed, saying, “Fallen, fallen is Babylon the great,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "14:8 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "See ",
                {
                  "type": "ref",
                  "loc": "ISA 21:9",
                  "content": [
                    "Isaiah 21:9"
                  ]
                },
                " and Revelation 18:2."
              ]
            }
          ]
        },
        " who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "has made"
          ]
        },
        " all the nations drink the wine of the passion of her immorality.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "REV 14:9"
        },
        "And a third angel followed them, calling out in a loud voice, “If anyone worships the beast and its image and receives ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "its"
          ]
        },
        " mark on his forehead or on his hand, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "REV 14:10"
        },
        "he too will drink the wine of God’s anger, poured undiluted into the cup of His wrath. And he will be tormented in fire and sulfur in the presence of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " holy angels and of the Lamb. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "REV 14:11"
        },
        "And the smoke of their torment rises forever ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " ever. Day and night ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "there is"
          ]
        },
        " no rest for those who worship the beast and its image, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "for"
          ]
        },
        " anyone who receives the mark of its name.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "REV 14:12"
        },
        "Here is ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "a call for"
          ]
        },
        " the perseverance of the saints, who keep the commandments of God and the faith of Jesus."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "REV 14:13"
        },
        "And I heard a voice from heaven telling ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "me"
          ]
        },
        " to write, “Blessed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " the dead — those who die in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord from this moment on.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "“Yes,” says the Spirit, “they will rest from their labors, for their deeds will follow them.”"
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Harvest of the Earth"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "REV 14:14"
        },
        "And I looked and saw a white cloud, and seated on the cloud ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was One"
          ]
        },
        " like ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Son of Man,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "14:14 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "one like a son of man"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; see ",
                {
                  "type": "ref",
                  "loc": "DAN 7:13",
                  "content": [
                    "Daniel 7:13"
                  ]
                },
                "."
              ]
            }
          ]
        },
        " with a golden crown on His head and a sharp sickle in His hand."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "REV 14:15"
        },
        "Then another angel came out of the temple, crying out in a loud voice to the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "One"
          ]
        },
        " seated on the cloud, “Swing Your sickle and reap, because the time has come to harvest, for the crop of the earth is ripe.” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "REV 14:16"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So"
          ]
        },
        " the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "One"
          ]
        },
        " seated on the cloud swung His sickle over the earth, and the earth was harvested."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "REV 14:17"
        },
        "Then another angel came out of the temple in heaven, and he ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "too"
          ]
        },
        " had a sharp sickle. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "REV 14:18"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Still"
          ]
        },
        " another angel, with authority over the fire, came from the altar and called out in a loud voice to the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "angel"
          ]
        },
        " with the sharp sickle, “Swing your sharp sickle and gather the clusters ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of grapes"
          ]
        },
        " from the vine of the earth, because its grapes are ripe.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "REV 14:19"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So"
          ]
        },
        " the angel swung his sickle over the earth and gathered the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "grapes"
          ]
        },
        " of the earth, and he threw ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        " into the great winepress of God’s wrath. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "REV 14:20"
        },
        "And the winepress was trodden outside the city, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " blood ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " flowed from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "rose"
          ]
        },
        " as high as the bridles of the horses for a distance of 1,600 stadia.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "14:20 "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "1,600 stadia "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "is approximately 184 miles or 296 kilometers."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "15",
      "sid": "REV 15"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Song of Moses and the Lamb"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "DEU 32:1-47",
          "content": [
            "Deuteronomy 32:1–47"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "REV 15:1"
        },
        "Then I saw another great and marvelous sign in heaven: seven angels with the seven final plagues, with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "which"
          ]
        },
        " the wrath of God is completed."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "REV 15:2"
        },
        "And I saw ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "something"
          ]
        },
        " like a sea of glass mixed with fire, beside ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "which"
          ]
        },
        " stood those who had conquered the beast and its image and the number of its name. They were holding harps from God, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "REV 15:3"
        },
        "and they sang the song of God’s servant Moses and of the Lamb:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Great and wonderful ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " Your works,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "O Lord God Almighty!"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Just and true ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " Your ways,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "O King of the nations!",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "15:3 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "SBL and WH "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "King of the ages"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "King of the saints"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "REV 15:4"
        },
        "Who will not fear ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "You"
          ]
        },
        ", O Lord,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and glorify Your name?"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "For ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "You"
          ]
        },
        " alone ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " holy."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "All nations will come and worship before You,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "for Your righteous acts have been revealed.”"
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Preparation for Judgment"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "REV 15:5"
        },
        "After this I looked, and the temple — the tabernacle of the Testimony — was opened in heaven. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "REV 15:6"
        },
        "And out of the temple came the seven angels with the seven plagues, dressed in clean ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " bright linen and girded with golden sashes around ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their"
          ]
        },
        " chests."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "REV 15:7"
        },
        "Then one of the four living creatures gave the seven angels seven golden bowls full of the wrath of God, who lives forever ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " ever. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "REV 15:8"
        },
        "And the temple was filled with smoke from the glory of God and from His power; and no one could enter the temple until the seven plagues of the seven angels were completed."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "16",
      "sid": "REV 16"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The First Six Bowls of Wrath"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "REV 16:1"
        },
        "Then I heard ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "a"
          ]
        },
        " loud voice from the temple saying to the seven angels, “Go, pour out on the earth the seven bowls of God’s wrath.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "REV 16:2"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So"
          ]
        },
        " the first ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "angel"
          ]
        },
        " went and poured out his bowl on the earth, and loathsome, malignant sores broke out on those who had the mark of the beast and worshiped its image."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "REV 16:3"
        },
        "And the second ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "angel"
          ]
        },
        " poured out his bowl into the sea, and it turned to blood like that of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " dead, and every living thing in the sea died."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "REV 16:4"
        },
        "And the third ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "angel"
          ]
        },
        " poured out his bowl into the rivers and springs of water, and they turned to blood. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "REV 16:5"
        },
        "And I heard the angel of the waters say:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Righteous are You, O Holy One,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "who is and was,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "because You have brought these judgments."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "REV 16:6"
        },
        "For they have spilled ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " blood of saints and prophets,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and You have given them blood to drink,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "as they deserve.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "REV 16:7"
        },
        "And I heard the altar reply:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Yes, Lord God Almighty,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "true and just ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " Your judgments.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "REV 16:8"
        },
        "Then the fourth ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "angel"
          ]
        },
        " poured out his bowl on the sun, and it was given power to scorch the people with fire. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "REV 16:9"
        },
        "And the people were scorched by intense heat, and they cursed the name of God, who had authority over these plagues. Yet they did not repent ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " give Him glory."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "REV 16:10"
        },
        "And the fifth ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "angel"
          ]
        },
        " poured out his bowl on the throne of the beast, and its kingdom was plunged into darkness, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "men"
          ]
        },
        " began to gnaw their tongues in anguish ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "REV 16:11"
        },
        "and curse the God of heaven for their pains and sores. Yet they did not repent of their deeds."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "REV 16:12"
        },
        "And the sixth ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "angel"
          ]
        },
        " poured out his bowl on the great river Euphrates, and its water was dried up to prepare the way for the kings of the East."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "REV 16:13"
        },
        "And I saw three unclean spirits that looked like frogs ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "coming"
          ]
        },
        " out of the mouths of the dragon, the beast, and the false prophet. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "REV 16:14"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "These"
          ]
        },
        " are demonic spirits that perform signs ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " go out to all the kings of the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "earth"
          ]
        },
        ", to assemble them for battle on the great day of God the Almighty."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "15",
              "sid": "REV 16:15"
            },
            "“Behold, I am coming like a thief. Blessed ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "one who"
              ]
            },
            " remains awake and clothed, so that he will not go naked and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "let"
              ]
            },
            " his shame be exposed.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "REV 16:16"
        },
        "And they assembled ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the kings"
          ]
        },
        " in the place that in Hebrew is called Armageddon."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Seventh Bowl of Wrath"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "REV 16:17"
        },
        "Then the seventh ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "angel"
          ]
        },
        " poured out his bowl into the air, and a loud voice came from the throne ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "in"
          ]
        },
        " the temple, saying, “It is done!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "REV 16:18"
        },
        "And there were flashes of lightning, rumblings, peals of thunder, and a great earthquake the likes of which had not occurred since men were upon the earth — so mighty ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was the"
          ]
        },
        " great quake. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "REV 16:19"
        },
        "The great city was ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "split"
          ]
        },
        " into three parts, and the cities of the nations collapsed. And God remembered Babylon the great ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " gave her the cup of the wine of the fury of His wrath."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "REV 16:20"
        },
        "Then every island fled, and no mountain could be found. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "REV 16:21"
        },
        "And great hailstones ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "weighing"
          ]
        },
        " almost a hundred pounds ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "each"
          ]
        },
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "16:21 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Greek "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "great hail as of a talent"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; that is, hailstones weighing approximately 75.4 pounds or 34.2 kilograms each"
              ]
            }
          ]
        },
        " rained down on ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        " from above. And men cursed God for the plague of hail, because ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " was so horrendous."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "17",
      "sid": "REV 17"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Woman on the Beast"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "REV 17:1"
        },
        "Then one of the seven angels with the seven bowls came and said to me, “Come, I will show you the punishment of the great prostitute, who sits on many waters. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "REV 17:2"
        },
        "The kings of the earth were immoral with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "her"
          ]
        },
        ", and those who dwell on the earth were intoxicated with the wine of her immorality.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "REV 17:3"
        },
        "And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the angel"
          ]
        },
        " carried me away in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Spirit into a wilderness, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "where"
          ]
        },
        " I saw a woman sitting on a scarlet beast that was covered with blasphemous names ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " had seven heads and ten horns. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "REV 17:4"
        },
        "The woman was dressed in purple and scarlet, and adorned with gold and precious stones and pearls. She held in her hand a golden cup full of abominations and the impurities of her sexual immorality. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "REV 17:5"
        },
        "And on her forehead a mysterious name was written:"
      ]
    },
    {
      "type": "para",
      "marker": "pc",
      "content": [
        "BABYLON THE GREAT, THE MOTHER OF PROSTITUTES AND OF THE ABOMINATIONS OF THE EARTH."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Mystery Explained"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "REV 17:6"
        },
        "I could see that the woman ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was"
          ]
        },
        " drunk with the blood of the saints and witnesses for Jesus. And I was utterly amazed at the sight of her."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "REV 17:7"
        },
        "“Why are you so amazed?” said the angel. “I will tell you the mystery of the woman and of the beast that carries her, which has the seven heads and ten horns."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "REV 17:8"
        },
        "The beast that you saw — it was, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "now"
          ]
        },
        " is no more, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "but"
          ]
        },
        " is about to come up out of the Abyss and go to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "its"
          ]
        },
        " destruction. And those who dwell on the earth whose names were not written in the Book of Life from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " foundation of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " world will marvel when they see the beast that was, and is not, and yet will be."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "REV 17:9"
        },
        "This calls for a mind with wisdom. The seven heads are seven mountains on which the woman sits. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "REV 17:10"
        },
        "There are also seven kings. Five have fallen, one is, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " the other ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "has"
          ]
        },
        " not yet come. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "But"
          ]
        },
        " when he does come, he must remain for only a little while."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "REV 17:11"
        },
        "The beast that was, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "now"
          ]
        },
        " is not, is an eighth ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "king"
          ]
        },
        ", who belongs to the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "other"
          ]
        },
        " seven and is going into destruction. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "REV 17:12"
        },
        "The ten horns you saw are ten kings who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "have"
          ]
        },
        " not yet received a kingdom, but will receive one hour of authority as kings along with the beast. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "REV 17:13"
        },
        "These ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "kings"
          ]
        },
        " have one purpose: to yield their power and authority to the beast."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Victory of the Lamb"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "REV 17:14"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "They"
          ]
        },
        " will make war against the Lamb, and the Lamb will triumph over them, because He is Lord of lords and King of kings; and He will be accompanied by His called and chosen and faithful ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "ones"
          ]
        },
        ".”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "REV 17:15"
        },
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the angel"
          ]
        },
        " said to me, “The waters you saw, where the prostitute was seated, are peoples and multitudes and nations and tongues. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "REV 17:16"
        },
        "And the ten horns and the beast that you saw will hate the prostitute. They will leave her desolate and naked, and they will eat her flesh and burn her with fire. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "REV 17:17"
        },
        "For God has put it into their hearts to carry out His purpose by uniting to give their kingdom to the beast, until the words of God are fulfilled. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "REV 17:18"
        },
        "And the woman you saw is the great city that rules over the kings of the earth.”"
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "18",
      "sid": "REV 18"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Babylon Is Fallen"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ISA 21:1-10",
          "content": [
            "Isaiah 21:1–10"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "REV 18:1"
        },
        "After this I saw another angel descending from heaven with great authority, and the earth was illuminated by his glory. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "REV 18:2"
        },
        "And he cried out in a mighty voice:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Fallen, fallen is Babylon the great!",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "18:2 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "See ",
                {
                  "type": "ref",
                  "loc": "ISA 21:9",
                  "content": [
                    "Isaiah 21:9"
                  ]
                },
                " and Revelation 14:8."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "She has become a lair for demons"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "and a haunt for every unclean spirit,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "every unclean bird,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and every detestable beast.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "18:2 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "NE, WH, BYZ, and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "a haunt for every unclean spirit and every unclean and detestable bird."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "REV 18:3"
        },
        "All the nations have drunk",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "18:3 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "SBL and WH "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "have fallen by"
              ]
            }
          ]
        },
        " the wine"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "of the passion of her immorality."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "The kings of the earth were immoral with her,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and the merchants of the earth have grown wealthy"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "from the extravagance of her luxury.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "REV 18:4"
        },
        "Then I heard another voice from heaven say:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Come out of her, My people,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "18:4 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "See ",
                {
                  "type": "ref",
                  "loc": "JER 51:45",
                  "content": [
                    "Jeremiah 51:45"
                  ]
                },
                "."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "so that you will not share in her sins"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " contract ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "any"
          ]
        },
        " of her plagues."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "REV 18:5"
        },
        "For her sins are piled up to heaven,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and God has remembered her iniquities."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "REV 18:6"
        },
        "Give back to her as she has done ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to others"
          ]
        },
        ";"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "pay her back double for what she has done;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "mix her a double ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "portion"
          ]
        },
        " in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "her own"
          ]
        },
        " cup."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "REV 18:7"
        },
        "As much as she has glorified herself and lived in luxury,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "give her the same measure of torment and grief."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "In her heart she says, ‘I sit ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as"
          ]
        },
        " queen;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "I am not a widow and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "will"
          ]
        },
        " never see grief.’"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "REV 18:8"
        },
        "Therefore her plagues will come in one day —"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "death and grief and famine —"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "and she will be consumed by fire,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "for mighty ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is the"
          ]
        },
        " Lord God who judges her.”"
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Lament over Babylon"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "REV 18:9"
        },
        "Then the kings of the earth who committed sexual immorality and lived in luxury with her will weep and wail at the sight of the smoke ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "rising"
          ]
        },
        " from the fire that consumes her.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "18:9 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "when they see the smoke of her burning"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; also in verse 18"
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "REV 18:10"
        },
        "In fear of her torment, they will stand at a distance ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " cry out:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Woe, woe to the great city,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "the mighty city of Babylon!"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "For ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "in"
          ]
        },
        " a single hour"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "your judgment has come.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "REV 18:11"
        },
        "And the merchants of the earth will weep and mourn over her, because ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "there is"
          ]
        },
        " no one left to buy their cargo — ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "REV 18:12"
        },
        "cargo of gold, silver, precious stones, and pearls; ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of"
          ]
        },
        " fine linen, purple, silk, and scarlet; of all kinds of citron wood and every article of ivory, precious wood, bronze, iron, and marble; ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "REV 18:13"
        },
        "of cinnamon, spice, incense, myrrh, and frankincense; of wine, olive oil, fine flour, and wheat; of cattle, sheep, horses, and carriages; of bodies and souls of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "slaves"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "REV 18:14"
        },
        "And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "they will say"
          ]
        },
        ":",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "18:14 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "And:"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“The fruit of your soul’s desire"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "has departed from you;"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "all ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " luxury and splendor have vanished,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "never to be ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "seen"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "again"
          ]
        },
        ".”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "REV 18:15"
        },
        "The merchants who sold these things ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " gained their wealth from her will stand at a distance, in fear of her torment. They will weep and mourn, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "REV 18:16"
        },
        "saying:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Woe, woe to the great city,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "clothed in fine linen and purple and scarlet,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "adorned with gold and precious stones and pearls!"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "REV 18:17"
        },
        "For ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "in"
          ]
        },
        " a single hour"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "such fabulous wealth has been destroyed!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Every shipmaster, passenger, and sailor, and all who make their living from the sea, will stand at a distance ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "REV 18:18"
        },
        "and cry out at the sight of the smoke ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "rising"
          ]
        },
        " from the fire that consumes her. “What ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "city was ever"
          ]
        },
        " like ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        " great city?” they will exclaim."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "REV 18:19"
        },
        "Then they will throw dust on their heads as they weep and mourn and cry out:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Woe, woe to the great city,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "add",
          "content": [
            "where"
          ]
        },
        " all who had ships on the sea"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "were enriched by her wealth!"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "For in a single hour"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "she has been destroyed.”"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "REV 18:20"
        },
        "Rejoice over her, O heaven,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        " saints and apostles and prophets,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "because God has pronounced for you"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " judgment against her."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Doom of Babylon"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "REV 18:21"
        },
        "Then a mighty angel picked up a stone the size of a great millstone and cast ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " into the sea, saying:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“With such violence"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "the great city of Babylon will be cast down,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "never to be ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "seen"
          ]
        },
        " again."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "REV 18:22"
        },
        "And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " sound of harpists and musicians,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "of flute players and trumpeters,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "will never ring out in you again."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Nor will"
          ]
        },
        " any craftsmen of any trade"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "be ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "found"
          ]
        },
        " in you again,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        {
          "type": "char",
          "marker": "add",
          "content": [
            "nor"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " sound of a millstone"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "be heard in you again."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "REV 18:23"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The"
          ]
        },
        " light of a lamp"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "will never shine in you again,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " voices of a bride and bridegroom"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "will never call out in you again."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "For your merchants were the great ones of the earth,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "because all the nations were deceived by your sorcery.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "REV 18:24"
        },
        "And there was found in her ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " blood of prophets and saints, and of all who had been slain on the earth."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "19",
      "sid": "REV 19"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Rejoicing in Heaven"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "REV 19:1"
        },
        "After this I heard ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "a sound"
          ]
        },
        " like ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " roar of a great multitude in heaven, shouting:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Hallelujah!",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "19:1 "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Hallelujah "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "is a transliteration of the Hebrew "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Hallelu YAH"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                ", meaning "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Praise the LORD"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; also in verses 3, 4, and 6."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Salvation and glory and power belong to our God!"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "REV 19:2"
        },
        "For His judgments ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " true and just."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "He has judged the great prostitute"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "who corrupted the earth with her immorality."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "He has avenged the blood of His servants"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that was poured "
          ]
        },
        " out by her hand.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "REV 19:3"
        },
        "And a second time they called out:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Hallelujah!"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Her smoke rises forever ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " ever.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "REV 19:4"
        },
        "And the twenty-four elders and the four living creatures fell down and worshiped God who sits on the throne, saying:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Amen, Hallelujah!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "REV 19:5"
        },
        "Then a voice came from the throne, saying:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Praise our God,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "all ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        " who serve Him,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "and those who fear Him,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "small and great ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "alike"
          ]
        },
        "!”"
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Marriage of the Lamb"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "REV 19:6"
        },
        "And I heard ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "a sound"
          ]
        },
        " like ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " roar of a great multitude, like ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " rushing of many waters, and like a mighty rumbling of thunder, crying out:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Hallelujah!"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "For the Lord our God",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "19:6 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "SBL, BYZ, and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "the Lord God"
              ]
            }
          ]
        },
        " the Almighty reigns."
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "REV 19:7"
        },
        "Let us rejoice and be glad"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and give Him the glory."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "For the marriage of the Lamb has come,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and His bride has made herself ready."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "REV 19:8"
        },
        "She was given clothing of fine linen,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "bright ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " pure.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "For the fine linen ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "she wears "
          ]
        },
        " is the righteous acts of the saints."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "REV 19:9"
        },
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the angel"
          ]
        },
        " told me to write, “Blessed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " those who are invited to the marriage supper of the Lamb.” And he said to me, “These are the true words of God.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "REV 19:10"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So"
          ]
        },
        " I fell at his feet to worship him. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "But"
          ]
        },
        " he told me, “Do not do that! I am a fellow servant with you and your brothers who rely on the testimony of Jesus. Worship God! For the testimony of Jesus is the spirit of prophecy.”"
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Rider on the White Horse"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "REV 19:11"
        },
        "Then I saw heaven standing open, and there before me was a white horse. And its rider is called Faithful and True. With righteousness He judges and wages war. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "REV 19:12"
        },
        "He ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "has"
          ]
        },
        " eyes like blazing fire, and many royal crowns on His head. He has a name written ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "on Him"
          ]
        },
        " that only He Himself knows. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "REV 19:13"
        },
        "He is dressed in a robe dipped in blood,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "19:13 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "WH "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "sprinkled with blood"
              ]
            }
          ]
        },
        " and His name is The Word of God."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "REV 19:14"
        },
        "The armies of heaven, dressed in fine linen, white ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " pure, follow Him on white horses. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "REV 19:15"
        },
        "And from His mouth proceeds a sharp sword with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "which"
          ]
        },
        " to strike down the nations, and He will rule them with an iron scepter.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "19:15 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "See ",
                {
                  "type": "ref",
                  "loc": "PSA 2:9",
                  "content": [
                    "Psalm 2:9"
                  ]
                },
                " (see also LXX)."
              ]
            }
          ]
        },
        " He treads the winepress of the fury of the wrath of God the Almighty. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "REV 19:16"
        },
        "And He has a name written on ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " robe and on His thigh:"
      ]
    },
    {
      "type": "para",
      "marker": "pc",
      "content": [
        "KING OF KINGS AND LORD OF LORDS."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Defeat of the Beast and False Prophet"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "REV 19:17"
        },
        "Then I saw an angel standing in the sun, and he cried out in a loud voice to all the birds flying overhead, “Come, gather together for the great supper of God, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "REV 19:18"
        },
        "so that you may eat ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " flesh of kings and commanders and mighty ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "men"
          ]
        },
        ", of horses and riders, of everyone slave and free, small and great.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "REV 19:19"
        },
        "Then I saw the beast and the kings of the earth ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "with"
          ]
        },
        " their armies assembled to wage war against the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "One"
          ]
        },
        " seated on the horse, and against His army. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "REV 19:20"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "But"
          ]
        },
        " the beast was captured along with the false prophet, who on its behalf had performed signs deceiving those who had the mark of the beast and worshiped its image. Both ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the beast and the false prophet"
          ]
        },
        " were thrown alive into the fiery lake of burning sulfur. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "REV 19:21"
        },
        "And the rest were killed with the sword that proceeded from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " mouth of the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "One"
          ]
        },
        " seated on the horse."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "And all the birds gorged themselves on their flesh."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "20",
      "sid": "REV 20"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Satan Bound"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "REV 20:1"
        },
        "Then I saw an angel coming down from heaven with the key to the Abyss, holding in his hand a great chain. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "REV 20:2"
        },
        "He seized the dragon, that ancient serpent who is ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " devil and Satan, and bound him for a thousand years. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "REV 20:3"
        },
        "And he threw him into the Abyss, shut ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        ", and sealed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " over him, so that he could not deceive the nations until the thousand years were complete. After that, he must be released for a brief period of time."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "REV 20:4"
        },
        "Then I saw ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " thrones, and those seated on them had been given authority to judge. And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "I saw"
          ]
        },
        " the souls of those who had been beheaded for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their"
          ]
        },
        " testimony of Jesus and for the word of God, and those who had not worshiped the beast ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " its image and had not received ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "its"
          ]
        },
        " mark on ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their"
          ]
        },
        " foreheads ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " hands. And they came to life and reigned with Christ for a thousand years."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "REV 20:5"
        },
        "The rest of the dead ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "did"
          ]
        },
        " not come back to life until the thousand years were complete. This ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " the first resurrection. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "REV 20:6"
        },
        "Blessed and holy ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " those who share in the first resurrection! ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The"
          ]
        },
        " second death has no power over them, but they will be priests of God and of Christ and will reign with Him for a thousand years."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Satan Cast into the Lake of Fire"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "REV 20:7"
        },
        "When the thousand years are complete, Satan will be released from his prison, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "REV 20:8"
        },
        "and will go out to deceive the nations in the four corners of the earth — Gog and Magog — to assemble them for battle. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Their"
          ]
        },
        " number ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " like the sand of the seashore."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "REV 20:9"
        },
        "And they marched across the broad expanse of the earth and surrounded the camp of the saints and the beloved city. But fire came down from heaven",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "20:9 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "came down from God out of heaven"
              ]
            }
          ]
        },
        " and consumed them. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "REV 20:10"
        },
        "And the devil who had deceived them was thrown into the lake of fire and sulfur, into which the beast and the false prophet ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "had already been thrown"
          ]
        },
        ". ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "There"
          ]
        },
        " they will be tormented day and night forever ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " ever."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Judgment before the Great White Throne"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "REV 20:11"
        },
        "Then I saw a great white throne and the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "One"
          ]
        },
        " seated on it. Earth and heaven fled from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " presence, and no place was found for them. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "REV 20:12"
        },
        "And I saw the dead, great and small, standing before the throne."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "And books were opened, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " one of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was"
          ]
        },
        " the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Book"
          ]
        },
        " of Life. And the dead were judged according to their deeds, as recorded in the books. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "REV 20:13"
        },
        "The sea gave up its dead, and Death and Hades gave up ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their"
          ]
        },
        " dead, and each ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one"
          ]
        },
        " was judged according to his deeds."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "REV 20:14"
        },
        "Then Death and Hades were thrown into the lake of fire. This is the second death — the lake of fire. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "REV 20:15"
        },
        "And if anyone was found ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "whose name"
          ]
        },
        " was not written in the Book of Life, he was thrown into the lake of fire."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "21",
      "sid": "REV 21"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "A New Heaven and a New Earth"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ISA 65:17-25",
          "content": [
            "Isaiah 65:17–25"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "REV 21:1"
        },
        "Then I saw a new heaven and a new earth,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "21:1 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "See ",
                {
                  "type": "ref",
                  "loc": "ISA 65:17",
                  "content": [
                    "Isaiah 65:17"
                  ]
                },
                " and Isaiah 66:22 (see also LXX)."
              ]
            }
          ]
        },
        " for the first heaven and earth had passed away, and the sea was no more. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "REV 21:2"
        },
        "I saw the holy city, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " new Jerusalem, coming down out of heaven from God, prepared as a bride adorned for her husband."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "REV 21:3"
        },
        "And I heard a loud voice from the throne saying:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Behold, the dwelling place of God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " with man,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and He will dwell with them."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "They will be His people,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and God Himself will be with them ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as"
          ]
        },
        " their God.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "21:3 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "SBL, NE, WH, and BYZ "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "God Himself will be with them."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "REV 21:4"
        },
        "‘He will wipe away every tear from their eyes,’",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "21:4 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 25:8",
                  "content": [
                    "Isaiah 25:8"
                  ]
                },
                "."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and there will be no more death"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " mourning ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " crying ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " pain,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "for the former things have passed away.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "REV 21:5"
        },
        "And the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "One"
          ]
        },
        " seated on the throne said, “Behold, I make all things new.” Then He said, “Write this down, for these words are faithful and true.” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "REV 21:6"
        },
        "And He told me, “It is done! I am the Alpha and the Omega, the Beginning and the End. To the thirsty I will give freely from the spring of the water of life. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "REV 21:7"
        },
        "The ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one who"
          ]
        },
        " overcomes will inherit all things, and I will be his God, and he will be My son."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "REV 21:8"
        },
        "But to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " cowardly and unbelieving and abominable and murderers and sexually immoral and sorcerers and idolaters and all liars, their place ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "will be"
          ]
        },
        " in the lake that burns with fire and sulfur. This is the second death.”"
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The New Jerusalem"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "REV 21:9"
        },
        "Then one of the seven angels with the seven bowls full of the seven final plagues came and said to me, “Come, I will show you the bride, the wife of the Lamb.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "REV 21:10"
        },
        "And he carried me away in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Spirit to a mountain great and high, and showed me the holy city ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of"
          ]
        },
        " Jerusalem coming down out of heaven from God, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "REV 21:11"
        },
        "shining with the glory of God. Its radiance ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was"
          ]
        },
        " like a most precious jewel, like a jasper, as clear as crystal. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "REV 21:12"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The city"
          ]
        },
        " had a great and high wall with twelve gates inscribed with the names of the twelve tribes of Israel, and twelve angels at the gates. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "REV 21:13"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "There were"
          ]
        },
        " three gates on ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " east, three on ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " north, three on ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " south, and three on ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " west. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "REV 21:14"
        },
        "The wall of the city had twelve foundations ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "bearing"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " names of the twelve apostles of the Lamb."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "REV 21:15"
        },
        "The ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "angel who"
          ]
        },
        " spoke with me had a golden measuring rod to measure the city and its gates and walls. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "REV 21:16"
        },
        "The city lies foursquare, with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "its"
          ]
        },
        " width the same as its length. And he measured the city with the rod, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and all its dimensions "
          ]
        },
        " were equal — 12,000 stadia",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "21:16 "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "12,000 stadia "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "is approximately 1,380 miles or 2,220 kilometers."
              ]
            }
          ]
        },
        " in length and width and height. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "REV 21:17"
        },
        "And he measured its wall ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to be"
          ]
        },
        " 144 cubits,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "21:17 "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "144 cubits "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "is approximately 216 feet or 65.8 meters. The measure could indicate either height or thickness."
              ]
            }
          ]
        },
        " by the human measure the angel was ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "using"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "REV 21:18"
        },
        "The wall was made of jasper, and the city ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "itself"
          ]
        },
        " of pure gold, as pure as glass. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "REV 21:19"
        },
        "The foundations of the city walls were adorned with every kind of precious stone:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "li1",
      "content": [
        "The first foundation ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was"
          ]
        },
        " jasper,"
      ]
    },
    {
      "type": "para",
      "marker": "li1",
      "content": [
        "the second sapphire,"
      ]
    },
    {
      "type": "para",
      "marker": "li1",
      "content": [
        "the third chalcedony,"
      ]
    },
    {
      "type": "para",
      "marker": "li1",
      "content": [
        "the fourth emerald,"
      ]
    },
    {
      "type": "para",
      "marker": "li1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "REV 21:20"
        },
        "the fifth sardonyx,"
      ]
    },
    {
      "type": "para",
      "marker": "li1",
      "content": [
        "the sixth carnelian,"
      ]
    },
    {
      "type": "para",
      "marker": "li1",
      "content": [
        "the seventh chrysolite,"
      ]
    },
    {
      "type": "para",
      "marker": "li1",
      "content": [
        "the eighth beryl,"
      ]
    },
    {
      "type": "para",
      "marker": "li1",
      "content": [
        "the ninth topaz,"
      ]
    },
    {
      "type": "para",
      "marker": "li1",
      "content": [
        "the tenth chrysoprase,"
      ]
    },
    {
      "type": "para",
      "marker": "li1",
      "content": [
        "the eleventh jacinth,"
      ]
    },
    {
      "type": "para",
      "marker": "li1",
      "content": [
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " the twelfth amethyst."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "REV 21:21"
        },
        "And the twelve gates ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "were"
          ]
        },
        " twelve pearls, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "with"
          ]
        },
        " each gate consisting of a single pearl. The main street of the city ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was"
          ]
        },
        " pure gold, as clear as glass."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "REV 21:22"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "But"
          ]
        },
        " I saw no temple in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the city"
          ]
        },
        ", because the Lord God Almighty and the Lamb are its temple. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "REV 21:23"
        },
        "And the city has no need of sun ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " moon to shine on it, because the glory of God illuminates ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the city"
          ]
        },
        ", and the Lamb ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " its lamp. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "REV 21:24"
        },
        "By its light the nations will walk, and into it the kings of the earth will bring their glory.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "21:24 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "and honor"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "."
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "REV 21:25"
        },
        "Its gates will never be shut at the end of the day, because there will be no night there."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "REV 21:26"
        },
        "And into ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the city"
          ]
        },
        " will be brought the glory and honor of the nations. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "REV 21:27"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "But"
          ]
        },
        " nothing unclean will ever enter it, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "nor"
          ]
        },
        " anyone who practices an abomination ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " a lie, but only those whose ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "names"
          ]
        },
        " are written in the Lamb’s Book of Life."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "22",
      "sid": "REV 22"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The River of Life"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "REV 22:1"
        },
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the angel"
          ]
        },
        " showed me a river of the water of life, as clear as crystal, flowing from the throne of God and of the Lamb ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "REV 22:2"
        },
        "down the middle of the main street of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the city"
          ]
        },
        ". On either side of the river stood a tree of life, bearing twelve kinds of fruit ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " yielding ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "a fresh"
          ]
        },
        " crop for each month. And the leaves of the tree ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " healing of the nations."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "REV 22:3"
        },
        "No longer will there be any curse. The throne of God and of the Lamb will be within ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the city"
          ]
        },
        ", and His servants will worship Him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "REV 22:4"
        },
        "They will see His face, and His name ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "will be"
          ]
        },
        " on their foreheads. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "REV 22:5"
        },
        "There will be no more night ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "in the city"
          ]
        },
        ", and they will have no need for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " light of a lamp ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " sun. For ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord God will shine on them, and they will reign forever ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " ever."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Is Coming"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "REV 22:6"
        },
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the angel"
          ]
        },
        " said to me, “These words ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " faithful and true. The Lord, the God of the spirits of the prophets, has sent His angel to show His servants what must soon",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "22:6 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "suddenly "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "quickly"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; similarly in verses 7, 12, and 20"
              ]
            }
          ]
        },
        " take place.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "7",
              "sid": "REV 22:7"
            },
            "“Behold, I am coming soon. Blessed ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "one who"
              ]
            },
            " keeps the words of prophecy in this book.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "22:7 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "scroll"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "; also in verses 9, 10, 18, 19"
                  ]
                }
              ]
            },
            "”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "REV 22:8"
        },
        "And I, John, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "am"
          ]
        },
        " the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one who"
          ]
        },
        " heard and saw these things. And when I had heard and seen ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        ", I fell down to worship at the feet of the angel who had shown me these things. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "REV 22:9"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "But"
          ]
        },
        " he said to me, “Do not do that! I am a fellow servant with you and your brothers the prophets, and with those who keep the words of this book. Worship God!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "REV 22:10"
        },
        "Then he told me, “Do not seal up the words of prophecy in this book, because the time is near. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "REV 22:11"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Let"
          ]
        },
        " the unrighteous continue to be unrighteous, and the vile continue to be vile; ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "let"
          ]
        },
        " the righteous continue to practice righteousness, and the holy continue to be holy.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "12",
              "sid": "REV 22:12"
            },
            "“Behold, I am coming soon, and My reward ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " with Me, to give to each one according to what he has done. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "13",
              "sid": "REV 22:13"
            },
            "I ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "am"
              ]
            },
            " the Alpha and the Omega, the First and the Last, the Beginning and the End.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "REV 22:14"
        },
        "Blessed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " those who wash their robes,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "22:14 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Blessed are those who do His commandments"
              ]
            }
          ]
        },
        " so that they may have the right to the tree of life and may enter the city by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "its"
          ]
        },
        " gates. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "REV 22:15"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "But"
          ]
        },
        " outside ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " the dogs, the sorcerers, the sexually immoral, the murderers, the idolaters, and everyone who loves and practices falsehood."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "16",
              "sid": "REV 22:16"
            },
            "“I, Jesus, have sent My angel to give you this testimony for the churches. I am the Root and the Offspring of David, the bright Morning Star.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "REV 22:17"
        },
        "The Spirit and the bride say, “Come!” ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Let"
          ]
        },
        " the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one who"
          ]
        },
        " hears say, “Come!” And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "let"
          ]
        },
        " the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one who"
          ]
        },
        " is thirsty come, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one who"
          ]
        },
        " desires ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " water of life ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "drink"
          ]
        },
        " freely."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Nothing May Be Added or Removed"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "REV 22:18"
        },
        "I testify to everyone who hears the words of prophecy in this book: If anyone adds to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        ", God will add to him the plagues described in this book. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "REV 22:19"
        },
        "And if anyone takes away from the words of this book of prophecy, God will take away his share in the tree of life and the holy city, which ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " described in this book."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "REV 22:20"
        },
        "He who testifies to these things says, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Yes, I am coming soon.”"
          ]
        },
        " Amen. Come, Lord Jesus!"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "REV 22:21"
        },
        "The grace of the Lord Jesus",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "22:21 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "WH and BYZ "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "the Lord Jesus Christ"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "our Lord Jesus Christ"
              ]
            }
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " with all the saints.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "22:21 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "SBL, WH, NE, and TR do not include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "the saints"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Amen.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "22:21 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "SBL, WH, NE, and NA do not include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Amen."
              ]
            }
          ]
        }
      ]
    }
  ]
}