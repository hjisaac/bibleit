      "content": [
        "Titus"
      ]
    },
    {
      "type": "para",
      "marker": "toc3",
      "content": [
        "TIT"
      ]
    },
    {
      "type": "para",
      "marker": "mt1",
      "content": [
        "Titus"
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "1",
      "sid": "TIT 1"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Paul’s Greeting to Titus"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "2CO 8:16-24",
          "content": [
            "2 Corinthians 8:16–24"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "TIT 1:1"
        },
        "Paul, a servant of God and an apostle of Jesus Christ for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " faith of God’s elect and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their"
          ]
        },
        " knowledge of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " truth that leads to godliness, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "TIT 1:2"
        },
        "in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " hope of eternal life, which God, who cannot lie, promised before time began.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:2 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "before times eternal"
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "TIT 1:3"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "In His"
          ]
        },
        " own time He has made His word ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "evident"
          ]
        },
        " in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " proclamation entrusted to me by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " command of God our Savior."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "TIT 1:4"
        },
        "To Titus, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "my"
          ]
        },
        " true child in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "our"
          ]
        },
        " common faith:"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Grace and peace from God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Father and Christ Jesus our Savior."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Appointing Elders on Crete"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "1TI 3:1-7",
          "content": [
            "1 Timothy 3:1–7"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "1PE 5:1-4",
          "content": [
            "1 Peter 5:1–4"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "TIT 1:5"
        },
        "The reason I left you in Crete ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was"
          ]
        },
        " that you would set in order what was unfinished and appoint elders in every town, as I directed you. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "TIT 1:6"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "An elder must"
          ]
        },
        " be blameless, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " husband of but one wife,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:6 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "faithful to his wife"
              ]
            }
          ]
        },
        " having children who are believers ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and who are"
          ]
        },
        " not open to accusation of indiscretion or insubordination."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "TIT 1:7"
        },
        "As God’s steward, an overseer must be above reproach — not self-willed, not quick-tempered, not given to drunkenness, not violent, not greedy for money. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "TIT 1:8"
        },
        "Instead, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "he must be"
          ]
        },
        " hospitable, a lover of good, self-controlled, upright, holy, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " disciplined. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "TIT 1:9"
        },
        "He must hold firmly to the faithful word as it was taught, so that he can encourage ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "others"
          ]
        },
        " by sound teaching and refute those who contradict ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Correcting False Teachers"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "1TI 1:3-11",
          "content": [
            "1 Timothy 1:3–11"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "TIT 1:10"
        },
        "For many are rebellious and full of empty talk and deception, especially those of the circumcision, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "TIT 1:11"
        },
        "who must be silenced. For ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " sake of dishonorable gain, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "they"
          ]
        },
        " undermine entire households ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " teach things they should not. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "TIT 1:12"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "As"
          ]
        },
        " one of their own prophets has said, “Cretans ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " always liars, evil beasts, lazy gluttons.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:12 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "This quote, also known as the Epimenides paradox, has been attributed to the Cretan philosopher Epimenides of Knossos."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "TIT 1:13"
        },
        "This testimony is true. Therefore rebuke them sternly, so that they will be sound in the faith ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "TIT 1:14"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " will pay no attention to Jewish myths ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to the"
          ]
        },
        " commands of men who have rejected the truth."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "TIT 1:15"
        },
        "To the pure, all things ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " pure; but to the defiled and unbelieving, nothing ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " pure. Indeed, both their minds and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their"
          ]
        },
        " consciences are defiled. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "TIT 1:16"
        },
        "They profess to know God, but by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their"
          ]
        },
        " actions they deny ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        ". They are detestable, disobedient, and unfit for any good deed."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "2",
      "sid": "TIT 2"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Teaching Sound Doctrine"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "TIT 2:1"
        },
        "But ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as for"
          ]
        },
        " you, speak the things that are consistent with sound doctrine."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "TIT 2:2"
        },
        "Older ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "men"
          ]
        },
        " are to be temperate, dignified, self-controlled, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " sound in faith, love, and perseverance."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "TIT 2:3"
        },
        "Older ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "women"
          ]
        },
        ", likewise, are to be reverent in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their"
          ]
        },
        " behavior, not slanderers ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " addicted to much wine, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "but"
          ]
        },
        " teachers of good. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "TIT 2:4"
        },
        "In this way they can train the young ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "women"
          ]
        },
        " to love ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their"
          ]
        },
        " husbands ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " children, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "TIT 2:5"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to be"
          ]
        },
        " self-controlled, pure, managers of their households, kind, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " submissive to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their"
          ]
        },
        " own husbands, so that the word of God will not be discredited."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "TIT 2:6"
        },
        "In the same way, urge the younger ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "men"
          ]
        },
        " to be self-controlled."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "TIT 2:7"
        },
        "In everything, show yourself ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to be"
          ]
        },
        " an example ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "by doing"
          ]
        },
        " good works. In ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " teaching ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "show"
          ]
        },
        " integrity, dignity, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "TIT 2:8"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " wholesome speech ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that is"
          ]
        },
        " above reproach, so that anyone who opposes ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "us"
          ]
        },
        " will be ashamed, having nothing bad to say about us."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "TIT 2:9"
        },
        "Slaves are to submit to their own masters in everything, to be well-pleasing, not argumentative, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "TIT 2:10"
        },
        "not stealing ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "from them"
          ]
        },
        ", but showing all good faith, so that in every respect they will adorn the teaching about God our Savior."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "God’s Grace Brings Salvation"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "TIT 2:11"
        },
        "For the grace of God has appeared, bringing salvation to everyone. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "TIT 2:12"
        },
        "It instructs us to renounce ungodliness and worldly passions, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " to live sensible, upright, and godly ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "lives"
          ]
        },
        " in the present age, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "TIT 2:13"
        },
        "as we await the blessed hope and glorious appearance of our great God and Savior Jesus Christ. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "TIT 2:14"
        },
        "He gave Himself for us to redeem us from all lawlessness and to purify for Himself a people for His own possession, zealous for good deeds."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "TIT 2:15"
        },
        "Speak these things ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as"
          ]
        },
        " you encourage and rebuke with all authority. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Let"
          ]
        },
        " no one despise you."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "3",
      "sid": "TIT 3"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Heirs of Grace"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "TIT 3:1"
        },
        "Remind ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the believers"
          ]
        },
        " to submit to rulers ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " authorities, to be obedient ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " ready for every good work, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "TIT 3:2"
        },
        "to malign no one, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " to be peaceable ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " gentle, showing full consideration to everyone."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "TIT 3:3"
        },
        "For at one time we too were foolish, disobedient, misled, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " enslaved to all sorts of desires and pleasures — living in malice and envy, being hated ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " hating one another."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "TIT 3:4"
        },
        "But when the kindness of God our Savior and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " love for mankind appeared, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "TIT 3:5"
        },
        "He saved us, not by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " righteous deeds we had done, but according to His mercy, through ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " washing of new birth",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:5 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "of regeneration"
              ]
            }
          ]
        },
        " and renewal by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Holy Spirit. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "TIT 3:6"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "This is the Spirit "
          ]
        },
        " He poured out on us abundantly through Jesus Christ our Savior, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "TIT 3:7"
        },
        "so that, having been justified by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " grace, we would become heirs with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " hope of eternal life. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "TIT 3:8"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "This"
          ]
        },
        " saying ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " trustworthy. And I want you to emphasize these things, so that those who have believed God will take care to devote themselves to good deeds. These things are excellent and profitable for the people."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Avoid Divisions"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ROM 16:17-20",
          "content": [
            "Romans 16:17–20"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "TIT 3:9"
        },
        "But avoid foolish controversies, genealogies, arguments, and quarrels about ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law, because ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "these things"
          ]
        },
        " are pointless and worthless."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "TIT 3:10"
        },
        "Reject a divisive man after a first and second admonition, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "TIT 3:11"
        },
        "knowing that such a man is corrupt and sinful; he is self-condemned."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Final Remarks and Greetings"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "TIT 3:12"
        },
        "As soon as I send Artemas or Tychicus to you, make every effort to come to me at Nicopolis, because I have decided to winter there. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "TIT 3:13"
        },
        "Do your best to equip Zenas the lawyer and Apollos, so that they will have everything they need. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "TIT 3:14"
        },
        "And our ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "people"
          ]
        },
        " must also learn to devote themselves to good works in order to meet ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " pressing needs ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of others"
          ]
        },
        ", so that they will not be unfruitful."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "TIT 3:15"
        },
        "All who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " with me send you greetings."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Greet those who love us in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " faith."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Grace ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " with all of you.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:15 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Amen."
              ]
            }
          ]
        }
      ]
    }
  ]
}