      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "1",
      "sid": "SNG 1"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Bride Confesses Her Love"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "EPH 5:22-33",
          "content": [
            "Ephesians 5:22–33"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "1PE 3:1-7",
          "content": [
            "1 Peter 3:1–7"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "SNG 1:1"
        },
        "This ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " Solomon’s Song of Songs.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:1 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Most translators add subheadings for speaker identifications such as "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "The Bride"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                ", "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "The Groom"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                ", and "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "The Friends "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "based on the gender and number of the Hebrew words."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Bride"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "SNG 1:2"
        },
        "Let him kiss me with the kisses of his mouth!"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "For your love is more delightful than wine."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "SNG 1:3"
        },
        "The fragrance of your perfume is pleasing;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "your name is like perfume poured out."
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "No wonder the maidens adore you."
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "SNG 1:4"
        },
        "Take me away with you— let us hurry!"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "May the king bring me to his chambers."
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Friends"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "We will rejoice and delight in you;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "we will praise your love more than wine."
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Bride"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "It is only right that they adore you."
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "SNG 1:5"
        },
        "I am dark, yet lovely, O daughters of Jerusalem,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "like the tents of Kedar, like the curtains of Solomon."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "SNG 1:6"
        },
        "Do not stare because I am dark,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "for the sun has gazed upon me."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "My mother’s sons were angry with me;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "they made me a keeper of the vineyards,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "add",
          "content": [
            "but"
          ]
        },
        " my own vineyard I have neglected."
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "SNG 1:7"
        },
        "Tell me, O one I love,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "where do you pasture your sheep?"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "Where do you rest them at midday?"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Why should I be like a veiled woman"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "beside the flocks of your companions?"
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Friends"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "SNG 1:8"
        },
        "If you do not know, O fairest of women,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "follow the tracks of the flock,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "and graze your young goats"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "near the tents of the shepherds."
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Bridegroom"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "SNG 1:9"
        },
        "I compare you, my darling,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "to a mare among Pharaoh’s chariots."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "SNG 1:10"
        },
        "Your cheeks are beautiful with ornaments,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "your neck with strings of jewels."
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Friends"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "SNG 1:11"
        },
        "We will make you ornaments of gold,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "add",
          "content": [
            "studded"
          ]
        },
        " with beads of silver."
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Bride"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "SNG 1:12"
        },
        "While the king was at his table,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "my perfume spread its fragrance."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "SNG 1:13"
        },
        "My beloved is to me a sachet of myrrh"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "resting between my breasts."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "SNG 1:14"
        },
        "My beloved is to me a cluster of henna blossoms"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "in the vineyards of En-gedi."
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Bridegroom"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "SNG 1:15"
        },
        "How beautiful ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you are"
          ]
        },
        ", my darling!"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "Oh, how very beautiful!"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "Your eyes are ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "like"
          ]
        },
        " doves."
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Bride"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "SNG 1:16"
        },
        "How handsome ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you are"
          ]
        },
        ", my beloved!"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "Oh, how delightful!"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "The soft grass ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " our bed."
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Bridegroom"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "SNG 1:17"
        },
        "The beams of our house are cedars;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "our rafters ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are fragrant"
          ]
        },
        " firs."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "2",
      "sid": "SNG 2"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Bride’s Admiration"
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Bride"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "SNG 2:1"
        },
        "I am a rose of Sharon,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:1 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Sharon Plain is a region in the coastal plain of Israel"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "a lily of the valley."
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Bridegroom"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "SNG 2:2"
        },
        "Like a lily among the thorns"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "is my darling among the maidens."
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Bride"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "SNG 2:3"
        },
        "Like an apple tree among the trees of the forest"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "is my beloved among the young men."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "I delight to sit in his shade,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and his fruit is sweet to my taste."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "SNG 2:4"
        },
        "He has brought me to the house of wine,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:4 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "That is, the banquet hall"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and his banner over me ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " love."
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "SNG 2:5"
        },
        "Sustain me with raisins;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "refresh me with apples,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "for I am faint with love."
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "SNG 2:6"
        },
        "His left hand is under my head,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and his right arm embraces me."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "SNG 2:7"
        },
        "O daughters of Jerusalem, I adjure you"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "by the gazelles and does of the field:"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Do not arouse or awaken love"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "until the time is right."
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "SNG 2:8"
        },
        "Listen! My beloved ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "approaches"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "Look! Here he comes,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "leaping across the mountains,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "bounding over the hills."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "SNG 2:9"
        },
        "My beloved is like a gazelle or a young stag."
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "Look, he stands behind our wall,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "gazing through the windows,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "peering through the lattice."
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "SNG 2:10"
        },
        "My beloved calls to me,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "“Arise, my darling."
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "Come away with me, my beautiful one."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "SNG 2:11"
        },
        "For now the winter is past;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "the rain is over and gone."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "SNG 2:12"
        },
        "The flowers have appeared in the countryside;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "the season of singing",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:12 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "pruning"
              ]
            }
          ]
        },
        " has come,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "and the cooing of turtledoves"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "is heard in our land."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "SNG 2:13"
        },
        "The fig tree ripens its figs;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "the blossoming vines spread their fragrance."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Arise, come away, my darling;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "come away with me, my beautiful one.”"
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Bridegroom"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "SNG 2:14"
        },
        "O my dove in the clefts of the rock,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "in the crevices of the cliff,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "let me see your face,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "let me hear your voice;"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "for your voice is sweet,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and your countenance is lovely."
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Friends"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "SNG 2:15"
        },
        "Catch for us the foxes—"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "the little foxes that ruin the vineyards—"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "for our vineyards are in bloom."
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Bride"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "SNG 2:16"
        },
        "My beloved is mine and I am his;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "he pastures ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his flock"
          ]
        },
        " among the lilies."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "SNG 2:17"
        },
        "Before the day breaks and shadows flee,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "turn, my beloved,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "and be like a gazelle"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "or a young stag on the mountains of Bether.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:17 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "the rugged mountains"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "3",
      "sid": "SNG 3"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Bride’s Dream"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "SNG 3:1"
        },
        "On my bed at night"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "I sought the one I love;"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "I sought him,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "but did not find him."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "SNG 3:2"
        },
        "I will arise now and go about the city,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "through the streets and squares."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "I will seek the one I love."
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "So I sought him but did not find him."
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "SNG 3:3"
        },
        "I encountered the watchmen on their rounds of the city:"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "“Have you seen ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the one"
          ]
        },
        " I love?”"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "SNG 3:4"
        },
        "I had just passed them when I found the one I love."
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "I held him and would not let go"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "until I had brought him to my mother’s house,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "to the chamber of the one who conceived me."
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "SNG 3:5"
        },
        "O daughters of Jerusalem, I adjure you"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "by the gazelles and does of the field:"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Do not arouse or awaken love"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "until the time is right."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Solomon Arrives on His Wedding Day"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "SNG 3:6"
        },
        "Who is this coming up from the wilderness"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "like a column of smoke,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "scented with myrrh and frankincense"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "from all the spices of the merchant?"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "SNG 3:7"
        },
        "Behold, it is Solomon’s carriage,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:7 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "That is, the couch on which servants carry a king"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "escorted by sixty of the mightiest men of Israel."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "SNG 3:8"
        },
        "All are skilled with the sword,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "experienced in warfare."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Each has his sword at his side"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "prepared for the terror of the night."
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "SNG 3:9"
        },
        "King Solomon has made his carriage"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "out of the timber of Lebanon."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "SNG 3:10"
        },
        "He has made its posts of silver,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "its base of gold, its seat of purple ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "fabric"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Its interior is inlaid with love"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "by the daughters of Jerusalem."
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "SNG 3:11"
        },
        "Come out, O daughters of Zion,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and gaze at King Solomon,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "wearing the crown with which his mother crowned him"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "on the day of his wedding—"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "the day of his heart’s rejoicing."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "4",
      "sid": "SNG 4"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Solomon Admires His Bride"
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Bridegroom"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "SNG 4:1"
        },
        "How beautiful ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you are"
          ]
        },
        ", my darling—"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "how very beautiful!"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Your eyes are ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "like"
          ]
        },
        " doves"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "behind your veil."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Your hair is like a flock of goats"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "streaming down Mount Gilead."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "SNG 4:2"
        },
        "Your teeth are like a flock of newly shorn sheep"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "coming up from the washing;"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "each has its twin,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and not one of them ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " lost."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "SNG 4:3"
        },
        "Your lips are like a scarlet ribbon,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and your mouth is lovely."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Your brow behind your veil"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "is like a slice of pomegranate."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "SNG 4:4"
        },
        "Your neck is like the tower of David,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "built with rows of stones;"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "on it hang a thousand shields,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "all of them shields of warriors."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "SNG 4:5"
        },
        "Your breasts are like two fawns,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "twins of a gazelle grazing among the lilies."
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "SNG 4:6"
        },
        "Before the day breaks and the shadows flee,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "I will make my way"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "to the mountain of myrrh"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and to the hill of frankincense."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "SNG 4:7"
        },
        "You are altogether beautiful, my darling;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "in you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "there is"
          ]
        },
        " no flaw."
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "SNG 4:8"
        },
        "Come with me from Lebanon, my bride,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "add",
          "content": [
            "come"
          ]
        },
        " with me from Lebanon!"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Descend",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "4:8 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Look down"
              ]
            }
          ]
        },
        " from the peak of Amana,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "from the summits of Senir and Hermon,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "from the dens of the lions,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "from the mountains of the leopards."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "SNG 4:9"
        },
        "You have captured my heart,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "my sister, my bride;"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "you have stolen my heart with one glance of your eyes,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "with one jewel of your neck."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "SNG 4:10"
        },
        "How delightful ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " your love,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "my sister, my bride!"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Your love is much better than wine,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and the fragrance of your perfume than all spices."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "SNG 4:11"
        },
        "Your lips, my bride,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "drip sweetness like the honeycomb;"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "honey and milk are under your tongue,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and the fragrance of your garments"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "is like the aroma of Lebanon."
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "SNG 4:12"
        },
        "My sister, my bride, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you are"
          ]
        },
        " a garden locked up,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "a spring enclosed, a fountain sealed."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "SNG 4:13"
        },
        "Your branches ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " an orchard of pomegranates"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "with the choicest of fruits, with henna ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " nard,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "SNG 4:14"
        },
        "with nard and saffron, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "with"
          ]
        },
        " calamus and cinnamon,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "with every kind of frankincense tree,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "with myrrh and aloes,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "with all the finest spices."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "SNG 4:15"
        },
        "You are a garden spring,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "a well of fresh water",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "4:15 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "flowing water "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "living water"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "flowing down from Lebanon."
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Bride"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "SNG 4:16"
        },
        "Awake, O north wind,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and come, O south wind."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Breathe on my garden"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and spread the fragrance of its spices."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Let my beloved come into his garden"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and taste its choicest fruits."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "5",
      "sid": "SNG 5"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Bride and Her Beloved"
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Bridegroom"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "SNG 5:1"
        },
        "I have come to my garden, my sister, my bride;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "I have gathered my myrrh with my spice."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "I have eaten my honeycomb with my honey;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "I have drunk my wine with my milk."
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Friends"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Eat, O friends, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " drink;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "drink freely, O beloved."
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Bride"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "SNG 5:2"
        },
        "I sleep, but my heart is awake."
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "A sound! My beloved is knocking:"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Open to me, my sister, my darling,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "my dove, my flawless one."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "My head is drenched with dew,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "my hair with the dampness of the night.”"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "SNG 5:3"
        },
        "I have taken off my robe —"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "must I put it back on?"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "I have washed my feet—"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "must I soil them again?"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "SNG 5:4"
        },
        "My beloved put his hand to the latch;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "my heart pounded for him."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "SNG 5:5"
        },
        "I rose up to open for my beloved."
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "My hands dripped with myrrh,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "my fingers with flowing myrrh"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "on the handles of the bolt."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "SNG 5:6"
        },
        "I opened for my beloved,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "but ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "he"
          ]
        },
        " had turned and gone."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "My heart sank at his departure."
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "I sought him but did not find him."
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "I called, but he did not answer."
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "SNG 5:7"
        },
        "I encountered the watchmen on their rounds of the city."
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "They beat me and bruised me;"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "they took away my cloak,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "those guardians of the walls."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "SNG 5:8"
        },
        "O daughters of Jerusalem, I adjure you,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "if you find my beloved,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "tell him I ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "am"
          ]
        },
        " sick with love."
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Friends"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "SNG 5:9"
        },
        "How ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " your beloved better than ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "others"
          ]
        },
        ","
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "O most beautiful among women?"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "How ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " your beloved better than another,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "that you charge us so?"
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Bride"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "SNG 5:10"
        },
        "My beloved is dazzling and ruddy,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "outstanding among ten thousand."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "SNG 5:11"
        },
        "His head is purest gold;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "his hair is wavy and black as a raven."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "SNG 5:12"
        },
        "His eyes are like doves"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "beside the streams of water,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "bathed in milk"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " mounted like jewels."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "SNG 5:13"
        },
        "His cheeks are like beds of spice,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "towers of perfume."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "His lips are like lilies,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "dripping with flowing myrrh."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "SNG 5:14"
        },
        "His arms are rods of gold"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "set with beryl."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "His body is polished ivory"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "bedecked with sapphires."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "SNG 5:15"
        },
        "His legs ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " pillars of marble"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "set on bases of pure gold."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "His appearance is like Lebanon,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "as majestic as the cedars."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "SNG 5:16"
        },
        "His mouth",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "5:16 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Hebrew "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "palate"
              ]
            }
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " most sweet;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "he is altogether lovely."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "This ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " my beloved, and this is my friend,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "O daughters of Jerusalem."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "6",
      "sid": "SNG 6"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Together in the Garden"
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Friends"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "SNG 6:1"
        },
        "Where has your beloved gone,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "O most beautiful among women?"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Which way has he turned?"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "We will seek him with you."
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Bride"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "SNG 6:2"
        },
        "My beloved has gone down to his garden,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "to the beds of spices,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "to pasture ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his flock"
          ]
        },
        " in the gardens"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and to gather lilies."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "SNG 6:3"
        },
        "I belong to my beloved and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "he"
          ]
        },
        " belongs to me;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "he pastures ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his flock"
          ]
        },
        " among the lilies."
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Bridegroom"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "SNG 6:4"
        },
        "You are as beautiful, my darling, as Tirzah,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "as lovely as Jerusalem,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "as majestic as troops with banners."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "SNG 6:5"
        },
        "Turn your eyes away from me,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "for they have overcome me."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Your hair is like a flock of goats"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "streaming down from Gilead."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "SNG 6:6"
        },
        "Your teeth are like a flock of sheep"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "coming up from the washing;"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "each has its twin,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and not one of them ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " lost."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "SNG 6:7"
        },
        "Your brow behind your veil"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "is like a slice of pomegranate."
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "SNG 6:8"
        },
        "There are sixty queens and eighty concubines,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and maidens without number,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "SNG 6:9"
        },
        "but my dove, my perfect one, is unique,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "the favorite of the mother who bore her."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "The maidens see her and call her blessed;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "the queens and concubines sing her praises."
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Friends"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "SNG 6:10"
        },
        "Who is this who shines like the dawn,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "as fair as the moon,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "as bright as the sun,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "as majestic as the stars in procession?"
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Bridegroom"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "SNG 6:11"
        },
        "I went down to the walnut grove"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "to see the blossoms of the valley,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "to see if the vines were budding"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "or the pomegranates ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "were"
          ]
        },
        " in bloom."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "SNG 6:12"
        },
        "Before I realized it, my desire had set me"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "among the royal chariots of my people.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "6:12 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "among the chariots of Amminadab"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Friends"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "SNG 6:13"
        },
        "Come back, come back, O Shulammite!"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "Come back, come back, that we may gaze upon you."
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Bridegroom"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Why do you look at the Shulammite,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "as on the dance of Mahanaim",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "6:13 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "the dance of the two camps"
              ]
            }
          ]
        },
        "?"
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "7",
      "sid": "SNG 7"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Admiration by the Bridegroom"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "SNG 7:1"
        },
        "How beautiful are your sandaled feet,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "O daughter of the prince!"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "The curves of your thighs are like jewels,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "the handiwork of a master."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "SNG 7:2"
        },
        "Your navel is a rounded goblet;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "it never lacks blended wine."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Your waist is a mound of wheat"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "encircled by the lilies."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "SNG 7:3"
        },
        "Your breasts are like two fawns,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "twins of a gazelle."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "SNG 7:4"
        },
        "Your neck is like a tower"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "add",
          "content": [
            "made"
          ]
        },
        " of ivory;"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "your eyes are like the pools of Heshbon"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "by the gate of Bath-rabbim;"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "your nose is like the tower of Lebanon,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "facing toward Damascus."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "SNG 7:5"
        },
        "Your head crowns you like Mount Carmel,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "the hair of your head like purple ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "threads"
          ]
        },
        ";"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "the king is captured in your tresses."
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "SNG 7:6"
        },
        "How fair and pleasant ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you are"
          ]
        },
        ","
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "O love, with your delights!"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "SNG 7:7"
        },
        "Your stature is like a palm tree;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "your breasts are clusters of fruit."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "SNG 7:8"
        },
        "I said, “I will climb the palm tree;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "I will take hold of its fruit.”"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "May your breasts be like clusters of the vine,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "the fragrance of your breath like apples,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "SNG 7:9"
        },
        "and your mouth",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "7:9 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Hebrew "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "palate "
              ]
            }
          ]
        },
        " like the finest wine."
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Bride"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "May it flow smoothly to my beloved,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "gliding gently over lips and teeth.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "7:9 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "LXX, Syriac, and Vulgate; Hebrew "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "gliding gently over lips as we sleep"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "SNG 7:10"
        },
        "I belong to my beloved,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and his desire is for me."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "SNG 7:11"
        },
        "Come, my beloved,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "let us go to the countryside;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "let us spend the night among the wildflowers.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "7:11 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "among the henna blossoms "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "in the villages"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "SNG 7:12"
        },
        "Let us go early to the vineyards"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "to see if the vine has budded,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "if the blossom has opened,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "if the pomegranates are in bloom —"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "there I will give you my love."
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "SNG 7:13"
        },
        "The mandrakes send forth a fragrance,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and at our door is every delicacy,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "new as well as old,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "that I have treasured up for you, my beloved."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "8",
      "sid": "SNG 8"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Longing for Her Beloved"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "SNG 8:1"
        },
        "O that you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "were"
          ]
        },
        " to me like a brother"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "who nursed at my mother’s breasts!"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "If I found you outdoors, I would kiss you,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and no one would despise me."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "SNG 8:2"
        },
        "I would lead you and bring you"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "to the house of my mother who taught me."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "I would give you spiced wine to drink,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "the nectar of my pomegranates."
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "SNG 8:3"
        },
        "His left hand is under my head,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and his right arm embraces me."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "SNG 8:4"
        },
        "O daughters of Jerusalem, I adjure you:"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "Do not arouse or awaken love"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "until the time is right."
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Friends"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "SNG 8:5"
        },
        "Who is this coming up from the wilderness,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "leaning on her beloved?"
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Bride"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "I roused you under the apple tree;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "there your mother conceived you;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "there she travailed and brought you forth."
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "SNG 8:6"
        },
        "Set me as a seal over your heart,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "as a seal upon your arm."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "For love is as strong as death,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "its jealousy",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "8:6 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "passion"
              ]
            }
          ]
        },
        " as unrelenting as Sheol."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Its sparks are fiery flames,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "the fiercest blaze of all."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "SNG 8:7"
        },
        "Mighty waters cannot quench love;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "rivers cannot sweep it away."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "If a man were to give all the wealth of his house for love,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his offer"
          ]
        },
        " would be utterly scorned."
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Friends"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "SNG 8:8"
        },
        "We have a little sister,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and her breasts are not yet grown."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "What shall we do for our sister"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "on the day she is spoken for?"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "SNG 8:9"
        },
        "If she is a wall,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "we will build a tower of silver upon her."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "If she is a door,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "we will enclose her with panels of cedar."
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Bride"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "SNG 8:10"
        },
        "I am a wall,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and my breasts are like towers."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "So I have become in his eyes"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "like one who brings peace."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "SNG 8:11"
        },
        "Solomon had a vineyard in Baal-hamon."
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "He leased ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " to the tenants."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "For its fruit, each was to bring"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "a thousand ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "shekels"
          ]
        },
        " of silver.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "8:11 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Hebrew "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "a thousand of silver"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; that is, approximately 25.1 pounds or 11.4 kilograms of silver"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "SNG 8:12"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "But"
          ]
        },
        " my own vineyard is mine to give;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "the thousand ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "shekels"
          ]
        },
        " are for you, O Solomon,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and two hundred are for those who tend its fruit."
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Bridegroom"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "SNG 8:13"
        },
        "You who dwell in the gardens,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "add",
          "content": [
            "my"
          ]
        },
        " companions are listening for your voice."
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "Let me hear it!"
      ]
    },
    {
      "type": "para",
      "marker": "s2",
      "content": [
        "The Bride"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "SNG 8:14"
        },
        "Come away, my beloved,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and be like a gazelle"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "or a young stag"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "on the mountains of spices."
      ]
    }
  ]
}