{
  "type": "USJ",
  "version": "3.0",
  "content": [
    {
      "type": "book",
      "marker": "id",
      "code": "1TH",
      "content": [
        "Autogenerated BSB by bsb2usfm"
      ]
    },
    {
      "type": "para",
      "marker": "h",
      "content": [
        "1 Thessalonians"
      ]
    },
    {
      "type": "para",
      "marker": "toc1",
      "content": [
        "1 Thessalonians"
      ]
    },
    {
      "type": "para",
      "marker": "toc2",
      "content": [
        "1 Thessalonians"
      ]
    },
    {
      "type": "para",
      "marker": "toc3",
      "content": [
        "1TH"
      ]
    },
    {
      "type": "para",
      "marker": "mt1",
      "content": [
        "1 Thessalonians"
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "1",
      "sid": "1TH 1"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Greetings to the Thessalonians"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "2TH 1:1-4",
          "content": [
            "2 Thessalonians 1:1–4"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "1TH 1:1"
        },
        "Paul, Silvanus,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:1 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "That is, Silas"
              ]
            }
          ]
        },
        " and Timothy,"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "To the church of the Thessalonians in God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Father and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord Jesus Christ:"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Grace and peace to you.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:1 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "from God our Father and the Lord Jesus Christ"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "1TH 1:2"
        },
        "We always thank God for all of you, remembering ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        " in our prayers ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "1TH 1:3"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " continually recalling before our God and Father your work of faith, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " labor of love, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " enduring hope in our Lord Jesus Christ."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "1TH 1:4"
        },
        "Brothers who are beloved by God, we know ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " He has chosen you, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "1TH 1:5"
        },
        "because our gospel came to you not only in word, but also in power, in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Holy Spirit, and with great conviction — just as you know we lived among you for your sake. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "1TH 1:6"
        },
        "And you became imitators of us and of the Lord when you welcomed the message with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " joy of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Holy Spirit, in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "spite of your"
          ]
        },
        " great suffering."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "1TH 1:7"
        },
        "As a result, you have become an example to all the believers in Macedonia and Achaia. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "1TH 1:8"
        },
        "For not only ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "did"
          ]
        },
        " the message of the Lord ring out from you to Macedonia and Achaia, but your faith in God has gone out to every place, so that we have no need to say anything ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "more"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "1TH 1:9"
        },
        "For they themselves report what kind of welcome you gave us, and how you turned to God from idols to serve ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " living and true God ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "1TH 1:10"
        },
        "and to await His Son from heaven, whom He raised from the dead — Jesus our deliverer from the coming wrath."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "2",
      "sid": "1TH 2"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Paul’s Ministry"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "1TH 2:1"
        },
        "You yourselves know, brothers, that our visit to you was not in vain. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "1TH 2:2"
        },
        "As you are aware, we had already endured suffering and shameful treatment in Philippi. But in the face of strong opposition, we were bold in our God to speak to you the gospel of God."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "1TH 2:3"
        },
        "For our appeal does not arise from deceit ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " ulterior motives ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " trickery. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "1TH 2:4"
        },
        "Instead, we speak as those approved by God to be entrusted with the gospel, not in order to please men but God, who examines our hearts. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "1TH 2:5"
        },
        "As you know, we never used words of flattery ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "any"
          ]
        },
        " pretext for greed. God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "our"
          ]
        },
        " witness! ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "1TH 2:6"
        },
        "Nor did we seek praise from you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " from anyone else, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "although"
          ]
        },
        " as apostles of Christ we had authority to demand ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        ".",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:6 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "although as apostles of Christ we could have been a burden to you"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; SBL, NE, and WH include this phrase with verse 7."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "1TH 2:7"
        },
        "On the contrary, we were gentle among you,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:7 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "WH and NA "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "we were like young children among you"
              ]
            }
          ]
        },
        " like a nursing mother caring for her children. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "1TH 2:8"
        },
        "We cared so deeply ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " we were delighted to share with you not only the gospel of God, but our own lives as well. That is how beloved you have become to us."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "1TH 2:9"
        },
        "Surely you recall, brothers, our labor and toil. We worked night and day so that we would not be a burden to anyone while we proclaimed to you the gospel of God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "1TH 2:10"
        },
        "You ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " witnesses, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "so is"
          ]
        },
        " God, of how holy, righteous, and blameless our conduct was among you who believed. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "1TH 2:11"
        },
        "For you know that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "we treated"
          ]
        },
        " each of you as a father ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "treats"
          ]
        },
        " his own children— ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "1TH 2:12"
        },
        "encouraging ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        ", comforting you, and urging you to walk in a manner worthy of God, who calls you into His own kingdom and glory."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "1TH 2:13"
        },
        "And we continually thank God because, when you received ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " word of God that you heard from us, you accepted ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " not ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as the"
          ]
        },
        " word of men, but as it truly is, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " word of God, which is also ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "now"
          ]
        },
        " at work in you who believe."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "1TH 2:14"
        },
        "For you, brothers, became imitators of the churches of God in Judea that are in Christ Jesus. You suffered from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " own countrymen the very things they ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "suffered"
          ]
        },
        " from the Jews, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "1TH 2:15"
        },
        "who killed both the Lord Jesus and their own prophets and drove us out ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as well"
          ]
        },
        ". They are displeasing to God and hostile to all men, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "1TH 2:16"
        },
        "hindering us from telling the Gentiles how they may be saved. As a result, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "they"
          ]
        },
        " continue to heap up their sins ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to full capacity"
          ]
        },
        "; the utmost wrath has come upon them.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:16 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "at last the wrath (of God) has come upon them."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Paul’s Longing to Visit"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "1TH 2:17"
        },
        "Brothers, although we were torn away from you for a short time (in person, not in heart), ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "our"
          ]
        },
        " desire to see you face ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to face"
          ]
        },
        " was even more intense. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "1TH 2:18"
        },
        "For we wanted to come to you — indeed I, Paul, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "tried"
          ]
        },
        " again and again — but Satan obstructed us. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "1TH 2:19"
        },
        "After all, who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " our hope, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "our"
          ]
        },
        " joy, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "our"
          ]
        },
        " crown of boasting, if it is not you yourselves in the presence of our Lord Jesus at His coming? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "1TH 2:20"
        },
        "You are indeed our glory and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "our"
          ]
        },
        " joy."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "3",
      "sid": "1TH 3"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Timothy’s Visit"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "1TH 3:1"
        },
        "So ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "when"
          ]
        },
        " we could bear ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " no longer, we were willing to be left on our own in Athens. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "1TH 3:2"
        },
        "We sent Timothy, our brother and fellow worker for God",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:2 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "our brother and God’s fellow worker"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; NE, WH, BYZ, and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "our brother and minister of God"
              ]
            }
          ]
        },
        " in the gospel of Christ, to strengthen and encourage you in your faith, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "1TH 3:3"
        },
        "so that none ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of you"
          ]
        },
        " would be shaken by these trials. For you know that we are destined for this. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "1TH 3:4"
        },
        "Indeed, when we were with you, we kept warning you that we would suffer persecution; and as you know, it has come to pass. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "1TH 3:5"
        },
        "For this reason, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "when"
          ]
        },
        " I could bear ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " no longer, I sent to find out about your faith, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "for fear that"
          ]
        },
        " the tempter ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "had"
          ]
        },
        " somehow tempted you and that our labor might have been in vain."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Timothy’s Encouraging Report"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "1TH 3:6"
        },
        "But just now, Timothy has returned from  ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his visit"
          ]
        },
        " with the good news about your faith, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " love, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " fond memories you have preserved, longing to see us just as we ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "long to see"
          ]
        },
        " you. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "1TH 3:7"
        },
        "For this reason, brothers, in all our distress and persecution, we have been reassured about you, because of your faith. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "1TH 3:8"
        },
        "For now we can go on living, as long as you are standing firm in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "1TH 3:9"
        },
        "How can we ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "adequately"
          ]
        },
        " thank God for you in return for our great joy over you in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " presence? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "1TH 3:10"
        },
        "Night and day we pray most earnestly that we may see you face to face and supply what is lacking in your faith."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "1TH 3:11"
        },
        "Now ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "may"
          ]
        },
        " our God and Father Himself, and our Lord Jesus, direct our way to you. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "1TH 3:12"
        },
        "And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "may"
          ]
        },
        " the Lord cause you to increase and overflow with love for one another and for everyone ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "else"
          ]
        },
        ", just as our ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "love"
          ]
        },
        " for you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "overflows"
          ]
        },
        ", ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "1TH 3:13"
        },
        "so that He may establish your hearts in blamelessness ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " holiness before our God and Father at the coming of our Lord Jesus with all His saints. Amen."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "4",
      "sid": "1TH 4"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Living to Please God"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "1TH 4:1"
        },
        "Finally, brothers, we ask and encourage you in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord Jesus to live in a way that is pleasing to God, just as you have received from us. This is how you already live, so you should do so all the more. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "1TH 4:2"
        },
        "For you know ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " instructions we gave you by the authority of the Lord Jesus."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "1TH 4:3"
        },
        "For it is God’s will that you should be holy: You must abstain from sexual immorality; ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "1TH 4:4"
        },
        "each of you must know ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "how"
          ]
        },
        " to control his ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "own"
          ]
        },
        " body",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "4:4 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "know how to possess his own vessel"
              ]
            }
          ]
        },
        " in holiness and honor, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "1TH 4:5"
        },
        "not in lustful passion like the Gentiles who do not know God; ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "1TH 4:6"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " no one should ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "ever"
          ]
        },
        " violate ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " exploit his brother in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        " regard,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "4:6 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "no one should ever harm or cheat his brother in this matter"
              ]
            }
          ]
        },
        " because ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord will avenge all such ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "acts"
          ]
        },
        ", as we have already told you and solemnly warned ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "1TH 4:7"
        },
        "For God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "has"
          ]
        },
        " not called us to impurity, but to holiness. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "1TH 4:8"
        },
        "Anyone, then, who rejects ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this command"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "does"
          ]
        },
        " not reject man but God, the very ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "One who"
          ]
        },
        " gives you His Holy Spirit."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "1TH 4:9"
        },
        "Now about brotherly love, you do not need ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "anyone"
          ]
        },
        " to write to you, because you yourselves have been taught by God to love one another. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "1TH 4:10"
        },
        "And you are indeed showing this ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "love"
          ]
        },
        " to all the brothers throughout Macedonia. But we urge you, brothers, to excel more and more ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "1TH 4:11"
        },
        "and to aspire to live quietly, to attend to your own ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "matters"
          ]
        },
        ", and to work with your own hands, as we instructed you. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "1TH 4:12"
        },
        "Then you will behave properly toward outsiders, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "without"
          ]
        },
        " being dependent ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "on anyone"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Return of the Lord"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "1TH 4:13"
        },
        "Brothers, we do not want you to be uninformed about those who sleep  ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "in death "
          ]
        },
        ",",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "4:13 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "those who have fallen asleep"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                ", as in verses 14 and 15"
              ]
            }
          ]
        },
        " so that you will not grieve like the rest, who are without hope. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "1TH 4:14"
        },
        "For since we believe that Jesus died and rose again, we also believe that God will bring with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " those who have fallen asleep in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "1TH 4:15"
        },
        "By ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " word of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord, we declare to you that we who are alive ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " remain until the coming of the Lord will by no means precede those who have fallen asleep. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "1TH 4:16"
        },
        "For the Lord Himself will descend from heaven with a loud command, with the voice of an archangel, and with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " trumpet of God, and the dead in Christ will be the first to rise. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "1TH 4:17"
        },
        "After that, we who are alive ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " remain will be caught up together with them in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " clouds to meet the Lord in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " air. And so we will always ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "1TH 4:18"
        },
        "Therefore encourage one another with these words."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "5",
      "sid": "1TH 5"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Day of the Lord"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ZEP 1:7-18",
          "content": [
            "Zephaniah 1:7–18"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MAL 4:1-6",
          "content": [
            "Malachi 4:1–6"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "2PE 3:8-13",
          "content": [
            "2 Peter 3:8–13"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "1TH 5:1"
        },
        "Now about the times and seasons, brothers, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "we do"
          ]
        },
        " not need to write to you. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "1TH 5:2"
        },
        "For you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " fully aware that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Day of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord will come like a thief in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " night. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "1TH 5:3"
        },
        "While ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "people"
          ]
        },
        " are saying, “Peace and security,” destruction will come upon them suddenly, like labor pains on a pregnant woman, and they will not escape."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "1TH 5:4"
        },
        "But you, brothers, are not in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " darkness so that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        " day should overtake you like a thief. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "1TH 5:5"
        },
        "For you are all sons of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " light and sons of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " day; we do not belong to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " night ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " darkness. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "1TH 5:6"
        },
        "So then, let us not sleep as the others ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do"
          ]
        },
        ", but let us remain awake and sober. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "1TH 5:7"
        },
        "For those who sleep, sleep at night, and those who get drunk, get drunk at night. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "1TH 5:8"
        },
        "But ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "since"
          ]
        },
        " we belong to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " day, let us be sober, putting on ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " breastplate of faith and love, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " helmet ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of our"
          ]
        },
        " hope of salvation."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "1TH 5:9"
        },
        "For God has not appointed us to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "suffer"
          ]
        },
        " wrath, but to obtain salvation through our Lord Jesus Christ. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "1TH 5:10"
        },
        "He died for us so that, whether we are awake or asleep, we may live together with Him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "1TH 5:11"
        },
        "Therefore encourage and build one another ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "up"
          ]
        },
        ", just as you are already doing."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Christian Living"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "1TH 5:12"
        },
        "But we ask you, brothers, to acknowledge those who work diligently among you, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who"
          ]
        },
        " care for you in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who"
          ]
        },
        " admonish you. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "1TH 5:13"
        },
        "In love, hold them in highest ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "regard"
          ]
        },
        " because of their work. Live in peace with one another."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "1TH 5:14"
        },
        "And we urge you, brothers, to admonish the unruly, encourage the fainthearted, help the weak, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " be patient with everyone."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "1TH 5:15"
        },
        "Make sure that no one repays evil for evil. Always pursue what ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " good for one another and for all ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "people"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "1TH 5:16"
        },
        "Rejoice at all times. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "1TH 5:17"
        },
        "Pray without ceasing. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "1TH 5:18"
        },
        "Give thanks in every circumstance, for this ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " God’s will for you in Christ Jesus."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "1TH 5:19"
        },
        "Do not extinguish the Spirit. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "1TH 5:20"
        },
        "Do not treat prophecies ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "with contempt"
          ]
        },
        ", ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "1TH 5:21"
        },
        "but test all things. Hold fast to what ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " good. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "1TH 5:22"
        },
        "Abstain from every form of evil."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Final Blessings and Instructions"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "1TH 5:23"
        },
        "Now ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "may"
          ]
        },
        " the God of peace Himself sanctify you completely, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "may"
          ]
        },
        " your entire spirit, soul, and body be kept blameless",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "5:23 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "may your spirit, soul, and body be kept entirely blameless"
              ]
            }
          ]
        },
        " at the coming of our Lord Jesus Christ. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "1TH 5:24"
        },
        "The ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "One who"
          ]
        },
        " calls you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " faithful, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "He"
          ]
        },
        " will do ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "1TH 5:25"
        },
        "Brothers, pray for us as well."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "1TH 5:26"
        },
        "Greet all the brothers with a holy kiss."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "1TH 5:27"
        },
        "I charge you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "before"
          ]
        },
        " the Lord ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to have this"
          ]
        },
        " letter read to all the brothers."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "1TH 5:28"
        },
        "The grace of our Lord Jesus Christ ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " with you.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "5:28 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Amen."
              ]
            }
          ]
        }
      ]
    }
  ]
}