      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "1",
      "sid": "MAT 1"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Genealogy of Jesus"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "RUT 4:18-22",
          "content": [
            "Ruth 4:18–22"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 3:23-38",
          "content": [
            "Luke 3:23–38"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MAT 1:1"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "This is the"
          ]
        },
        " record of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " genealogy of Jesus Christ, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " son of David, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " son of Abraham:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MAT 1:2"
        },
        "Abraham was the father of Isaac,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Isaac the father of Jacob,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "and Jacob the father of Judah and his brothers."
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "MAT 1:3"
        },
        "Judah was the father of Perez and Zerah by Tamar,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Perez the father of Hezron,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "and Hezron the father of Ram.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:3 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Greek "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Aram"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                ", a variant of "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Ram"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; also in verse 4; see ",
                {
                  "type": "ref",
                  "loc": "1CH 2:9-10",
                  "content": [
                    "1 Chronicles 2:9–10"
                  ]
                },
                "."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "MAT 1:4"
        },
        "Ram was the father of Amminadab,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Amminadab the father of Nahshon,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "and Nahshon the father of Salmon."
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MAT 1:5"
        },
        "Salmon was the father of Boaz by Rahab,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Boaz the father of Obed by Ruth,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Obed the father of Jesse,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "MAT 1:6"
        },
        "and Jesse the father of David the king."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Next:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "David was the father of Solomon by Uriah’s ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "wife"
          ]
        },
        ","
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MAT 1:7"
        },
        "Solomon the father of Rehoboam,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Rehoboam the father of Abijah,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "and Abijah the father of Asa.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:7 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Greek "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Asaph"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                ", a variant of "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Asa"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; also in verse 8; see ",
                {
                  "type": "ref",
                  "loc": "1CH 3:10",
                  "content": [
                    "1 Chronicles 3:10"
                  ]
                },
                "."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "MAT 1:8"
        },
        "Asa was the father of Jehoshaphat,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Jehoshaphat the father of Joram,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "and Joram the father of Uzziah."
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MAT 1:9"
        },
        "Uzziah was the father of Jotham,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Jotham the father of Ahaz,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "and Ahaz the father of Hezekiah."
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "MAT 1:10"
        },
        "Hezekiah was the father of Manasseh,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Manasseh the father of Amon,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:10 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Greek "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Amōs"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                ", a variant spelling of Amon; twice in this verse; see ",
                {
                  "type": "ref",
                  "loc": "1CH 3:14",
                  "content": [
                    "1 Chronicles 3:14"
                  ]
                },
                "."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Amon the father of Josiah,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "MAT 1:11"
        },
        "and Josiah the father of Jeconiah and his brothers"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "at ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the time"
          ]
        },
        " of the exile to Babylon."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "MAT 1:12"
        },
        "After the exile to Babylon:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Jeconiah was the father of Shealtiel,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Shealtiel the father of Zerubbabel,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MAT 1:13"
        },
        "Zerubbabel the father of Abiud,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Abiud the father of Eliakim,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "and Eliakim the father of Azor."
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MAT 1:14"
        },
        "Azor was the father of Zadok,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Zadok the father of Achim,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "and Achim the father of Eliud."
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "MAT 1:15"
        },
        "Eliud was the father of Eleazar,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Eleazar the father of Matthan,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Matthan the father of Jacob,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "MAT 1:16"
        },
        "and Jacob the father of Joseph, the husband of Mary,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "of whom was born Jesus, who is called Christ."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "MAT 1:17"
        },
        "In all, then, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "there were"
          ]
        },
        " fourteen generations from Abraham to David, fourteen from David to the exile to Babylon, and fourteen from the exile to the Christ."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Birth of Jesus"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ISA 7:10-16",
          "content": [
            "Isaiah 7:10–16"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 2:1-7",
          "content": [
            "Luke 2:1–7"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "MAT 1:18"
        },
        "This is how the birth of Jesus Christ came about: His mother Mary was pledged in marriage to Joseph, but before they came together, she was found to be with child through ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Holy Spirit. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "MAT 1:19"
        },
        "Because Joseph her husband was a righteous man and was unwilling to disgrace her publicly, he resolved to divorce her quietly."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "MAT 1:20"
        },
        "But after he had pondered these things, an angel of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord appeared to him in a dream ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, “Joseph, son of David, do not be afraid to embrace Mary ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as"
          ]
        },
        " your wife, for the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "One"
          ]
        },
        " conceived in her is from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Holy Spirit. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "MAT 1:21"
        },
        "She will give birth to a Son, and you are to give Him the name Jesus,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:21 "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Jesus "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "means "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "The LORD saves"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "."
              ]
            }
          ]
        },
        " because He will save His people from their sins.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "MAT 1:22"
        },
        "All this took place to fulfill what the Lord had said through the prophet:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MAT 1:23"
        },
        "“Behold, the virgin will be with child"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and will give birth to a son,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "and they will call Him Immanuel”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:23 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "they will call His name Immanuel"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; ",
                {
                  "type": "ref",
                  "loc": "ISA 7:14",
                  "content": [
                    "Isaiah 7:14"
                  ]
                },
                " (see also DSS)"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "(which means, “God with us”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:23 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "See ",
                {
                  "type": "ref",
                  "loc": "ISA 7:14",
                  "content": [
                    "Isaiah 7:14"
                  ]
                },
                ", Isaiah 8:8, and Isaiah 8:10."
              ]
            }
          ]
        },
        ")."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "MAT 1:24"
        },
        "When Joseph woke up, he did as the angel of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord had commanded him and embraced ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Mary as"
          ]
        },
        " his wife. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "MAT 1:25"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "But"
          ]
        },
        " he had no union with her",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:25 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "he did not know her"
              ]
            }
          ]
        },
        " until she gave birth to a Son. And he gave Him the name Jesus."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "2",
      "sid": "MAT 2"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Pilgrimage of the Magi"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MIC 5:1-6",
          "content": [
            "Micah 5:1–6"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MAT 2:1"
        },
        "After Jesus was born in Bethlehem in Judea, during ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " time of King Herod, Magi from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " east arrived in Jerusalem, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MAT 2:2"
        },
        "asking, “Where is the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "One who"
          ]
        },
        " has been born King of the Jews? We saw His star in the east",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:2 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "as it rose"
              ]
            }
          ]
        },
        " and have come to worship Him.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "MAT 2:3"
        },
        "When King Herod heard ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        ", he was disturbed, and all Jerusalem with him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "MAT 2:4"
        },
        "And when he had assembled all the chief priests and scribes of the people, he asked them where the Christ was to be born."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MAT 2:5"
        },
        "“In Bethlehem in Judea,” they replied, “for this is what the prophet has written:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "MAT 2:6"
        },
        "‘",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "But"
          ]
        },
        " you, Bethlehem, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "in the"
          ]
        },
        " land of Judah,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "are by no means least among the rulers of Judah,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "for out of you will come a ruler"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "who will be the shepherd of My people Israel.’",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:6 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "MIC 5:2",
                  "content": [
                    "Micah 5:2"
                  ]
                },
                "; see also 2 Samuel 5:2."
              ]
            }
          ]
        },
        "”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MAT 2:7"
        },
        "Then Herod called the Magi secretly ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " learned from them the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "exact"
          ]
        },
        " time the star had appeared. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "MAT 2:8"
        },
        "And sending them to Bethlehem, he said: “Go ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " search carefully for the Child, and when you find ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        ", report to me, so that I too may go ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " worship Him.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MAT 2:9"
        },
        "After they had heard the king, they went on their way, and the star they had seen in the east went ahead of them until it stood over the place where the Child was. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "MAT 2:10"
        },
        "When they saw the star, they rejoiced with great delight. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "MAT 2:11"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "On"
          ]
        },
        " coming to the house, they saw the Child with His mother Mary, and they fell down ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " worshiped Him. Then they opened their treasures ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " presented Him with gifts ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of"
          ]
        },
        " gold and frankincense and myrrh."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "MAT 2:12"
        },
        "And having been warned in a dream not to return to Herod, they withdrew to their country by another route."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Flight to Egypt"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "HOS 11:1-7",
          "content": [
            "Hosea 11:1–7"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MAT 2:13"
        },
        "When ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the Magi"
          ]
        },
        " had gone, an angel of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord appeared to Joseph in a dream. “Get up!” he said. “Take the Child and His mother and flee to Egypt. Stay there until I tell you, for Herod is going to search for the Child to kill Him.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MAT 2:14"
        },
        "So he got up, took the Child and His mother by night, and withdrew to Egypt, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "MAT 2:15"
        },
        "where he stayed until the death of Herod. This fulfilled what ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord had spoken through the prophet: “Out of Egypt I called My Son.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:15 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "HOS 11:1",
                  "content": [
                    "Hosea 11:1"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Weeping and Great Mourning"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "JER 31:1-25",
          "content": [
            "Jeremiah 31:1–25"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "MAT 2:16"
        },
        "When Herod saw that he had been outwitted by the Magi, he was filled with rage. Sending orders, he put to death all the boys in Bethlehem and its vicinity ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who were"
          ]
        },
        " two years old and under, according to the time he had learned from the Magi. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "MAT 2:17"
        },
        "Then what was spoken through the prophet Jeremiah was fulfilled:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "MAT 2:18"
        },
        "“A voice is heard in Ramah,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "weeping and great mourning,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "Rachel weeping ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "for"
          ]
        },
        " her children"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and refusing to be comforted,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "because they are no more.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:18 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "JER 31:15",
                  "content": [
                    "Jeremiah 31:15"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Return to Nazareth"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 2:39-40",
          "content": [
            "Luke 2:39–40"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "MAT 2:19"
        },
        "After Herod died, an angel of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord appeared in a dream to Joseph in Egypt. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "MAT 2:20"
        },
        "“Get up!” he said. “Take the Child and His mother and go to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " land of Israel, for those seeking the Child’s life are now dead.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "MAT 2:21"
        },
        "So ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Joseph"
          ]
        },
        " got up, took the Child and His mother, and went to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " land of Israel. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "MAT 2:22"
        },
        "But when he learned that Archelaus was reigning in Judea in place of his father Herod, he was afraid to go there. And having been warned in a dream, he withdrew to the district of Galilee, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MAT 2:23"
        },
        "and he went ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " lived in a town called Nazareth. So was fulfilled what was spoken through the prophets: “He will be called a Nazarene.”"
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "3",
      "sid": "MAT 3"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Mission of John the Baptist"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ISA 40:1-5",
          "content": [
            "Isaiah 40:1–5"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MRK 1:1-8",
          "content": [
            "Mark 1:1–8"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 3:1-20",
          "content": [
            "Luke 3:1–20"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 1:19-28",
          "content": [
            "John 1:19–28"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MAT 3:1"
        },
        "In those days John the Baptist came, preaching in the wilderness of Judea ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MAT 3:2"
        },
        "and saying, “Repent, for the kingdom of heaven is near.” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "MAT 3:3"
        },
        "This is he who was spoken of through the prophet Isaiah:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "A"
          ]
        },
        " voice of one calling in the wilderness,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "‘Prepare the way for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "make straight paths for Him.’”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:3 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 40:3",
                  "content": [
                    "Isaiah 40:3"
                  ]
                },
                " (see also LXX)"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "MAT 3:4"
        },
        "John wore a garment of camel’s hair, with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "a"
          ]
        },
        " leather belt around his waist. His food was locusts and wild honey. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MAT 3:5"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "People"
          ]
        },
        " went out to him ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "from"
          ]
        },
        " Jerusalem and all Judea and the whole region around the Jordan. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "MAT 3:6"
        },
        "Confessing their sins, they were baptized by him in the Jordan River."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MAT 3:7"
        },
        "But when ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "John"
          ]
        },
        " saw many of the Pharisees and Sadducees coming to his ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "place of"
          ]
        },
        " baptism, he said to them, “",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "You"
          ]
        },
        " brood of vipers, who warned you to flee from the coming wrath? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "MAT 3:8"
        },
        "Produce fruit, then, in keeping with repentance. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MAT 3:9"
        },
        "And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do"
          ]
        },
        " not presume to say to yourselves, ‘We have Abraham ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as our"
          ]
        },
        " father.’ For I tell you that out of these stones God can raise up children for Abraham. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "MAT 3:10"
        },
        "The axe lies ready at the root of the trees, and every tree that does not produce good fruit will be cut down and thrown into ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " fire."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "MAT 3:11"
        },
        "I baptize you with water",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:11 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "in water"
              ]
            }
          ]
        },
        " for repentance, but after me will come ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "One"
          ]
        },
        " more powerful than I, whose sandals I am not worthy to carry. He will baptize you with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Holy Spirit and with fire.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:11 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "in the Holy Spirit and in fire"
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "MAT 3:12"
        },
        "His winnowing fork ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " in His hand to clear His threshing floor and to gather His wheat into the barn; but He will burn up the chaff with unquenchable fire.”"
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Baptism of Jesus"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 1:9-11",
          "content": [
            "Mark 1:9–11"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 3:21-22",
          "content": [
            "Luke 3:21–22"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 1:29-34",
          "content": [
            "John 1:29–34"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MAT 3:13"
        },
        "At that time Jesus came from Galilee to the Jordan to be baptized by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "John"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MAT 3:14"
        },
        "But John tried to prevent Him, saying, “I need to be baptized by You, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do"
          ]
        },
        " You come to me?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "15",
              "sid": "MAT 3:15"
            },
            "“Let ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            " be so now,”"
          ]
        },
        " Jesus replied. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“It is fitting for us to fulfill all righteousness in this way.”"
          ]
        },
        " Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "John"
          ]
        },
        " permitted Him."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "MAT 3:16"
        },
        "As soon as ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " was baptized, He went up out of the water. Suddenly the heavens were opened,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:16 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "NA, BYZ, and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "the heavens were opened to Him"
              ]
            }
          ]
        },
        " and He saw",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:16 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "and he saw"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; see ",
                {
                  "type": "ref",
                  "loc": "JHN 1:32-33",
                  "content": [
                    "John 1:32–33"
                  ]
                },
                "."
              ]
            }
          ]
        },
        " the Spirit of God descending like a dove and resting on Him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "MAT 3:17"
        },
        "And a voice from heaven said, “This is My beloved Son, in whom I am well pleased!”"
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "4",
      "sid": "MAT 4"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Temptation of Jesus"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 1:12-13",
          "content": [
            "Mark 1:12–13"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 4:1-13",
          "content": [
            "Luke 4:1–13"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MAT 4:1"
        },
        "Then Jesus was led by the Spirit into the wilderness to be tempted by the devil. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MAT 4:2"
        },
        "After fasting forty days and forty nights, He was hungry."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "MAT 4:3"
        },
        "The tempter came to Him ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, “If You are ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Son of God, tell these stones to become bread.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "MAT 4:4"
        },
        "But ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " answered, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“It is written:"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "‘Man shall not live on bread alone,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "but on every word that comes from ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " mouth of God.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "4:4 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "DEU 8:3",
                      "content": [
                        "Deuteronomy 8:3"
                      ]
                    }
                  ]
                }
              ]
            },
            "”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MAT 4:5"
        },
        "Then the devil took Him to the holy city and set Him on the pinnacle of the temple. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "MAT 4:6"
        },
        "“If You are ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Son of God,” he said, “throw Yourself down. For it is written:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "‘He will command His angels concerning You,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and they will lift You up in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their"
          ]
        },
        " hands,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "so that You will not strike Your foot"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "against a stone.’",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "4:6 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "PSA 91:11-12",
                  "content": [
                    "Psalm 91:11–12"
                  ]
                }
              ]
            }
          ]
        },
        "”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MAT 4:7"
        },
        "Jesus replied, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“It is also written: ‘Do not put ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " Lord your God ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "to the test"
              ]
            },
            ".’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "4:7 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "DEU 6:16",
                      "content": [
                        "Deuteronomy 6:16"
                      ]
                    }
                  ]
                }
              ]
            },
            "”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "MAT 4:8"
        },
        "Again, the devil took Him to a very high mountain and showed Him all the kingdoms of the world and their glory. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MAT 4:9"
        },
        "“All this I will give You,” he said, “if You will fall down ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " worship me.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "10",
              "sid": "MAT 4:10"
            },
            "“Away from Me, Satan!”"
          ]
        },
        " Jesus told him. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“For it is written: ‘Worship ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " Lord your God and serve Him only.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "4:10 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "DEU 6:13",
                      "content": [
                        "Deuteronomy 6:13"
                      ]
                    }
                  ]
                }
              ]
            },
            "”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "MAT 4:11"
        },
        "Then the devil left Him, and angels came and ministered to Him."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Begins His Ministry"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ISA 9:1-7",
          "content": [
            "Isaiah 9:1–7"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MRK 1:14-15",
          "content": [
            "Mark 1:14–15"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 4:14-15",
          "content": [
            "Luke 4:14–15"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "MAT 4:12"
        },
        "When ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " heard that John had been imprisoned, He withdrew to Galilee. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MAT 4:13"
        },
        "Leaving Nazareth, He went ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " lived in Capernaum, which ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " by the sea in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " region of Zebulun and Naphtali, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MAT 4:14"
        },
        "to fulfill what was spoken through the prophet Isaiah:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "MAT 4:15"
        },
        "“Land of Zebulun"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and land of Naphtali,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Way of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Sea, beyond the Jordan,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "Galilee of the Gentiles —"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "MAT 4:16"
        },
        "the people living in darkness"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "have seen ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "a"
          ]
        },
        " great light;"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "on those living in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " land ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of the"
          ]
        },
        " shadow of death,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "a light has dawned.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "4:16 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 9:1-2",
                  "content": [
                    "Isaiah 9:1–2"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "MAT 4:17"
        },
        "From that time ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "on"
          ]
        },
        " Jesus began to preach, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Repent, for the kingdom of heaven is near.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The First Disciples"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 1:16-20",
          "content": [
            "Mark 1:16–20"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 5:1-11",
          "content": [
            "Luke 5:1–11"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 1:35-42",
          "content": [
            "John 1:35–42"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "MAT 4:18"
        },
        "As ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " was walking beside the Sea of Galilee, He saw two brothers, Simon called Peter and his brother Andrew. They were casting a net into the sea, for they were fishermen. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "19",
              "sid": "MAT 4:19"
            },
            "“Come, follow Me,”"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“and I will make you fishers of men.”"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "MAT 4:20"
        },
        "And at once they left ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their"
          ]
        },
        " nets ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " followed Him."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "MAT 4:21"
        },
        "Going on from there, He saw two other brothers, James ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "son"
          ]
        },
        " of Zebedee and his brother John. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "They were"
          ]
        },
        " in a boat with their father Zebedee, mending their nets. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " called them, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "MAT 4:22"
        },
        "and immediately they left the boat and their father ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " followed Him."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Heals the Multitudes"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 3:7-12",
          "content": [
            "Mark 3:7–12"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 6:17-19",
          "content": [
            "Luke 6:17–19"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MAT 4:23"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " went throughout Galilee, teaching in their synagogues, preaching the gospel of the kingdom, and healing every disease and sickness among the people. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "MAT 4:24"
        },
        "News about Him spread all over Syria, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "people"
          ]
        },
        " brought to Him all who were ill with various diseases, those suffering acute pain, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " demon-possessed, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "those"
          ]
        },
        " having seizures, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " paralyzed, and He healed them."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "MAT 4:25"
        },
        "Large crowds followed Him, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "having come"
          ]
        },
        " from Galilee, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Decapolis,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "4:25 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "That is, the Ten Cities"
              ]
            }
          ]
        },
        " Jerusalem, Judea, and beyond the Jordan."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "5",
      "sid": "MAT 5"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Sermon on the Mount"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MAT 5:1"
        },
        "When Jesus saw the crowds, He went up on the mountain and sat down. His disciples came to Him, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MAT 5:2"
        },
        "and He began to teach them, saying:"
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Beatitudes"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "PSA 1:1-6",
          "content": [
            "Psalm 1:1–6"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 6:20-23",
          "content": [
            "Luke 6:20–23"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "MAT 5:3"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Blessed ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "are"
              ]
            },
            " the poor in spirit,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "for theirs is the kingdom of heaven."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "MAT 5:4"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Blessed ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "are"
              ]
            },
            " those who mourn,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "for they will be comforted."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MAT 5:5"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Blessed ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "are"
              ]
            },
            " the meek,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "for they will inherit the earth.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "5:5 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "Blessed are those who exercise strength under control, for they will inherit the land"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "; see ",
                    {
                      "type": "ref",
                      "loc": "PSA 37:11",
                      "content": [
                        "Psalm 37:11"
                      ]
                    },
                    "."
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "MAT 5:6"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Blessed ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "are"
              ]
            },
            " those who hunger and thirst for righteousness,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "for they will be filled."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MAT 5:7"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Blessed ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "are"
              ]
            },
            " the merciful,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "for they will be shown mercy."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "MAT 5:8"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Blessed ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "are"
              ]
            },
            " the pure in heart,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "for they will see God."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MAT 5:9"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Blessed ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "are"
              ]
            },
            " the peacemakers,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "for they will be called sons of God."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "MAT 5:10"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Blessed ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "are"
              ]
            },
            " those who are persecuted because of righteousness,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "for theirs is the kingdom of heaven."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "MAT 5:11"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Blessed are you when ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "people"
              ]
            },
            " insult you, persecute ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "you"
              ]
            },
            ", and falsely say all kinds of evil against you because of Me. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "12",
              "sid": "MAT 5:12"
            },
            "Rejoice and be glad, because great ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " your reward in heaven, for in the same way they persecuted the prophets before you."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Salt and Light"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 9:49-50",
          "content": [
            "Mark 9:49–50"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 14:34-35",
          "content": [
            "Luke 14:34–35"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "PHP 2:12-18",
          "content": [
            "Philippians 2:12–18"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MAT 5:13"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "You are the salt of the earth. But if the salt loses its savor, how can it be made salty again? It is no longer good for ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "anything"
              ]
            },
            ", except to be thrown out ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " trampled by men."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MAT 5:14"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "You are the light of the world. A city on a hill",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "5:14 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Literally "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "A city lying on a hill"
                  ]
                }
              ]
            },
            " cannot be hidden. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "15",
              "sid": "MAT 5:15"
            },
            "Neither do ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "people"
              ]
            },
            " light a lamp and put it under a basket. Instead, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "they set it"
              ]
            },
            " on a stand, and it gives light to everyone in the house. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "16",
              "sid": "MAT 5:16"
            },
            "In the same way, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "let"
              ]
            },
            " your light shine before men, that they may see your good deeds and glorify your Father in heaven."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Fulfillment of the Law"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "MAT 5:17"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            {
              "type": "char",
              "marker": "add",
              "content": [
                "Do"
              ]
            },
            " not think that I have come to abolish the Law or the Prophets. I have not come to abolish ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "them"
              ]
            },
            ", but to fulfill ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "them"
              ]
            },
            ". ",
            {
              "type": "verse",
              "marker": "v",
              "number": "18",
              "sid": "MAT 5:18"
            },
            "For I tell you truly, until heaven and earth pass away, not a single jot, not a stroke of a pen, will disappear from the Law until everything is accomplished."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "MAT 5:19"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "So then, whoever breaks one of the least of these commandments and teaches others to do likewise will be called least in the kingdom of heaven; but whoever practices and teaches ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "them"
              ]
            },
            " will be called great in the kingdom of heaven. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "20",
              "sid": "MAT 5:20"
            },
            "For I tell you that unless your righteousness exceeds ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "that"
              ]
            },
            " of the scribes and Pharisees, you will never enter the kingdom of heaven."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Anger and Reconciliation"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 12:57-59",
          "content": [
            "Luke 12:57–59"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "MAT 5:21"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "You have heard that it was said to the ancients, ‘Do not murder’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "5:21 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "EXO 20:13",
                      "content": [
                        "Exodus 20:13"
                      ]
                    },
                    "; Deuteronomy 5:17"
                  ]
                }
              ]
            },
            " and ‘Anyone who murders will be subject to judgment.’ ",
            {
              "type": "verse",
              "marker": "v",
              "number": "22",
              "sid": "MAT 5:22"
            },
            "But I tell you that anyone who is angry with his brother",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "5:22 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "BYZ and TR include "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "without cause"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "."
                  ]
                }
              ]
            },
            " will be subject to judgment. Again, anyone who says to his brother, ‘Raca,’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "5:22 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "Raca "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "is an Aramaic expression of contempt."
                  ]
                }
              ]
            },
            " will be subject to the Sanhedrin.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "5:22 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "the Council"
                  ]
                }
              ]
            },
            " But anyone who says, ‘You fool!’ will be subject to the fire of hell.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "5:22 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "the hell of fire"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "; Greek "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "the Gehenna of fire"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MAT 5:23"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "So if you are offering your gift at the altar and there remember that your brother has something against you, ",
            {
              "type": "verse",
              "marker": "v",
              "number": "24",
              "sid": "MAT 5:24"
            },
            "leave your gift there before the altar. First go ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " be reconciled to your brother; then come ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " offer your gift."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "MAT 5:25"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Reconcile quickly with your adversary, while you are still on the way ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "to court"
              ]
            },
            ". Otherwise, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "he"
              ]
            },
            " may hand you over to the judge, and the judge ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "may hand you over"
              ]
            },
            " to the officer, and you may be thrown into prison. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "26",
              "sid": "MAT 5:26"
            },
            "Truly I tell you, you will not get out until you have paid the last penny.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "5:26 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Greek "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "kodrantēn"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "; that is, a Roman copper coin worth about 1/64 of a denarius"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Adultery"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LEV 18:1-30",
          "content": [
            "Leviticus 18:1–30"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "MAT 5:27"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "You have heard that it was said, ‘Do not commit adultery.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "5:27 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "EXO 20:14",
                      "content": [
                        "Exodus 20:14"
                      ]
                    },
                    "; Deuteronomy 5:18"
                  ]
                }
              ]
            },
            {
              "type": "verse",
              "marker": "v",
              "number": "28",
              "sid": "MAT 5:28"
            },
            "But I tell you that anyone who looks at a woman to lust after her ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "has"
              ]
            },
            " already committed adultery with her in his heart. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "29",
              "sid": "MAT 5:29"
            },
            "If your right eye causes you to sin, gouge it out and throw ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            " away. It is better for you to lose one part of your body ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "than for"
              ]
            },
            " your whole body to be thrown into hell.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "5:29 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Greek "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "Gehenna"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "; also in verse 30"
                  ]
                }
              ]
            },
            {
              "type": "verse",
              "marker": "v",
              "number": "30",
              "sid": "MAT 5:30"
            },
            "And if your right hand causes you to sin, cut it off and throw ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            " away. It is better for you to lose one part of your body ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "than for"
              ]
            },
            " your whole body to depart into hell."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Divorce"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "DEU 24:1-5",
          "content": [
            "Deuteronomy 24:1–5"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 16:18",
          "content": [
            "Luke 16:18"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "MAT 5:31"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "It has also been said, ‘Whoever divorces his wife must give her a certificate of divorce.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "5:31 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "DEU 24:1",
                      "content": [
                        "Deuteronomy 24:1"
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "verse",
              "marker": "v",
              "number": "32",
              "sid": "MAT 5:32"
            },
            "But I tell you that anyone who divorces his wife, except for sexual immorality, brings adultery upon her.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "5:32 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "causes her to commit adultery"
                  ]
                }
              ]
            },
            " And he who marries a divorced woman commits adultery."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Oaths and Vows"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "NUM 30:1-16",
          "content": [
            "Numbers 30:1–16"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "MAT 5:33"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Again, you have heard that it was said to the ancients, ‘Do not break your oath, but fulfill your vows to the Lord.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "5:33 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "NUM 30:2",
                      "content": [
                        "Numbers 30:2"
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "verse",
              "marker": "v",
              "number": "34",
              "sid": "MAT 5:34"
            },
            "But I tell you not to swear at all: ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "either"
              ]
            },
            " by heaven, for it is God’s throne; ",
            {
              "type": "verse",
              "marker": "v",
              "number": "35",
              "sid": "MAT 5:35"
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "or"
              ]
            },
            " by the earth, for it is His footstool; ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "or"
              ]
            },
            " by Jerusalem, for it is ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " city of the great King. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "36",
              "sid": "MAT 5:36"
            },
            "Nor should you swear by your head, for you cannot make a single hair white or black. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "37",
              "sid": "MAT 5:37"
            },
            "Simply let your ‘Yes’ ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "be"
              ]
            },
            " ‘Yes,’ ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and your"
              ]
            },
            " ‘No,’ ‘No.’ Anything more comes from the evil ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "one"
              ]
            },
            ".",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "5:37 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "from evil"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Love Your Enemies"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LEV 24:17-23",
          "content": [
            "Leviticus 24:17–23"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 6:27-36",
          "content": [
            "Luke 6:27–36"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "38",
          "sid": "MAT 5:38"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "You have heard that it was said, ‘Eye for eye and tooth for tooth.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "5:38 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "EXO 21:24",
                      "content": [
                        "Exodus 21:24"
                      ]
                    },
                    "; Leviticus 24:20; Deuteronomy 19:21"
                  ]
                }
              ]
            },
            {
              "type": "verse",
              "marker": "v",
              "number": "39",
              "sid": "MAT 5:39"
            },
            "But I tell you not to resist an evil ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "person"
              ]
            },
            ". ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "If"
              ]
            },
            " someone slaps you on your right cheek, turn to him the other also; ",
            {
              "type": "verse",
              "marker": "v",
              "number": "40",
              "sid": "MAT 5:40"
            },
            "if someone wants to sue you and take your tunic, let him have ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "your"
              ]
            },
            " cloak as well; ",
            {
              "type": "verse",
              "marker": "v",
              "number": "41",
              "sid": "MAT 5:41"
            },
            "and if someone forces you to go one mile,",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "5:41 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Greek "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "one milion"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "; that is, a Roman mile, approximately 4,855 feet or 1,480 meters"
                  ]
                }
              ]
            },
            " go with him two ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "miles"
              ]
            },
            ".",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "5:41 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Literally "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "go with him two."
                  ]
                }
              ]
            },
            {
              "type": "verse",
              "marker": "v",
              "number": "42",
              "sid": "MAT 5:42"
            },
            "Give to the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "one"
              ]
            },
            " who asks you, and do not turn away from the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "one"
              ]
            },
            " who wants to borrow from you."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "43",
          "sid": "MAT 5:43"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "You have heard that it was said, ‘Love your neighbor’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "5:43 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "LEV 19:18",
                      "content": [
                        "Leviticus 19:18"
                      ]
                    }
                  ]
                }
              ]
            },
            " and ‘Hate your enemy.’ ",
            {
              "type": "verse",
              "marker": "v",
              "number": "44",
              "sid": "MAT 5:44"
            },
            "But I tell you, love your enemies and pray for those who persecute you,",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "5:44 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "BYZ and TR "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "love your enemies, bless those who curse you, do good to those who hate you, and pray for those who spitefully accuse you and persecute you"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "; see ",
                    {
                      "type": "ref",
                      "loc": "LUK 6:27-28",
                      "content": [
                        "Luke 6:27–28"
                      ]
                    },
                    "."
                  ]
                }
              ]
            },
            {
              "type": "verse",
              "marker": "v",
              "number": "45",
              "sid": "MAT 5:45"
            },
            "that you may be sons of your Father in heaven. He causes His sun ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "to rise"
              ]
            },
            " on ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " evil and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " good, and sends rain on ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " righteous and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " unrighteous. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "46",
              "sid": "MAT 5:46"
            },
            "If you love those who love you, what reward will you get? Do not even tax collectors do the same? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "47",
              "sid": "MAT 5:47"
            },
            "And if you greet only your brothers, what are you doing more than others? Do not even Gentiles do the same?"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "48",
          "sid": "MAT 5:48"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Be perfect, therefore, as your heavenly Father is perfect.’’"
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "6",
      "sid": "MAT 6"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Giving to the Needy"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "DEU 15:7-11",
          "content": [
            "Deuteronomy 15:7–11"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MAT 6:1"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            {
              "type": "char",
              "marker": "add",
              "content": [
                "“"
              ]
            },
            "Be careful not to perform your righteous acts",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "6:1 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "BYZ and TR "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "charitable acts "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "alms"
                  ]
                }
              ]
            },
            " before men to be seen by them. If ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "you do"
              ]
            },
            ", you will have no reward from your Father in heaven."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MAT 6:2"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "So when you give to the needy, do not sound a trumpet before you, as the hypocrites do in the synagogues and on the streets, to be honored by men. Truly I tell you, they already have their full reward. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "3",
              "sid": "MAT 6:3"
            },
            "But ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "when"
              ]
            },
            " you give to the needy, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "do"
              ]
            },
            " not ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "let"
              ]
            },
            " your left ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "hand"
              ]
            },
            " know what your right hand is doing, ",
            {
              "type": "verse",
              "marker": "v",
              "number": "4",
              "sid": "MAT 6:4"
            },
            "so that your giving may be in secret. And your Father, who sees what is done in secret, will reward you."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Lord’s Prayer"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 11:1-4",
          "content": [
            "Luke 11:1–4"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MAT 6:5"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "And when you pray, do not be like the hypocrites. For they love to pray standing in the synagogues and on the street corners to be seen by men. Truly I tell you, they already have their full reward. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "6",
              "sid": "MAT 6:6"
            },
            "But when you pray, go into your inner room, shut your door, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " pray to your Father, who ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " unseen. And your Father, who sees what is done in secret, will reward you."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MAT 6:7"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "And ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "when"
              ]
            },
            " you pray, do not babble on like pagans, for they think that by their many words they will be heard. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "8",
              "sid": "MAT 6:8"
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "Do"
              ]
            },
            " not be like them, for your Father knows what you need before you ask Him."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MAT 6:9"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "So then, this is how you should pray:"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "‘Our Father in heaven,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "hallowed be Your name."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "MAT 6:10"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Your kingdom come,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Your will be done,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "on earth as ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it is"
              ]
            },
            " in heaven."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "MAT 6:11"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Give us this day our daily bread."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "MAT 6:12"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "And forgive us our debts,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "as we also have forgiven our debtors."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MAT 6:13"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "And lead us not into temptation,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "but deliver us from the evil ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "one"
              ]
            },
            ".",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "6:13 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "from evil"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "; BYZ and TR include "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "For Yours is the kingdom and the power and the glory, forever. Amen."
                  ]
                }
              ]
            },
            "’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MAT 6:14"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "For if you forgive men their trespasses, your heavenly Father will also forgive you. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "15",
              "sid": "MAT 6:15"
            },
            "But if you do not forgive men their trespasses, neither ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "will"
              ]
            },
            " your Father forgive yours."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Proper Fasting"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "MAT 6:16"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "When you fast, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "do"
              ]
            },
            " not be somber like the hypocrites, for they disfigure their faces to show men they are fasting. Truly I tell you, they already have their full reward. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "17",
              "sid": "MAT 6:17"
            },
            "But ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "when"
              ]
            },
            " you fast, anoint your head and wash your face, ",
            {
              "type": "verse",
              "marker": "v",
              "number": "18",
              "sid": "MAT 6:18"
            },
            "so that ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "your"
              ]
            },
            " fasting will not be obvious to men, but only to your Father, who ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " unseen. And your Father, who sees what is done in secret, will reward you."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Treasures in Heaven"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 12:32-34",
          "content": [
            "Luke 12:32–34"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "MAT 6:19"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            {
              "type": "char",
              "marker": "add",
              "content": [
                "Do"
              ]
            },
            " not store up for yourselves treasures on earth, where moth and rust",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "6:19 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "worm"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "; also in verse 20"
                  ]
                }
              ]
            },
            " destroy, and where thieves break in and steal. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "20",
              "sid": "MAT 6:20"
            },
            "But store up for yourselves treasures in heaven, where moth ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " rust do not destroy, and where thieves do not break in ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " steal. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "21",
              "sid": "MAT 6:21"
            },
            "For where your treasure is, there your heart will be also."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Lamp of the Body"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 11:33-36",
          "content": [
            "Luke 11:33–36"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "MAT 6:22"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "The eye is the lamp of the body. If your eyes are good,",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "6:22 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Literally "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "If your eye is sound"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "; see ",
                    {
                      "type": "ref",
                      "loc": "PRO 22:9",
                      "content": [
                        "Proverbs 22:9"
                      ]
                    }
                  ]
                }
              ]
            },
            " your whole body will be full of light. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "23",
              "sid": "MAT 6:23"
            },
            "But if your eyes are bad,",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "6:23 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Literally "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "if your eye is evil"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "; see ",
                    {
                      "type": "ref",
                      "loc": "PRO 23:6",
                      "content": [
                        "Proverbs 23:6"
                      ]
                    },
                    " and Proverbs 28:22"
                  ]
                }
              ]
            },
            " your whole body will be full of darkness. If then the light within you is darkness, how great ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " that darkness!"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "MAT 6:24"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "No one can serve two masters: Either he will hate the one and love the other, or he will be devoted to ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " one and despise the other. You cannot serve ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "both"
              ]
            },
            " God and money."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Do Not Worry"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 12:22-31",
          "content": [
            "Luke 12:22–31"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "MAT 6:25"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Therefore I tell you, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "do"
              ]
            },
            " not worry about your life, what you will eat or drink; or ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "about"
              ]
            },
            " your body, what you will wear. Is not life more than food, and the body ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "more"
              ]
            },
            " than clothes? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "26",
              "sid": "MAT 6:26"
            },
            "Look at the birds of the air: They do not sow ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "or"
              ]
            },
            " reap ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "or"
              ]
            },
            " gather into barns, and yet your heavenly Father feeds them. ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "Are"
              ]
            },
            " you not much more valuable than they? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "27",
              "sid": "MAT 6:27"
            },
            "Who of you by worrying can add a single hour to his life?",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "6:27 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "a single cubit to his height"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "; a cubit was approximately 18 inches or 45 centimeters."
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "MAT 6:28"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "And why do you worry about clothes? Consider how the lilies of the field grow: ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "They do"
              ]
            },
            " not labor ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "or"
              ]
            },
            " spin. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "29",
              "sid": "MAT 6:29"
            },
            "Yet I tell you that not even Solomon in all his glory was adorned like one of these. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "30",
              "sid": "MAT 6:30"
            },
            "If that is how God clothes the grass of the field, which is ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "here"
              ]
            },
            " today and tomorrow ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " thrown into the furnace, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "will He"
              ]
            },
            " not much more ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "clothe"
              ]
            },
            " you, O ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "you"
              ]
            },
            " of little faith?"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "MAT 6:31"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Therefore ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "do"
              ]
            },
            " not worry, saying, ‘What shall we eat?’ or ‘What shall we drink?’ or ‘What shall we wear?’ ",
            {
              "type": "verse",
              "marker": "v",
              "number": "32",
              "sid": "MAT 6:32"
            },
            "For the Gentiles strive after all these things, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " your heavenly Father knows that you need them. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "33",
              "sid": "MAT 6:33"
            },
            "But seek first the kingdom of God",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "6:33 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "SBL, WH, and NE "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "seek first His kingdom"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "; see also ",
                    {
                      "type": "ref",
                      "loc": "LUK 12:31",
                      "content": [
                        "Luke 12:31"
                      ]
                    },
                    "."
                  ]
                }
              ]
            },
            " and His righteousness, and all these things will be added unto you."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "34",
          "sid": "MAT 6:34"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Therefore ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "do"
              ]
            },
            " not worry about tomorrow, for tomorrow will worry about itself. Today ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "has"
              ]
            },
            " enough trouble of its own.’’"
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "7",
      "sid": "MAT 7"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Judging Others"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 6:37-42",
          "content": [
            "Luke 6:37–42"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "ROM 14:1-12",
          "content": [
            "Romans 14:1–12"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MAT 7:1"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            {
              "type": "char",
              "marker": "add",
              "content": [
                "“"
              ]
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "Do"
              ]
            },
            " not judge, or you will be judged. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "2",
              "sid": "MAT 7:2"
            },
            "For with the same judgment you pronounce, you will be judged, and with the measure you ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "use"
              ]
            },
            ", it will be measured to you."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "MAT 7:3"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Why do you look at the speck in your brother’s eye but fail to notice ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " beam in your ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "own"
              ]
            },
            " eye? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "4",
              "sid": "MAT 7:4"
            },
            "How can you say to your brother, ‘Let me take the speck out of your eye,’ while ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "there is still"
              ]
            },
            " a beam in your ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "own"
              ]
            },
            " eye? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "5",
              "sid": "MAT 7:5"
            },
            "You hypocrite! First take the beam out of your ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "own"
              ]
            },
            " eye, and then you will see clearly to remove the speck from your brother’s eye."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "MAT 7:6"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            {
              "type": "char",
              "marker": "add",
              "content": [
                "Do"
              ]
            },
            " not give dogs what is holy; ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "do"
              ]
            },
            " not throw your pearls before swine. If you do, they may trample them under their feet, and then turn ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " tear you to pieces."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Ask, Seek, Knock"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 11:5-13",
          "content": [
            "Luke 11:5–13"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MAT 7:7"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Ask, and it will be given to you; seek, and you will find; knock, and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the door"
              ]
            },
            " will be opened to you. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "8",
              "sid": "MAT 7:8"
            },
            "For everyone who asks receives; he who seeks finds; and to him who knocks, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the door"
              ]
            },
            " will be opened."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MAT 7:9"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Which of you, if his son asks for bread, will give him a stone? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "10",
              "sid": "MAT 7:10"
            },
            "Or ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "if"
              ]
            },
            " he asks for a fish, will give him a snake? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "11",
              "sid": "MAT 7:11"
            },
            "So if you who are evil know how to give good gifts to your children, how much more ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "will"
              ]
            },
            " your Father in heaven give good things to those who ask Him!"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "MAT 7:12"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "In everything, then, do to others as you would have them do to you. For this is ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the essence of"
              ]
            },
            " the Law and the Prophets."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Narrow Gate"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 13:22-30",
          "content": [
            "Luke 13:22–30"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MAT 7:13"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Enter through the narrow gate. For wide ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " the gate and broad ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " the way that leads to destruction, and many enter through it. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "14",
              "sid": "MAT 7:14"
            },
            "But small ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " the gate and narrow the way that leads to life, and only a few find it."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "A Tree and Its Fruit"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 6:43-45",
          "content": [
            "Luke 6:43–45"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "MAT 7:15"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Beware of false prophets. ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "They"
              ]
            },
            " come to you in sheep’s clothing, but inwardly they are ravenous wolves. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "16",
              "sid": "MAT 7:16"
            },
            "By their fruit you will recognize them. Are grapes gathered from thornbushes, or figs from thistles? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "17",
              "sid": "MAT 7:17"
            },
            "Likewise, every good tree bears good fruit, but a bad tree bears bad fruit. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "18",
              "sid": "MAT 7:18"
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "A"
              ]
            },
            " good tree cannot bear bad fruit, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and a"
              ]
            },
            " bad tree cannot bear good fruit. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "19",
              "sid": "MAT 7:19"
            },
            "Every tree that does not bear good fruit is cut down and thrown into ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " fire. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "20",
              "sid": "MAT 7:20"
            },
            "So then, by their fruit you will recognize them."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "MAT 7:21"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Not everyone who says to Me, ‘Lord, Lord,’ will enter the kingdom of heaven, but only he who does the will of My Father in heaven. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "22",
              "sid": "MAT 7:22"
            },
            "Many will say to Me on that day, ‘Lord, Lord, did we not prophesy in Your name, and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "in"
              ]
            },
            " Your name drive out demons and perform many miracles?’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MAT 7:23"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Then I will tell them plainly, ‘I never knew you; depart from Me, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "you"
              ]
            },
            " workers of lawlessness!’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The House on the Rock"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 6:46-49",
          "content": [
            "Luke 6:46–49"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "MAT 7:24"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Therefore everyone who hears these words of Mine and acts on them is like ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "a"
              ]
            },
            " wise man who built his house on the rock. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "25",
              "sid": "MAT 7:25"
            },
            "The rain fell, the torrents raged, and the winds blew and beat against that house; yet it did not fall, because its foundation was on the rock."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "MAT 7:26"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "But everyone who hears these words of Mine and does not act on them is like a foolish man who built his house on sand. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "27",
              "sid": "MAT 7:27"
            },
            "The rain fell, the torrents raged, and the winds blew and beat against that house, and it fell— and great was its collapse!”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Authority of Jesus"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "MAT 7:28"
        },
        "When Jesus had finished saying these things, the crowds were astonished at His teaching, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "MAT 7:29"
        },
        "because He taught as ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one"
          ]
        },
        " who had authority, and not as their scribes."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "8",
      "sid": "MAT 8"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Leper’s Prayer"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LEV 14:1-32",
          "content": [
            "Leviticus 14:1–32"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MRK 1:40-45",
          "content": [
            "Mark 1:40–45"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 5:12-16",
          "content": [
            "Luke 5:12–16"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MAT 8:1"
        },
        "When ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " came down from the mountain, large crowds followed Him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MAT 8:2"
        },
        "Suddenly a leper",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "8:2 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "A "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "leper "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "was one afflicted with a skin disease. See Leviticus 13."
              ]
            }
          ]
        },
        " came ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " knelt before Him, saying, “Lord, if You are willing, You can make me clean.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "MAT 8:3"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " reached out ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " hand ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " touched ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the man"
          ]
        },
        ". ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“I am willing,”"
          ]
        },
        " He said. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Be clean!”"
          ]
        },
        " And immediately his leprosy was cleansed."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "MAT 8:4"
        },
        "Then Jesus instructed him, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“See that you don’t tell anyone. But go, show yourself to the priest and offer the gift prescribed by Moses, as a testimony to them.”",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "8:4 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "See ",
                    {
                      "type": "ref",
                      "loc": "LEV 14:1-32",
                      "content": [
                        "Leviticus 14:1–32"
                      ]
                    },
                    "."
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Faith of the Centurion"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 7:1-10",
          "content": [
            "Luke 7:1–10"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 4:43-54",
          "content": [
            "John 4:43–54"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MAT 8:5"
        },
        "When ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " had entered Capernaum, a centurion came ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " pleaded with Him, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "MAT 8:6"
        },
        "“Lord, my servant",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "8:6 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "child"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; also in verses 8 and 13"
              ]
            }
          ]
        },
        " lies at home, paralyzed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " in terrible agony.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "7",
              "sid": "MAT 8:7"
            },
            "“I will go ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " heal him,”"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " replied."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "MAT 8:8"
        },
        "The centurion answered, “Lord, I am not worthy to have You come under my roof. But just say the word, and my servant will be healed. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MAT 8:9"
        },
        "For I myself am a man under authority, with soldiers under me. I tell ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one"
          ]
        },
        " to go, and he goes, and another to come, and he comes. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "I tell"
          ]
        },
        " my servant to do something, and he does ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        ".”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "MAT 8:10"
        },
        "When Jesus heard ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        ", He marveled and said to those following ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        ", ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Truly I tell you, I have not found anyone in Israel ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "with"
              ]
            },
            " such great faith. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "11",
              "sid": "MAT 8:11"
            },
            "I say to you that many will come from ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " east and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " west to share the banquet with Abraham, Isaac, and Jacob in the kingdom of heaven. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "12",
              "sid": "MAT 8:12"
            },
            "But the sons of the kingdom will be thrown into the outer darkness, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "where"
              ]
            },
            " there will be weeping and gnashing of teeth.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MAT 8:13"
        },
        "Then Jesus said to the centurion, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Go! As you have believed, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "so"
              ]
            },
            " will it be done for you.”"
          ]
        },
        " And his servant was healed at that very hour."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Heals at Peter’s House"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 1:29-34",
          "content": [
            "Mark 1:29–34"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 4:38-41",
          "content": [
            "Luke 4:38–41"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MAT 8:14"
        },
        "When Jesus arrived at Peter’s house, He saw ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Peter’s"
          ]
        },
        " mother-in-law sick in bed with a fever. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "MAT 8:15"
        },
        "So He touched her hand, and the fever left her, and she got up and began to serve Him."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "MAT 8:16"
        },
        "When evening came, many who were demon-possessed were brought to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        ", and He drove out the spirits with a word and healed all the sick. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "MAT 8:17"
        },
        "This was to fulfill what was spoken through the prophet Isaiah:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“He took up our infirmities"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and carried our diseases.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "8:17 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 53:4",
                  "content": [
                    "Isaiah 53:4"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Cost of Discipleship"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 9:57-62",
          "content": [
            "Luke 9:57–62"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 14:25-33",
          "content": [
            "Luke 14:25–33"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 6:59-66",
          "content": [
            "John 6:59–66"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "MAT 8:18"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "When"
          ]
        },
        " Jesus saw ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "a"
          ]
        },
        " large crowd around Him, He gave orders to cross to the other side ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of the sea"
          ]
        },
        ".",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "8:18 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "That is, the Sea of Galilee; Greek "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "to the other side"
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "MAT 8:19"
        },
        "And one of the scribes came to Him ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, “Teacher, I will follow You wherever You go.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "MAT 8:20"
        },
        "Jesus replied, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Foxes have dens and birds of the air ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "have"
              ]
            },
            " nests, but ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " Son of Man has no ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "place"
              ]
            },
            " to lay ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "His"
              ]
            },
            " head.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "MAT 8:21"
        },
        "Another of His disciples requested, “Lord, first let me go and bury my father.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "MAT 8:22"
        },
        "But Jesus told him, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Follow Me, and let the dead bury their own dead.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Calms the Storm"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "PSA 107:1-43",
          "content": [
            "Psalm 107:1–43"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MRK 4:35-41",
          "content": [
            "Mark 4:35–41"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 8:22-25",
          "content": [
            "Luke 8:22–25"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MAT 8:23"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "When"
          ]
        },
        " He got into the boat, His disciples followed Him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "MAT 8:24"
        },
        "Suddenly a violent storm came up on the sea, so that the boat was engulfed by the waves. But ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " was sleeping. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "MAT 8:25"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The disciples"
          ]
        },
        " went ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " woke Him, saying, “Lord, save us! We are perishing!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "26",
              "sid": "MAT 8:26"
            },
            "“",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "You"
              ]
            },
            " of little faith,”"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " replied, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“why are you so afraid?”"
          ]
        },
        " Then He got up ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " rebuked the winds and the sea, and it was perfectly calm."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "MAT 8:27"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The"
          ]
        },
        " men were amazed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " asked, “What kind ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of man"
          ]
        },
        " is this? Even the winds and the sea obey Him!”"
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Demons and the Pigs"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 5:1-20",
          "content": [
            "Mark 5:1–20"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 8:26-39",
          "content": [
            "Luke 8:26–39"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "MAT 8:28"
        },
        "When ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " arrived on the other side in the region of the Gadarenes,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "8:28 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ, TR, and PT "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Gergesenes"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; other manuscripts "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Gerasenes"
              ]
            }
          ]
        },
        " He was met by two demon-possessed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "men"
          ]
        },
        " coming from the tombs. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "They were"
          ]
        },
        " so violent that no one could pass that way."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "MAT 8:29"
        },
        "“What do You ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "want"
          ]
        },
        " with us, Son of God?” they shouted. “Have You come here to torture us before ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " appointed time?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "MAT 8:30"
        },
        "In the distance a large herd of pigs was feeding. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "MAT 8:31"
        },
        "So the demons begged ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        ", “If You drive us out, send us into the herd of pigs.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "32",
              "sid": "MAT 8:32"
            },
            "“Go!”"
          ]
        },
        " He told them. So they came out and went into the pigs, and the whole herd rushed down the steep bank into the sea and died in the waters."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "MAT 8:33"
        },
        "Those tending ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the pigs"
          ]
        },
        " ran off into the town ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " reported all this, including the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "account"
          ]
        },
        " of the demon-possessed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "men"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "34",
          "sid": "MAT 8:34"
        },
        "Then the whole town went out to meet Jesus. And when they saw Him, they begged ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        " to leave their region."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "9",
      "sid": "MAT 9"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Heals a Paralytic"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 2:1-12",
          "content": [
            "Mark 2:1–12"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 5:17-26",
          "content": [
            "Luke 5:17–26"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MAT 9:1"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " got into a boat, crossed over, and came to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " own town. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MAT 9:2"
        },
        "Just then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "some men"
          ]
        },
        " brought",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "9:2 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "And behold, they brought"
              ]
            }
          ]
        },
        " to Him a paralytic lying on a mat. When Jesus saw their faith, He said to the paralytic, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Take courage, son; your sins are forgiven.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "MAT 9:3"
        },
        "On seeing this, some of the scribes said to themselves, “This ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        " is blaspheming!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "MAT 9:4"
        },
        "But Jesus knew",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "9:4 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "NA, BYZ, and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "saw"
              ]
            }
          ]
        },
        " what they were thinking ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Why do you harbor evil in your hearts? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "5",
              "sid": "MAT 9:5"
            },
            "Which is easier: to say, ‘Your sins are forgiven,’ or to say, ‘Get up and walk’? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "6",
              "sid": "MAT 9:6"
            },
            "But so that you may know that the Son of Man has authority on earth to forgive sins...”"
          ]
        },
        " Then He said to the paralytic, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Get up, pick up your mat, and go home.”"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MAT 9:7"
        },
        "And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the man"
          ]
        },
        " got up and went home."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "MAT 9:8"
        },
        "When the crowds saw this, they were filled with awe and glorified God, who had given such authority to men."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Calls Matthew"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 2:13-17",
          "content": [
            "Mark 2:13–17"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 5:27-32",
          "content": [
            "Luke 5:27–32"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MAT 9:9"
        },
        "As Jesus went on from there, He saw a man named Matthew sitting at the tax booth. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Follow Me,”"
          ]
        },
        " He told him, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Matthew"
          ]
        },
        " got up ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " followed Him."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "MAT 9:10"
        },
        "Later, as ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " was dining at ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Matthew’s"
          ]
        },
        " house, many tax collectors and sinners came ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " ate with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        " and His disciples. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "MAT 9:11"
        },
        "When the Pharisees saw this, they asked His disciples, “Why ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "does"
          ]
        },
        " your Teacher eat with tax collectors and sinners?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "MAT 9:12"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "On"
          ]
        },
        " hearing this, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "It is"
              ]
            },
            " not the healthy ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "who"
              ]
            },
            " need a doctor, but the sick. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "13",
              "sid": "MAT 9:13"
            },
            "But go ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " learn what this means: ‘I desire mercy, not sacrifice.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "9:13 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "HOS 6:6",
                      "content": [
                        "Hosea 6:6"
                      ]
                    }
                  ]
                }
              ]
            },
            " For I have not come to call ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " righteous, but sinners.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "9:13 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "BYZ and TR "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "but sinners, to repentance"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "; see ",
                    {
                      "type": "ref",
                      "loc": "LUK 5:32",
                      "content": [
                        "Luke 5:32"
                      ]
                    },
                    "."
                  ]
                }
              ]
            },
            "”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Questions about Fasting"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 2:18-20",
          "content": [
            "Mark 2:18–20"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 5:33-35",
          "content": [
            "Luke 5:33–35"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MAT 9:14"
        },
        "Then John’s disciples came to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " asked, “Why is it that we and the Pharisees fast so often,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "9:14 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "NE and WH do not include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "so often"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "."
              ]
            }
          ]
        },
        " but Your disciples ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do"
          ]
        },
        " not fast?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "MAT 9:15"
        },
        "Jesus replied, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“How can the guests of the bridegroom mourn while ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "He"
              ]
            },
            " is with them? But ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " time will come when the bridegroom will be taken from them; then they will fast."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Patches and the Wineskins"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 2:21-22",
          "content": [
            "Mark 2:21–22"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 5:36-39",
          "content": [
            "Luke 5:36–39"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "MAT 9:16"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "No one sews a patch of unshrunk cloth on an old garment. For the patch will pull away from the garment, and a worse tear will result."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "MAT 9:17"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Neither do ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "men"
              ]
            },
            " pour new wine into old wineskins. If they do, the skins will burst, the wine will spill, and the wineskins will be ruined. Instead, they pour new wine into new wineskins, and both are preserved.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Healing Touch of Jesus"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 5:21-43",
          "content": [
            "Mark 5:21–43"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 8:40-56",
          "content": [
            "Luke 8:40–56"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "MAT 9:18"
        },
        "While ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " was saying these things, a synagogue leader came ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " knelt before Him. “My daughter has just died,” he said. “But come ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " place Your hand on her, and she will live.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "MAT 9:19"
        },
        "So Jesus got up ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " went with him, along with His disciples. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "MAT 9:20"
        },
        "Suddenly a woman who had suffered from bleeding ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "for"
          ]
        },
        " twelve years came up behind ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " touched the fringe of His cloak. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "MAT 9:21"
        },
        "She said to herself, “If only I touch His cloak, I will be healed.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "MAT 9:22"
        },
        "Jesus turned and saw her. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Take courage, daughter,”"
          ]
        },
        " He said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“your faith has healed you.”"
          ]
        },
        " And the woman was healed from that very hour."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MAT 9:23"
        },
        "When Jesus entered the house of the synagogue leader, He saw the flute players and the noisy crowd. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "24",
              "sid": "MAT 9:24"
            },
            "“Go away,”"
          ]
        },
        " He told them. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“The girl is not dead, but asleep.”"
          ]
        },
        " And they laughed at Him."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "MAT 9:25"
        },
        "After the crowd had been put outside, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " went in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " took ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the girl"
          ]
        },
        " by the hand, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "she"
          ]
        },
        " got up. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "MAT 9:26"
        },
        "And the news about this spread throughout that region."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Heals the Blind and Mute"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 7:31-37",
          "content": [
            "Mark 7:31–37"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "MAT 9:27"
        },
        "As Jesus went on from there, two blind ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "men"
          ]
        },
        " followed Him, crying out, “Have mercy on us, Son of David!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "MAT 9:28"
        },
        "After ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " had entered the house, the blind ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "men"
          ]
        },
        " came to Him. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Do you believe that I am able to do this?”"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "He"
          ]
        },
        " asked."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "“Yes, Lord,” they answered."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "MAT 9:29"
        },
        "Then He touched their eyes ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“According to your faith will it be done to you.”"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "MAT 9:30"
        },
        "And their eyes were opened. Jesus warned them sternly, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“See that no one finds out about this!”"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "MAT 9:31"
        },
        "But they went out and spread the news about Him throughout the land."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "32",
          "sid": "MAT 9:32"
        },
        "As they were leaving, a demon-possessed man who was mute was brought to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "MAT 9:33"
        },
        "And when the demon had been driven out, the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        " began to speak. The crowds were amazed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, “Nothing like this has ever been seen in Israel!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "34",
          "sid": "MAT 9:34"
        },
        "But the Pharisees said, “",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "It is"
          ]
        },
        " by the prince of demons ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " He drives out demons.”"
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Lord of the Harvest"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 10:1-12",
          "content": [
            "Luke 10:1–12"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "35",
          "sid": "MAT 9:35"
        },
        "Jesus went through all the towns and villages, teaching in their synagogues, preaching the gospel of the kingdom, and healing every disease and sickness. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "36",
          "sid": "MAT 9:36"
        },
        "When He saw the crowds, He was moved with compassion for them, because they were harassed and helpless, like sheep without a shepherd."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "37",
          "sid": "MAT 9:37"
        },
        "Then He said to His disciples, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“The harvest ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " plentiful, but the workers ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "are"
              ]
            },
            " few. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "38",
              "sid": "MAT 9:38"
            },
            "Ask the Lord of the harvest, therefore, to send out workers into His harvest.”"
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "10",
      "sid": "MAT 10"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Twelve Apostles"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 3:13-19",
          "content": [
            "Mark 3:13–19"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 6:12-16",
          "content": [
            "Luke 6:12–16"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MAT 10:1"
        },
        "And calling His twelve disciples ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to Him"
          ]
        },
        ", ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " gave them authority over unclean spirits, so that they could drive them out and heal every disease and sickness."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MAT 10:2"
        },
        "These are the names of the twelve apostles: first Simon, called Peter, and his brother Andrew; James ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "son"
          ]
        },
        " of Zebedee, and his brother John; ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "MAT 10:3"
        },
        "Philip and Bartholomew; Thomas and Matthew the tax collector; James ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "son"
          ]
        },
        " of Alphaeus, and Thaddaeus; ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "MAT 10:4"
        },
        "Simon the Zealot,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "10:4 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Greek "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Simon the Cananean"
              ]
            }
          ]
        },
        " and Judas Iscariot, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who"
          ]
        },
        " betrayed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        ".",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "10:4 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "the one also having betrayed Him"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Ministry of the Twelve"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 6:7-13",
          "content": [
            "Mark 6:7–13"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 9:1-6",
          "content": [
            "Luke 9:1–6"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MAT 10:5"
        },
        "These twelve Jesus sent out with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the following"
          ]
        },
        " instructions: ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Do not go onto the road of the Gentiles ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "or"
              ]
            },
            " enter any town of ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " Samaritans. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "6",
              "sid": "MAT 10:6"
            },
            "Go rather to the lost sheep of Israel. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "7",
              "sid": "MAT 10:7"
            },
            "As you go, preach this message: ‘The kingdom of heaven is near.’ ",
            {
              "type": "verse",
              "marker": "v",
              "number": "8",
              "sid": "MAT 10:8"
            },
            "Heal the sick, raise ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " dead, cleanse ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " lepers,",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "10:8 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "A "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "leper "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "was one afflicted with a skin disease. See Leviticus 13."
                  ]
                }
              ]
            },
            " drive out demons. Freely you have received; freely give."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MAT 10:9"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            {
              "type": "char",
              "marker": "add",
              "content": [
                "Do"
              ]
            },
            " not take along ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "any"
              ]
            },
            " gold or silver or copper in your belts. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "10",
              "sid": "MAT 10:10"
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "Take"
              ]
            },
            " no bag for ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " road, or second tunic, or sandals, or staff; for the worker ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " worthy of his provisions."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "MAT 10:11"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Whatever town or village you enter, find out who is worthy there ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " stay ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "at his house"
              ]
            },
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "10:11 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Literally "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "stay there"
                  ]
                }
              ]
            },
            " until you move on. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "12",
              "sid": "MAT 10:12"
            },
            "As you enter the home, greet its ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "occupants"
              ]
            },
            ".",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "10:12 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Literally "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "greet it"
                  ]
                }
              ]
            },
            {
              "type": "verse",
              "marker": "v",
              "number": "13",
              "sid": "MAT 10:13"
            },
            "If the home is worthy, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "let"
              ]
            },
            " your peace rest on it, but if it is not, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "let"
              ]
            },
            " your peace return to you. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "14",
              "sid": "MAT 10:14"
            },
            "And if anyone will not welcome you or heed your words, shake the dust off your feet when you leave that home or town. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "15",
              "sid": "MAT 10:15"
            },
            "Truly I tell you, it will be more bearable for Sodom and Gomorrah on ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " day of judgment than for that town."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Sheep among Wolves"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "2TI 1:3-12",
          "content": [
            "2 Timothy 1:3–12"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "MAT 10:16"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Behold, I am sending you out like sheep among wolves; therefore be as shrewd as snakes and as innocent as doves. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "17",
              "sid": "MAT 10:17"
            },
            "But beware of men, for they will hand you over to ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "their"
              ]
            },
            " councils and flog you in their synagogues. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "18",
              "sid": "MAT 10:18"
            },
            "On My account you will be brought before governors and kings as witnesses to them and to the Gentiles. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "19",
              "sid": "MAT 10:19"
            },
            "But when they hand you over, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "do"
              ]
            },
            " not worry about how ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "to respond"
              ]
            },
            " or what to say. In that hour you will be given what to say. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "20",
              "sid": "MAT 10:20"
            },
            "For it will not be you speaking, but the Spirit of your Father speaking through you."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "MAT 10:21"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Brother will betray brother to death, and a father ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "his"
              ]
            },
            " child; children will rise against ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "their"
              ]
            },
            " parents and have them put to death. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "22",
              "sid": "MAT 10:22"
            },
            "You will be hated by everyone because of My name, but the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "one who"
              ]
            },
            " perseveres to ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " end will be saved."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MAT 10:23"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "When they persecute you in one town, flee to the next. Truly I tell you, you will not reach ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "all"
              ]
            },
            " the towns of Israel before the Son of Man comes."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "MAT 10:24"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "A disciple is not above ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "his"
              ]
            },
            " teacher, nor a servant above his master. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "25",
              "sid": "MAT 10:25"
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "It is"
              ]
            },
            " enough for a disciple to be like his teacher, and a servant like his master. If the head of the house has been called Beelzebul,",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "10:25 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "WH "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "Beezeboul"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "; Vulgate "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "Beelzebub"
                  ]
                }
              ]
            },
            " how much more the members of his household!"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Fear God Alone"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 12:4-7",
          "content": [
            "Luke 12:4–7"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "MAT 10:26"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "So do not be afraid of them. For there is nothing concealed that will not be disclosed, and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "nothing"
              ]
            },
            " hidden that will not be made known. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "27",
              "sid": "MAT 10:27"
            },
            "What I tell you in the dark, speak in the daylight; what is whispered in ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "your"
              ]
            },
            " ear, proclaim from the housetops."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "MAT 10:28"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Do not be afraid of those who kill the body but cannot kill the soul. Instead, fear the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "One who"
              ]
            },
            " can destroy both soul and body in hell.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "10:28 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Greek "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "Gehenna"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "MAT 10:29"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            {
              "type": "char",
              "marker": "add",
              "content": [
                "Are"
              ]
            },
            " not two sparrows sold for a penny?",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "10:29 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Greek "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "an assarion"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "; that is, a Roman copper coin worth about 1/16 of a denarius"
                  ]
                }
              ]
            },
            " Yet not one of them will fall to the ground apart from the will of your Father. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "30",
              "sid": "MAT 10:30"
            },
            "And even the very hairs of your head are all numbered. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "31",
              "sid": "MAT 10:31"
            },
            "So do not be afraid; you are worth more than many sparrows."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Confessing Christ"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 12:8-12",
          "content": [
            "Luke 12:8–12"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "32",
          "sid": "MAT 10:32"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Therefore everyone who confesses Me before men, I will also confess him before My Father in heaven. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "33",
              "sid": "MAT 10:33"
            },
            "But whoever denies Me before men, I will also deny him before My Father in heaven."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Not Peace but a Sword"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MIC 7:1-6",
          "content": [
            "Micah 7:1–6"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 12:49-53",
          "content": [
            "Luke 12:49–53"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "34",
          "sid": "MAT 10:34"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            {
              "type": "char",
              "marker": "add",
              "content": [
                "Do"
              ]
            },
            " not assume that I have come to bring peace to the earth; I have not come to bring peace, but a sword. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "35",
              "sid": "MAT 10:35"
            },
            "For I have come to turn"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "‘a man against his father,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "a daughter against her mother,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "a daughter-in-law against her mother-in-law."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "36",
          "sid": "MAT 10:36"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "A man’s enemies ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "will be"
              ]
            },
            " the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "members"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "of his own household.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "10:36 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "MIC 7:6",
                      "content": [
                        "Micah 7:6"
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "37",
          "sid": "MAT 10:37"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Anyone who loves ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "his"
              ]
            },
            " father or mother more than Me is not worthy of Me; anyone who loves ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "his"
              ]
            },
            " son or daughter more than Me is not worthy of Me; ",
            {
              "type": "verse",
              "marker": "v",
              "number": "38",
              "sid": "MAT 10:38"
            },
            "and anyone who does not take up his cross and follow Me is not worthy of Me. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "39",
              "sid": "MAT 10:39"
            },
            "Whoever finds his life will lose it, and whoever loses his life for My sake will find it."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Reward of Service"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "2KI 4:8-17",
          "content": [
            "2 Kings 4:8–17"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "40",
          "sid": "MAT 10:40"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "He who receives you receives Me, and he who receives Me receives the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "One who"
              ]
            },
            " sent Me. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "41",
              "sid": "MAT 10:41"
            },
            "Whoever receives a prophet because he is a prophet will receive a prophet’s reward, and whoever receives a righteous ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "man"
              ]
            },
            " because he is a righteous ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "man"
              ]
            },
            " will receive a righteous ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "man’s"
              ]
            },
            " reward. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "42",
              "sid": "MAT 10:42"
            },
            "And if anyone gives even a cup of cold ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "water"
              ]
            },
            " to one of these little ones ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "because he is My"
              ]
            },
            " disciple, truly I tell you, he will never lose his reward.”"
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "11",
      "sid": "MAT 11"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "John’s Inquiry"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 7:18-23",
          "content": [
            "Luke 7:18–23"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MAT 11:1"
        },
        "After Jesus had finished instructing His twelve disciples, He went on from there to teach and preach in their cities.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "11:1 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "That is, in the towns of Galilee"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MAT 11:2"
        },
        "Meanwhile John heard in prison ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "about"
          ]
        },
        " the works of Christ, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " he sent his disciples",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "11:2 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "he sent two of his disciples"
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "MAT 11:3"
        },
        "to ask Him, “Are You the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "One who"
          ]
        },
        " was to come, or should we look for someone else?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "MAT 11:4"
        },
        "Jesus replied, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Go ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "back"
              ]
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " report to John what you hear and see: ",
            {
              "type": "verse",
              "marker": "v",
              "number": "5",
              "sid": "MAT 11:5"
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "The"
              ]
            },
            " blind receive sight, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " lame walk, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " lepers",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "11:5 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "A "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "leper "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "was one afflicted with a skin disease. See Leviticus 13."
                  ]
                }
              ]
            },
            " are cleansed, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " deaf hear, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " dead are raised, and the good news is preached ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "to the"
              ]
            },
            " poor. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "6",
              "sid": "MAT 11:6"
            },
            "Blessed is the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "one who"
              ]
            },
            " does not fall away on account of Me.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "11:6 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "who is not offended by Me"
                  ]
                }
              ]
            },
            "”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Testifies about John"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAL 3:1-5",
          "content": [
            "Malachi 3:1–5"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 7:24-35",
          "content": [
            "Luke 7:24–35"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MAT 11:7"
        },
        "As ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "John’s disciples"
          ]
        },
        " were leaving, Jesus began to speak to the crowds about John: ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“What did you go out into the wilderness to see? A reed swaying in ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " wind? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "8",
              "sid": "MAT 11:8"
            },
            "Otherwise, what did you go out to see? A man dressed in fine ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "clothes"
              ]
            },
            "? Look, those who wear fine ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "clothing"
              ]
            },
            " are found in kings’ palaces. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "9",
              "sid": "MAT 11:9"
            },
            "What then did you go out to see? A prophet? Yes, I tell you, and more than a prophet. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "10",
              "sid": "MAT 11:10"
            },
            "This is ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the one"
              ]
            },
            " about whom it is written:"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "‘Behold, I will send My messenger ahead of You,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "who will prepare Your way before You.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "11:10 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "MAL 3:1",
                      "content": [
                        "Malachi 3:1"
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "MAT 11:11"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Truly I tell you, among ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "those"
              ]
            },
            " born of women there has risen no one greater than John the Baptist. Yet even the least in the kingdom of heaven is greater than he. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "12",
              "sid": "MAT 11:12"
            },
            "From the days of John the Baptist until now, the kingdom of heaven has been subject to violence,",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "11:12 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "has been forcefully advancing"
                  ]
                }
              ]
            },
            " and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " violent lay claim to it. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "13",
              "sid": "MAT 11:13"
            },
            "For all the Prophets and the Law prophesied until John. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "14",
              "sid": "MAT 11:14"
            },
            "And if you are willing to accept ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            ", he is ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " Elijah who was to come.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "11:14 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "See ",
                    {
                      "type": "ref",
                      "loc": "MAL 4:5",
                      "content": [
                        "Malachi 4:5"
                      ]
                    },
                    "."
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "MAT 11:15"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "He who has ears,",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "11:15 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "BYZ and TR "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "ears to hear"
                  ]
                }
              ]
            },
            " let him hear."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "MAT 11:16"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "To what can I compare this generation? They are like children sitting in the marketplaces and calling out to others:"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "MAT 11:17"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "‘We played the flute for you,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "and you did not dance;"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "we sang a dirge,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "and you did not mourn.’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "MAT 11:18"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "For John came neither eating nor drinking, and they say, ‘He has a demon!’ ",
            {
              "type": "verse",
              "marker": "v",
              "number": "19",
              "sid": "MAT 11:19"
            },
            "The Son of Man came eating and drinking, and they say, ‘Look ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "at this"
              ]
            },
            " glutton and drunkard, a friend of tax collectors and sinners!’ But wisdom is vindicated by her actions.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Woe to the Unrepentant"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 10:13-16",
          "content": [
            "Luke 10:13–16"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "MAT 11:20"
        },
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " began to denounce the cities in which most of His miracles had been performed, because they did not repent. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "21",
              "sid": "MAT 11:21"
            },
            "“Woe to you, Chorazin! Woe to you, Bethsaida! For if the miracles ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "that"
              ]
            },
            " were performed in you had been performed in Tyre and Sidon, they would have repented long ago in sackcloth and ashes. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "22",
              "sid": "MAT 11:22"
            },
            "But I tell you, it will be more bearable for Tyre and Sidon on ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " day of judgment than for you."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MAT 11:23"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "And you, Capernaum, will you be lifted up to heaven? ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "No"
              ]
            },
            ", you will be brought down to Hades! For if the miracles ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "that"
              ]
            },
            " were performed in you had been performed in Sodom, it would have remained to this day. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "24",
              "sid": "MAT 11:24"
            },
            "But I tell you that it will be more bearable for Sodom on ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " day of judgment than for you.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Rest for the Weary"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 10:21-24",
          "content": [
            "Luke 10:21–24"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "MAT 11:25"
        },
        "At that time Jesus declared, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“I praise You, Father, Lord of heaven and earth, because You have hidden these things from ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " wise and learned, and revealed them to little children. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "26",
              "sid": "MAT 11:26"
            },
            "Yes, Father, for this was well-pleasing in Your sight."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "MAT 11:27"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "All things have been entrusted to Me by My Father. No one knows the Son except the Father, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "no one"
              ]
            },
            " knows the Father except the Son and those to whom the Son chooses to reveal ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "Him"
              ]
            },
            "."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "MAT 11:28"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Come to Me, all you who are weary and burdened, and I will give you rest. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "29",
              "sid": "MAT 11:29"
            },
            "Take My yoke upon you and learn from Me, for I am gentle and humble ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "in"
              ]
            },
            " heart, and you will find rest ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "for"
              ]
            },
            " your souls. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "30",
              "sid": "MAT 11:30"
            },
            "For My yoke is easy and My burden is light.”"
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "12",
      "sid": "MAT 12"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Lord of the Sabbath"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "1SA 21:1-7",
          "content": [
            "1 Samuel 21:1–7"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MRK 2:23-28",
          "content": [
            "Mark 2:23–28"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 6:1-5",
          "content": [
            "Luke 6:1–5"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MAT 12:1"
        },
        "At that time Jesus went through the grainfields on the Sabbath. His disciples were hungry and began to pick ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " heads of grain and eat ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MAT 12:2"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "When"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Pharisees saw ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        ", they said to Him, “Look, Your disciples are doing what is unlawful on ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Sabbath.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "MAT 12:3"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " replied, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Have you not read what David did when ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "he"
              ]
            },
            " and his companions were hungry? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "4",
              "sid": "MAT 12:4"
            },
            "He entered the house of God, and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "he and his companions"
              ]
            },
            " ate the consecrated bread,",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "12:4 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "the Bread of the Presence"
                  ]
                }
              ]
            },
            " which was not lawful for ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "them"
              ]
            },
            " to eat, but only for the priests."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MAT 12:5"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Or haven’t you read in the Law that on the Sabbath the priests in the temple break the Sabbath and yet are innocent? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "6",
              "sid": "MAT 12:6"
            },
            "But I tell you that One greater than the temple is here."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MAT 12:7"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "If only you had known the meaning of ‘I desire mercy, not sacrifice,’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "12:7 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "HOS 6:6",
                      "content": [
                        "Hosea 6:6"
                      ]
                    }
                  ]
                }
              ]
            },
            " you would not have condemned the innocent. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "8",
              "sid": "MAT 12:8"
            },
            "For the Son of Man is Lord of the Sabbath.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Heals on the Sabbath"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 3:1-6",
          "content": [
            "Mark 3:1–6"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 6:6-11",
          "content": [
            "Luke 6:6–11"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MAT 12:9"
        },
        "Moving on from there, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " entered their synagogue, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "MAT 12:10"
        },
        "and a man with a withered hand ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was there"
          ]
        },
        ". In order to accuse ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        ", they asked Him, “Is it lawful to heal on the Sabbath?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "MAT 12:11"
        },
        "He replied, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“If one of you has a sheep and it falls into a pit on the Sabbath, will he not take hold of it and lift ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            " out? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "12",
              "sid": "MAT 12:12"
            },
            "How much more valuable is a man than a sheep! Therefore it is lawful to do good on the Sabbath.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MAT 12:13"
        },
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " said to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " man, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Stretch out your hand.”"
          ]
        },
        " So he stretched ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " out, and it was restored to full use, just like the other. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MAT 12:14"
        },
        "But the Pharisees went out ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " plotted how they might kill ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "God’s Chosen Servant"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ISA 42:1-9",
          "content": [
            "Isaiah 42:1–9"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "MAT 12:15"
        },
        "Aware of this, Jesus withdrew from that place. Large crowds followed Him, and He healed them all, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "MAT 12:16"
        },
        "warning them not to make Him known. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "MAT 12:17"
        },
        "This was to fulfill what was spoken through the prophet Isaiah:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "MAT 12:18"
        },
        "“Here is My Servant,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "whom I have chosen,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "My beloved,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "in whom My soul delights."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "I will put My Spirit on Him,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and He will proclaim justice to the nations."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "MAT 12:19"
        },
        "He will not quarrel or cry out;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "no one will hear His voice in the streets."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "MAT 12:20"
        },
        "A bruised reed He will not break,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and a smoldering wick He will not extinguish,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "till He leads justice to victory."
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "MAT 12:21"
        },
        "In His name ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " nations will put their hope.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "12:21 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 42:1-4",
                  "content": [
                    "Isaiah 42:1–4"
                  ]
                },
                " (see also LXX)"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "A House Divided"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 3:20-27",
          "content": [
            "Mark 3:20–27"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 11:14-23",
          "content": [
            "Luke 11:14–23"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "MAT 12:22"
        },
        "Then a demon-possessed man ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who was"
          ]
        },
        " blind and mute was brought to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        ", and He healed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the man"
          ]
        },
        " so that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "he"
          ]
        },
        " could speak and see. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MAT 12:23"
        },
        "The crowds were astounded and asked, “Could this be the Son of David?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "MAT 12:24"
        },
        "But when ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Pharisees heard this, they said, “Only by Beelzebul,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "12:24 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "WH "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Beezeboul"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; Vulgate "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Beelzebub"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; also in verse 27"
              ]
            }
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " prince of demons, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "does"
          ]
        },
        " this ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        " drive out demons.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "MAT 12:25"
        },
        "Knowing their thoughts, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " said to them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Every kingdom divided against itself will be laid waste, and every city or household divided against itself will not stand. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "26",
              "sid": "MAT 12:26"
            },
            "If Satan drives out Satan, he is divided against himself. How then ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "can"
              ]
            },
            " his kingdom stand? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "27",
              "sid": "MAT 12:27"
            },
            "And if I drive out demons by Beelzebul, by whom ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "do"
              ]
            },
            " your sons drive them out? So then, they will be your judges. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "28",
              "sid": "MAT 12:28"
            },
            "But if I drive out demons by ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " Spirit of God, then the kingdom of God has come upon you."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "MAT 12:29"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Or ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "again"
              ]
            },
            ", how can anyone enter a strong ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "man’s"
              ]
            },
            " house and steal his possessions, unless ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "he"
              ]
            },
            " first ties up the strong ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "man"
              ]
            },
            "? Then he can plunder his house."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "MAT 12:30"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "He who is not with Me is against Me, and he who ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "does"
              ]
            },
            " not gather with Me scatters."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Unpardonable Sin"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 3:28-30",
          "content": [
            "Mark 3:28–30"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "MAT 12:31"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Therefore I tell you, every sin and blasphemy will be forgiven men, but the blasphemy against ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " Spirit ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "will"
              ]
            },
            " not be forgiven. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "32",
              "sid": "MAT 12:32"
            },
            "Whoever speaks a word against the Son of Man will be forgiven, but whoever speaks against the Holy Spirit will not be forgiven, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "either"
              ]
            },
            " in this age ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "or"
              ]
            },
            " in the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "one"
              ]
            },
            " to come."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Good and Bad Fruit"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 6:43-45",
          "content": [
            "Luke 6:43–45"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "MAT 12:33"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Make a tree good and its fruit ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "will be"
              ]
            },
            " good, or make a tree bad and its fruit ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "will be"
              ]
            },
            " bad, for a tree is known by ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "its"
              ]
            },
            " fruit. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "34",
              "sid": "MAT 12:34"
            },
            "You brood of vipers, how can you who are evil say anything good? For out of the overflow of the heart the mouth speaks. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "35",
              "sid": "MAT 12:35"
            },
            "The good man brings good things out of his good store of treasure, and the evil man brings evil things out of his evil store of treasure. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "36",
              "sid": "MAT 12:36"
            },
            "But I tell you that men will give an account on ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " day of judgment for every careless word they have spoken. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "37",
              "sid": "MAT 12:37"
            },
            "For by your words you will be acquitted, and by your words you will be condemned.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Sign of Jonah"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "JON 3:1-10",
          "content": [
            "Jonah 3:1–10"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 11:29-32",
          "content": [
            "Luke 11:29–32"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "38",
          "sid": "MAT 12:38"
        },
        "Then some of the scribes and Pharisees said to Him, “Teacher, we want to see a sign from You.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "39",
          "sid": "MAT 12:39"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " replied, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“A wicked and adulterous generation demands a sign, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "but"
              ]
            },
            " none will be given it except the sign of the prophet Jonah. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "40",
              "sid": "MAT 12:40"
            },
            "For as Jonah was three days and three nights in the belly of the great fish, so the Son of Man will be three days and three nights in the heart of the earth."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "41",
          "sid": "MAT 12:41"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "The men of Nineveh will stand at the judgment with this generation and condemn it; for they repented at the preaching of Jonah, and now ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "One"
              ]
            },
            " greater than Jonah is here. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "42",
              "sid": "MAT 12:42"
            },
            "The Queen of ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " South will rise at the judgment with this generation and condemn it; for she came from the ends of the earth to hear the wisdom of Solomon, and now ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "One"
              ]
            },
            " greater than Solomon is here."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "An Unclean Spirit Returns"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 11:24-26",
          "content": [
            "Luke 11:24–26"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "43",
          "sid": "MAT 12:43"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "When an unclean spirit comes out of a man, it passes through arid places seeking rest and does not find ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            ". ",
            {
              "type": "verse",
              "marker": "v",
              "number": "44",
              "sid": "MAT 12:44"
            },
            "Then it says, ‘I will return to the house I left.’ On its return, it finds ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the house"
              ]
            },
            " vacant, swept clean, and put in order. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "45",
              "sid": "MAT 12:45"
            },
            "Then it goes and brings with it seven other spirits more wicked than itself, and they go in ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " dwell there. And the final ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "plight"
              ]
            },
            " of that man is worse than the first. So will it be with this wicked generation.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus’ Mother and Brothers"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 3:31-35",
          "content": [
            "Mark 3:31–35"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 8:19-21",
          "content": [
            "Luke 8:19–21"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "46",
          "sid": "MAT 12:46"
        },
        "While ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " was still speaking to the crowds, His mother and brothers stood outside, wanting to speak to Him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "47",
          "sid": "MAT 12:47"
        },
        "Someone told Him, “Look, Your mother and brothers are standing outside, wanting to speak to You.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "12:47 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "WH does not include verse 47."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "48",
          "sid": "MAT 12:48"
        },
        "But ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " replied, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Who is My mother, and who are My brothers?”"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "49",
          "sid": "MAT 12:49"
        },
        "Pointing to His disciples, He said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Here are My mother and My brothers. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "50",
              "sid": "MAT 12:50"
            },
            "For whoever does the will of My Father in heaven is My brother and sister and mother.”"
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "13",
      "sid": "MAT 13"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Parable of the Sower"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 4:1-9",
          "content": [
            "Mark 4:1–9"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 8:4-8",
          "content": [
            "Luke 8:4–8"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MAT 13:1"
        },
        "That ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "same"
          ]
        },
        " day Jesus went out of the house ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " sat by the sea. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MAT 13:2"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Such"
          ]
        },
        " large crowds gathered around Him that He got into a boat ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " sat down, while all the people stood on the shore."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "MAT 13:3"
        },
        "And He told them many things in parables, saying, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“A farmer went out to sow his seed. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "4",
              "sid": "MAT 13:4"
            },
            "And as he was sowing, some ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "seed"
              ]
            },
            " fell along the path, and the birds came ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " devoured it."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MAT 13:5"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Some fell on rocky ground, where it did not have much soil. It sprang up quickly because the soil was shallow. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "6",
              "sid": "MAT 13:6"
            },
            "But ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "when the"
              ]
            },
            " sun rose, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the seedlings"
              ]
            },
            " were scorched, and they withered because they had no root."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MAT 13:7"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Other ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "seed"
              ]
            },
            " fell among thorns, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "which"
              ]
            },
            " grew up and choked ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the seedlings"
              ]
            },
            "."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "MAT 13:8"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Still other ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "seed"
              ]
            },
            " fell on good soil and produced a crop — a hundredfold, sixtyfold, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "or"
              ]
            },
            " thirtyfold."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MAT 13:9"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "He who has ears,",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "13:9 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "BYZ and TR "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "ears to hear"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "; also in verse 43"
                  ]
                }
              ]
            },
            " let him hear.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Purpose of Jesus’ Parables"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ISA 6:1-13",
          "content": [
            "Isaiah 6:1–13"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MRK 4:10-12",
          "content": [
            "Mark 4:10–12"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 8:9-10",
          "content": [
            "Luke 8:9–10"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "MAT 13:10"
        },
        "Then the disciples came to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " asked, “Why do You speak to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the people"
          ]
        },
        " in parables?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "MAT 13:11"
        },
        "He replied, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“The knowledge of the mysteries of the kingdom of heaven has been given to you, but not to them. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "12",
              "sid": "MAT 13:12"
            },
            "Whoever has will be given ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "more"
              ]
            },
            ", and he will have an abundance. Whoever ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "does"
              ]
            },
            " not have, even what he has will be taken away from him. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "13",
              "sid": "MAT 13:13"
            },
            "This is why I speak to them in parables:"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "‘Though seeing, they do not see;"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            {
              "type": "char",
              "marker": "add",
              "content": [
                "though"
              ]
            },
            " hearing, they do not hear ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "or"
              ]
            },
            " understand.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "13:13 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "See ",
                    {
                      "type": "ref",
                      "loc": "DEU 29:4",
                      "content": [
                        "Deuteronomy 29:4"
                      ]
                    },
                    ", Isaiah 42:20, Jeremiah 5:21, and Ezekiel 12:2."
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MAT 13:14"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "In them the prophecy of Isaiah is fulfilled:"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "‘You will be ever hearing but never understanding;"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "you will be ever seeing but never perceiving."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "MAT 13:15"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "For this people’s heart has grown callous;"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "they hardly hear with ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "their"
              ]
            },
            " ears,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "and they have closed their eyes."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Otherwise they might see with ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "their"
              ]
            },
            " eyes,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "hear with ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "their"
              ]
            },
            " ears,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "understand with ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "their"
              ]
            },
            " hearts,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "and turn, and I would heal them.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "13:15 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "ISA 6:9-10",
                      "content": [
                        "Isaiah 6:9–10"
                      ]
                    },
                    " (see also LXX)"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "MAT 13:16"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "But blessed ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "are"
              ]
            },
            " your eyes because they see, and your ears because they hear. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "17",
              "sid": "MAT 13:17"
            },
            "For truly I tell you, many prophets and righteous ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "men"
              ]
            },
            " longed to see what you see ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "but"
              ]
            },
            " did not see ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            ", and to hear what you hear ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "but"
              ]
            },
            " did not hear ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            "."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Parable of the Sower Explained"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 4:13-20",
          "content": [
            "Mark 4:13–20"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 8:11-15",
          "content": [
            "Luke 8:11–15"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "MAT 13:18"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Consider, then, the parable of the sower: ",
            {
              "type": "verse",
              "marker": "v",
              "number": "19",
              "sid": "MAT 13:19"
            },
            "When anyone hears the message of the kingdom but ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "does"
              ]
            },
            " not understand ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            ", the evil one comes and snatches away what was sown in his heart. This is the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "seed"
              ]
            },
            " sown",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "13:19 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Literally "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "the one sown"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "; also in verses 20, 22, and 23"
                  ]
                }
              ]
            },
            " along the path."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "MAT 13:20"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "The ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "seed"
              ]
            },
            " sown on rocky ground is the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "one who"
              ]
            },
            " hears the word and at once receives it with joy. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "21",
              "sid": "MAT 13:21"
            },
            "But since he has no root, he remains for only a season. ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "When"
              ]
            },
            " trouble or persecution comes because of the word, he quickly falls away."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "MAT 13:22"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "The ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "seed"
              ]
            },
            " sown among the thorns is the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "one who"
              ]
            },
            " hears the word, but the worries of this life and the deceitfulness of wealth choke the word, and it becomes unfruitful."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MAT 13:23"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "But the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "seed"
              ]
            },
            " sown on good soil is the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "one who"
              ]
            },
            " hears the word ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " understands ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            ". ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "He"
              ]
            },
            " indeed bears fruit and produces a crop — a hundredfold, sixtyfold, or thirtyfold.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Parable of the Weeds"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "EZK 17:1-10",
          "content": [
            "Ezekiel 17:1–10"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "MAT 13:24"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " put before them another parable: ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“The kingdom of heaven is like a man who sowed good seed in his field. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "25",
              "sid": "MAT 13:25"
            },
            "But while everyone was asleep, his enemy came and sowed weeds among the wheat, and slipped away. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "26",
              "sid": "MAT 13:26"
            },
            "When the wheat sprouted and bore grain, then the weeds also appeared."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "MAT 13:27"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "The owner’s servants came to him ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " said, ‘Sir, didn’t you sow good seed in your field? Where then did ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " weeds ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "come from"
              ]
            },
            "?’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "MAT 13:28"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "‘An enemy did this,’ he replied."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            {
              "type": "char",
              "marker": "add",
              "content": [
                "So"
              ]
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " servants asked him, ‘Do you want us to go ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " pull them up?’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "MAT 13:29"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "‘No,’ he said, ‘if you pull the weeds ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "now"
              ]
            },
            ", you might uproot the wheat with them. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "30",
              "sid": "MAT 13:30"
            },
            "Let both grow together until the harvest. At that time I will tell the harvesters: First collect the weeds and tie them in bundles to be burned; then gather ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " wheat into my barn.’”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Parable of the Mustard Seed"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 4:30-34",
          "content": [
            "Mark 4:30–34"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 13:18-19",
          "content": [
            "Luke 13:18–19"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "MAT 13:31"
        },
        "He put before them another parable: ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“The kingdom of heaven is like a mustard seed that a man took ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " planted in his field. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "32",
              "sid": "MAT 13:32"
            },
            "Although it is ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " smallest of all seeds, yet it grows into the largest of garden plants and becomes a tree, so that the birds of the air come and nest in its branches.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Parable of the Leaven"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 13:20-21",
          "content": [
            "Luke 13:20–21"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "MAT 13:33"
        },
        "He told them still another parable: ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“The kingdom of heaven is like leaven that a woman took ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " mixed into three measures of flour, until all of it was leavened.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "I Will Open My Mouth in Parables"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "PSA 78:1-72",
          "content": [
            "Psalm 78:1–72"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "34",
          "sid": "MAT 13:34"
        },
        "Jesus spoke all these things to the crowds in parables. He did not tell them anything without using a parable. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "35",
          "sid": "MAT 13:35"
        },
        "So was fulfilled what was spoken through the prophet:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“I will open My mouth in parables;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "I will utter things hidden since ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " foundation ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of the"
          ]
        },
        " world.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "13:35 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "PSA 78:2",
                  "content": [
                    "Psalm 78:2"
                  ]
                },
                " (see also LXX); SBL, NE, and WH do not include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "of the world"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Parable of the Weeds Explained"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ZEP 1:1-6",
          "content": [
            "Zephaniah 1:1–6"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "36",
          "sid": "MAT 13:36"
        },
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " dismissed the crowds ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " went into the house. His disciples came to Him ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, “Explain to us the parable of the weeds in the field.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "37",
          "sid": "MAT 13:37"
        },
        "He replied, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“The ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "One"
              ]
            },
            " who sows the good seed is the Son of Man. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "38",
              "sid": "MAT 13:38"
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "The"
              ]
            },
            " field is the world, and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " good seed represents the sons of the kingdom. ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "The"
              ]
            },
            " weeds are the sons of the evil ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "one"
              ]
            },
            ", ",
            {
              "type": "verse",
              "marker": "v",
              "number": "39",
              "sid": "MAT 13:39"
            },
            "and the enemy who sows them is the devil. The harvest is ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " end of the age, and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " harvesters are angels."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "40",
          "sid": "MAT 13:40"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "As the weeds are collected and burned in the fire, so will it be at the end of the age. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "41",
              "sid": "MAT 13:41"
            },
            "The Son of Man will send out His angels, and they will weed out of His kingdom every cause of sin and all who practice lawlessness. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "42",
              "sid": "MAT 13:42"
            },
            "And they will throw them into the fiery furnace, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "where"
              ]
            },
            " there will be weeping and gnashing of teeth. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "43",
              "sid": "MAT 13:43"
            },
            "Then the righteous will shine like the sun in the kingdom of their Father.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "13:43 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "See ",
                    {
                      "type": "ref",
                      "loc": "DAN 12:3",
                      "content": [
                        "Daniel 12:3"
                      ]
                    },
                    "."
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "He who has ears, let him hear."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Parables of the Treasure and the Pearl"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "44",
          "sid": "MAT 13:44"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "The kingdom of heaven is like treasure hidden in a field. ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "When a"
              ]
            },
            " man found ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            ", he hid ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it again"
              ]
            },
            ", and in ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "his"
              ]
            },
            " joy he went and sold all he had and bought that field."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "45",
          "sid": "MAT 13:45"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Again, the kingdom of heaven is like a merchant in search of fine pearls. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "46",
              "sid": "MAT 13:46"
            },
            "When he found one very precious pearl, he went away ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " sold all he had and bought it."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Parable of the Net"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "47",
          "sid": "MAT 13:47"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Once again, the kingdom of heaven is like a net that was cast into the sea and caught all kinds ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "of fish"
              ]
            },
            ". ",
            {
              "type": "verse",
              "marker": "v",
              "number": "48",
              "sid": "MAT 13:48"
            },
            "When it was full, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the men"
              ]
            },
            " pulled ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            " ashore. Then they sat down ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " sorted the good ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "fish"
              ]
            },
            " into containers, but threw the bad away."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "49",
          "sid": "MAT 13:49"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "So will it be at the end of the age: The angels will come and separate the wicked from the righteous ",
            {
              "type": "verse",
              "marker": "v",
              "number": "50",
              "sid": "MAT 13:50"
            },
            "and throw them into the fiery furnace, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "where"
              ]
            },
            " there will be weeping and gnashing of teeth."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "51",
          "sid": "MAT 13:51"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Have you understood all these things?”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "“Yes,” they answered."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "52",
          "sid": "MAT 13:52"
        },
        "Then He told them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“For this reason, every scribe who has been discipled in the kingdom of heaven is like a homeowner who brings out of his storeroom new ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "treasures"
              ]
            },
            " as well as old.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Rejection at Nazareth"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 6:1-6",
          "content": [
            "Mark 6:1–6"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 4:16-30",
          "content": [
            "Luke 4:16–30"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "53",
          "sid": "MAT 13:53"
        },
        "When Jesus had finished these parables, He withdrew from that place. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "54",
          "sid": "MAT 13:54"
        },
        "Coming to His hometown, He taught ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the people"
          ]
        },
        " in their synagogue, and they were astonished. “Where did this man get such wisdom and miraculous powers?” they asked. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "55",
          "sid": "MAT 13:55"
        },
        "“Isn’t this the carpenter’s son? Isn’t His mother’s name Mary, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "aren’t"
          ]
        },
        " His brothers James, Joseph,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "13:55 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Joses"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; see ",
                {
                  "type": "ref",
                  "loc": "MRK 6:3",
                  "content": [
                    "Mark 6:3"
                  ]
                },
                "."
              ]
            }
          ]
        },
        " Simon, and Judas? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "56",
          "sid": "MAT 13:56"
        },
        "Aren’t all His sisters with us as well? Where then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "did"
          ]
        },
        " this ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "get"
          ]
        },
        " all these things?” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "57",
          "sid": "MAT 13:57"
        },
        "And they took offense at Him."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "But Jesus said to them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Only in ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "his"
              ]
            },
            " hometown and in his own household is a prophet without honor.”"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "58",
          "sid": "MAT 13:58"
        },
        "And He did not do many miracles there, because of their unbelief."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "14",
      "sid": "MAT 14"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Beheading of John"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 6:14-29",
          "content": [
            "Mark 6:14–29"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 9:7-9",
          "content": [
            "Luke 9:7–9"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MAT 14:1"
        },
        "At that time Herod the tetrarch heard the reports about Jesus ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MAT 14:2"
        },
        "and said to his servants, “This is John the Baptist; he has risen from the dead! That is why miraculous powers are at work in him.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "MAT 14:3"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Now"
          ]
        },
        " Herod had arrested John ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " bound him and put ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "him"
          ]
        },
        " in prison on account of Herodias, his brother Philip’s wife, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "MAT 14:4"
        },
        "because John had been telling him, “It is not lawful for you to have her.” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MAT 14:5"
        },
        "Although ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Herod"
          ]
        },
        " wanted to kill ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "John"
          ]
        },
        ", he was afraid of the people, because they regarded ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "John"
          ]
        },
        " as a prophet."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "MAT 14:6"
        },
        "On Herod’s birthday, however, the daughter of Herodias danced before them and pleased Herod ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MAT 14:7"
        },
        "so much that he promised with an oath to give to her whatever she asked."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "MAT 14:8"
        },
        "Prompted by her mother, she said, “Give me here on a platter the head of John the Baptist.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MAT 14:9"
        },
        "The king was grieved, but because of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " oaths and his guests, he ordered that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "her wish"
          ]
        },
        " be granted ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "MAT 14:10"
        },
        "and sent ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to have"
          ]
        },
        " John beheaded in the prison."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "MAT 14:11"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "John’s"
          ]
        },
        " head was brought in on a platter and presented to the girl, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who"
          ]
        },
        " carried ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " to her mother."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "MAT 14:12"
        },
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "John’s"
          ]
        },
        " disciples came ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " took ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " body and buried it. And they went ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " informed Jesus."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Feeding of the Five Thousand"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 6:30-44",
          "content": [
            "Mark 6:30–44"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 9:10-17",
          "content": [
            "Luke 9:10–17"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 6:1-15",
          "content": [
            "John 6:1–15"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MAT 14:13"
        },
        "When Jesus heard  ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "about John "
          ]
        },
        ", He withdrew by boat privately to a solitary place. But the crowds found out ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "about it"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " followed Him on foot from the towns. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MAT 14:14"
        },
        "When He stepped ashore ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " saw a large crowd, He had compassion on them and healed their sick."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "MAT 14:15"
        },
        "When evening came, the disciples came to Him ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, “This is a desolate place, and the hour is already late. Dismiss the crowds so they can go to the villages ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " buy themselves some food.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "16",
              "sid": "MAT 14:16"
            },
            "“They do not need to go away,”"
          ]
        },
        " Jesus replied. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“You give them ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "something"
              ]
            },
            " to eat.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "MAT 14:17"
        },
        "“We have here only five loaves of bread and two fish,” they answered."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "18",
              "sid": "MAT 14:18"
            },
            "“Bring them here to Me,”"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " said. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "MAT 14:19"
        },
        "And He directed the crowds to sit down on the grass. Taking the five loaves and the two fish ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " looking up to heaven, He spoke a blessing. Then He broke the loaves ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " gave ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        " to the disciples, and the disciples ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "gave them"
          ]
        },
        " to the people."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "MAT 14:20"
        },
        "They all ate and were satisfied, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the disciples"
          ]
        },
        " picked up twelve basketfuls of broken pieces that were left over. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "MAT 14:21"
        },
        "About five thousand men were fed, besides women and children."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Walks on Water"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 6:45-52",
          "content": [
            "Mark 6:45–52"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 6:16-21",
          "content": [
            "John 6:16–21"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "MAT 14:22"
        },
        "Immediately ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " made the disciples get into the boat and go on ahead of Him to the other side, while He dismissed the crowds. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MAT 14:23"
        },
        "After He had dismissed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        ", He went up on the mountain by Himself to pray. When evening came, He was there alone, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "MAT 14:24"
        },
        "but the boat was already far",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "14:24 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Greek "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "many stadia"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; a stadion was about 607 feet or 185 meters"
              ]
            }
          ]
        },
        " from land, buffeted by the waves because the wind was against it."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "MAT 14:25"
        },
        "During the fourth watch of the night,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "14:25 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "That is, between three and six in the morning"
              ]
            }
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " went out to them, walking on the sea. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "MAT 14:26"
        },
        "When the disciples saw Him walking on the sea, they were terrified. “It’s a ghost!” they said, and cried out in fear."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "MAT 14:27"
        },
        "But Jesus spoke up at once: ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Take courage! It is I. ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "Do"
              ]
            },
            " not be afraid.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "MAT 14:28"
        },
        "“Lord, if ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " is You,” Peter replied, “command me to come to You on the water.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "29",
              "sid": "MAT 14:29"
            },
            "“Come,”"
          ]
        },
        " said ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Then Peter got down out of the boat, walked on the water, and came toward Jesus. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "MAT 14:30"
        },
        "But when he saw the strength of the wind,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "14:30 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "when he saw the strong wind"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; NE and WH do not include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "strong"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "."
              ]
            }
          ]
        },
        " he was afraid and, beginning to sink, cried out, “Lord, save me!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "MAT 14:31"
        },
        "Immediately Jesus reached out ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " hand ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " took hold of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Peter"
          ]
        },
        ". ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "You"
              ]
            },
            " of little faith,”"
          ]
        },
        " He said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“why did you doubt?”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "32",
          "sid": "MAT 14:32"
        },
        "And when they had climbed back into the boat, the wind died down. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "MAT 14:33"
        },
        "Then those who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "were"
          ]
        },
        " in the boat worshiped Him, saying, “Truly You are the Son of God!”"
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Heals at Gennesaret"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 6:53-56",
          "content": [
            "Mark 6:53–56"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "34",
          "sid": "MAT 14:34"
        },
        "When they had crossed over, they landed at Gennesaret. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "35",
          "sid": "MAT 14:35"
        },
        "And when the men of that place recognized ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        ", they sent word to all the surrounding region. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "People"
          ]
        },
        " brought all the sick to Him ",
        {
          "type": "verse",
          "marker": "v",
          "number": "36",
          "sid": "MAT 14:36"
        },
        "and begged Him just to let them touch the fringe of His cloak. And all who touched ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        " were healed."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "15",
      "sid": "MAT 15"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Tradition of the Elders"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 7:1-13",
          "content": [
            "Mark 7:1–13"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MAT 15:1"
        },
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "some"
          ]
        },
        " Pharisees and scribes came to Jesus from Jerusalem ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " asked, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MAT 15:2"
        },
        "“Why ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do"
          ]
        },
        " Your disciples break the tradition of the elders? They do not wash their hands before they eat.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "MAT 15:3"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " replied, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“And why ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "do"
              ]
            },
            " you break the command of God for the sake of your tradition? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "4",
              "sid": "MAT 15:4"
            },
            "For God said, ‘Honor ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "your"
              ]
            },
            " father and mother’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "15:4 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "EXO 20:12",
                      "content": [
                        "Exodus 20:12"
                      ]
                    },
                    "; Deuteronomy 5:16"
                  ]
                }
              ]
            },
            " and ‘Anyone who curses ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "his"
              ]
            },
            " father or mother must be put to death.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "15:4 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "EXO 21:17",
                      "content": [
                        "Exodus 21:17"
                      ]
                    },
                    "; Leviticus 20:9"
                  ]
                }
              ]
            },
            {
              "type": "verse",
              "marker": "v",
              "number": "5",
              "sid": "MAT 15:5"
            },
            "But you say that if anyone says to ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "his"
              ]
            },
            " father or mother, ‘Whatever you would have received from me is a gift devoted ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "to God"
              ]
            },
            ",’ ",
            {
              "type": "verse",
              "marker": "v",
              "number": "6",
              "sid": "MAT 15:6"
            },
            "he need not honor his father or mother ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "with it"
              ]
            },
            ".",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "15:6 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "NE and TR (see also ",
                    {
                      "type": "ref",
                      "loc": "MRK 7:12",
                      "content": [
                        "Mark 7:12"
                      ]
                    },
                    "); literally "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "he need not honor his father or mother"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "; SBL, NA, WH, and BYZ do not include "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "or mother"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "."
                  ]
                }
              ]
            },
            " Thus you nullify the word of God for the sake of your tradition. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "7",
              "sid": "MAT 15:7"
            },
            "You hypocrites! Isaiah prophesied correctly about you:"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "MAT 15:8"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "‘These people honor Me with their lips,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "but their hearts are far from Me."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MAT 15:9"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "They worship Me in vain;"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "they teach ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "as"
              ]
            },
            " doctrine ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " precepts of men.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "15:9 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "ISA 29:13",
                      "content": [
                        "Isaiah 29:13"
                      ]
                    },
                    " (see also LXX)"
                  ]
                }
              ]
            },
            "”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "What Defiles a Man"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 7:14-23",
          "content": [
            "Mark 7:14–23"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "MAT 15:10"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " called the crowd ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to Him"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Listen and understand. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "11",
              "sid": "MAT 15:11"
            },
            "A man is not defiled by what enters ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "his"
              ]
            },
            " mouth, but by what comes out of ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            ".”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "MAT 15:12"
        },
        "Then the disciples came to Him ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, “Are You aware that the Pharisees were offended when they heard this?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MAT 15:13"
        },
        "But ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " replied, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Every plant that My heavenly Father has not planted will be pulled up by its roots. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "14",
              "sid": "MAT 15:14"
            },
            "Disregard them! They are blind guides.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "15:14 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "blind guides of the blind"
                  ]
                }
              ]
            },
            " If ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "a"
              ]
            },
            " blind ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "man"
              ]
            },
            " leads ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "a"
              ]
            },
            " blind ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "man"
              ]
            },
            ", both will fall into a pit.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "MAT 15:15"
        },
        "Peter said to Him, “Explain this parable to us.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "16",
              "sid": "MAT 15:16"
            },
            "“Do you still not understand?”"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " asked. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "17",
              "sid": "MAT 15:17"
            },
            "“Do you not yet realize that whatever enters the mouth goes into the stomach and then is eliminated? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "18",
              "sid": "MAT 15:18"
            },
            "But the things that come out of the mouth come from the heart, and these things defile a man. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "19",
              "sid": "MAT 15:19"
            },
            "For out of the heart come evil thoughts, murder, adultery, sexual immorality, theft, false testimony, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " slander. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "20",
              "sid": "MAT 15:20"
            },
            "These are what defile a man, but eating with unwashed hands does not defile ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "him"
              ]
            },
            ".”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Faith of the Canaanite Woman"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 7:24-30",
          "content": [
            "Mark 7:24–30"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "MAT 15:21"
        },
        "Leaving that place, Jesus withdrew to the district of Tyre and Sidon. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "MAT 15:22"
        },
        "And a Canaanite woman from that region came ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to Him"
          ]
        },
        ", crying out, “Lord, Son of David, have mercy on me! My daughter ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " miserably possessed by a demon.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MAT 15:23"
        },
        "But ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " did not answer a word. So His disciples came ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " urged Him, “Send her away, for she keeps crying out after us.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "MAT 15:24"
        },
        "He answered, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“I was sent only to the lost sheep of ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " house of Israel.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "MAT 15:25"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The woman"
          ]
        },
        " came ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " knelt before Him. “Lord, help me!” she said."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "MAT 15:26"
        },
        "But ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " replied, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“It is not right to take the children’s bread and toss ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            " to the dogs.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "MAT 15:27"
        },
        "“Yes, Lord,” she said, “even the dogs",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "15:27 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "puppies"
              ]
            }
          ]
        },
        " eat the crumbs that fall from their master’s table.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "28",
              "sid": "MAT 15:28"
            },
            "“O woman,”"
          ]
        },
        " Jesus answered, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“your faith is great! Let it be done for you as you desire.”"
          ]
        },
        " And her daughter was healed from that very hour."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Feeding of the Four Thousand"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "2KI 4:42-44",
          "content": [
            "2 Kings 4:42–44"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MRK 8:1-10",
          "content": [
            "Mark 8:1–10"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "MAT 15:29"
        },
        "Moving on from there, Jesus went along the Sea of Galilee. Then He went up on a mountain ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " sat down. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "MAT 15:30"
        },
        "Large crowds came to Him, bringing ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " lame, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " blind, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " crippled, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " mute, and many others, and laid them at His feet, and He healed them. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "MAT 15:31"
        },
        "The crowd was amazed when they saw ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " mute speaking, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " crippled restored, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " lame walking, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " blind seeing. And they glorified the God of Israel."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "32",
          "sid": "MAT 15:32"
        },
        "Then Jesus called His disciples ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to Him"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“I have compassion for ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "this"
              ]
            },
            " crowd, because they have already been with Me three days and have nothing to eat. I do not want to send them away hungry, or they may faint along the way.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "MAT 15:33"
        },
        "The disciples replied, “Where in this desolate place could we ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "find"
          ]
        },
        " enough bread to feed such a large crowd?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "34",
              "sid": "MAT 15:34"
            },
            "“How many loaves do you have?”"
          ]
        },
        " Jesus asked."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "“Seven,” they replied, “and a few small fish.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "35",
          "sid": "MAT 15:35"
        },
        "And He instructed the crowd to sit down on the ground. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "36",
          "sid": "MAT 15:36"
        },
        "Taking the seven loaves and the fish, He gave thanks ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " broke ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        ". Then He gave ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        " to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " disciples, and the disciples ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "gave them"
          ]
        },
        " to the people."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "37",
          "sid": "MAT 15:37"
        },
        "They all ate and were satisfied, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the disciples"
          ]
        },
        " picked up seven basketfuls of broken pieces that were left over. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "38",
          "sid": "MAT 15:38"
        },
        "A total of four thousand men were fed, besides women and children."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "39",
          "sid": "MAT 15:39"
        },
        "After ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " had dismissed the crowds, He got into the boat and went to the region of Magadan."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "16",
      "sid": "MAT 16"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Demand for a Sign"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 8:11-13",
          "content": [
            "Mark 8:11–13"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 12:54-56",
          "content": [
            "Luke 12:54–56"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MAT 16:1"
        },
        "Then the Pharisees and Sadducees came ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " tested ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " by asking Him to show them a sign from heaven."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MAT 16:2"
        },
        "But He replied, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“When evening comes, you say, ‘The weather ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "will be"
              ]
            },
            " fair, for the sky is red,’ ",
            {
              "type": "verse",
              "marker": "v",
              "number": "3",
              "sid": "MAT 16:3"
            },
            "and in the morning, ‘Today ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it will be"
              ]
            },
            " stormy, for the sky is red ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " overcast.’ You know ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "how"
              ]
            },
            " to interpret the appearance of the sky, but not the signs of the times.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "16:3 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Several manuscripts do not include "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "When evening comes... of the times. "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "from verses 2 and 3."
                  ]
                }
              ]
            },
            {
              "type": "verse",
              "marker": "v",
              "number": "4",
              "sid": "MAT 16:4"
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "A"
              ]
            },
            " wicked and adulterous generation demands a sign, but none will be given it except the sign of Jonah.”"
          ]
        },
        " Then He left them ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " went away."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Leaven of the Pharisees and Sadducees"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 8:14-21",
          "content": [
            "Mark 8:14–21"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 12:1-3",
          "content": [
            "Luke 12:1–3"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MAT 16:5"
        },
        "When they crossed to the other side, the disciples forgot to take bread. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "6",
              "sid": "MAT 16:6"
            },
            "“Watch out!”"
          ]
        },
        " Jesus told them. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Beware of the leaven of the Pharisees and Sadducees.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MAT 16:7"
        },
        "They discussed this among themselves ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " concluded, “",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "It is"
          ]
        },
        " because we did not bring ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "any"
          ]
        },
        " bread.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "MAT 16:8"
        },
        "Aware ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of their conversation"
          ]
        },
        ", Jesus said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "You"
              ]
            },
            " of little faith, why are you debating among yourselves about having no bread? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "9",
              "sid": "MAT 16:9"
            },
            "Do you still not understand? Do you not remember the five loaves for the five thousand, and how many basketfuls you gathered? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "10",
              "sid": "MAT 16:10"
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "Or"
              ]
            },
            " the seven loaves for the four thousand, and how many basketfuls you gathered? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "11",
              "sid": "MAT 16:11"
            },
            "How do you not understand that I was not telling you about bread? But beware of the leaven of the Pharisees and Sadducees.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "MAT 16:12"
        },
        "Then they understood that He was not telling ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        " to beware of the leaven used in bread, but of the teaching of the Pharisees and Sadducees."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Peter’s Confession of Christ"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 8:27-30",
          "content": [
            "Mark 8:27–30"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 9:18-20",
          "content": [
            "Luke 9:18–20"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 6:67-71",
          "content": [
            "John 6:67–71"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MAT 16:13"
        },
        "When Jesus came to the region of Caesarea Philippi, He questioned His disciples: ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Who ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "do"
              ]
            },
            " people say the Son of Man is?”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MAT 16:14"
        },
        "They replied, “Some ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "say"
          ]
        },
        " John the Baptist; others ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "say"
          ]
        },
        " Elijah; and still others, Jeremiah or one of the prophets.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "15",
              "sid": "MAT 16:15"
            },
            "“But ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "what about"
              ]
            },
            " you?”"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " asked. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Who do you say I am?”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "MAT 16:16"
        },
        "Simon Peter answered, “You are the Christ, the Son of the living God.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "MAT 16:17"
        },
        "Jesus replied, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Blessed are you, Simon son of Jonah!",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "16:17 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Greek "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "Simon Bar-Jonah"
                  ]
                }
              ]
            },
            " For ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "this"
              ]
            },
            " was not revealed to you ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "by"
              ]
            },
            " flesh and blood, but ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "by"
              ]
            },
            " My Father in heaven. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "18",
              "sid": "MAT 16:18"
            },
            "And I tell you that you are Peter, and on this rock I will build My church, and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " gates of Hades will not prevail against it. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "19",
              "sid": "MAT 16:19"
            },
            "I will give you the keys of the kingdom of heaven. Whatever you bind on earth will be bound in heaven, and whatever you loose on earth will be loosed in heaven.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "MAT 16:20"
        },
        "Then He admonished the disciples not to tell anyone that He was the Christ."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Christ’s Passion Foretold"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 8:31-33",
          "content": [
            "Mark 8:31–33"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 9:21-22",
          "content": [
            "Luke 9:21–22"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "MAT 16:21"
        },
        "From that time ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "on"
          ]
        },
        " Jesus",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "16:21 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "NE and WH "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Jesus Christ"
              ]
            }
          ]
        },
        " began to show His disciples that He must go to Jerusalem and suffer many things at the hands of the elders, chief priests, and scribes, and that He must be killed and on the third day be raised to life."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "MAT 16:22"
        },
        "Peter took Him aside ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " began to rebuke Him. “Far be it from You, Lord!” he said. “This ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "shall"
          ]
        },
        " never happen to You!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MAT 16:23"
        },
        "But ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " turned ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said to Peter, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Get behind Me, Satan! You are a stumbling block to Me. For you do not have in mind the things of God, but the things of men.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Take Up Your Cross"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 8:34-38",
          "content": [
            "Mark 8:34–38"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 9:23-27",
          "content": [
            "Luke 9:23–27"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "MAT 16:24"
        },
        "Then Jesus told His disciples, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“If anyone wants to come after Me, he must deny himself and take up his cross and follow Me. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "25",
              "sid": "MAT 16:25"
            },
            "For whoever wants to save his life will lose it, but whoever loses his life for My sake will find it. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "26",
              "sid": "MAT 16:26"
            },
            "What will it profit a man if he gains the whole world, yet forfeits his soul? Or what ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "can"
              ]
            },
            " a man give in exchange for his soul? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "27",
              "sid": "MAT 16:27"
            },
            "For the Son of Man will come in His Father’s glory with His angels, and then He will repay each one according to what he has done."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "MAT 16:28"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Truly I tell you, some who are standing here will not taste death before they see the Son of Man coming in His kingdom.”"
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "17",
      "sid": "MAT 17"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Transfiguration"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 9:1-13",
          "content": [
            "Mark 9:1–13"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 9:28-36",
          "content": [
            "Luke 9:28–36"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "2PE 1:16-21",
          "content": [
            "2 Peter 1:16–21"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MAT 17:1"
        },
        "After six days Jesus took with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        " Peter, James, and John the brother of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "James"
          ]
        },
        ", and led them up a high mountain by themselves. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MAT 17:2"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "There"
          ]
        },
        " He was transfigured before them. His face shone like the sun, and His clothes became as white as the light."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "MAT 17:3"
        },
        "Suddenly Moses and Elijah appeared before them, talking with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "MAT 17:4"
        },
        "Peter said to Jesus, “Lord, it is good for us to be here. If You wish, I will put up three shelters",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "17:4 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "three tabernacles"
              ]
            }
          ]
        },
        "— one for You, one for Moses, and one for Elijah.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MAT 17:5"
        },
        "While ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Peter"
          ]
        },
        " was ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "still"
          ]
        },
        " speaking, a bright cloud enveloped them, and a voice from the cloud said, “This is My beloved Son, in whom I am well pleased.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "17:5 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Cited in ",
                {
                  "type": "ref",
                  "loc": "2PE 1:17",
                  "content": [
                    "2 Peter 1:17"
                  ]
                }
              ]
            }
          ]
        },
        " Listen to Him!” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "MAT 17:6"
        },
        "When the disciples heard ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        ", they fell facedown in terror."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MAT 17:7"
        },
        "Then Jesus came over and touched them. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Get up,”"
          ]
        },
        " He said. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Do not be afraid.”"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "MAT 17:8"
        },
        "And when they looked up, they saw no one except Jesus."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MAT 17:9"
        },
        "As they were coming down the mountain, Jesus commanded them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Do not tell anyone ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "about this"
              ]
            },
            " vision until the Son of Man has been raised from ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " dead.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "MAT 17:10"
        },
        "The disciples asked Him, “Why then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do"
          ]
        },
        " the scribes say that Elijah must come first?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "MAT 17:11"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " replied, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Elijah ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "does"
              ]
            },
            " indeed come, and he will restore all things. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "12",
              "sid": "MAT 17:12"
            },
            "But I tell you that Elijah ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "has"
              ]
            },
            " already come, and they did not recognize him, but have done to him whatever they wished. In the same way, the Son of Man will suffer at their hands.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MAT 17:13"
        },
        "Then the disciples understood that He was speaking to them about John the Baptist."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Boy with a Demon"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 9:14-29",
          "content": [
            "Mark 9:14–29"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 9:37-42",
          "content": [
            "Luke 9:37–42"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MAT 17:14"
        },
        "When they came to the crowd, a man came up to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " knelt before Him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "MAT 17:15"
        },
        "“Lord, have mercy on my son,” he said. “He has seizures and is suffering terribly. He often falls into the fire ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " into the water. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "MAT 17:16"
        },
        "I brought him to Your disciples, but they could not heal him.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "17",
              "sid": "MAT 17:17"
            },
            "“O unbelieving and perverse generation!”"
          ]
        },
        " Jesus replied. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“How long must I remain with you? How long must I put up with you? Bring ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the boy"
              ]
            },
            " here to Me.”"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "MAT 17:18"
        },
        "Then Jesus rebuked ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the demon"
          ]
        },
        ", and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " came out of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the boy"
          ]
        },
        ", and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "he"
          ]
        },
        " was healed from that moment."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Power of Faith"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 17:5-10",
          "content": [
            "Luke 17:5–10"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "MAT 17:19"
        },
        "Afterward the disciples came to Jesus privately ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " asked, “Why couldn’t we drive it out?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "20",
              "sid": "MAT 17:20"
            },
            "“Because you ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "have"
              ]
            },
            " so little faith,”"
          ]
        },
        " He answered. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“For truly I tell you, if you have faith the size of a mustard seed, you can say to this mountain, ‘Move from here to there,’ and it will move. Nothing will be impossible for you.”"
          ]
        },
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "17:20 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                {
                  "type": "char",
                  "marker": "fv",
                  "content": [
                    "21"
                  ]
                },
                "But this kind does not come out except by prayer and fasting"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; see ",
                {
                  "type": "ref",
                  "loc": "MRK 9:29",
                  "content": [
                    "Mark 9:29"
                  ]
                },
                "."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Second Prediction of the Passion"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 9:30-32",
          "content": [
            "Mark 9:30–32"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 9:43-45",
          "content": [
            "Luke 9:43–45"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "MAT 17:22"
        },
        "When they gathered together in Galilee, Jesus told them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“The Son of Man is about to be delivered into ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " hands of men. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "23",
              "sid": "MAT 17:23"
            },
            "They will kill Him, and on the third day He will be raised ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "to life"
              ]
            },
            ".”"
          ]
        },
        " And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the disciples"
          ]
        },
        " were deeply grieved."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Temple Tax"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "MAT 17:24"
        },
        "After they had arrived in Capernaum, the collectors of the two-drachma ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "tax"
          ]
        },
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "17:24 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Greek "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "the didrachma"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; twice in this verse"
              ]
            }
          ]
        },
        " came to Peter and asked, “",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Does"
          ]
        },
        " your Teacher pay the two drachmas?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "MAT 17:25"
        },
        "“Yes,” he answered."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "When ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Peter"
          ]
        },
        " entered the house, Jesus preempted him. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“What do you think, Simon?”"
          ]
        },
        " He asked. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“From whom ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "do"
              ]
            },
            " the kings of the earth collect customs ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " taxes: from their ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "own"
              ]
            },
            " sons, or from others?”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "MAT 17:26"
        },
        "“From others,” ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Peter"
          ]
        },
        " answered."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Then the sons are exempt,”"
          ]
        },
        " Jesus said to him. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "27",
              "sid": "MAT 17:27"
            },
            "“But so that we may not offend them, go to the sea, cast a hook, and take the first fish you catch. When you open its mouth, you will find a four-drachma coin.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "17:27 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Greek "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "a stater"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "; that is, a silver coin worth approximately one shekel"
                  ]
                }
              ]
            },
            " Take ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " give ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            " to them for My tax and yours.”"
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "18",
      "sid": "MAT 18"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Greatest in the Kingdom"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 9:33-41",
          "content": [
            "Mark 9:33–41"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 9:46-50",
          "content": [
            "Luke 9:46–50"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MAT 18:1"
        },
        "At that time the disciples came to Jesus ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " asked, “Who then is ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " greatest in the kingdom of heaven?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MAT 18:2"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " invited a little child to stand among them. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "3",
              "sid": "MAT 18:3"
            },
            "“Truly I tell you,”"
          ]
        },
        " He said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“unless you change and become like little children, you will never enter the kingdom of heaven. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "4",
              "sid": "MAT 18:4"
            },
            "Therefore, whoever humbles himself like this little child is the greatest in the kingdom of heaven. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "5",
              "sid": "MAT 18:5"
            },
            "And whoever welcomes a little child like this in My name welcomes Me."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Temptations and Trespasses"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 9:42-48",
          "content": [
            "Mark 9:42–48"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 17:1-4",
          "content": [
            "Luke 17:1–4"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "MAT 18:6"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "But if anyone causes one of these little ones who believe in Me ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "to stumble"
              ]
            },
            ", it would be better for him to have a large millstone hung around his neck and to be drowned in the depths of the sea."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MAT 18:7"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Woe to the world for the causes of sin. ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "These"
              ]
            },
            " stumbling blocks must come, but woe to the man through whom ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "they"
              ]
            },
            " come!"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "MAT 18:8"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "If your hand or your foot causes you to sin, cut it off and throw it away. It is better for you to enter life crippled or lame than to have two hands ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " two feet ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " be thrown into the eternal fire. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "9",
              "sid": "MAT 18:9"
            },
            "And if your eye causes you to sin, gouge it out and throw it away. It is better for you to enter life with one eye than to have two eyes ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " be thrown into the fire of hell.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "18:9 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "the hell of fire"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "; Greek "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "the Gehenna of fire"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Parable of the Lost Sheep"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 15:1-7",
          "content": [
            "Luke 15:1–7"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "MAT 18:10"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "See ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "that"
              ]
            },
            " you do not look down on any of these little ones. For I tell you that their angels in heaven always see the face of My Father in heaven.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "18:10 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "BYZ and TR include "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    {
                      "type": "char",
                      "marker": "fv",
                      "content": [
                        "11"
                      ]
                    },
                    "For the Son of Man came to save the lost"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "; see ",
                    {
                      "type": "ref",
                      "loc": "LUK 19:10",
                      "content": [
                        "Luke 19:10"
                      ]
                    },
                    "."
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "MAT 18:12"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "What ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "do"
              ]
            },
            " you think? If a man has a hundred sheep and one of them goes astray, will he not leave the ninety-nine on the hills and go out to search for the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "one"
              ]
            },
            " that is lost? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "13",
              "sid": "MAT 18:13"
            },
            "And if he finds it, truly I tell you, he rejoices more over ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "that one sheep"
              ]
            },
            " than over the ninety-nine that did not go astray. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "14",
              "sid": "MAT 18:14"
            },
            "In the same way, your Father in heaven is not willing that any of these little ones should perish."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "A Brother Who Sins"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "DEU 19:15-21",
          "content": [
            "Deuteronomy 19:15–21"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "MAT 18:15"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "If your brother sins against you,",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "18:15 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "NE and WH do not include "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "against you"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "."
                  ]
                }
              ]
            },
            " go ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " confront him privately. If he listens to you, you have won your brother ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "over"
              ]
            },
            ". ",
            {
              "type": "verse",
              "marker": "v",
              "number": "16",
              "sid": "MAT 18:16"
            },
            "But if he will not listen, take one or two others along, so that ‘every matter may be established by ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " testimony of two or three witnesses.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "18:16 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "DEU 19:15",
                      "content": [
                        "Deuteronomy 19:15"
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "verse",
              "marker": "v",
              "number": "17",
              "sid": "MAT 18:17"
            },
            "If he refuses to listen to them, tell ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            " to the church. And if he refuses to listen even to the church, regard ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "him"
              ]
            },
            " as you ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "would"
              ]
            },
            " a pagan ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "or"
              ]
            },
            " a tax collector."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "MAT 18:18"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Truly I tell you, whatever you bind on earth will be bound in heaven, and whatever you loose on earth will be loosed in heaven."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Ask in My Name"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "JHN 16:23-33",
          "content": [
            "John 16:23–33"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "MAT 18:19"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Again, I tell you truly that if two of you on the earth agree about anything ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "you"
              ]
            },
            " ask for, it will be done for ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "you"
              ]
            },
            " by My Father in heaven. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "20",
              "sid": "MAT 18:20"
            },
            "For where two or three gather together in My name, there am I with them.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Unforgiving Servant"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ROM 12:14-21",
          "content": [
            "Romans 12:14–21"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "MAT 18:21"
        },
        "Then Peter came to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " asked, “Lord, how many times shall I forgive my brother who sins against me? Up to seven times?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "MAT 18:22"
        },
        "Jesus answered, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“I tell you, not just seven times, but seventy-seven times!"
          ]
        },
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "18:22 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "seventy times seven"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; see ",
                {
                  "type": "ref",
                  "loc": "GEN 4:24",
                  "content": [
                    "Genesis 4:24"
                  ]
                },
                " LXX"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MAT 18:23"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Because of this, the kingdom of heaven is like a king who wanted to settle accounts with his servants. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "24",
              "sid": "MAT 18:24"
            },
            "As he began the settlements, a debtor owing ten thousand talents",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "18:24 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "A talent was worth about twenty years’ wages for a laborer."
                  ]
                }
              ]
            },
            " was brought to him. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "25",
              "sid": "MAT 18:25"
            },
            "Since ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the man"
              ]
            },
            " was unable to pay, the master ordered that he be sold to pay ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "his"
              ]
            },
            " debt, along with ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "his"
              ]
            },
            " wife and children and everything he owned."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "MAT 18:26"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Then the servant fell on his knees before him. ‘Have patience with me,’ he begged, ‘and I will pay back everything.’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "MAT 18:27"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            {
              "type": "char",
              "marker": "add",
              "content": [
                "His"
              ]
            },
            " master had compassion ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "on him"
              ]
            },
            ", forgave his debt, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " released him."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "MAT 18:28"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "But when that servant went out, he found one of his fellow servants who owed him a hundred denarii.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "18:28 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "A denarius was customarily a day’s wage for a laborer; see ",
                    {
                      "type": "ref",
                      "loc": "MAT 20:2",
                      "content": [
                        "Matthew 20:2"
                      ]
                    },
                    "."
                  ]
                }
              ]
            },
            " He grabbed him and began to choke ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "him"
              ]
            },
            ", saying, ‘Pay back what you owe ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "me"
              ]
            },
            "!’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "MAT 18:29"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "So his fellow servant fell down ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " begged him, ‘Have patience with me, and I will pay you ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "back"
              ]
            },
            ".’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "MAT 18:30"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "But he refused. Instead, he went ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " had ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the man"
              ]
            },
            " thrown into prison until he could pay ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "his"
              ]
            },
            " debt."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "MAT 18:31"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            {
              "type": "char",
              "marker": "add",
              "content": [
                "When"
              ]
            },
            " his fellow servants saw what had happened, they were greatly distressed, and they went ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " recounted all ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "of this"
              ]
            },
            " to their master."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "32",
          "sid": "MAT 18:32"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Then the master summoned him ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " said, ‘",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "You"
              ]
            },
            " wicked servant! I forgave all ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "your"
              ]
            },
            " debt because you begged me. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "33",
              "sid": "MAT 18:33"
            },
            "Shouldn’t you have had mercy on your fellow servant, just as I ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "had"
              ]
            },
            " on you?’ ",
            {
              "type": "verse",
              "marker": "v",
              "number": "34",
              "sid": "MAT 18:34"
            },
            "In anger his master turned him over to the jailers to be tortured, until he should repay all that he owed."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "35",
          "sid": "MAT 18:35"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "That is how My heavenly Father will treat each of you unless you forgive ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "your"
              ]
            },
            " brother from your heart.”"
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "19",
      "sid": "MAT 19"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Teachings about Divorce"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 10:1-12",
          "content": [
            "Mark 10:1–12"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MAT 19:1"
        },
        "When Jesus had finished saying these things, He left Galilee and went into the region of Judea beyond the Jordan. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MAT 19:2"
        },
        "Large crowds followed Him, and He healed them there."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "MAT 19:3"
        },
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "some"
          ]
        },
        " Pharisees came ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " tested Him by asking, “Is it lawful for a man to divorce his wife for any reason?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "MAT 19:4"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " answered, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Have you not read that from ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " beginning the Creator ‘made them male and female,’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "19:4 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "GEN 1:27",
                      "content": [
                        "Genesis 1:27"
                      ]
                    },
                    "; Genesis 5:2"
                  ]
                }
              ]
            },
            {
              "type": "verse",
              "marker": "v",
              "number": "5",
              "sid": "MAT 19:5"
            },
            "and said, ‘For this reason a man will leave ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "his"
              ]
            },
            " father and mother and be united to his wife, and the two will become one flesh’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "19:5 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "GEN 2:24",
                      "content": [
                        "Genesis 2:24"
                      ]
                    },
                    " (see also LXX)"
                  ]
                }
              ]
            },
            "? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "6",
              "sid": "MAT 19:6"
            },
            "So they are no longer two, but one flesh. Therefore what God has joined together, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "let"
              ]
            },
            " man not separate.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MAT 19:7"
        },
        "“Why then,” they asked, “",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "did"
          ]
        },
        " Moses order ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "a man"
          ]
        },
        " to give ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his wife"
          ]
        },
        " a certificate of divorce and send ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "her"
          ]
        },
        " away?",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "19:7 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "See ",
                {
                  "type": "ref",
                  "loc": "DEU 24:1",
                  "content": [
                    "Deuteronomy 24:1"
                  ]
                },
                "."
              ]
            }
          ]
        },
        "”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "MAT 19:8"
        },
        "Jesus replied, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Moses permitted you to divorce your wives because of your hardness of heart. But ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            " was not this way from ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " beginning. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "9",
              "sid": "MAT 19:9"
            },
            "Now I tell you that whoever divorces his wife, except for sexual immorality, and marries another woman commits adultery.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "19:9 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "SBL and BYZ include "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "And he who marries a divorced woman commits adultery"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "; see ",
                    {
                      "type": "ref",
                      "loc": "MAT 5:32",
                      "content": [
                        "Matthew 5:32"
                      ]
                    },
                    "."
                  ]
                }
              ]
            },
            "”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "MAT 19:10"
        },
        "His disciples said to Him, “If this is the case between a man ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " wife, it is better not to marry.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "11",
              "sid": "MAT 19:11"
            },
            "“Not everyone can accept this word,”"
          ]
        },
        " He replied, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“but only ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "those"
              ]
            },
            " to whom it has been given. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "12",
              "sid": "MAT 19:12"
            },
            "For there are eunuchs who were born that way; ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "others"
              ]
            },
            " were made ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "that way"
              ]
            },
            " by men; and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "still others"
              ]
            },
            " live like eunuchs for the sake of the kingdom of heaven. The ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "one"
              ]
            },
            " who can accept ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "this"
              ]
            },
            " should accept ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            ".”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Blesses the Children"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 10:13-16",
          "content": [
            "Mark 10:13–16"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 18:15-17",
          "content": [
            "Luke 18:15–17"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MAT 19:13"
        },
        "Then little children were brought to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " for Him to place ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " hands on them and pray ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "for them"
          ]
        },
        ". And the disciples rebuked those ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who brought them"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MAT 19:14"
        },
        "But Jesus said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Let the little children come to Me, and do not hinder them! For the kingdom of heaven belongs to such as these.”"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "MAT 19:15"
        },
        "And after He had placed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " hands on them, He went on from there."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Rich Young Man"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 10:17-31",
          "content": [
            "Mark 10:17–31"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 18:18-30",
          "content": [
            "Luke 18:18–30"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "MAT 19:16"
        },
        "Just then a man came up to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " inquired, “Teacher, what good ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "thing"
          ]
        },
        " must I do to obtain eternal life?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "17",
              "sid": "MAT 19:17"
            },
            "“Why do you ask Me about what is good?”",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "19:17 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "BYZ and TR "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    {
                      "type": "char",
                      "marker": "fv",
                      "content": [
                        "16"
                      ]
                    },
                    "...“Good Teacher, what good thing must I do to obtain eternal life?” ",
                    {
                      "type": "char",
                      "marker": "fv",
                      "content": [
                        "17"
                      ]
                    },
                    "“Why do you call Me good?”"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "See ",
                    {
                      "type": "ref",
                      "loc": "MRK 10:17-18",
                      "content": [
                        "Mark 10:17–18"
                      ]
                    },
                    " and Luke 18:18–19."
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " replied. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“There is only One who is good. If you want to enter life, keep the commandments.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "MAT 19:18"
        },
        "“Which ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "ones"
          ]
        },
        "?” ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the man"
          ]
        },
        " asked."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Jesus answered, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“‘Do not murder, do not commit adultery, do not steal, do not bear false witness, ",
            {
              "type": "verse",
              "marker": "v",
              "number": "19",
              "sid": "MAT 19:19"
            },
            "honor ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "your"
              ]
            },
            " father and mother, and love your neighbor as yourself.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "19:19 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "EXO 20:12-16",
                      "content": [
                        "Exodus 20:12–16"
                      ]
                    },
                    "; Leviticus 19:18; Deuteronomy 5:16–20"
                  ]
                }
              ]
            },
            "”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "MAT 19:20"
        },
        "“All these I have kept,” said the young man. “What do I still lack?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "MAT 19:21"
        },
        "Jesus told him, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“If you want to be perfect, go, sell your possessions and give to the poor, and you will have treasure in heaven. Then come, follow Me.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "MAT 19:22"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "When"
          ]
        },
        " the young man heard this, he went away in sorrow, because he had great wealth."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MAT 19:23"
        },
        "Then Jesus said to His disciples, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Truly I tell you, it is hard for a rich man to enter the kingdom of heaven. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "24",
              "sid": "MAT 19:24"
            },
            "Again I tell you, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            " is easier for a camel to pass through ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " eye of a needle than for a rich man to enter the kingdom of God.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "MAT 19:25"
        },
        "When the disciples heard this, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "they were"
          ]
        },
        " greatly astonished ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " asked, “Who then can be saved?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "MAT 19:26"
        },
        "Jesus looked at ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“With man this is impossible, but with God all things ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "are"
              ]
            },
            " possible.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "MAT 19:27"
        },
        "“Look,” Peter replied, “we have left everything to follow You. What then will there be for us?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "MAT 19:28"
        },
        "Jesus said to them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Truly I tell you, in the renewal of all things,",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "19:28 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "in the regeneration"
                  ]
                }
              ]
            },
            " when the Son of Man sits on His glorious throne, you who have followed Me will also sit on twelve thrones, judging the twelve tribes of Israel. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "29",
              "sid": "MAT 19:29"
            },
            "And everyone who has left houses or brothers or sisters or father or mother or wife",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "19:29 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "NE, WH, and NA do not include "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "or wife"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "."
                  ]
                }
              ]
            },
            " or children or fields for the sake of My name will receive a hundredfold and will inherit eternal life. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "30",
              "sid": "MAT 19:30"
            },
            "But many ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "who are"
              ]
            },
            " first will be last, and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " last ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "will be"
              ]
            },
            " first.’’"
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "20",
      "sid": "MAT 20"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Parable of the Workers"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MAT 20:1"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            {
              "type": "char",
              "marker": "add",
              "content": [
                "“"
              ]
            },
            "For the kingdom of heaven is like a landowner who went out early in ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " morning to hire workers for his vineyard. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "2",
              "sid": "MAT 20:2"
            },
            "He agreed ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "to pay"
              ]
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "them"
              ]
            },
            " a denarius",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "20:2 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "A denarius was customarily a day’s wage for a laborer; similarly in verses 9, 10, and 13."
                  ]
                }
              ]
            },
            " for the day ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " sent them into his vineyard."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "MAT 20:3"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "About the third hour",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "20:3 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "That is, about nine in the morning"
                  ]
                }
              ]
            },
            " he went out ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " saw others standing in the marketplace doing nothing. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "4",
              "sid": "MAT 20:4"
            },
            "‘You also go into ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "my"
              ]
            },
            " vineyard,’ he said, ‘and I will pay you whatever is right.’ ",
            {
              "type": "verse",
              "marker": "v",
              "number": "5",
              "sid": "MAT 20:5"
            },
            "So they went."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "He went out again about ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " sixth ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "hour"
              ]
            },
            " and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " ninth hour",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "20:5 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "That is, about noon and again about three in the afternoon"
                  ]
                }
              ]
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " did the same thing."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "MAT 20:6"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "About the eleventh ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "hour"
              ]
            },
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "20:6 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "That is, about five in the afternoon; also in verse 9"
                  ]
                }
              ]
            },
            " he went out ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " found still others standing ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "around"
              ]
            },
            ". ‘Why have you been standing here all day ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "long"
              ]
            },
            " doing nothing?’ he asked."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MAT 20:7"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "‘Because no one has hired us,’ they answered."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "So he told them, ‘You also go into ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "my"
              ]
            },
            " vineyard.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "20:7 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "BYZ and TR include "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "and whatever is right, you shall receive."
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "MAT 20:8"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "When evening came, the owner of the vineyard said to his foreman, ‘Call the workers and pay them ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "their"
              ]
            },
            " wages, starting with the last ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "ones hired"
              ]
            },
            " and moving on to the first.’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MAT 20:9"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            {
              "type": "char",
              "marker": "add",
              "content": [
                "The workers who were hired"
              ]
            },
            " about the eleventh hour came ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " each received a denarius. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "10",
              "sid": "MAT 20:10"
            },
            "So when the original ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "workers"
              ]
            },
            " came, they assumed they would receive more. But each of them also received a denarius."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "MAT 20:11"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "On receiving ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "their pay"
              ]
            },
            ", they began to grumble against the landowner. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "12",
              "sid": "MAT 20:12"
            },
            "‘These ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "men who were hired"
              ]
            },
            " last worked only one hour,’ they said, ‘and you have made them equal to us who have borne the burden and the scorching heat of the day.’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MAT 20:13"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "But he answered one of them, ‘Friend, I am not being unfair to you. Did you not agree with me on one denarius? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "14",
              "sid": "MAT 20:14"
            },
            "Take your ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "pay"
              ]
            },
            " and go. I want to give this last ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "man"
              ]
            },
            " the same as ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "I gave"
              ]
            },
            " you. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "15",
              "sid": "MAT 20:15"
            },
            "Do I not have the right to do as I please with what ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " mine? Or are you envious because I am generous?’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "MAT 20:16"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "So the last will be first, and the first ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "will be"
              ]
            },
            " last.”"
          ]
        },
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "20:16 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "For many are called, but few are chosen."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Third Prediction of the Passion"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 10:32-34",
          "content": [
            "Mark 10:32–34"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 18:31-34",
          "content": [
            "Luke 18:31–34"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "MAT 20:17"
        },
        "As Jesus was going up to Jerusalem, He took the twelve disciples aside and said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "18",
              "sid": "MAT 20:18"
            },
            "“Look, we are going up to Jerusalem, and the Son of Man will be delivered over to the chief priests and scribes. They will condemn Him to death ",
            {
              "type": "verse",
              "marker": "v",
              "number": "19",
              "sid": "MAT 20:19"
            },
            "and will deliver Him ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "over"
              ]
            },
            " to the Gentiles to be mocked and flogged and crucified. And on the third day He will be raised ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "to life"
              ]
            },
            ".”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "A Mother’s Request"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 10:35-45",
          "content": [
            "Mark 10:35–45"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "MAT 20:20"
        },
        "Then the mother of Zebedee’s sons came to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " with her sons ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " knelt down to make a request of Him."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "21",
              "sid": "MAT 20:21"
            },
            "“What do you want?”"
          ]
        },
        " He inquired."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "She answered, “Declare that in Your kingdom one of these two sons of mine may sit at Your right hand, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the other"
          ]
        },
        " at Your left.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "22",
              "sid": "MAT 20:22"
            },
            "“You do not know what you are asking,”"
          ]
        },
        " Jesus replied. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Can you drink the cup I am going to drink?”"
          ]
        },
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "20:22 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ includes "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "or be baptized with the baptism with which I am baptized. "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "TR is similar."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "“We can,” ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the brothers"
          ]
        },
        " answered."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "23",
              "sid": "MAT 20:23"
            },
            "“You will indeed drink My cup,”"
          ]
        },
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "20:23 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "and be baptized with the baptism with which I am baptized"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "."
              ]
            }
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " said. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“But to sit at My right ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "or"
              ]
            },
            " left is not Mine to grant. ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "These seats belong"
              ]
            },
            " to those for whom My Father has prepared them.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "MAT 20:24"
        },
        "When the ten heard about ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        ", they were indignant with the two brothers. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "MAT 20:25"
        },
        "But Jesus called them aside ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“You know that the rulers of the Gentiles lord it over them, and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "their"
              ]
            },
            " superiors exercise authority over them. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "26",
              "sid": "MAT 20:26"
            },
            "It shall not be this way among you. Instead, whoever wants to become great among you must be your servant, ",
            {
              "type": "verse",
              "marker": "v",
              "number": "27",
              "sid": "MAT 20:27"
            },
            "and whoever wants to be first among you must be your slave — ",
            {
              "type": "verse",
              "marker": "v",
              "number": "28",
              "sid": "MAT 20:28"
            },
            "just as the Son of Man did not come to be served, but to serve, and to give His life ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "as"
              ]
            },
            " a ransom for many.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Blind Men by the Road"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 10:46-52",
          "content": [
            "Mark 10:46–52"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 18:35-43",
          "content": [
            "Luke 18:35–43"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "MAT 20:29"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "As"
          ]
        },
        " they were leaving Jericho, a large crowd followed Him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "MAT 20:30"
        },
        "And there were two blind ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "men"
          ]
        },
        " sitting beside the road. When they heard that Jesus was passing by, they cried out, “Lord, Son of David, have mercy on us!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "MAT 20:31"
        },
        "The crowd admonished them to be silent, but they cried out all the louder, “Lord, Son of David, have mercy on us!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "32",
          "sid": "MAT 20:32"
        },
        "Jesus stopped ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " called them. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“What do you want Me to do for you?”"
          ]
        },
        " He asked."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "MAT 20:33"
        },
        "“Lord,” they answered, “let our eyes be opened.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "34",
          "sid": "MAT 20:34"
        },
        "Moved with compassion, Jesus touched their eyes, and at once they received their sight and followed Him."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "21",
      "sid": "MAT 21"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Triumphal Entry"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ZEC 9:9-13",
          "content": [
            "Zechariah 9:9–13"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MRK 11:1-11",
          "content": [
            "Mark 11:1–11"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 19:28-40",
          "content": [
            "Luke 19:28–40"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 12:12-19",
          "content": [
            "John 12:12–19"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MAT 21:1"
        },
        "As they approached Jerusalem and came to Bethphage on the Mount of Olives, Jesus sent out two disciples, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MAT 21:2"
        },
        "saying to them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Go into the village ahead of you, and at once you will find a donkey tied ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "there"
              ]
            },
            ", with ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "her"
              ]
            },
            " colt beside her. Untie ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "them"
              ]
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " bring ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "them"
              ]
            },
            " to Me. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "3",
              "sid": "MAT 21:3"
            },
            "If anyone questions you, tell ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "him"
              ]
            },
            " that the Lord needs them, and he will send them right away.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "MAT 21:4"
        },
        "This took place to fulfill what was spoken through the prophet:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MAT 21:5"
        },
        "“Say to the Daughter of Zion,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "‘See, your King comes to you,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "gentle and riding on a donkey,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "on a colt, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " foal of a donkey.’”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "21:5 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ZEC 9:9",
                  "content": [
                    "Zechariah 9:9"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "MAT 21:6"
        },
        "So the disciples went and did as Jesus had directed them. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MAT 21:7"
        },
        "They brought the donkey and the colt and laid their cloaks on them, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " sat on them."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "MAT 21:8"
        },
        "A massive crowd spread their cloaks on the road, while others cut branches from the trees and spread ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        " on the road."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MAT 21:9"
        },
        "The crowds that went ahead of Him and those that followed were shouting:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Hosanna to the Son of David!”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "21:9 "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Hosanna "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "is a transliteration of the Hebrew "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Hosia-na"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                ", meaning "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Save, we pray "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Save now"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                ", which became a shout of praise; see ",
                {
                  "type": "ref",
                  "loc": "PSA 118:25",
                  "content": [
                    "Psalm 118:25"
                  ]
                },
                "; also in verse 15."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Blessed is He who comes in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " name of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord!”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "21:9 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "PSA 118:26",
                  "content": [
                    "Psalm 118:26"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Hosanna in the highest!”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "21:9 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "“Hosanna in the highest heaven!”"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "See ",
                {
                  "type": "ref",
                  "loc": "PSA 118:25",
                  "content": [
                    "Psalm 118:25"
                  ]
                },
                " and Psalm 148:1."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "MAT 21:10"
        },
        "When ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " had entered Jerusalem, the whole city was stirred ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " asked, “Who is this?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "MAT 21:11"
        },
        "The crowds replied, “This is Jesus, the prophet from Nazareth in Galilee.”"
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Cleanses the Temple"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 11:15-19",
          "content": [
            "Mark 11:15–19"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 19:45-48",
          "content": [
            "Luke 19:45–48"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 2:12-25",
          "content": [
            "John 2:12–25"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "MAT 21:12"
        },
        "Then Jesus entered the temple ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "courts"
          ]
        },
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "21:12 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "the temple"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; also in verses 15 and 23; BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "the temple of God"
              ]
            }
          ]
        },
        " and drove out all who were buying and selling ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "there"
          ]
        },
        ". He overturned the tables of the money changers and the seats of those selling doves. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MAT 21:13"
        },
        "And He declared to them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“It is written: ‘My house will be called a house of prayer.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "21:13 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "ISA 56:7",
                      "content": [
                        "Isaiah 56:7"
                      ]
                    }
                  ]
                }
              ]
            },
            " But you are making it ‘a den of robbers.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "21:13 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "JER 7:11",
                      "content": [
                        "Jeremiah 7:11"
                      ]
                    }
                  ]
                }
              ]
            },
            "”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MAT 21:14"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The"
          ]
        },
        " blind and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " lame came to Him at the temple, and He healed them. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "MAT 21:15"
        },
        "But the chief priests and scribes were indignant when they saw the wonders He performed and the children shouting in the temple ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "courts"
          ]
        },
        ", “Hosanna to the Son of David!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "MAT 21:16"
        },
        "“Do You hear what these ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "children"
          ]
        },
        " are saying?” they asked."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Yes,”"
          ]
        },
        " Jesus answered. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Have you never read:"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "‘From ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " mouths of children and infants"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "You have ordained praise’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "21:16 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "PSA 8:2",
                      "content": [
                        "Psalm 8:2"
                      ]
                    },
                    " (see also LXX)"
                  ]
                }
              ]
            },
            "?”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "MAT 21:17"
        },
        "Then He left them ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " went out of the city to Bethany, where He spent the night."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Barren Fig Tree"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 11:12-14",
          "content": [
            "Mark 11:12–14"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MRK 11:20-25",
          "content": [
            "Mark 11:20–25"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "MAT 21:18"
        },
        "In the morning, as ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " was returning to the city, He was hungry. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "MAT 21:19"
        },
        "Seeing a fig tree by the road, He went up to it but found nothing on it except leaves. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“May you never bear fruit again!”"
          ]
        },
        " He said. And immediately the tree withered."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "MAT 21:20"
        },
        "When the disciples saw ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        ", they marveled ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " asked, “How ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "did"
          ]
        },
        " the fig tree wither so quickly?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "21",
              "sid": "MAT 21:21"
            },
            "“Truly I tell you,”"
          ]
        },
        " Jesus replied, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“if you have faith and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "do"
              ]
            },
            " not doubt, not only will you do what was done to the fig tree, but even if you say to this mountain, ‘Be lifted up and thrown into the sea,’ it will happen. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "22",
              "sid": "MAT 21:22"
            },
            "If you believe, you will receive whatever you ask for in prayer.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus’ Authority Challenged"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 11:27-33",
          "content": [
            "Mark 11:27–33"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 20:1-8",
          "content": [
            "Luke 20:1–8"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MAT 21:23"
        },
        "When ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " returned to the temple ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "courts"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " began to teach, the chief priests and elders of the people came up to Him. “By what authority are You doing these things?” they asked. “And who gave You this authority?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "24",
              "sid": "MAT 21:24"
            },
            "“I will also ask you one question,”"
          ]
        },
        " Jesus replied, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " if you answer Me, I will tell you by what authority I am doing these things. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "25",
              "sid": "MAT 21:25"
            },
            "What was the source of John’s baptism? ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "Was it"
              ]
            },
            " from heaven or from men?”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "They deliberated among themselves ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, “If we say, ‘From heaven,’ He will ask, ‘Why then did you not believe him?’ ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "MAT 21:26"
        },
        "But if we say, ‘From men,’ we are afraid of the people, for they all regard John as a prophet.” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "MAT 21:27"
        },
        "So they answered, “We do not know.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " replied, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Neither ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "will"
              ]
            },
            " I tell you by what authority I am doing these things."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Parable of the Two Sons"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "MAT 21:28"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "But what ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "do"
              ]
            },
            " you think? ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "There was"
              ]
            },
            " a man who had two sons. He went to the first ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "one"
              ]
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " said, ‘Son, go ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " work today in the vineyard.’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "MAT 21:29"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "‘I will not,’ he replied. But later he changed his mind ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " went.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "21:29 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "NE and WH "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "But he went."
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "MAT 21:30"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Then ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the man"
              ]
            },
            " went to the second ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "son"
              ]
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " told ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "him"
              ]
            },
            " the same thing."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "‘I ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "will"
              ]
            },
            ", sir,’ he said. But he did not go."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "MAT 21:31"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Which of the two did the will of ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "his"
              ]
            },
            " father?”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "“The first,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "21:31 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "NE and WH "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "The latter"
              ]
            }
          ]
        },
        "” they answered."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Jesus said to them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Truly I tell you, the tax collectors and prostitutes are entering the kingdom of God before you. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "32",
              "sid": "MAT 21:32"
            },
            "For John came to you in ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " way of righteousness, and you did not believe him, but the tax collectors and prostitutes ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "did"
              ]
            },
            ". And ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "even"
              ]
            },
            " after you saw this, you did not repent ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " believe him."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Parable of the Wicked Tenants"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 12:1-12",
          "content": [
            "Mark 12:1–12"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 20:9-18",
          "content": [
            "Luke 20:9–18"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "MAT 21:33"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Listen to another parable: There was a landowner who planted a vineyard. He put a wall around it, dug a winepress in it, and built a tower. Then he rented it out to ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "some"
              ]
            },
            " tenants and went away on a journey."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "34",
          "sid": "MAT 21:34"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "When the harvest time drew near, he sent his servants to the tenants to collect his ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "share of the"
              ]
            },
            " fruit. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "35",
              "sid": "MAT 21:35"
            },
            "But the tenants seized his servants. They beat one, killed ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "another"
              ]
            },
            ", and stoned a third."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "36",
          "sid": "MAT 21:36"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Again, he sent other servants, more than the first ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "group"
              ]
            },
            ". But ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the tenants"
              ]
            },
            " did the same to them."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "37",
          "sid": "MAT 21:37"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Finally, he sent his son to them. ‘They will respect my son,’ he said."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "38",
          "sid": "MAT 21:38"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "But when the tenants saw the son, they said to one another, ‘This is the heir. Come, let us kill him and take his inheritance.’ ",
            {
              "type": "verse",
              "marker": "v",
              "number": "39",
              "sid": "MAT 21:39"
            },
            "So they seized him ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " threw ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "him"
              ]
            },
            " out of the vineyard and killed ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "him"
              ]
            },
            "."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "40",
          "sid": "MAT 21:40"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Therefore, when the owner of the vineyard returns, what will he do to those tenants?”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "41",
          "sid": "MAT 21:41"
        },
        "“He will bring those wretches ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to a"
          ]
        },
        " wretched ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "end"
          ]
        },
        ",” they replied, “and will rent out the vineyard to other tenants who will give him ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " share of the fruit at harvest time.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "42",
          "sid": "MAT 21:42"
        },
        "Jesus said to them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Have you never read in the Scriptures:"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "‘",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "The"
              ]
            },
            " stone the builders rejected"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "has become the cornerstone."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "This is from ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " Lord,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "and it is marvelous in our eyes’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "21:42 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "PSA 118:22-23",
                      "content": [
                        "Psalm 118:22–23"
                      ]
                    }
                  ]
                }
              ]
            },
            "?"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "43",
          "sid": "MAT 21:43"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Therefore I tell you that the kingdom of God will be taken away from you and given to a people who will produce its fruit. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "44",
              "sid": "MAT 21:44"
            },
            "He who falls on this stone will be broken to pieces, but he on whom it falls will be crushed.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "21:44 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Tischendorf and some early manuscripts do not include verse 44; see also ",
                    {
                      "type": "ref",
                      "loc": "LUK 20:18",
                      "content": [
                        "Luke 20:18"
                      ]
                    },
                    "."
                  ]
                }
              ]
            },
            "”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "45",
          "sid": "MAT 21:45"
        },
        "When the chief priests and Pharisees heard His parables, they knew that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " was speaking about them. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "46",
          "sid": "MAT 21:46"
        },
        "Although they wanted to arrest Him, they were afraid of the crowds, because ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the people"
          ]
        },
        " regarded Him as a prophet."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "22",
      "sid": "MAT 22"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Parable of the Banquet"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 14:15-24",
          "content": [
            "Luke 14:15–24"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MAT 22:1"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Once"
          ]
        },
        " again, Jesus spoke to them in parables: ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "2",
              "sid": "MAT 22:2"
            },
            "“The kingdom of heaven is like a king who prepared a wedding banquet for his son. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "3",
              "sid": "MAT 22:3"
            },
            "He sent his servants to call those he had invited to the banquet, but they refused to come."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "MAT 22:4"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Again, he sent other servants ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " said, ‘Tell those who have been invited that I have prepared my dinner. My oxen and fattened cattle have been killed, and everything ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " ready. Come to the wedding banquet.’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MAT 22:5"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "But they paid no attention ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " went away, one to his field, another to his business. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "6",
              "sid": "MAT 22:6"
            },
            "The rest seized his servants, mistreated ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "them"
              ]
            },
            ", and killed ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "them"
              ]
            },
            "."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MAT 22:7"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "The king was enraged, and he sent his troops to destroy those murderers and burn their city. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "8",
              "sid": "MAT 22:8"
            },
            "Then he said to his servants, ‘The wedding banquet is ready, but those I invited were not worthy. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "9",
              "sid": "MAT 22:9"
            },
            "Go therefore to the crossroads and invite to the banquet as many as you can find.’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "MAT 22:10"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "So the servants went out into the streets ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " gathered everyone they could find, both evil and good, and the wedding hall was filled with guests."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "MAT 22:11"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "But when the king came in to see the guests, he spotted a man ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "who was"
              ]
            },
            " not dressed in wedding clothes. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "12",
              "sid": "MAT 22:12"
            },
            "‘Friend,’ he asked, ‘how did you get in here without wedding clothes?’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "But ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the man"
              ]
            },
            " was speechless."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MAT 22:13"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Then the king told the servants, ‘Tie him hand and foot, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " throw him into the outer darkness, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "where"
              ]
            },
            " there will be weeping and gnashing of teeth.’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MAT 22:14"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "For many are called, but few ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "are"
              ]
            },
            " chosen.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Paying Taxes to Caesar"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 12:13-17",
          "content": [
            "Mark 12:13–17"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 20:19-26",
          "content": [
            "Luke 20:19–26"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "MAT 22:15"
        },
        "Then the Pharisees went out ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " conspired to trap ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " in His words. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "MAT 22:16"
        },
        "They sent their disciples to Him along with the Herodians. “Teacher,” they said, “we know that You are honest and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " You teach the way of God in accordance with the truth. You seek favor from no one, because You pay no attention to external appearance. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "MAT 22:17"
        },
        "So tell us what You think: Is it lawful to pay taxes to Caesar or not?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "MAT 22:18"
        },
        "But Jesus knew their evil intent ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“You hypocrites, why are you testing Me? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "19",
              "sid": "MAT 22:19"
            },
            "Show Me the coin used for the tax.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "And they brought Him a denarius.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "22:19 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "A denarius was customarily a day’s wage for a laborer; see ",
                {
                  "type": "ref",
                  "loc": "MAT 20:2",
                  "content": [
                    "Matthew 20:2"
                  ]
                },
                "."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "20",
              "sid": "MAT 22:20"
            },
            "“Whose image ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " this,”"
          ]
        },
        " He asked, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“and whose inscription?”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "MAT 22:21"
        },
        "“Caesar’s,” they answered."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "So ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " told them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Give to Caesar what ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " Caesar’s, and to God what ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " God’s.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "MAT 22:22"
        },
        "And when they heard ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        ", they were amazed. So they left Him ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " went away."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Sadducees and the Resurrection"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 12:18-27",
          "content": [
            "Mark 12:18–27"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 20:27-40",
          "content": [
            "Luke 20:27–40"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MAT 22:23"
        },
        "That ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "same"
          ]
        },
        " day ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Sadducees, who say there is no resurrection, came to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " and questioned Him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "MAT 22:24"
        },
        "“Teacher,” they said, “Moses declared that if a man dies without having children, his brother is to marry the widow and raise up offspring for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "him"
          ]
        },
        ".",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "22:24 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "DEU 25:5",
                  "content": [
                    "Deuteronomy 25:5"
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "MAT 22:25"
        },
        "Now there were seven brothers among us. The first ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one"
          ]
        },
        " married and died without having children. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So"
          ]
        },
        " he left his wife to his brother. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "MAT 22:26"
        },
        "The same thing happened to the second and third ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "brothers"
          ]
        },
        ", down to the seventh. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "MAT 22:27"
        },
        "And last of all, the woman died. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "MAT 22:28"
        },
        "In the resurrection, then, whose wife will she be of the seven? For all of them were married to her.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "MAT 22:29"
        },
        "Jesus answered, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“You are mistaken ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "because"
              ]
            },
            " you do not know the Scriptures or the power of God. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "30",
              "sid": "MAT 22:30"
            },
            "In the resurrection, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "people"
              ]
            },
            " will neither marry nor be given in marriage. Instead, they will be like ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " angels",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "22:30 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "SBL, BYZ, and TR "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "the angels of God"
                  ]
                }
              ]
            },
            " in heaven. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "31",
              "sid": "MAT 22:31"
            },
            "But concerning the resurrection of the dead, have you not read what God said to you: ",
            {
              "type": "verse",
              "marker": "v",
              "number": "32",
              "sid": "MAT 22:32"
            },
            "‘I am the God of Abraham, the God of Isaac, and the God of Jacob’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "22:32 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "EXO 3:6",
                      "content": [
                        "Exodus 3:6"
                      ]
                    }
                  ]
                }
              ]
            },
            "? He is not the God of ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " dead, but of ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " living.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "MAT 22:33"
        },
        "When the crowds heard ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        ", they were astonished at His teaching."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Greatest Commandment"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "DEU 6:1-19",
          "content": [
            "Deuteronomy 6:1–19"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MRK 12:28-34",
          "content": [
            "Mark 12:28–34"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "34",
          "sid": "MAT 22:34"
        },
        "And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "when"
          ]
        },
        " the Pharisees heard that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " had silenced the Sadducees, they themselves gathered together. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "35",
          "sid": "MAT 22:35"
        },
        "One of them, an expert in the law, tested Him with a question: ",
        {
          "type": "verse",
          "marker": "v",
          "number": "36",
          "sid": "MAT 22:36"
        },
        "“Teacher, which commandment ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is the"
          ]
        },
        " greatest in the Law?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "37",
          "sid": "MAT 22:37"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " declared, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“‘Love ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " Lord your God with all your heart and with all your soul and with all your mind.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "22:37 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "DEU 6:5",
                      "content": [
                        "Deuteronomy 6:5"
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "verse",
              "marker": "v",
              "number": "38",
              "sid": "MAT 22:38"
            },
            "This is the first and greatest commandment. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "39",
              "sid": "MAT 22:39"
            },
            "And ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " second ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " like it: ‘Love your neighbor as yourself.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "22:39 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "LEV 19:18",
                      "content": [
                        "Leviticus 19:18"
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "verse",
              "marker": "v",
              "number": "40",
              "sid": "MAT 22:40"
            },
            "All the Law and the Prophets hang on these two commandments.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Whose Son Is the Christ?"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 12:35-37",
          "content": [
            "Mark 12:35–37"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 20:41-44",
          "content": [
            "Luke 20:41–44"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "41",
          "sid": "MAT 22:41"
        },
        "While the Pharisees were assembled, Jesus questioned them: ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "42",
              "sid": "MAT 22:42"
            },
            "“What ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "do"
              ]
            },
            " you think about the Christ? Whose son is He?”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "“David’s,” they answered."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "43",
          "sid": "MAT 22:43"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " said to them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“How then ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "does"
              ]
            },
            " David in ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " Spirit call Him ‘Lord’? ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "For"
              ]
            },
            " he says:"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "44",
          "sid": "MAT 22:44"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "‘The Lord said to my Lord,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Sit at My right hand"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "until I put Your enemies"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "under Your feet.”’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "22:44 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "PSA 110:1",
                      "content": [
                        "Psalm 110:1"
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "45",
          "sid": "MAT 22:45"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "So if David calls Him ‘Lord,’ how can He be ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "David’s"
              ]
            },
            " son?”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "46",
          "sid": "MAT 22:46"
        },
        "No one was able to answer a word, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " from that day ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "on"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "no one"
          ]
        },
        " dared to question Him ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "any"
          ]
        },
        " further."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "23",
      "sid": "MAT 23"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Woes to Scribes and Pharisees"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 11:37-54",
          "content": [
            "Luke 11:37–54"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MAT 23:1"
        },
        "Then Jesus spoke to the crowds and to His disciples: ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "2",
              "sid": "MAT 23:2"
            },
            "“The scribes and Pharisees sit in Moses’ seat. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "3",
              "sid": "MAT 23:3"
            },
            "So practice and observe everything they tell you. But ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "do"
              ]
            },
            " not do what they do, for they do not practice what they preach. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "4",
              "sid": "MAT 23:4"
            },
            "They tie up heavy, burdensome loads",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "23:4 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "SBL, NE, and WH "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "They tie up heavy loads"
                  ]
                }
              ]
            },
            " and lay ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "them"
              ]
            },
            " on men’s shoulders, but they themselves are not willing to lift a finger to move them."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MAT 23:5"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "All their deeds are done for men to see. They broaden their phylacteries and lengthen their tassels. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "6",
              "sid": "MAT 23:6"
            },
            "They love the places of honor at banquets, the chief seats in the synagogues, ",
            {
              "type": "verse",
              "marker": "v",
              "number": "7",
              "sid": "MAT 23:7"
            },
            "the greetings in the marketplaces, and the title of ‘Rabbi’ by ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "which they are addressed"
              ]
            },
            ".",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "23:7 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Literally "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "and to be called ‘Rabbi’ by men"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "MAT 23:8"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "But you are not to be called ‘Rabbi,’ for you ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "have"
              ]
            },
            " one Teacher, and you are all brothers. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "9",
              "sid": "MAT 23:9"
            },
            "And do not call anyone on earth your father, for you ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "have"
              ]
            },
            " one Father, who ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " in heaven. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "10",
              "sid": "MAT 23:10"
            },
            "Nor are you to be called instructors, for you ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "have"
              ]
            },
            " one Instructor, the Christ. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "11",
              "sid": "MAT 23:11"
            },
            "The greatest among you shall be your servant. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "12",
              "sid": "MAT 23:12"
            },
            "For whoever exalts himself will be humbled, and whoever humbles himself will be exalted."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MAT 23:13"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Woe to you, scribes and Pharisees, you hypocrites! You shut the kingdom of heaven in men’s faces. You yourselves do not enter, nor will you let in those who wish to enter.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "23:13 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "BYZ and TR include "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    {
                      "type": "char",
                      "marker": "fv",
                      "content": [
                        "14"
                      ]
                    },
                    "Woe to you, scribes and Pharisees, you hypocrites! You defraud widows of their houses, and for a show make lengthy prayers. Therefore you will receive greater condemnation."
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "See ",
                    {
                      "type": "ref",
                      "loc": "MRK 12:40",
                      "content": [
                        "Mark 12:40"
                      ]
                    },
                    " and Luke 20:47."
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "MAT 23:15"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Woe to you, scribes and Pharisees, you hypocrites! You traverse ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "land"
              ]
            },
            " and sea to win a single convert, and when he becomes ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "one"
              ]
            },
            ", you make him twice as much a son of hell",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "23:15 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Greek "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "Gehenna"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "; also in verse 33"
                  ]
                }
              ]
            },
            " as you are."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "MAT 23:16"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Woe to you, blind guides! ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "You"
              ]
            },
            " say, ‘If anyone swears by the temple, it means nothing; but if anyone swears by the gold of the temple, he is bound by his oath.’ ",
            {
              "type": "verse",
              "marker": "v",
              "number": "17",
              "sid": "MAT 23:17"
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "You"
              ]
            },
            " blind fools! Which is greater: the gold, or the temple that makes it sacred? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "18",
              "sid": "MAT 23:18"
            },
            "And ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "you say"
              ]
            },
            ", ‘If anyone swears by the altar, it means nothing; but if anyone swears by the gift on it, he is bound by his oath.’ ",
            {
              "type": "verse",
              "marker": "v",
              "number": "19",
              "sid": "MAT 23:19"
            },
            "You blind men! Which ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " greater: the gift, or the altar that makes it sacred? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "20",
              "sid": "MAT 23:20"
            },
            "So then, he who swears by the altar swears by it and by everything on it. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "21",
              "sid": "MAT 23:21"
            },
            "And he who swears by the temple swears by it and by the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "One"
              ]
            },
            " who dwells in it. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "22",
              "sid": "MAT 23:22"
            },
            "And he who swears by heaven swears by God’s throne and by the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "One"
              ]
            },
            " who sits on it."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MAT 23:23"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Woe to you, scribes and Pharisees, you hypocrites! You pay tithes of mint, dill, and cumin. But you have disregarded the weightier ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "matters"
              ]
            },
            " of the law: justice, mercy, and faithfulness. You should have practiced the latter, without neglecting the former. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "24",
              "sid": "MAT 23:24"
            },
            "You blind guides! You strain out a gnat but swallow a camel.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "23:24 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "See ",
                    {
                      "type": "ref",
                      "loc": "LEV 11:4",
                      "content": [
                        "Leviticus 11:4"
                      ]
                    },
                    " and Leviticus 11:23, where camels and gnats are both forbidden as food."
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "MAT 23:25"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Woe to you, scribes and Pharisees, you hypocrites! You clean the outside of the cup and dish, but inside they are full of greed and self-indulgence. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "26",
              "sid": "MAT 23:26"
            },
            "Blind Pharisee! First clean the inside of the cup and dish,",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "23:26 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "NA does not include "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "and dish"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "."
                  ]
                }
              ]
            },
            " so that the outside may become clean as well."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "MAT 23:27"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Woe to you, scribes and Pharisees, you hypocrites! You are like whitewashed tombs, which look beautiful on the outside but on the inside are full of dead ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "men’s"
              ]
            },
            " bones and every kind of impurity. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "28",
              "sid": "MAT 23:28"
            },
            "In the same way, on the outside you appear to be righteous, but on the inside you are full of hypocrisy and wickedness."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "MAT 23:29"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Woe to you, scribes and Pharisees, you hypocrites! You build tombs for the prophets and decorate the monuments of the righteous. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "30",
              "sid": "MAT 23:30"
            },
            "And you say, ‘If we had lived in the days of our fathers, we would not have been partners with them in ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "shedding"
              ]
            },
            " the blood of the prophets.’ ",
            {
              "type": "verse",
              "marker": "v",
              "number": "31",
              "sid": "MAT 23:31"
            },
            "So you testify against yourselves that you are ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " sons of those who murdered the prophets. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "32",
              "sid": "MAT 23:32"
            },
            "Fill up, then,",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "23:32 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "Go ahead, then, and complete"
                  ]
                }
              ]
            },
            " the measure ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "of the sin"
              ]
            },
            " of your fathers. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "33",
              "sid": "MAT 23:33"
            },
            "You snakes! You brood of vipers! How will you escape the sentence of hell?"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "34",
          "sid": "MAT 23:34"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Because of this, I am sending you prophets and wise ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "men"
              ]
            },
            " and teachers. Some of them you will kill and crucify, and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "others"
              ]
            },
            " you will flog in your synagogues and persecute from town to town. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "35",
              "sid": "MAT 23:35"
            },
            "And so upon you will come all ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " righteous blood shed on earth, from the blood of righteous Abel to the blood of Zechariah son of Berechiah, whom you murdered between the temple and the altar. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "36",
              "sid": "MAT 23:36"
            },
            "Truly I tell you, all these things will come upon this generation."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Lament over Jerusalem"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 13:31-35",
          "content": [
            "Luke 13:31–35"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "37",
          "sid": "MAT 23:37"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "O Jerusalem, Jerusalem, who kills the prophets and stones those sent to her, how often I have longed to gather your children ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "together"
              ]
            },
            ", as a hen gathers her chicks under ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "her"
              ]
            },
            " wings, but you were unwilling! ",
            {
              "type": "verse",
              "marker": "v",
              "number": "38",
              "sid": "MAT 23:38"
            },
            "Look, your house is left to you desolate.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "23:38 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "NE and WH do not include "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "desolate"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "."
                  ]
                }
              ]
            },
            {
              "type": "verse",
              "marker": "v",
              "number": "39",
              "sid": "MAT 23:39"
            },
            "For I tell you ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "that"
              ]
            },
            " you will not see Me again until you say, ‘Blessed ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " He who comes in ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " name of ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " Lord.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "23:39 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "PSA 118:26",
                      "content": [
                        "Psalm 118:26"
                      ]
                    }
                  ]
                }
              ]
            },
            "”"
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "24",
      "sid": "MAT 24"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Temple Destruction and Other Signs"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 13:1-8",
          "content": [
            "Mark 13:1–8"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 21:5-9",
          "content": [
            "Luke 21:5–9"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MAT 24:1"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "As"
          ]
        },
        " Jesus left the temple ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " was walking away, His disciples came up to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        " to point out ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "its"
          ]
        },
        " buildings."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "2",
              "sid": "MAT 24:2"
            },
            "“Do you see all these things?”"
          ]
        },
        " He replied. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Truly I tell you, not one stone here will be left on ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "another"
              ]
            },
            "; ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "every one"
              ]
            },
            " will be thrown down.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "MAT 24:3"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "While"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " was sitting on the Mount of Olives, the disciples came to Him privately. “Tell us,” they said, “when ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "will"
          ]
        },
        " these things happen, and what ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "will be"
          ]
        },
        " the sign of Your coming and of the end of the age?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "MAT 24:4"
        },
        "Jesus answered, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“See to it that no one deceives you. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "5",
              "sid": "MAT 24:5"
            },
            "For many will come in My name, claiming, ‘I am the Christ,’ and will deceive many. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "6",
              "sid": "MAT 24:6"
            },
            "You will hear of wars and rumors of wars, but see to it that you are not alarmed. ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "These things"
              ]
            },
            " must happen, but the end is still to come. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "7",
              "sid": "MAT 24:7"
            },
            "Nation will rise against nation, and kingdom against kingdom. There will be famines and earthquakes in ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "various"
              ]
            },
            " places. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "8",
              "sid": "MAT 24:8"
            },
            "All these ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "are"
              ]
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " beginning of birth pains."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Witnessing to All Nations"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 13:9-13",
          "content": [
            "Mark 13:9–13"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 21:10-19",
          "content": [
            "Luke 21:10–19"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MAT 24:9"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Then they will deliver you over to be persecuted and killed, and you will be hated by all nations because of My name. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "10",
              "sid": "MAT 24:10"
            },
            "At that time many will fall away and will betray and hate one another, ",
            {
              "type": "verse",
              "marker": "v",
              "number": "11",
              "sid": "MAT 24:11"
            },
            "and many false prophets will arise and deceive many."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "MAT 24:12"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Because of the multiplication of wickedness, the love of most will grow cold. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "13",
              "sid": "MAT 24:13"
            },
            "But the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "one who"
              ]
            },
            " perseveres to ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " end will be saved."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MAT 24:14"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "And this gospel of the kingdom will be preached in all the world as a testimony to all nations, and then the end will come."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Abomination of Desolation"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 13:14-23",
          "content": [
            "Mark 13:14–23"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 21:20-24",
          "content": [
            "Luke 21:20–24"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "MAT 24:15"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "So when you see standing in ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " holy place ‘the abomination of desolation,’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "24:15 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "See ",
                    {
                      "type": "ref",
                      "loc": "DAN 9:27",
                      "content": [
                        "Daniel 9:27"
                      ]
                    },
                    ", Daniel 11:31, and Daniel 12:11."
                  ]
                }
              ]
            },
            " spoken of by the prophet Daniel (",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "let"
              ]
            },
            " the reader understand), ",
            {
              "type": "verse",
              "marker": "v",
              "number": "16",
              "sid": "MAT 24:16"
            },
            "then ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "let"
              ]
            },
            " those who are in Judea flee to the mountains. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "17",
              "sid": "MAT 24:17"
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "Let no one"
              ]
            },
            " on the housetop come down to retrieve anything from his house. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "18",
              "sid": "MAT 24:18"
            },
            "And ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "let no one"
              ]
            },
            " in the field return for his cloak."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "MAT 24:19"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "How miserable those days ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "will be"
              ]
            },
            " for pregnant and nursing ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "mothers"
              ]
            },
            "! ",
            {
              "type": "verse",
              "marker": "v",
              "number": "20",
              "sid": "MAT 24:20"
            },
            "Pray that your flight will not occur in the winter ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "or"
              ]
            },
            " on the Sabbath. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "21",
              "sid": "MAT 24:21"
            },
            "For at that time there will be great tribulation, unseen from ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " beginning of ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " world until now, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " never to be ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "seen again"
              ]
            },
            ". ",
            {
              "type": "verse",
              "marker": "v",
              "number": "22",
              "sid": "MAT 24:22"
            },
            "If those days had not been cut short, nobody would be saved. But for the sake of the elect, those days will be cut short."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MAT 24:23"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "At that time, if anyone says to you, ‘Look, here ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " the Christ!’ or ‘There ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "He is"
              ]
            },
            "!’ ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "do"
              ]
            },
            " not believe ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            ". ",
            {
              "type": "verse",
              "marker": "v",
              "number": "24",
              "sid": "MAT 24:24"
            },
            "For false Christs and false prophets will appear and perform great signs and wonders to deceive even the elect, if that were possible. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "25",
              "sid": "MAT 24:25"
            },
            "See, I have told you in advance."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Return of the Son of Man"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 13:24-27",
          "content": [
            "Mark 13:24–27"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 21:25-28",
          "content": [
            "Luke 21:25–28"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "MAT 24:26"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "So if they tell you, ‘There He is, in the wilderness,’ ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "do"
              ]
            },
            " not go out, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "or"
              ]
            },
            ", ‘Here ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "He is,"
              ]
            },
            " in the inner rooms,’ ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "do"
              ]
            },
            " not believe ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            ". ",
            {
              "type": "verse",
              "marker": "v",
              "number": "27",
              "sid": "MAT 24:27"
            },
            "For just as the lightning comes from ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " east and flashes as far as ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " west, so will be the coming of the Son of Man. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "28",
              "sid": "MAT 24:28"
            },
            "Wherever there is a carcass, there the vultures will gather."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "MAT 24:29"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Immediately after the tribulation of those days:"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "‘The sun will be darkened,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "and the moon will not give its light;"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "the stars will fall from the sky,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "and the powers of the heavens will be shaken.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "24:29 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "and the celestial bodies will be shaken"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "; see ",
                    {
                      "type": "ref",
                      "loc": "ISA 13:10",
                      "content": [
                        "Isaiah 13:10"
                      ]
                    },
                    ", Isaiah 34:4, and Joel 2:10."
                  ]
                }
              ]
            },
            "’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "MAT 24:30"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "At that time the sign of the Son of Man will appear in heaven,",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "24:30 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "the sky"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "; twice in this verse"
                  ]
                }
              ]
            },
            " and all the tribes of the earth will mourn. They will see the Son of Man coming on the clouds of heaven with power and great glory.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "24:30 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "See ",
                    {
                      "type": "ref",
                      "loc": "DAN 7:13-14",
                      "content": [
                        "Daniel 7:13–14"
                      ]
                    },
                    "."
                  ]
                }
              ]
            },
            {
              "type": "verse",
              "marker": "v",
              "number": "31",
              "sid": "MAT 24:31"
            },
            "And He will send out His angels with a loud trumpet call, and they will gather His elect from the four winds, from one end of the heavens to the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "other"
              ]
            },
            "."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Lesson of the Fig Tree"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 13:28-31",
          "content": [
            "Mark 13:28–31"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 21:29-33",
          "content": [
            "Luke 21:29–33"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "32",
          "sid": "MAT 24:32"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Now learn this lesson",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "24:32 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "this parable"
                  ]
                }
              ]
            },
            " from the fig tree: As soon as its branches become tender and sprout leaves, you know that summer ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " near. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "33",
              "sid": "MAT 24:33"
            },
            "So also, when you see all these things, you will know that He is near,",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "24:33 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "it is near"
                  ]
                }
              ]
            },
            " right at ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " door. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "34",
              "sid": "MAT 24:34"
            },
            "Truly I tell you, this generation ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "will"
              ]
            },
            " not pass away until all these things have happened. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "35",
              "sid": "MAT 24:35"
            },
            "Heaven and earth will pass away, but My words ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "will"
              ]
            },
            " never pass away."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Readiness at Any Hour"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "GEN 6:1-7",
          "content": [
            "Genesis 6:1–7"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MRK 13:32-37",
          "content": [
            "Mark 13:32–37"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 12:35-48",
          "content": [
            "Luke 12:35–48"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "36",
          "sid": "MAT 24:36"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "No one knows about that day ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "or"
              ]
            },
            " hour, not even the angels in heaven, nor the Son,",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "24:36 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "BYZ and TR do not include "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "nor the Son"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "."
                  ]
                }
              ]
            },
            " but only the Father. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "37",
              "sid": "MAT 24:37"
            },
            "As ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it was"
              ]
            },
            " in the days of Noah, so will it be at the coming of the Son of Man. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "38",
              "sid": "MAT 24:38"
            },
            "For in the days before the flood, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "people"
              ]
            },
            " were eating and drinking, marrying and giving in marriage, up to the day Noah entered the ark. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "39",
              "sid": "MAT 24:39"
            },
            "And they were oblivious until the flood came and swept them all away. So will it be ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "at"
              ]
            },
            " the coming of the Son of Man. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "40",
              "sid": "MAT 24:40"
            },
            "Two ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "men"
              ]
            },
            " will be in the field: one will be taken and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the other"
              ]
            },
            " left. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "41",
              "sid": "MAT 24:41"
            },
            "Two ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "women"
              ]
            },
            " will be grinding at the mill: one will be taken and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the other"
              ]
            },
            " left."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "42",
          "sid": "MAT 24:42"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Therefore keep watch, because you do not know ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " day on which your Lord will come. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "43",
              "sid": "MAT 24:43"
            },
            "But understand this: If the homeowner had known in which watch of the night the thief was coming, he would have kept watch and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "would"
              ]
            },
            " not have let his house be broken into. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "44",
              "sid": "MAT 24:44"
            },
            "For this reason, you also must be ready, because the Son of Man will come at an hour you do not expect."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "45",
          "sid": "MAT 24:45"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Who then is the faithful and wise servant, whom the master has put in charge of his household, to give ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the others"
              ]
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "their"
              ]
            },
            " food at the proper time? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "46",
              "sid": "MAT 24:46"
            },
            "Blessed ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " that servant whose master finds him doing so when he returns. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "47",
              "sid": "MAT 24:47"
            },
            "Truly I tell you, he will put him in charge of all his possessions."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "48",
          "sid": "MAT 24:48"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "But suppose that servant ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " wicked ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " says in his heart, ‘My master will be away a long time.’ ",
            {
              "type": "verse",
              "marker": "v",
              "number": "49",
              "sid": "MAT 24:49"
            },
            "And he begins to beat his fellow servants and to eat and drink with drunkards. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "50",
              "sid": "MAT 24:50"
            },
            "The master of that servant will come on a day he does not expect and at an hour he does not anticipate. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "51",
              "sid": "MAT 24:51"
            },
            "Then he will cut him to pieces and assign him a place with the hypocrites, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "where"
              ]
            },
            " there will be weeping and gnashing of teeth.’’"
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "25",
      "sid": "MAT 25"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Parable of the Ten Virgins"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MAT 25:1"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            {
              "type": "char",
              "marker": "add",
              "content": [
                "“"
              ]
            },
            "At that time the kingdom of heaven will be like ten virgins who took their lamps ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " went out to meet the bridegroom. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "2",
              "sid": "MAT 25:2"
            },
            "Five of them were foolish, and five ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "were"
              ]
            },
            " wise. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "3",
              "sid": "MAT 25:3"
            },
            "The foolish ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "ones"
              ]
            },
            " took their lamps ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "but did not"
              ]
            },
            " take along ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "any extra"
              ]
            },
            " oil. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "4",
              "sid": "MAT 25:4"
            },
            "But the wise ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "ones"
              ]
            },
            " took oil in flasks along with their lamps. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "5",
              "sid": "MAT 25:5"
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "When"
              ]
            },
            " the bridegroom was delayed, they all became drowsy and fell asleep."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "MAT 25:6"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "At midnight the cry rang out: ‘Here is the bridegroom! Come out to meet him!’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MAT 25:7"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Then all the virgins woke up and trimmed their lamps. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "8",
              "sid": "MAT 25:8"
            },
            "The foolish ones said to the wise, ‘Give us some of your oil; our lamps are going out.’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MAT 25:9"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "‘No,’ said the wise ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "ones"
              ]
            },
            ", ‘or there may not be enough for ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "both"
              ]
            },
            " us and you. Instead, go to those who sell ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "oil"
              ]
            },
            " and buy ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "some"
              ]
            },
            " for yourselves.’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "MAT 25:10"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "But ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "while"
              ]
            },
            " they were on their way to buy ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            ", the bridegroom arrived. Those who were ready went in with him to the wedding banquet, and the door was shut."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "MAT 25:11"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Later the other virgins arrived and said, ‘Lord, lord, open ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the door"
              ]
            },
            " for us!’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "MAT 25:12"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "But he replied, ‘Truly I tell you, I do not know you.’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MAT 25:13"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Therefore keep watch, because you do not know the day ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "or"
              ]
            },
            " the hour.",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "25:13 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "BYZ and TR include "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "when the Son of Man comes"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "."
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Parable of the Talents"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 19:11-27",
          "content": [
            "Luke 19:11–27"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MAT 25:14"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "For ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            " is just like a man going on a journey, who called his servants and entrusted them with his possessions. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "15",
              "sid": "MAT 25:15"
            },
            "To one he gave five talents,",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "25:15 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "A talent was worth about twenty years’ wages for a laborer."
                  ]
                }
              ]
            },
            " to ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "another"
              ]
            },
            " two ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "talents"
              ]
            },
            ", and to ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "another"
              ]
            },
            " one ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "talent"
              ]
            },
            " — each according to his own ability. And he went on his journey."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "16",
              "sid": "MAT 25:16"
            },
            "The ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "servant"
              ]
            },
            " who had received the five talents went at once ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " put them to work",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "25:16 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    {
                      "type": "char",
                      "marker": "fv",
                      "content": [
                        "15"
                      ]
                    },
                    "... And he went on his journey at once. ",
                    {
                      "type": "char",
                      "marker": "fv",
                      "content": [
                        "16"
                      ]
                    },
                    "... went and put them to work"
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    ". Translators vary as to the placement of the Greek adverb "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "eutheōs "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "(at once) at the end of verse 15 or at the beginning of verse 16."
                  ]
                }
              ]
            },
            " and gained five more. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "17",
              "sid": "MAT 25:17"
            },
            "Likewise, the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "one with"
              ]
            },
            " the two ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "talents"
              ]
            },
            " gained two more. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "18",
              "sid": "MAT 25:18"
            },
            "But the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "servant"
              ]
            },
            " who had received the one ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "talent"
              ]
            },
            " went off, dug a hole in the ground, and hid his master’s money."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "MAT 25:19"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "After a long time the master of those servants returned and settled accounts with them. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "20",
              "sid": "MAT 25:20"
            },
            "The ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "servant"
              ]
            },
            " who had received the five talents came ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " presented five more. ‘Master,’ he said, ‘you entrusted me ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "with"
              ]
            },
            " five talents. See, I have gained five more.’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "MAT 25:21"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "His master replied, ‘Well done, good and faithful servant! You have been faithful with a few things; I will put you ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "in charge"
              ]
            },
            " of many things. Enter into the joy of your master!’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "MAT 25:22"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "The ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "servant"
              ]
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "who had received"
              ]
            },
            " the two talents also came ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " said, ‘Master, you entrusted me ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "with"
              ]
            },
            " two talents. See, I have gained two more.’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MAT 25:23"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "His master replied, ‘Well done, good and faithful servant! You have been faithful with a few things; I will put you ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "in charge"
              ]
            },
            " of many things. Enter into the joy of your master!’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "MAT 25:24"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Finally, the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "servant"
              ]
            },
            " who had received the one talent came and said, ‘Master, I knew that you are a hard man, reaping where you have not sown and gathering where you have not scattered seed. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "25",
              "sid": "MAT 25:25"
            },
            "So I was afraid and went out ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " hid your talent in the ground. See, you have what ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "belongs"
              ]
            },
            " to you.’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "MAT 25:26"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "‘You wicked, lazy servant!’ replied his master. ‘You knew that I reap where I have not sown and gather where I have not scattered seed. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "27",
              "sid": "MAT 25:27"
            },
            "Then you should have deposited my money with the bankers, and on my return I would have received it ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "back"
              ]
            },
            " with interest."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "MAT 25:28"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Therefore take the talent from him and give ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            " to the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "one"
              ]
            },
            " who has ten talents. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "29",
              "sid": "MAT 25:29"
            },
            "For everyone who has will be given ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "more"
              ]
            },
            ", and ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "he"
              ]
            },
            " will have an abundance. But the ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "one who"
              ]
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "does"
              ]
            },
            " not have, even what he has will be taken away from him. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "30",
              "sid": "MAT 25:30"
            },
            "And throw that worthless servant into the outer darkness, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "where"
              ]
            },
            " there will be weeping and gnashing of teeth.’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Sheep and the Goats"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "MAT 25:31"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "When the Son of Man comes in His glory, and all the angels with Him, He will sit on His glorious throne. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "32",
              "sid": "MAT 25:32"
            },
            "All the nations will be gathered before Him, and He will separate ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the people"
              ]
            },
            " one from another, as a shepherd separates the sheep from the goats. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "33",
              "sid": "MAT 25:33"
            },
            "He will place the sheep on His right and the goats on ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "His"
              ]
            },
            " left."
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "34",
          "sid": "MAT 25:34"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Then the King will say to those on His right, ‘Come, you who are blessed by My Father, inherit the kingdom prepared for you from ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " foundation of ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " world. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "35",
              "sid": "MAT 25:35"
            },
            "For I was hungry and you gave Me ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "something"
              ]
            },
            " to eat, I was thirsty and you gave Me ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "something"
              ]
            },
            " to drink, I was a stranger and you took Me in, ",
            {
              "type": "verse",
              "marker": "v",
              "number": "36",
              "sid": "MAT 25:36"
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "I was"
              ]
            },
            " naked and you clothed Me, I was sick and you looked after Me, I was in prison and you visited Me.’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "37",
          "sid": "MAT 25:37"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Then the righteous will answer Him, ‘Lord, when did we see You hungry and feed ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "You"
              ]
            },
            ", or thirsty and give ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "You"
              ]
            },
            " something to drink? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "38",
              "sid": "MAT 25:38"
            },
            "When did we see You a stranger and take ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "You"
              ]
            },
            " in, or naked and clothe ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "You"
              ]
            },
            "? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "39",
              "sid": "MAT 25:39"
            },
            "When did we see You sick or in prison and visit You?’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "40",
          "sid": "MAT 25:40"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "And the King will reply, ‘Truly I tell you, whatever you did for one of the least of these brothers of Mine, you did for Me.’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "41",
          "sid": "MAT 25:41"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Then He will say to those on ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "His"
              ]
            },
            " left, ‘Depart from Me, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "you"
              ]
            },
            " who are cursed, into the eternal fire prepared for the devil and his angels. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "42",
              "sid": "MAT 25:42"
            },
            "For I was hungry and you gave Me nothing to eat, I was thirsty and you gave Me nothing to drink, ",
            {
              "type": "verse",
              "marker": "v",
              "number": "43",
              "sid": "MAT 25:43"
            },
            "I was a stranger and you did not take Me in, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "I was"
              ]
            },
            " naked and you did not clothe Me, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "I was"
              ]
            },
            " sick and in prison and you did not look after Me.’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "44",
          "sid": "MAT 25:44"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "And they too will reply, ‘Lord, when did we see You hungry or thirsty or a stranger or naked or sick or in prison, and did not minister to You?’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "45",
          "sid": "MAT 25:45"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "Then ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the King"
              ]
            },
            " will answer, ‘Truly I tell you, whatever you did not do for one of the least of these, you did not do for Me.’"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "46",
          "sid": "MAT 25:46"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "And they will go away into eternal punishment, but the righteous into eternal life.”"
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "26",
      "sid": "MAT 26"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Plot to Kill Jesus"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 14:1-2",
          "content": [
            "Mark 14:1–2"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 22:1-2",
          "content": [
            "Luke 22:1–2"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 11:45-57",
          "content": [
            "John 11:45–57"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MAT 26:1"
        },
        "When Jesus had finished ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "saying"
          ]
        },
        " all these things, He told His disciples, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "2",
              "sid": "MAT 26:2"
            },
            "“You know that the Passover is two days away, and the Son of Man will be handed over to be crucified.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "MAT 26:3"
        },
        "At that time the chief priests and elders of the people assembled in the courtyard of the high priest, whose name was Caiaphas, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "MAT 26:4"
        },
        "and they conspired to arrest Jesus covertly and kill ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MAT 26:5"
        },
        "“But not during the feast,” they said, “or there may be a riot among the people.”"
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Anointed at Bethany"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 14:3-9",
          "content": [
            "Mark 14:3–9"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 7:36-50",
          "content": [
            "Luke 7:36–50"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 12:1-8",
          "content": [
            "John 12:1–8"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "MAT 26:6"
        },
        "While Jesus was in Bethany in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " home of Simon the Leper,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "26:6 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Aramaic "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Simon the Potter "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Simon the Jar Maker"
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MAT 26:7"
        },
        "a woman came to Him with an alabaster jar of expensive perfume, which she poured on His head as He reclined at the table."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "MAT 26:8"
        },
        "When the disciples saw this, they were indignant and asked, “Why this waste? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MAT 26:9"
        },
        "This ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "perfume"
          ]
        },
        " could have been sold at a high price, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the money"
          ]
        },
        " given to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " poor.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "MAT 26:10"
        },
        "Aware of this, Jesus asked, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Why are you bothering ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "this"
              ]
            },
            " woman? She has done a beautiful deed to Me. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "11",
              "sid": "MAT 26:11"
            },
            "The poor you will always have with you,",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "26:11 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "See ",
                    {
                      "type": "ref",
                      "loc": "DEU 15:11",
                      "content": [
                        "Deuteronomy 15:11"
                      ]
                    },
                    "."
                  ]
                }
              ]
            },
            " but ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "you will"
              ]
            },
            " not always have Me. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "12",
              "sid": "MAT 26:12"
            },
            "By pouring this perfume on Me, she has prepared My body for burial. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "13",
              "sid": "MAT 26:13"
            },
            "Truly I tell you, wherever this gospel is preached in all the world, what she has done will also be told in memory of her.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Judas Agrees to Betray Jesus"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 14:10-11",
          "content": [
            "Mark 14:10–11"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 22:3-6",
          "content": [
            "Luke 22:3–6"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MAT 26:14"
        },
        "Then one of the Twelve, the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one"
          ]
        },
        " called Judas Iscariot, went to the chief priests ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "MAT 26:15"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " asked, “What are you willing to give me if I hand Him ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "over"
          ]
        },
        " to you?” And they set out for him thirty pieces of silver. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "MAT 26:16"
        },
        "So from then on ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Judas"
          ]
        },
        " looked for an opportunity to betray ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Preparing the Passover"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 14:12-16",
          "content": [
            "Mark 14:12–16"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 22:7-13",
          "content": [
            "Luke 22:7–13"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "MAT 26:17"
        },
        "On the first ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "day"
          ]
        },
        " of the Feast of Unleavened ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Bread"
          ]
        },
        ",",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "26:17 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "On the first of the Unleavened"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; see ",
                {
                  "type": "ref",
                  "loc": "EXO 12:14-20",
                  "content": [
                    "Exodus 12:14–20"
                  ]
                },
                "."
              ]
            }
          ]
        },
        " the disciples came to Jesus ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " asked, “Where do You want us to prepare for You to eat the Passover?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "MAT 26:18"
        },
        "He answered, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Go into the city to a certain man and tell him ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "that"
              ]
            },
            " the Teacher says, ‘My time is near. I will keep the Passover with My disciples at your ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "house"
              ]
            },
            ".’”"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "MAT 26:19"
        },
        "So the disciples did as Jesus had directed them and prepared the Passover."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Last Supper"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 14:17-26",
          "content": [
            "Mark 14:17–26"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 22:14-23",
          "content": [
            "Luke 22:14–23"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "1CO 11:17-34",
          "content": [
            "1 Corinthians 11:17–34"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "MAT 26:20"
        },
        "When evening came, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " was reclining with the twelve disciples.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "26:20 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "the Twelve"
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "MAT 26:21"
        },
        "And while they were eating, He said to them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Truly I tell you, one of you will betray Me.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "MAT 26:22"
        },
        "They were deeply grieved ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " began to ask Him one after another, “Surely not I, Lord?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MAT 26:23"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " answered, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“The ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "one"
              ]
            },
            " who has dipped ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "his"
              ]
            },
            " hand into the bowl with Me will betray Me. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "24",
              "sid": "MAT 26:24"
            },
            "The Son of Man will go just as it is written about Him, but woe to that man by whom ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "He"
              ]
            },
            " is betrayed. It would be better for him if ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "he"
              ]
            },
            " had not been born.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "MAT 26:25"
        },
        "Then Judas, who would betray Him, said, “Surely not I, Rabbi?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " answered, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“You have said ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            " yourself.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "MAT 26:26"
        },
        "While they were eating, Jesus took bread, spoke a blessing ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " broke ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        ", and gave ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " to the disciples, saying, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Take ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " eat; this is My body.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "MAT 26:27"
        },
        "Then He took ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " cup, gave thanks, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " gave ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " to them, saying, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Drink from it, all of you. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "28",
              "sid": "MAT 26:28"
            },
            "This is My blood of the covenant,",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "26:28 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "BYZ and TR "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "the new covenant"
                  ]
                }
              ]
            },
            " which is poured out for many for ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " forgiveness of sins. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "29",
              "sid": "MAT 26:29"
            },
            "I tell you, I will not drink of this fruit of the vine from now on until that day when I drink it anew with you in My Father’s kingdom.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "MAT 26:30"
        },
        "And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "when"
          ]
        },
        " they had sung a hymn, they went out to the Mount of Olives."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Predicts Peter’s Denial"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ZEC 13:7-9",
          "content": [
            "Zechariah 13:7–9"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MRK 14:27-31",
          "content": [
            "Mark 14:27–31"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 22:31-38",
          "content": [
            "Luke 22:31–38"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 13:36-38",
          "content": [
            "John 13:36–38"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "MAT 26:31"
        },
        "Then Jesus said to them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“This very night you will all fall away on account of Me. For it is written:"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "‘I will strike the Shepherd,"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "and the sheep of the flock will be scattered.’",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "26:31 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    {
                      "type": "ref",
                      "loc": "ZEC 13:7",
                      "content": [
                        "Zechariah 13:7"
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "32",
          "sid": "MAT 26:32"
        },
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "But after I have risen, I will go ahead of you into Galilee.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "MAT 26:33"
        },
        "Peter said to Him, “Even if all fall away on account of You, I never will.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "34",
              "sid": "MAT 26:34"
            },
            "“Truly I tell you,”"
          ]
        },
        " Jesus declared, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“this very night, before ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " rooster crows, you will deny Me three times.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "35",
          "sid": "MAT 26:35"
        },
        "Peter replied, “Even if I have to die with You, I will never deny You.” And all the other disciples said the same thing."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Prays at Gethsemane"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 14:32-42",
          "content": [
            "Mark 14:32–42"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 22:39-46",
          "content": [
            "Luke 22:39–46"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "36",
          "sid": "MAT 26:36"
        },
        "Then Jesus went with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His disciples"
          ]
        },
        " to a place called Gethsemane, and He told ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        ", ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Sit here while I go over there ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " pray.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "37",
          "sid": "MAT 26:37"
        },
        "He took with Him Peter and the two sons of Zebedee ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " began to be sorrowful and deeply distressed. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "38",
          "sid": "MAT 26:38"
        },
        "Then He said to them, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“My soul is consumed with sorrow to the point of death. Stay here and keep watch with Me.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "39",
          "sid": "MAT 26:39"
        },
        "Going a little ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "farther"
          ]
        },
        ", He fell facedown ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " prayed, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“My Father, if it is possible, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "let"
              ]
            },
            " this cup pass from Me. Yet not as I will, but as You ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "will"
              ]
            },
            ".”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "40",
          "sid": "MAT 26:40"
        },
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " returned to the disciples and found them sleeping. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Were you not able to keep watch with Me ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "for"
              ]
            },
            " one hour?”"
          ]
        },
        " He asked Peter. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "41",
              "sid": "MAT 26:41"
            },
            "“Watch and pray so that you will not enter into temptation. For the spirit ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " willing, but the body ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "is"
              ]
            },
            " weak.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "42",
          "sid": "MAT 26:42"
        },
        "A second time He went away ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " prayed, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“My Father, if this ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "cup"
              ]
            },
            " cannot pass unless I drink it, ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "may"
              ]
            },
            " Your will be done.”"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "43",
          "sid": "MAT 26:43"
        },
        "And again ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " returned ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " found them sleeping, for their eyes were heavy."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "44",
          "sid": "MAT 26:44"
        },
        "So He left them ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " went away once more ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " prayed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "a"
          ]
        },
        " third time, saying the same thing. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "45",
          "sid": "MAT 26:45"
        },
        "Then He returned to the disciples and said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Are you still sleeping and resting? Look, the hour is near, and the Son of Man is betrayed into ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " hands of sinners. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "46",
              "sid": "MAT 26:46"
            },
            "Rise, let us go! See, My betrayer is approaching!”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Betrayal of Jesus"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 14:43-52",
          "content": [
            "Mark 14:43–52"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 22:47-53",
          "content": [
            "Luke 22:47–53"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 18:1-14",
          "content": [
            "John 18:1–14"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "47",
          "sid": "MAT 26:47"
        },
        "While ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " was still speaking, Judas, one of the Twelve, arrived, accompanied by a large crowd ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "armed"
          ]
        },
        " with swords and clubs, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "sent"
          ]
        },
        " from the chief priests and elders of the people."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "48",
          "sid": "MAT 26:48"
        },
        "Now the betrayer had arranged a signal with them: “The One I kiss is ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the man"
          ]
        },
        "; arrest Him.” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "49",
          "sid": "MAT 26:49"
        },
        "Going directly to Jesus, he said, “Greetings, Rabbi!” and kissed Him."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "50",
              "sid": "MAT 26:50"
            },
            "“Friend,”"
          ]
        },
        " Jesus replied, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "do"
              ]
            },
            " what you came for.”"
          ]
        },
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "26:50 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "“Friend,” Jesus replied, “for what have you come?”"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the men"
          ]
        },
        " stepped forward, seized Jesus, and arrested Him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "51",
          "sid": "MAT 26:51"
        },
        "At this, one of Jesus’ companions drew his sword and struck the servant of the high priest, cutting off his ear."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "52",
              "sid": "MAT 26:52"
            },
            "“Put your sword back in its place,”"
          ]
        },
        " Jesus said to him. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“For all who draw ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " sword will die by ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " sword. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "53",
              "sid": "MAT 26:53"
            },
            "Are you not aware that I can call on My Father, and He will at once put at My disposal more than twelve legions of angels? ",
            {
              "type": "verse",
              "marker": "v",
              "number": "54",
              "sid": "MAT 26:54"
            },
            "But how then ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "would"
              ]
            },
            " the Scriptures be fulfilled that say it must happen this way?”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "55",
          "sid": "MAT 26:55"
        },
        "At that time Jesus said to the crowd, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Have you come out with swords and clubs to arrest Me as ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "you would"
              ]
            },
            " an outlaw? Every day I sat teaching in the temple ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "courts"
              ]
            },
            ",",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "26:55 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Literally "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "the temple"
                  ]
                }
              ]
            },
            " and you did not arrest Me. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "56",
              "sid": "MAT 26:56"
            },
            "But this ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "has"
              ]
            },
            " all happened so that the writings of the prophets would be fulfilled.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Then all the disciples deserted Him ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " fled."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus before the Sanhedrin"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 14:53-65",
          "content": [
            "Mark 14:53–65"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 22:66-71",
          "content": [
            "Luke 22:66–71"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 18:19-24",
          "content": [
            "John 18:19–24"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "57",
          "sid": "MAT 26:57"
        },
        "Those who had arrested Jesus led ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        " away to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the house of"
          ]
        },
        " Caiaphas the high priest, where the scribes and elders had gathered. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "58",
          "sid": "MAT 26:58"
        },
        "But Peter followed Him at a distance, right up to the courtyard of the high priest. And he went in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " sat down with the guards to see the outcome."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "59",
          "sid": "MAT 26:59"
        },
        "Now the chief priests and the whole Sanhedrin",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "26:59 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "the whole Council"
              ]
            }
          ]
        },
        " were seeking false testimony against Jesus in order to put Him to death. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "60",
          "sid": "MAT 26:60"
        },
        "But they did not find any, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "though"
          ]
        },
        " many false witnesses came forward."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Finally two came forward ",
        {
          "type": "verse",
          "marker": "v",
          "number": "61",
          "sid": "MAT 26:61"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " declared, “This ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        " said, ‘I am able to destroy the temple of God and rebuild it in three days.’”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "62",
          "sid": "MAT 26:62"
        },
        "So the high priest stood up ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " asked Him, “Have You no answer? What ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " these ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "men"
          ]
        },
        " testifying against You?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "63",
          "sid": "MAT 26:63"
        },
        "But Jesus remained silent."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Then the high priest said to Him, “I charge You under oath by the living God: Tell us if You are the Christ, the Son of God.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "64",
              "sid": "MAT 26:64"
            },
            "“You have said ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "it"
              ]
            },
            " yourself,”"
          ]
        },
        " Jesus answered. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“But I say to all of you, from now on you will see the Son of Man sitting at ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " right hand of Power",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "26:64 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Or "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "the right hand of the Mighty One"
                  ]
                }
              ]
            },
            " and coming on the clouds of heaven.”"
          ]
        },
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "26:64 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "See ",
                {
                  "type": "ref",
                  "loc": "PSA 110:1",
                  "content": [
                    "Psalm 110:1"
                  ]
                },
                " and Daniel 7:13."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "65",
          "sid": "MAT 26:65"
        },
        "At this, the high priest tore his clothes ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " declared, “He has blasphemed! Why do we need any more witnesses? Look, now you have heard the blasphemy. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "66",
          "sid": "MAT 26:66"
        },
        "What ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do"
          ]
        },
        " you think?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "“He deserves to die,” they answered."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "67",
          "sid": "MAT 26:67"
        },
        "Then they spit in His face and struck Him. Others slapped ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "68",
          "sid": "MAT 26:68"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, “Prophesy to us, Christ! Who hit You?”"
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Peter Denies Jesus"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 14:66-72",
          "content": [
            "Mark 14:66–72"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 22:54-62",
          "content": [
            "Luke 22:54–62"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 18:15-18",
          "content": [
            "John 18:15–18"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "69",
          "sid": "MAT 26:69"
        },
        "Meanwhile, Peter was sitting out in the courtyard, and a servant girl came up to him. “You also were with Jesus the Galilean,” she said."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "70",
          "sid": "MAT 26:70"
        },
        "But he denied ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " before ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        " all: “I do not know what you are talking about.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "71",
          "sid": "MAT 26:71"
        },
        "When ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Peter"
          ]
        },
        " had gone out to the gateway, another ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "servant girl"
          ]
        },
        " saw him and said to the people there, “This ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        " was with Jesus of Nazareth.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "72",
          "sid": "MAT 26:72"
        },
        "And again he denied ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " with an oath: “I do not know the man!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "73",
          "sid": "MAT 26:73"
        },
        "After a little while, those standing nearby came up to Peter. “Surely you are one of them,” they said, “for your accent gives you away.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "74",
          "sid": "MAT 26:74"
        },
        "At that he began to curse and swear ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to them"
          ]
        },
        ", “I do not know the man!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "And immediately a rooster crowed."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "75",
          "sid": "MAT 26:75"
        },
        "Then Peter remembered the word ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " Jesus had spoken: ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Before ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " rooster crows, you will deny Me three times.”"
          ]
        },
        " And he went outside ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " wept bitterly."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "27",
      "sid": "MAT 27"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus Delivered to Pilate"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 15:1-5",
          "content": [
            "Mark 15:1–5"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MAT 27:1"
        },
        "When morning came, all the chief priests and elders of the people conspired against Jesus to put Him to death. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MAT 27:2"
        },
        "They bound Him, led ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        " away, and handed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        " over to Pilate the governor."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Judas Hangs Himself"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ZEC 11:10-17",
          "content": [
            "Zechariah 11:10–17"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "MAT 27:3"
        },
        "When Judas, who had betrayed Him, saw that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " was condemned, he was filled with remorse ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " returned the thirty pieces of silver to the chief priests and elders. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "MAT 27:4"
        },
        "“I have sinned by betraying innocent blood,” he said."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "“What ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is that"
          ]
        },
        " to us?” they replied. “You bear the responsibility.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MAT 27:5"
        },
        "So ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Judas"
          ]
        },
        " threw the silver into the temple and left. Then he went away and hanged himself."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "MAT 27:6"
        },
        "The chief priests picked up the pieces of silver ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, “It is unlawful to put this into the treasury, since it is blood money.” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MAT 27:7"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "After"
          ]
        },
        " conferring together, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "they used"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the money"
          ]
        },
        " to buy the potter’s field as a burial place for foreigners. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "MAT 27:8"
        },
        "That is why ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " has been called the Field of Blood to this day. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MAT 27:9"
        },
        "Then what was spoken through Jeremiah the prophet was fulfilled:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“They took the thirty pieces of silver,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "the price set on Him by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " people of Israel,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "MAT 27:10"
        },
        "and they gave them for the potter’s field,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "as ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord had commanded me.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "27:10 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "See ",
                {
                  "type": "ref",
                  "loc": "JER 19:1-15",
                  "content": [
                    "Jeremiah 19:1–15"
                  ]
                },
                ", Jeremiah 32:6–9, and Zechariah 11:12–13."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Jesus before Pilate"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LUK 23:1-5",
          "content": [
            "Luke 23:1–5"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 18:28-40",
          "content": [
            "John 18:28–40"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "MAT 27:11"
        },
        "Meanwhile Jesus stood before the governor, who questioned Him: “Are You the King of the Jews?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“You have said ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "so"
              ]
            },
            ",”"
          ]
        },
        " Jesus replied."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "MAT 27:12"
        },
        "And when He was accused by the chief priests and elders, He gave no answer."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MAT 27:13"
        },
        "Then Pilate asked Him, “Do You not hear how many charges they are bringing against You?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MAT 27:14"
        },
        "But ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " gave no answer, not even to a single charge, much to the governor’s amazement."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Crowd Chooses Barabbas"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 15:6-11",
          "content": [
            "Mark 15:6–11"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 23:13-25",
          "content": [
            "Luke 23:13–25"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "MAT 27:15"
        },
        "Now ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it was"
          ]
        },
        " the governor’s custom at ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " feast to release to the crowd a prisoner of their choosing. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "MAT 27:16"
        },
        "At that time they were holding a notorious prisoner named Barabbas.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "27:16 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "SBL and NA "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Jesus Barabbas"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; also in verse 17, but universally called "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Barabbas "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "in verses 20, 21, and 26"
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "MAT 27:17"
        },
        "So when ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the crowd"
          ]
        },
        " had assembled, Pilate asked them, “Which ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one"
          ]
        },
        " do you want me to release to you: Barabbas, or Jesus who is called Christ?” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "MAT 27:18"
        },
        "For he knew ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it was"
          ]
        },
        " out of envy ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " they had handed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " over to him."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "MAT 27:19"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "While"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Pilate"
          ]
        },
        " was sitting on the judgment seat, his wife sent him this message: “Have nothing to do with that innocent ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        ", for I have suffered terribly in a dream today because of Him.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "MAT 27:20"
        },
        "But the chief priests and elders persuaded the crowds to ask for Barabbas and to have Jesus put to death."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "MAT 27:21"
        },
        "“Which of the two do you want me to release to you?” asked the governor."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "“Barabbas,” they replied."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "MAT 27:22"
        },
        "“What then should I do with Jesus who is called Christ?” Pilate asked."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "They all answered, “Crucify Him!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "MAT 27:23"
        },
        "“Why?” asked ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Pilate"
          ]
        },
        ". “What evil has He done?”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "But they shouted all the louder, “Crucify Him!”"
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Pilate Washes His Hands"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 15:12-15",
          "content": [
            "Mark 15:12–15"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "MAT 27:24"
        },
        "When Pilate saw that he was accomplishing nothing, but that instead a riot was breaking out, he took water ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " washed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " hands before the crowd. “I am innocent of this ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man’s"
          ]
        },
        " blood,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "27:24 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "this blood"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "this righteous blood"
              ]
            }
          ]
        },
        "” he said. “You bear the responsibility.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "MAT 27:25"
        },
        "All the people answered, “His blood ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " on us and on our children!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "MAT 27:26"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Pilate"
          ]
        },
        " released Barabbas to them. But he had Jesus flogged, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " handed Him over to be crucified."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Soldiers Mock Jesus"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ISA 50:4-11",
          "content": [
            "Isaiah 50:4–11"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MRK 15:16-20",
          "content": [
            "Mark 15:16–20"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 22:63-65",
          "content": [
            "Luke 22:63–65"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 19:1-15",
          "content": [
            "John 19:1–15"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "MAT 27:27"
        },
        "Then the governor’s soldiers took Jesus into the Praetorium ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " gathered the whole company around Him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "MAT 27:28"
        },
        "They stripped Him ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " put a scarlet robe on Him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "MAT 27:29"
        },
        "And they twisted together a crown of thorns ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " set ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " on His head. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "They put"
          ]
        },
        " a staff in His right hand, knelt down before Him, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " mocked Him, saying, “Hail, King of the Jews!” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "MAT 27:30"
        },
        "Then they spit on Him ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " took the staff and struck Him on the head ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "repeatedly"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "MAT 27:31"
        },
        "After they had mocked Him, they removed the robe and put His ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "own"
          ]
        },
        " clothes ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "back"
          ]
        },
        " on Him. Then they led Him away to crucify ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Crucifixion"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "PSA 22:1-31",
          "content": [
            "Psalm 22:1–31"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MRK 15:21-32",
          "content": [
            "Mark 15:21–32"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 23:26-43",
          "content": [
            "Luke 23:26–43"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 19:16-27",
          "content": [
            "John 19:16–27"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "32",
          "sid": "MAT 27:32"
        },
        "Along the way they found a man from Cyrene, named Simon, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " they forced him to carry the cross of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "MAT 27:33"
        },
        "And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "when"
          ]
        },
        " they came to a place called Golgotha, which means The Place of the Skull, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "34",
          "sid": "MAT 27:34"
        },
        "they offered Him wine to drink, mixed with gall; but after tasting ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        ", He refused to drink ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "35",
          "sid": "MAT 27:35"
        },
        "When they had crucified Him, they divided up His garments by casting lots.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "27:35 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "See ",
                {
                  "type": "ref",
                  "loc": "PSA 22:18",
                  "content": [
                    "Psalm 22:18"
                  ]
                },
                "; TR includes "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "to fulfill what was said through the prophet: “They divided My garments among them, and cast lots for My clothing.”"
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "36",
          "sid": "MAT 27:36"
        },
        "And sitting down, they kept watch over Him there."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "37",
          "sid": "MAT 27:37"
        },
        "Above His head they posted the written charge against Him:"
      ]
    },
    {
      "type": "para",
      "marker": "pc",
      "content": [
        "THIS IS JESUS, THE KING OF THE JEWS."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "38",
          "sid": "MAT 27:38"
        },
        "Two robbers",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "27:38 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "insurrectionists"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; also in verse 44"
              ]
            }
          ]
        },
        " were crucified with Him, one on ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " right and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the other"
          ]
        },
        " on ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " left."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "39",
          "sid": "MAT 27:39"
        },
        "And those who passed by heaped abuse on Him, shaking their heads ",
        {
          "type": "verse",
          "marker": "v",
          "number": "40",
          "sid": "MAT 27:40"
        },
        "and saying, “You who are going to destroy the temple and rebuild ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " in three days, save Yourself! If You are ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Son of God, come down from the cross!”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "41",
          "sid": "MAT 27:41"
        },
        "In the same way, the chief priests, scribes, and elders mocked Him, saying, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "42",
          "sid": "MAT 27:42"
        },
        "“He saved others, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "but"
          ]
        },
        " He cannot save Himself. He is ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " King of Israel! Let Him come down now from the cross, and we will believe in Him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "43",
          "sid": "MAT 27:43"
        },
        "He trusts in God. Let ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "God"
          ]
        },
        " deliver Him now if He wants Him.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "27:43 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "PSA 22:8",
                  "content": [
                    "Psalm 22:8"
                  ]
                }
              ]
            }
          ]
        },
        " For He said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "‘I am ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "the"
              ]
            },
            " Son of God.’"
          ]
        },
        "”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "44",
          "sid": "MAT 27:44"
        },
        "In the same way, even the robbers who were crucified with Him berated Him."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Death of Jesus"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "PSA 22:1-31",
          "content": [
            "Psalm 22:1–31"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MRK 15:33-41",
          "content": [
            "Mark 15:33–41"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 23:44-49",
          "content": [
            "Luke 23:44–49"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 19:28-30",
          "content": [
            "John 19:28–30"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "45",
          "sid": "MAT 27:45"
        },
        "From ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " sixth hour until ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " ninth hour",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "27:45 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "That is, from noon until three in the afternoon"
              ]
            }
          ]
        },
        " darkness came over all the land. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "46",
          "sid": "MAT 27:46"
        },
        "About the ninth hour Jesus cried out in a loud voice, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Eli, Eli,",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "27:46 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "NE and WH "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "Eloi, Eloi"
                  ]
                }
              ]
            },
            " lema sabachthani?”"
          ]
        },
        " which means, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“My God, My God, why have You forsaken Me?”"
          ]
        },
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "27:46 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "PSA 22:1",
                  "content": [
                    "Psalm 22:1"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "47",
          "sid": "MAT 27:47"
        },
        "When some of those standing there heard this, they said, “",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "He"
          ]
        },
        " is calling Elijah.” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "48",
          "sid": "MAT 27:48"
        },
        "One of them quickly ran and brought a sponge. He filled ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " with sour wine,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "27:48 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "filled it with wine vinegar"
              ]
            }
          ]
        },
        " put ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " on a reed, and held it up for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus"
          ]
        },
        " to drink.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "27:48 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "See ",
                {
                  "type": "ref",
                  "loc": "PSA 69:21",
                  "content": [
                    "Psalm 69:21"
                  ]
                },
                "."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "49",
          "sid": "MAT 27:49"
        },
        "But the others said, “Leave ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        " alone. Let us see if Elijah comes to save Him.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "27:49 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "WH includes "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "And another took a spear and pierced His side, and water and blood flowed out"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; see ",
                {
                  "type": "ref",
                  "loc": "JHN 19:34",
                  "content": [
                    "John 19:34"
                  ]
                },
                "."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "50",
          "sid": "MAT 27:50"
        },
        "When Jesus had cried out again in a loud voice, He yielded up ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " spirit. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "51",
          "sid": "MAT 27:51"
        },
        "At that moment the veil of the temple was torn in two from top to bottom. The earth quaked, and the rocks were split. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "52",
          "sid": "MAT 27:52"
        },
        "The tombs broke open, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " bodies of many saints who had fallen asleep were raised. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "53",
          "sid": "MAT 27:53"
        },
        "After ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Jesus’"
          ]
        },
        " resurrection, when they had come out of the tombs, they entered the holy city and appeared to many ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "people"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "54",
          "sid": "MAT 27:54"
        },
        "When the centurion and those with him who were guarding Jesus saw the earthquake and all that had happened, they were terrified ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, “Truly this was ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Son of God.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "55",
          "sid": "MAT 27:55"
        },
        "And many women were there, watching from a distance. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "They"
          ]
        },
        " had followed Jesus from Galilee to minister to Him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "56",
          "sid": "MAT 27:56"
        },
        "Among ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        " were Mary Magdalene, Mary the mother of James and Joseph, and the mother of Zebedee’s sons."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Burial of Jesus"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ISA 53:9-12",
          "content": [
            "Isaiah 53:9–12"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MRK 15:42-47",
          "content": [
            "Mark 15:42–47"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 23:50-56",
          "content": [
            "Luke 23:50–56"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 19:38-42",
          "content": [
            "John 19:38–42"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "57",
          "sid": "MAT 27:57"
        },
        "When it was evening, there came a rich man from Arimathea named Joseph, who himself was a disciple of Jesus. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "58",
          "sid": "MAT 27:58"
        },
        "He went to Pilate to ask for the body of Jesus, and Pilate ordered that it be given to him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "59",
          "sid": "MAT 27:59"
        },
        "So Joseph took the body, wrapped it in a clean linen cloth, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "60",
          "sid": "MAT 27:60"
        },
        "and placed it in his own new tomb that he had cut into the rock. Then he rolled a great stone across the entrance to the tomb ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " went away. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "61",
          "sid": "MAT 27:61"
        },
        "Mary Magdalene and the other Mary were sitting there opposite the tomb."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Guards at the Tomb"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "62",
          "sid": "MAT 27:62"
        },
        "The next day, the one after Preparation Day, the chief priests and Pharisees assembled before Pilate. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "63",
          "sid": "MAT 27:63"
        },
        "“Sir,” they said, “we remember that while He was alive that deceiver said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "‘After three days I will rise again.’"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "64",
          "sid": "MAT 27:64"
        },
        "So give the order that the tomb be secured until the third day. Otherwise, His disciples may come ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " steal Him away and tell the people He has risen from the dead. And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        " last deception would be worse than the first.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "65",
          "sid": "MAT 27:65"
        },
        "“You have a guard,” Pilate said. “Go, make ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the tomb as"
          ]
        },
        " secure as you know ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "how"
          ]
        },
        ".” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "66",
          "sid": "MAT 27:66"
        },
        "So they went ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " secured the tomb by sealing the stone ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and posting"
          ]
        },
        " the guard."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "28",
      "sid": "MAT 28"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Resurrection"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 16:1-8",
          "content": [
            "Mark 16:1–8"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 24:1-12",
          "content": [
            "Luke 24:1–12"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "JHN 20:1-9",
          "content": [
            "John 20:1–9"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "MAT 28:1"
        },
        "After ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Sabbath, at dawn on ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " first ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "day"
          ]
        },
        " of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " week,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "28:1 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Now after the Sabbaths, it being dawn toward the first of the Sabbaths,"
              ]
            }
          ]
        },
        " Mary Magdalene and the other Mary went to see the tomb."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "MAT 28:2"
        },
        "Suddenly there was a great earthquake, for an angel of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord descended from heaven, rolled away the stone, and sat on it. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "MAT 28:3"
        },
        "His appearance was like lightning, and his clothes ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "were"
          ]
        },
        " white as snow. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "MAT 28:4"
        },
        "The guards trembled in fear of him and became like dead ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "men"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "MAT 28:5"
        },
        "But the angel said to the women, “",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Do"
          ]
        },
        " not be afraid, for I know that you are looking for Jesus, who was crucified. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "MAT 28:6"
        },
        "He is not here; He has risen, just as He said! Come, see the place where He lay.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "28:6 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "where the Lord lay"
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "MAT 28:7"
        },
        "Then go quickly ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " tell His disciples, ‘He has risen from the dead and is going ahead of you into Galilee. There you will see Him.’ See, I have told you.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "MAT 28:8"
        },
        "So they hurried away from the tomb in fear and great joy, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " ran to tell His disciples. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "MAT 28:9"
        },
        "Suddenly",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "28:9 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "They were going to tell His disciples, and suddenly"
              ]
            }
          ]
        },
        " Jesus met them ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Greetings!”"
          ]
        },
        " They came to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        ", grasped His feet, and worshiped Him. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            " ",
            {
              "type": "verse",
              "marker": "v",
              "number": "10",
              "sid": "MAT 28:10"
            },
            "“",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "Do"
              ]
            },
            " not be afraid,”"
          ]
        },
        " said Jesus. ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“Go ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " tell My brothers to go to Galilee. There they will see Me.”"
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Report of the Guards"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "MAT 28:11"
        },
        "While ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the women"
          ]
        },
        " were on their way, some of the guards went into the city ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " reported to the chief priests all that had happened. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "MAT 28:12"
        },
        "And after ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the chief priests"
          ]
        },
        " had met with the elders and formed a plan, they gave the soldiers a large sum of money ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "MAT 28:13"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " instructed them: “You are to say, ‘His disciples came by night ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " stole Him ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "away"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "while"
          ]
        },
        " we were asleep.’ ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "MAT 28:14"
        },
        "If this ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "report"
          ]
        },
        " reaches the governor, we will satisfy him and keep you out of trouble.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "MAT 28:15"
        },
        "So the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "guards"
          ]
        },
        " took the money ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " did as they were instructed. And this account has been circulated among ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Jews to this very day."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Great Commission"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MRK 16:14-18",
          "content": [
            "Mark 16:14–18"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "MAT 28:16"
        },
        "Meanwhile, the eleven disciples went to Galilee, to the mountain Jesus had designated. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "MAT 28:17"
        },
        "When they saw Him, they worshiped Him, but some doubted."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "MAT 28:18"
        },
        "Then Jesus came to them ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " said, ",
        {
          "type": "char",
          "marker": "wj",
          "content": [
            "“All authority in heaven and on earth has been given to Me. ",
            {
              "type": "verse",
              "marker": "v",
              "number": "19",
              "sid": "MAT 28:19"
            },
            "Therefore go ",
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " make disciples",
            {
              "type": "note",
              "marker": "f",
              "caller": "+",
              "content": [
                {
                  "type": "char",
                  "marker": "fr",
                  "content": [
                    "28:19 "
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "Literally "
                  ]
                },
                {
                  "type": "char",
                  "marker": "fqa",
                  "content": [
                    "Having gone, therefore, make disciples"
                  ]
                }
              ]
            },
            " of all nations, baptizing them in the name of the Father and of the Son and of the Holy Spirit, ",
            {
              "type": "verse",
              "marker": "v",
              "number": "20",
              "sid": "MAT 28:20"
            },
            {
              "type": "char",
              "marker": "add",
              "content": [
                "and"
              ]
            },
            " teaching them to obey all that I have commanded you. And surely I am with you always, even to the end of the age.”"
          ]
        }
      ]
    }
  ]
}