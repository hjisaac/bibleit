      "content": [
        "1 Peter"
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "1",
      "sid": "1PE 1"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "A Greeting from Peter"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "2PE 1:1-2",
          "content": [
            "2 Peter 1:1–2"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "1PE 1:1"
        },
        "Peter, an apostle of Jesus Christ,"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "To ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " elect who are exiles of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Dispersion ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "throughout"
          ]
        },
        " Pontus, Galatia, Cappadocia, Asia, and Bithynia, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "chosen"
          ]
        },
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:1 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "To the elect sojourners of the Diaspora of Pontus, Galatia, Cappadocia, Asia, and Bithynia"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                ". These provinces were located in what is now Turkey."
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "1PE 1:2"
        },
        "according to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " foreknowledge of God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Father ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " sanctified by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Spirit for obedience to Jesus Christ and sprinkling by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " blood:"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Grace and peace be yours in abundance."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "A Living Hope"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "1PE 1:3"
        },
        "Blessed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " the God and Father of our Lord Jesus Christ! By His great mercy ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "He"
          ]
        },
        " has given us new birth",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:3 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "has caused us to be born again "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "has begotten us again"
              ]
            }
          ]
        },
        " into a living hope through ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " resurrection of Jesus Christ from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " dead, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "1PE 1:4"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " into an inheritance ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that is"
          ]
        },
        " imperishable, undefiled, and unfading, reserved in heaven for you, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "1PE 1:5"
        },
        "who through faith ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " shielded by God’s power for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " salvation ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that is"
          ]
        },
        " ready to be revealed in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " last time."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "1PE 1:6"
        },
        "In this you greatly rejoice, though now for a little while you may have had to suffer grief in various trials ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "1PE 1:7"
        },
        "so that the proven character of your faith — more precious than gold, which perishes even though refined by fire — may result in praise, glory, and honor at ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " revelation of Jesus Christ."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "1PE 1:8"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Though"
          ]
        },
        " you have not seen ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        ", you love ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        "; ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and though"
          ]
        },
        " you do not see ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        " now, you believe in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        " and rejoice with an inexpressible and glorious joy, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "1PE 1:9"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "now that"
          ]
        },
        " you are receiving the goal of your faith, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " salvation of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " souls."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "1PE 1:10"
        },
        "Concerning this salvation, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " prophets who foretold the grace to come to you searched and investigated carefully, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "1PE 1:11"
        },
        "trying to determine the time and setting to which the Spirit of Christ in them was pointing when He predicted the sufferings of Christ and the glories to follow."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "1PE 1:12"
        },
        "It was revealed to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        " that they were not serving themselves, but you, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "when they foretold"
          ]
        },
        " the things now announced by those who preached the gospel to you by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Holy Spirit sent from heaven. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Even"
          ]
        },
        " angels long to look into ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "these things"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "A Call to Holiness"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "HEB 12:14-17",
          "content": [
            "Hebrews 12:14–17"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "1PE 1:13"
        },
        "Therefore prepare your minds ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "for action"
          ]
        },
        ".",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:13 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Wherefore gird up the loins of your mind"
              ]
            }
          ]
        },
        " Be sober-minded. Set ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " hope fully on the grace to be given you at ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " revelation of Jesus Christ. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "1PE 1:14"
        },
        "As obedient children, do not conform to the passions of your former ignorance. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "1PE 1:15"
        },
        "But just as He who called you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " holy, so be holy in all you do, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "1PE 1:16"
        },
        "for it is written: “Be holy, because I am holy.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:16 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "LEV 11:44-45",
                  "content": [
                    "Leviticus 11:44–45"
                  ]
                },
                "; Leviticus 19:2"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "1PE 1:17"
        },
        "Since you call on ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "a"
          ]
        },
        " Father who judges each one’s work impartially, conduct yourselves in reverent fear during your stay as foreigners. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "1PE 1:18"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "For"
          ]
        },
        " you know that it was not with perishable things ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "such as"
          ]
        },
        " silver or gold that you were redeemed from the empty way of life you inherited from your forefathers, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "1PE 1:19"
        },
        "but with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " precious blood of Christ, a lamb without blemish ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " spot. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "1PE 1:20"
        },
        "He was known before ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " foundation of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " world, but was revealed in the last times for your sake."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "1PE 1:21"
        },
        "Through Him ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        " believe in God, who raised Him from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " dead and glorified Him; and so your faith and hope are in God."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Enduring Word"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ISA 40:6-8",
          "content": [
            "Isaiah 40:6–8"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "1PE 1:22"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Since"
          ]
        },
        " you have purified your souls by obedience to the truth so that you have a genuine love for your brothers, love one another deeply, from a pure heart.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:22 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "SBL, NE, and WH "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "from the heart"
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "1PE 1:23"
        },
        "For you have been born again, not of perishable seed, but of imperishable, through ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " living and enduring word of God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "1PE 1:24"
        },
        "For,"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“All flesh ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " like grass,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and all its glory like ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " flowers of the field;"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "the grass withers and the flowers fall,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "1PE 1:25"
        },
        "but the word of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord stands forever.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:25 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 40:6-8",
                  "content": [
                    "Isaiah 40:6–8"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "And this is the word that was proclaimed to you."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "2",
      "sid": "1PE 2"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Living Stone and Chosen People"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ISA 28:14-22",
          "content": [
            "Isaiah 28:14–22"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "1CO 3:10-15",
          "content": [
            "1 Corinthians 3:10–15"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "EPH 2:19-22",
          "content": [
            "Ephesians 2:19–22"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "1PE 2:1"
        },
        "Rid yourselves, therefore, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of"
          ]
        },
        " all malice, deceit, hypocrisy, envy, and slander. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "1PE 2:2"
        },
        "Like newborn babies, crave pure spiritual milk, so that by it you may grow up in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " salvation, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "1PE 2:3"
        },
        "now that you have tasted that the Lord ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " good."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "1PE 2:4"
        },
        "As you come to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        ", ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " living stone, rejected by men but chosen ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " precious in God’s sight, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "1PE 2:5"
        },
        "you also, like living stones, are being built into a spiritual house to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " a holy priesthood, offering spiritual sacrifices acceptable to God through Jesus Christ. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "1PE 2:6"
        },
        "For it stands in Scripture:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“See, I lay in Zion a stone,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "a chosen ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " precious cornerstone;"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "and the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one who"
          ]
        },
        " believes in Him"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "will never be put to shame.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:6 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 28:16",
                  "content": [
                    "Isaiah 28:16"
                  ]
                },
                " (see also LXX)"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "1PE 2:7"
        },
        "To you who believe, then, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this stone"
          ]
        },
        " is precious. But ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to those who"
          ]
        },
        " do not believe,"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The"
          ]
        },
        " stone the builders rejected"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "has become the cornerstone,”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:7 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "PSA 118:22",
                  "content": [
                    "Psalm 118:22"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "1PE 2:8"
        },
        "and,"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“A stone of stumbling"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and a rock of offense.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:8 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 8:14",
                  "content": [
                    "Isaiah 8:14"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        {
          "type": "char",
          "marker": "add",
          "content": [
            "They"
          ]
        },
        " stumble ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "because"
          ]
        },
        " they disobey the word— and to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        " they were appointed."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "1PE 2:9"
        },
        "But you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " a chosen people, a royal priesthood, a holy nation, a people for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "God’s own"
          ]
        },
        " possession, to proclaim the virtues of Him who called you out of darkness into His marvelous light. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "1PE 2:10"
        },
        "Once ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you were"
          ]
        },
        " not a people, but now ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you are"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " people of God; ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "once you"
          ]
        },
        " had not received mercy, but now you have received mercy.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:10 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "HOS 2:23",
                  "content": [
                    "Hosea 2:23"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "1PE 2:11"
        },
        "Beloved, I urge ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        ", as foreigners and exiles, to abstain from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " desires of the flesh, which war against ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " soul. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "1PE 2:12"
        },
        "Conduct yourselves with such honor among the Gentiles that, though they slander you as evildoers, they may see ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " good deeds ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " glorify God on ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " day He visits us."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Submission to Authorities"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ROM 13:1-7",
          "content": [
            "Romans 13:1–7"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "1PE 2:13"
        },
        "Submit yourselves for the Lord’s sake to every human institution, whether to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " king as the supreme ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "authority"
          ]
        },
        ", ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "1PE 2:14"
        },
        "or to governors as those sent by him to punish those who do wrong and to praise those who do right. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "1PE 2:15"
        },
        "For it is God’s will that by doing good you should silence the ignorance of foolish men."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "1PE 2:16"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Live"
          ]
        },
        " in freedom, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "but"
          ]
        },
        " do not use ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " freedom as a cover-up for evil; ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "live"
          ]
        },
        " as servants of God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "1PE 2:17"
        },
        "Treat everyone with high regard: Love the brotherhood ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of believers"
          ]
        },
        ",",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:17 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Love the brotherhood"
              ]
            }
          ]
        },
        " fear God, honor the king."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "1PE 2:18"
        },
        "Servants, submit yourselves to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " masters with all respect,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:18 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "in all fear"
              ]
            }
          ]
        },
        " not only to those who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " good and gentle, but even to those who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " unreasonable. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "1PE 2:19"
        },
        "For if anyone endures the pain of unjust suffering because he is conscious of God, this is to be commended. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "1PE 2:20"
        },
        "How is it to your credit if you are beaten for doing wrong and you endure ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        "? But if you suffer for doing good ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " you endure ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        ", this ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " commendable before God."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Christ’s Example of Suffering"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ISA 53:1-8",
          "content": [
            "Isaiah 53:1–8"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "1PE 2:21"
        },
        "For to this you were called, because Christ also suffered for you, leaving you an example, that you should follow in His footsteps:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "1PE 2:22"
        },
        "“He committed no sin,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " no deceit was found in His mouth.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:22 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 53:9",
                  "content": [
                    "Isaiah 53:9"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "1PE 2:23"
        },
        "When they heaped abuse on Him,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "He did not retaliate;"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "when He suffered, He made no threats,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "but entrusted Himself to Him who judges justly."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "1PE 2:24"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "He"
          ]
        },
        " Himself bore our sins",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:24 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 53:4",
                  "content": [
                    "Isaiah 53:4"
                  ]
                },
                " (see also LXX)"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "in His body on the tree,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "so that we might die to sin"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " live to righteousness."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“By ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " stripes you are healed.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:24 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 53:5",
                  "content": [
                    "Isaiah 53:5"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "1PE 2:25"
        },
        "For “you were like sheep going astray,”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:25 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 53:6",
                  "content": [
                    "Isaiah 53:6"
                  ]
                }
              ]
            }
          ]
        },
        " but now you have returned to the Shepherd and Overseer of your souls."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "3",
      "sid": "1PE 3"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Wives and Husbands"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "1:1-17",
          "content": [
            "Song of Solomon 1:1–17"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "EPH 5:22-33",
          "content": [
            "Ephesians 5:22–33"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "1PE 3:1"
        },
        "Wives, in the same way, submit yourselves to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " husbands, so that even if ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "they"
          ]
        },
        " refuse to believe the word, they will be won over without words by the behavior of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their"
          ]
        },
        " wives ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "1PE 3:2"
        },
        "when they see your pure ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " reverent demeanor."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "1PE 3:3"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Your beauty"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "should"
          ]
        },
        " not come ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "from"
          ]
        },
        " outward adornment, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "such as"
          ]
        },
        " braided hair or gold ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "jewelry"
          ]
        },
        " or fine clothes, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "1PE 3:4"
        },
        "but from the inner disposition of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " heart, the unfading ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "beauty "
          ]
        },
        " of a gentle and quiet spirit, which is precious in God’s sight. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "1PE 3:5"
        },
        "For this is how the holy women of the past adorned themselves. They put their hope in God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " were submissive to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their"
          ]
        },
        " husbands, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "1PE 3:6"
        },
        "just as Sarah obeyed Abraham ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " called him lord. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "And"
          ]
        },
        " you are ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "her"
          ]
        },
        " children if you do what is right and refuse to give way to fear."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "1PE 3:7"
        },
        "Husbands, in the same way, treat ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " wives ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "with"
          ]
        },
        " consideration as a delicate vessel, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "with"
          ]
        },
        " honor as fellow heirs of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " gracious gift of life, so that your prayers will not be hindered."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Turning from Evil"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "1PE 3:8"
        },
        "Finally, all ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of you"
          ]
        },
        ", ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " like-minded ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " sympathetic, love as brothers, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " tenderhearted ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " humble. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "1PE 3:9"
        },
        "Do not repay evil with evil or insult with insult, but with blessing, because to this you were called so that you may inherit a blessing. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "1PE 3:10"
        },
        "For,"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Whoever would love life"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and see good days"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "must keep ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " tongue from evil"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " lips ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "from"
          ]
        },
        " deceitful speech."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "1PE 3:11"
        },
        "He must turn from evil and do good;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "he must seek peace and pursue it."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "1PE 3:12"
        },
        "For ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " eyes of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " on ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " righteous,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and His ears are inclined to their prayer."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "But ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " face of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " against"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "those who do evil.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:12 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "PSA 34:12-16",
                  "content": [
                    "Psalm 34:12–16"
                  ]
                },
                " (see also LXX)"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "1PE 3:13"
        },
        "Who can harm you if you are zealous for what ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " good?"
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Suffering for Righteousness"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "1PE 3:14"
        },
        "But even if you should suffer for what is right, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you are"
          ]
        },
        " blessed. “Do not fear what they fear; do not be shaken.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:14 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "“Do not fear their threats; do not be shaken.”"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 8:12",
                  "content": [
                    "Isaiah 8:12"
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "1PE 3:15"
        },
        "But in your hearts sanctify Christ ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as"
          ]
        },
        " Lord.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:15 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "But sanctify the Lord God in your hearts."
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "This sentence may also be included with the quotation from the previous verse; see ",
                {
                  "type": "ref",
                  "loc": "ISA 8:13",
                  "content": [
                    "Isaiah 8:13"
                  ]
                },
                "."
              ]
            }
          ]
        },
        " Always be prepared to give a defense to everyone who asks you the reason for the hope ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that is"
          ]
        },
        " in you. But ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "respond"
          ]
        },
        " with gentleness and respect, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "1PE 3:16"
        },
        "keeping a clear conscience, so that those who slander you may be put to shame by your good behavior in Christ. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "1PE 3:17"
        },
        "For ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it is"
          ]
        },
        " better, if ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it is"
          ]
        },
        " God’s will, to suffer ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "for"
          ]
        },
        " doing good than for doing evil."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "1PE 3:18"
        },
        "For Christ also suffered",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:18 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "NE and WH "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "died"
              ]
            }
          ]
        },
        " for sins once for all, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " righteous for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " unrighteous, to bring you to God. He was put to death in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " body but made alive in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Spirit, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "1PE 3:19"
        },
        "in whom",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:19 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "in the spirit, ",
                {
                  "type": "char",
                  "marker": "fv",
                  "content": [
                    "19"
                  ]
                },
                "in which"
              ]
            }
          ]
        },
        " He also went ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " preached to the spirits in prison ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "1PE 3:20"
        },
        "who disobeyed long ago when God waited patiently in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " days of Noah ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "while the"
          ]
        },
        " ark was being built."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "In ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the ark"
          ]
        },
        " a few ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "people"
          ]
        },
        ", ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "only"
          ]
        },
        " eight souls, were saved through water. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "1PE 3:21"
        },
        "And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this water"
          ]
        },
        " symbolizes ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " baptism ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " now saves you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "also"
          ]
        },
        " — not the removal of dirt from the body, but ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " pledge of",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:21 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "appeal for"
              ]
            }
          ]
        },
        " a clear conscience toward God — through ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " resurrection of Jesus Christ, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "1PE 3:22"
        },
        "who has gone into heaven ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " is at ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " right hand of God, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "with"
          ]
        },
        " angels, authorities, and powers subject to Him."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "4",
      "sid": "1PE 4"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Living for God’s Glory"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "1CO 10:23-33",
          "content": [
            "1 Corinthians 10:23–33"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "1PE 4:1"
        },
        "Therefore, since Christ suffered",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "4:1 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "for us"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "."
              ]
            }
          ]
        },
        " in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " body, arm yourselves with the same resolve, because anyone who has suffered ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "in his"
          ]
        },
        " body is done with sin. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "1PE 4:2"
        },
        "Consequently, he does not live out ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " remaining time on earth for human passions, but for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " will of God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "1PE 4:3"
        },
        "For ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you have spent"
          ]
        },
        " enough time in the past carrying out the same desires as the Gentiles: living in debauchery, lust, drunkenness, orgies, carousing, and detestable idolatry."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "1PE 4:4"
        },
        "Because of this, they consider it strange of you not to plunge with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        " into the same flood of reckless indiscretion, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " they heap abuse on you. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "1PE 4:5"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "But they"
          ]
        },
        " will have to give an account to Him who is ready to judge ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " living and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " dead. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "1PE 4:6"
        },
        "That is why the gospel was preached even to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "those who are now"
          ]
        },
        " dead,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "4:6 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "to those who are dead"
              ]
            }
          ]
        },
        " so that they might be judged as men in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " flesh, but live according to God in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " spirit."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "1PE 4:7"
        },
        "The end of all ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "things"
          ]
        },
        " is near. Therefore be clear-minded and sober, so that you can pray. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "1PE 4:8"
        },
        "Above all, love one another deeply, because love covers over a multitude of sins.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "4:8 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "See ",
                {
                  "type": "ref",
                  "loc": "PRO 10:12",
                  "content": [
                    "Proverbs 10:12"
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "1PE 4:9"
        },
        "Show hospitality to one another without complaining."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "1PE 4:10"
        },
        "As good stewards of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " manifold grace of God, each ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of you"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "should use"
          ]
        },
        " whatever gift he has received to serve one another. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "1PE 4:11"
        },
        "If anyone speaks, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "he should speak"
          ]
        },
        " as one conveying the words of God. If anyone serves, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "he should serve"
          ]
        },
        " with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " strength God provides, so that in all things God may be glorified through Jesus Christ, to whom be the glory and the power forever ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " ever. Amen."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Suffering as Christians"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "1PE 4:12"
        },
        "Beloved, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do"
          ]
        },
        " not be surprised at the fiery trial that has come upon you, as though something strange were happening to you. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "1PE 4:13"
        },
        "But rejoice that you share in the sufferings of Christ, so that you may be overjoyed at the revelation of His glory."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "1PE 4:14"
        },
        "If you are insulted for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " name of Christ, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you are"
          ]
        },
        " blessed, because the Spirit of glory and of God rests on you.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "4:14 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "On their part He is spoken of as evil, but on your part He is glorified."
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "1PE 4:15"
        },
        "Indeed, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "none"
          ]
        },
        " of you should suffer as a murderer or thief or wrongdoer, or even as a meddler. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "1PE 4:16"
        },
        "But if ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you suffer"
          ]
        },
        " as a Christian, do not be ashamed, but glorify God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that you bear"
          ]
        },
        " that name.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "4:16 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "glorify God in that name"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; NA "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "glorify God in this matter"
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "1PE 4:17"
        },
        "For ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it is"
          ]
        },
        " time ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "for"
          ]
        },
        " judgment to begin with the family of God; and if it begins with us, what ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "will"
          ]
        },
        " the outcome ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " for those who disobey the gospel of God? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "1PE 4:18"
        },
        "And,"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“If it is hard for the righteous to be saved,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "what will become of the ungodly and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " sinner?”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "4:18 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "PRO 11:31",
                  "content": [
                    "Proverbs 11:31"
                  ]
                },
                " (see also LXX)"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "1PE 4:19"
        },
        "So then, those who suffer according to God’s will should entrust their souls to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their"
          ]
        },
        " faithful Creator and continue to do good."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "5",
      "sid": "1PE 5"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Instructions to Elders"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "1TI 3:1-7",
          "content": [
            "1 Timothy 3:1–7"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "TIT 1:5-9",
          "content": [
            "Titus 1:5–9"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "1PE 5:1"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "As"
          ]
        },
        " a fellow elder, a witness of Christ’s sufferings, and a partaker of the glory to be revealed, I appeal to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " elders",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "5:1 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "SBL, NE, and WH "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "I appeal therefore to the elders"
              ]
            }
          ]
        },
        " among you: ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "1PE 5:2"
        },
        "Be shepherds of God’s flock ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that is"
          ]
        },
        " among you, watching over them",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "5:2 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "NE and WH do not include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "watching over them"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "."
              ]
            }
          ]
        },
        " not out of compulsion, but willingly, as God would have you;",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "5:2 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "WH, BYZ, and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "but willingly"
              ]
            }
          ]
        },
        " not out of greed, but out of eagerness; ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "1PE 5:3"
        },
        "not lording it over those entrusted to you, but being examples to the flock. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "1PE 5:4"
        },
        "And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "when"
          ]
        },
        " the Chief Shepherd appears, you will receive the crown of glory that will never fade away."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Cast Your Cares on Him"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "1PE 5:5"
        },
        "Young men, in the same way, submit yourselves to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " elders. And all ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of you"
          ]
        },
        ", clothe yourselves with humility toward one another, because,"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“God opposes ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " proud,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "but gives grace to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " humble.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "5:5 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "PRO 3:34",
                  "content": [
                    "Proverbs 3:34"
                  ]
                },
                " (see also LXX)"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "1PE 5:6"
        },
        "Humble yourselves, therefore, under God’s mighty hand, so that in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "due"
          ]
        },
        " time He may exalt you. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "1PE 5:7"
        },
        "Cast all your anxiety on Him, because He cares for you."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "1PE 5:8"
        },
        "Be sober-minded ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " alert. Your adversary the devil prowls around like a roaring lion, seeking ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "someone"
          ]
        },
        " to devour. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "1PE 5:9"
        },
        "Resist ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "him"
          ]
        },
        ", ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "standing"
          ]
        },
        " firm in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " faith ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " in the knowledge that your brothers throughout the world are undergoing the same kinds of suffering."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Benediction and Farewell"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "1PE 5:10"
        },
        "And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "after you"
          ]
        },
        " have suffered for a little while, the God of all grace, who has called you to His eternal glory in Christ,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "5:10 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "in Christ Jesus"
              ]
            }
          ]
        },
        " will Himself restore ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        ", secure ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        ", strengthen ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        ", ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " establish ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "1PE 5:11"
        },
        "To Him ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " the power forever ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " ever. Amen."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "1PE 5:12"
        },
        "Through Silvanus,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "5:12 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "That is, Silas"
              ]
            }
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "whom"
          ]
        },
        " I regard as a faithful brother, I have written to you briefly, encouraging ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        " and testifying ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " this is ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " true grace of God. Stand firm in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "1PE 5:13"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The church"
          ]
        },
        " in Babylon,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "5:13 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "She in Babylon"
              ]
            }
          ]
        },
        " chosen together with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        ", sends you greetings, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as does"
          ]
        },
        " my son Mark."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "1PE 5:14"
        },
        "Greet one another with a kiss of love."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Peace to all of you who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " in Christ.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "5:14 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Amen."
              ]
            }
          ]
        }
      ]
    }
  ]
}