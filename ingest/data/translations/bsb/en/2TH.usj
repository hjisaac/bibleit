      "content": [
        "Autogenerated BSB by bsb2usfm"
      ]
    },
    {
      "type": "para",
      "marker": "h",
      "content": [
        "2 Thessalonians"
      ]
    },
    {
      "type": "para",
      "marker": "toc1",
      "content": [
        "2 Thessalonians"
      ]
    },
    {
      "type": "para",
      "marker": "toc2",
      "content": [
        "2 Thessalonians"
      ]
    },
    {
      "type": "para",
      "marker": "toc3",
      "content": [
        "2TH"
      ]
    },
    {
      "type": "para",
      "marker": "mt1",
      "content": [
        "2 Thessalonians"
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "1",
      "sid": "2TH 1"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Greetings to the Thessalonians"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "1TH 1:1-10",
          "content": [
            "1 Thessalonians 1:1–10"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "2TH 1:1"
        },
        "Paul, Silvanus,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:1 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "That is, Silas"
              ]
            }
          ]
        },
        " and Timothy,"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "To the church of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Thessalonians in God our Father and the Lord Jesus Christ:"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "2TH 1:2"
        },
        "Grace and peace to you from God our Father",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:2 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "SBL, NE, and WH "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "God the Father"
              ]
            }
          ]
        },
        " and the Lord Jesus Christ."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "2TH 1:3"
        },
        "We are obligated to thank God for you all the time, brothers, as is fitting, because your faith is growing more and more, and your love for one another is increasing. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "2TH 1:4"
        },
        "That is why we boast among God’s churches about your perseverance and faith in the face of all ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " persecution and affliction you are enduring."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Christ’s Coming"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "2TH 1:5"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "All this is "
          ]
        },
        " clear evidence of God’s righteous judgment. And so you will be counted worthy of the kingdom of God, for which you are suffering. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "2TH 1:6"
        },
        "After all, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it is"
          ]
        },
        " only right for God to repay with affliction those who afflict you, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "2TH 1:7"
        },
        "and to grant relief to you who are oppressed and to us ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as well"
          ]
        },
        ". ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "This will take place when"
          ]
        },
        " the Lord Jesus is revealed from heaven with His mighty angels ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "2TH 1:8"
        },
        "in blazing fire, inflicting vengeance on those who do not know God and do not obey the gospel of our Lord Jesus. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "2TH 1:9"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "They"
          ]
        },
        " will suffer ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " penalty of eternal destruction, separated from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " presence of the Lord and the glory of His might, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "2TH 1:10"
        },
        "on ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " day He comes to be glorified in His saints and regarded with wonder by all who have believed, including you who have believed our testimony."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "2TH 1:11"
        },
        "To this end, we always pray for you, that our God will count you worthy of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " calling, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " He will powerfully fulfill ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " every good desire and work of faith, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "2TH 1:12"
        },
        "so that the name of our Lord Jesus will be glorified in you, and you in Him, according to the grace of our God and of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord Jesus Christ.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:12 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "the grace of our God and Lord, Jesus Christ."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "2",
      "sid": "2TH 2"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Man of Lawlessness"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "2TH 2:1"
        },
        "Now concerning the coming of our Lord Jesus Christ and our being gathered together to Him, we ask you, brothers, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "2TH 2:2"
        },
        "not to be easily disconcerted ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " alarmed by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "any"
          ]
        },
        " spirit ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " message ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " letter seeming ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to be"
          ]
        },
        " from us, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "alleging"
          ]
        },
        " that the Day of the Lord has already come. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "2TH 2:3"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Let"
          ]
        },
        " no one deceive you in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "any"
          ]
        },
        " way, for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it will not come "
          ]
        },
        " until the rebellion occurs and the man of lawlessness — the son of destruction — is revealed. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "2TH 2:4"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "He"
          ]
        },
        " will oppose and exalt himself above every so-called god or object of worship. So he will seat himself in the temple of God, proclaiming himself to be God."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "2TH 2:5"
        },
        "Do you not remember that I told you these things while I was still with you? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "2TH 2:6"
        },
        "And you know what is now restraining ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "him"
          ]
        },
        ", so that he may be revealed at the proper time. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "2TH 2:7"
        },
        "For the mystery of lawlessness ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " already at work, but the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one who"
          ]
        },
        " now restrains ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "will continue"
          ]
        },
        " until he is taken out of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " way. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "2TH 2:8"
        },
        "And then the lawless ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one"
          ]
        },
        " will be revealed, whom the Lord Jesus will slay with the breath of His mouth and annihilate by the majesty of His arrival."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "2TH 2:9"
        },
        "The coming ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of the lawless one"
          ]
        },
        " will be accompanied by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " working of Satan, with every kind of power, sign, and false wonder, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "2TH 2:10"
        },
        "and with every wicked deception directed against those who are perishing, because they refused the love of the truth that would have saved them. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "2TH 2:11"
        },
        "For this reason God will send them a powerful delusion so that they believe ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " lie, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "2TH 2:12"
        },
        "in order that judgment may come upon all who have disbelieved the truth ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " delighted in wickedness."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Stand Firm"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "2TH 2:13"
        },
        "But we should always thank God for you, brothers who are loved by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord, because God chose you from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " beginning",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:13 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "God has chosen you as the firstfruits"
              ]
            }
          ]
        },
        " to be saved by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " sanctification of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Spirit and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "by"
          ]
        },
        " faith in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " truth. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "2TH 2:14"
        },
        "To this He called you through our gospel, so that you may share in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " glory of our Lord Jesus Christ. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "2TH 2:15"
        },
        "Therefore, brothers, stand firm and cling to the traditions we taught you, whether by speech or by letter."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "2TH 2:16"
        },
        "Now ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "may"
          ]
        },
        " our Lord Jesus Christ Himself and God our Father, who by grace has loved us and given ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "us"
          ]
        },
        " eternal comfort and good hope, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "2TH 2:17"
        },
        "encourage your hearts and strengthen ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        " in every good word and deed."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "3",
      "sid": "2TH 3"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Request for Prayer"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "2TH 3:1"
        },
        "Finally, brothers, pray for us, that the word of the Lord may spread quickly and be held in honor, just as ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it was"
          ]
        },
        " with you. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "2TH 3:2"
        },
        "And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "pray"
          ]
        },
        " that we may be delivered from wicked and evil men; for not everyone ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "holds to "
          ]
        },
        " the faith. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "2TH 3:3"
        },
        "But the Lord is faithful, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and He"
          ]
        },
        " will strengthen ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        " and guard you from the evil ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one"
          ]
        },
        ".",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:3 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "from evil"
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "2TH 3:4"
        },
        "And we have confidence in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord that you are doing and will continue to do what we command. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "2TH 3:5"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "May"
          ]
        },
        " the Lord direct your hearts into God’s love and Christ’s perseverance."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "A Warning against Idleness"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "2TH 3:6"
        },
        "Now we command you, brothers, in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " name of our Lord Jesus Christ, to keep away from any brother ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who"
          ]
        },
        " leads an undisciplined life ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that is"
          ]
        },
        " not in keeping with the tradition you received",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:6 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "they received"
              ]
            }
          ]
        },
        " from us. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "2TH 3:7"
        },
        "For you yourselves know how you ought to imitate us, because we were not undisciplined among you, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "2TH 3:8"
        },
        "nor did we eat anyone’s food without paying for it. Instead, in labor and toil, we worked night and day so that we would not be a burden to any of you. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "2TH 3:9"
        },
        "Not that we lack ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        " right, but we wanted to offer ourselves ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as"
          ]
        },
        " an example for you to imitate. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "2TH 3:10"
        },
        "For even while we were with you, we gave you this command: “If anyone is unwilling to work, he shall not eat.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "2TH 3:11"
        },
        "For we hear that some of you are leading undisciplined lives, accomplishing nothing, but being busybodies. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "2TH 3:12"
        },
        "We command and urge such ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "people"
          ]
        },
        " by our Lord Jesus Christ to begin working quietly to earn their own living. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "2TH 3:13"
        },
        "But ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as for"
          ]
        },
        " you, brothers, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do"
          ]
        },
        " not grow weary ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "in"
          ]
        },
        " well-doing."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "2TH 3:14"
        },
        "Take note of anyone who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "does"
          ]
        },
        " not obey the instructions we have given in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        " letter. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Do"
          ]
        },
        " not associate with him, so that he may be ashamed. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "2TH 3:15"
        },
        "Yet ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do"
          ]
        },
        " not regard ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "him"
          ]
        },
        " as an enemy, but admonish ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "him"
          ]
        },
        " as a brother."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Signature and Final Greetings"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "1CO 16:19-24",
          "content": [
            "1 Corinthians 16:19–24"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "COL 4:15-18",
          "content": [
            "Colossians 4:15–18"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "2TH 3:16"
        },
        "Now ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "may"
          ]
        },
        " the Lord of peace Himself give you peace at all ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "times"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " in every way. The Lord ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " with all of you."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "2TH 3:17"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "This"
          ]
        },
        " greeting ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " in my own hand — Paul. This is ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "my"
          ]
        },
        " mark in every letter; it is the way I write."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "2TH 3:18"
        },
        "The grace of our Lord Jesus Christ ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " with all of you.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:18 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Amen."
              ]
            }
          ]
        }
      ]
    }
  ]
}