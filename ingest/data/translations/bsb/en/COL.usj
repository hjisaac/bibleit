        "Colossians"
      ]
    },
    {
      "type": "para",
      "marker": "toc2",
      "content": [
        "Colossians"
      ]
    },
    {
      "type": "para",
      "marker": "toc3",
      "content": [
        "COL"
      ]
    },
    {
      "type": "para",
      "marker": "mt1",
      "content": [
        "Colossians"
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "1",
      "sid": "COL 1"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Greetings from Paul and Timothy"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "PHP 1:1-2",
          "content": [
            "Philippians 1:1–2"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "PHM 1-3",
          "content": [
            "Philemon 1:1–3"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "COL 1:1"
        },
        "Paul, an apostle of Christ Jesus by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " will of God, and Timothy ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "our"
          ]
        },
        " brother,"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "COL 1:2"
        },
        "To the saints and faithful brothers in Christ at Colossae:"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Grace and peace to you from God our Father.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:2 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "God our Father and the Lord Jesus Christ"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Thanksgiving and Prayer"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "1CO 1:4-9",
          "content": [
            "1 Corinthians 1:4–9"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "PHP 1:3-11",
          "content": [
            "Philippians 1:3–11"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "COL 1:3"
        },
        "We always thank God, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Father of our Lord Jesus Christ, when we pray for you, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "COL 1:4"
        },
        "because we have heard about your faith in Christ Jesus and your love for all the saints — ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "COL 1:5"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the faith and love"
          ]
        },
        " proceeding from the hope stored up for you in heaven, of which you have already heard in the word of truth, the gospel ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "COL 1:6"
        },
        "that has come to you."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "All over the world ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this gospel"
          ]
        },
        " is bearing fruit and growing, just as ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it has been doing"
          ]
        },
        " among you since the day you heard ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " and truly understood the grace of God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "COL 1:7"
        },
        "You learned ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " from Epaphras, our beloved fellow servant, who is a faithful minister of Christ on our",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:7 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "NE, NA, BYZ, and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "your"
              ]
            }
          ]
        },
        " behalf, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "COL 1:8"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " who also informed us of your love in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Spirit."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "COL 1:9"
        },
        "For this reason, since the day we heard ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "about you"
          ]
        },
        ", we ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "have"
          ]
        },
        " not stopped praying for you and asking ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "God"
          ]
        },
        " to fill you with the knowledge of His will in all spiritual wisdom and understanding, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "COL 1:10"
        },
        "so that you may walk in a manner worthy of the Lord ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " may please ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        " in every way: bearing fruit in every good work, growing in the knowledge of God, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "COL 1:11"
        },
        "being strengthened with all power according to His glorious might so that you may have full endurance and patience, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " joyfully ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "COL 1:12"
        },
        "giving thanks to the Father, who has qualified you",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:12 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "us"
              ]
            }
          ]
        },
        " to share in the inheritance of the saints in the light."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "COL 1:13"
        },
        "He has rescued us from the dominion of darkness and brought ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "us"
          ]
        },
        " into the kingdom of His beloved Son, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "COL 1:14"
        },
        "in whom we have redemption,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:14 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "redemption through His blood,"
              ]
            }
          ]
        },
        " the forgiveness of sins."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Supremacy of the Son"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "HEB 1:1-14",
          "content": [
            "Hebrews 1:1–14"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "COL 1:15"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The Son"
          ]
        },
        " is ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " image of the invisible God, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " firstborn over all creation. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "COL 1:16"
        },
        "For in Him all things were created, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "things"
          ]
        },
        " in heaven and on earth, visible and invisible, whether thrones or dominions or rulers or authorities. All things were created through Him and for Him."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "COL 1:17"
        },
        "He is before all things, and in Him all things hold together. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "COL 1:18"
        },
        "And He is the head of the body, the church; He is the beginning ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " firstborn from among the dead, so that in all things He may have preeminence. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "COL 1:19"
        },
        "For ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "God"
          ]
        },
        " was pleased ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to have"
          ]
        },
        " all ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " fullness dwell in Him, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "COL 1:20"
        },
        "and through Him to reconcile to Himself all things, whether things on earth or things in heaven, by making peace through the blood of His cross."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "COL 1:21"
        },
        "Once you were alienated  ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "from God "
          ]
        },
        " and were hostile in your minds, engaging in evil deeds. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "COL 1:22"
        },
        "But now He has reconciled ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        " by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Christ’s"
          ]
        },
        " physical body through death to present you holy, unblemished, and blameless in His presence — ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "COL 1:23"
        },
        "if indeed you continue in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " faith, established and firm, not moved from the hope of the gospel you heard, which has been proclaimed to every creature",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:23 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "in all creation"
              ]
            }
          ]
        },
        " under heaven, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " of which I, Paul, have become a servant."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Paul’s Suffering for the Church"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "2CO 11:16-33",
          "content": [
            "2 Corinthians 11:16–33"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "COL 1:24"
        },
        "Now I rejoice in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "my"
          ]
        },
        " sufferings for you, and I fill up in my flesh what is lacking in regard to Christ’s afflictions for the sake of His body, which is the church. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "COL 1:25"
        },
        "I became its servant by the commission God gave me to fully proclaim to you the word of God, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "COL 1:26"
        },
        "the mystery that was hidden for ages and generations but is now revealed to His saints. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "COL 1:27"
        },
        "To ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        " God has chosen to make known among the Gentiles the glorious riches of this mystery, which is Christ in you, the hope of glory."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "COL 1:28"
        },
        "We proclaim Him, admonishing and teaching everyone with all wisdom, so that we may present everyone perfect",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:28 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "fully mature"
              ]
            }
          ]
        },
        " in Christ. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "COL 1:29"
        },
        "To this end I also labor, striving with all His energy working powerfully within me."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "2",
      "sid": "COL 2"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Absent in Body, Present in Spirit"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "REV 3:14-22",
          "content": [
            "Revelation 3:14–22"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "COL 2:1"
        },
        "For I want you to know how much I am struggling for you and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "for"
          ]
        },
        " those at Laodicea, and for all who have not met me face to face, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "COL 2:2"
        },
        "that they may be encouraged in heart, knit together in love, and filled with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " full riches of complete understanding, so that they may know the mystery of God, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "namely"
          ]
        },
        " Christ,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:2 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "the mystery of God: Christ"
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "COL 2:3"
        },
        "in whom are hidden all the treasures of wisdom and knowledge."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "COL 2:4"
        },
        "I say this so that no one will deceive you by smooth rhetoric. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "COL 2:5"
        },
        "For although I am absent from you in body, I am present with you in spirit, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " I delight to see your orderly condition and firm faith in Christ."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Alive with Christ"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "EPH 2:1-10",
          "content": [
            "Ephesians 2:1–10"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "COL 2:6"
        },
        "Therefore, just as you have received Christ Jesus ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as"
          ]
        },
        " Lord, continue to walk in Him, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "COL 2:7"
        },
        "rooted and built up in Him, established in the faith as you were taught, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " overflowing with thankfulness."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "COL 2:8"
        },
        "See to it that no one takes you captive through philosophy and empty deception, which are based on human tradition ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " the spiritual forces of the world rather than on Christ. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "COL 2:9"
        },
        "For in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Christ"
          ]
        },
        " all the fullness of the Deity dwells in bodily form. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "COL 2:10"
        },
        "And you have been made complete in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Christ"
          ]
        },
        ", who is the head over every ruler and authority."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "COL 2:11"
        },
        "In Him you were also circumcised, in the putting off of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " sinful nature, with the circumcision ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "performed"
          ]
        },
        " by Christ",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:11 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "in the cutting away of the body of the flesh, by the circumcision of Christ"
              ]
            }
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " not by human hands. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "COL 2:12"
        },
        "And having been buried with Him in baptism, you were raised with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        " through ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " faith in the power of God, who raised Him from the dead."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "COL 2:13"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "When"
          ]
        },
        " you were dead in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " trespasses and in the uncircumcision of your sinful nature, God made you alive with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Christ"
          ]
        },
        ". He forgave us all ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "our"
          ]
        },
        " trespasses, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "COL 2:14"
        },
        "having canceled the debt ascribed to us in the decrees that stood against us. He took it away, nailing it to the cross! ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "COL 2:15"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "And"
          ]
        },
        " having disarmed the powers and authorities, He made a public spectacle ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of them"
          ]
        },
        ", triumphing over them by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the cross"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "COL 2:16"
        },
        "Therefore ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "let"
          ]
        },
        " no one judge you by what you eat or drink, or with regard to a feast, a New Moon, or a Sabbath. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "COL 2:17"
        },
        "These are a shadow of the things to come, but the body  ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that casts it "
          ]
        },
        " belongs to Christ.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:17 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "but the body is of the Christ"
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "COL 2:18"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Do not let anyone"
          ]
        },
        " who delights in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "false"
          ]
        },
        " humility and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " worship of angels disqualify you with speculation about what he has seen. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Such a person"
          ]
        },
        " is puffed up without basis by his unspiritual mind. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "COL 2:19"
        },
        "He has lost connection to the head, from whom the whole body, supported and knit together by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "its"
          ]
        },
        " joints and ligaments, grows as God causes it to grow."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "COL 2:20"
        },
        "If you have died with Christ to the spiritual forces of the world, why, as though you still belonged to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " world, do you submit to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "its"
          ]
        },
        " regulations: ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "COL 2:21"
        },
        "“",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Do"
          ]
        },
        " not handle, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do"
          ]
        },
        " not taste, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do"
          ]
        },
        " not touch!”? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "COL 2:22"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "These"
          ]
        },
        " will all perish with use, because they are based on human commands and teachings. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "COL 2:23"
        },
        "Such ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "restrictions"
          ]
        },
        " indeed have an appearance of wisdom, with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their"
          ]
        },
        " self-prescribed worship, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their false"
          ]
        },
        " humility, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their"
          ]
        },
        " harsh treatment of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " body; ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "but"
          ]
        },
        " they are of no value against ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " indulgence of the flesh."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "3",
      "sid": "COL 3"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Put On the New Self"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "EPH 4:17-32",
          "content": [
            "Ephesians 4:17–32"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "COL 3:1"
        },
        "Therefore, since you have been raised with Christ, strive for the things above, where Christ is seated at ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " right hand of God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "COL 3:2"
        },
        "Set ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " minds on things above, not on earthly things. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "COL 3:3"
        },
        "For you died, and your life is now hidden with Christ in God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "COL 3:4"
        },
        "When Christ, who is your",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:4 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "NE, WH, BYZ, and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "our"
              ]
            }
          ]
        },
        " life, appears, then you also will appear with Him in glory."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "COL 3:5"
        },
        "Put to death, therefore, the components of your earthly nature: sexual immorality, impurity, lust, evil desires, and greed, which is idolatry. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "COL 3:6"
        },
        "Because of these, the wrath of God is coming on the sons of disobedience.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:6 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "NE, WH, and Tischendorf do not include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "on the sons of disobedience"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "."
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "COL 3:7"
        },
        "When you lived among them, you also used to walk in these ways. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "COL 3:8"
        },
        "But now you must put aside all such things as these: anger, rage, malice, slander, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " filthy language from your lips."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "COL 3:9"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Do"
          ]
        },
        " not lie to one another, since you have taken off the old self with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "its"
          ]
        },
        " practices, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "COL 3:10"
        },
        "and have put on the new ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "self"
          ]
        },
        ", which is being renewed in knowledge in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " image of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "its"
          ]
        },
        " Creator. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "COL 3:11"
        },
        "Here there is no Greek ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " Jew, circumcised ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " uncircumcised, barbarian, Scythian, slave, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " free, but Christ ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " all and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " in all."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "COL 3:12"
        },
        "Therefore, as ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " elect of God, holy and beloved, clothe yourselves with hearts of compassion, kindness, humility, gentleness, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " patience. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "COL 3:13"
        },
        "Bear with one another and forgive ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "any"
          ]
        },
        " complaint you may have against someone else. Forgive as the Lord forgave you. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "COL 3:14"
        },
        "And over all these ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "virtues"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "put on"
          ]
        },
        " love, which is ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " bond of perfect unity. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "COL 3:15"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Let"
          ]
        },
        " the peace of Christ rule in your hearts, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "for"
          ]
        },
        " to this you were called as members of one body. And be thankful."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "COL 3:16"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Let"
          ]
        },
        " the word of Christ richly dwell within you as you teach and admonish one another with all wisdom, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " as you sing psalms, hymns, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " spiritual songs with gratitude in your hearts to God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "COL 3:17"
        },
        "And whatever you do, in word or deed, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do it"
          ]
        },
        " all in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " name of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord Jesus, giving thanks to God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Father through Him."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Christian Households"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "EPH 6:1-4",
          "content": [
            "Ephesians 6:1–4"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "COL 3:18"
        },
        "Wives, submit to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " husbands, as is fitting in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "COL 3:19"
        },
        "Husbands, love ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " wives and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do"
          ]
        },
        " not be harsh with them."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "COL 3:20"
        },
        "Children, obey ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " parents in everything, for this is pleasing to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "COL 3:21"
        },
        "Fathers, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do"
          ]
        },
        " not provoke your children, so they will not become discouraged."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Serving with Honor"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "EPH 6:5-9",
          "content": [
            "Ephesians 6:5–9"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "1TI 6:1-2",
          "content": [
            "1 Timothy 6:1–2"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "COL 3:22"
        },
        "Slaves, obey ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " earthly masters in everything, not ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "only"
          ]
        },
        " to please them while they are watching, but with sincerity of heart ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " fear of the Lord."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "COL 3:23"
        },
        "Whatever you do, work at it with your whole being, as for the Lord and not for men, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "COL 3:24"
        },
        "because you know that you will receive an inheritance from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as your"
          ]
        },
        " reward. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "It is"
          ]
        },
        " the Lord Christ you are serving. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "COL 3:25"
        },
        "Whoever does wrong will be repaid ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "for"
          ]
        },
        " his wrong, and there is no favoritism."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "4",
      "sid": "COL 4"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Prayerful Speech and Actions"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "COL 4:1"
        },
        "Masters, supply ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " slaves with what ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " right and fair, since you know that you also have a Master in heaven."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "COL 4:2"
        },
        "Devote yourselves to prayer, being watchful ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " thankful, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "COL 4:3"
        },
        "as you pray also for us, that God may open to us a door for the word, so that we may proclaim the mystery of Christ, for which I am in chains. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "COL 4:4"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Pray"
          ]
        },
        " that I may declare it clearly, as I should."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "COL 4:5"
        },
        "Act wisely toward outsiders, redeeming the time. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "COL 4:6"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Let"
          ]
        },
        " your speech always ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " gracious, seasoned with salt, so that you may know how to answer everyone."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Greetings from Paul’s Fellow Workers"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ROM 16:21-23",
          "content": [
            "Romans 16:21–23"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "COL 4:7"
        },
        "Tychicus will tell you all the news about me. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "He is"
          ]
        },
        " a beloved brother, a faithful minister, and a fellow servant in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "COL 4:8"
        },
        "I have sent him to you for this very purpose, that you may know about us, and that he may encourage your hearts. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "COL 4:9"
        },
        "With him ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "I am sending"
          ]
        },
        " Onesimus, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "our"
          ]
        },
        " faithful and beloved brother, who is ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one"
          ]
        },
        " of you. They will tell you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "about"
          ]
        },
        " everything here."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "COL 4:10"
        },
        "My fellow prisoner Aristarchus sends you greetings, as does Mark the cousin of Barnabas. You have ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "already"
          ]
        },
        " received instructions about ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "him"
          ]
        },
        ": If he comes to you, welcome him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "COL 4:11"
        },
        "Jesus, who is called Justus, also ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "sends greetings"
          ]
        },
        ". These are ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " only Jews among ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "my"
          ]
        },
        " fellow workers for the kingdom of God, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " they have been a comfort to me."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "COL 4:12"
        },
        "Epaphras, who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one"
          ]
        },
        " of you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " a servant of Christ Jesus, sends you greetings. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "He is"
          ]
        },
        " always wrestling in prayer for you, so that you may stand mature and fully assured in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " full will of God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "COL 4:13"
        },
        "For I testify about him that he goes to great pains for you and for those at Laodicea and Hierapolis."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "COL 4:14"
        },
        "Luke, the beloved physician, and Demas send you greetings."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Signature and Final Instructions"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "1CO 16:19-24",
          "content": [
            "1 Corinthians 16:19–24"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "2TH 3:16-18",
          "content": [
            "2 Thessalonians 3:16–18"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "COL 4:15"
        },
        "Greet the brothers in Laodicea, as well as Nympha and the church ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that meets"
          ]
        },
        " at her house."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "COL 4:16"
        },
        "After ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        " letter has been read among you, make sure that it is also read in the church of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Laodiceans, and that you in turn read the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "letter"
          ]
        },
        " from Laodicea."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "COL 4:17"
        },
        "Tell Archippus: “See to it that you complete the ministry you have received in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord.”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "COL 4:18"
        },
        "This greeting ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is in my"
          ]
        },
        " own hand — Paul."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Remember my chains."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Grace ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " with you.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "4:18 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Amen."
              ]
            }
          ]
        }
      ]
    }
  ]
}