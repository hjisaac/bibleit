{
  "type": "USJ",
  "version": "3.0",
  "content": [
    {
      "type": "book",
      "marker": "id",
      "code": "ROM",
      "content": [
        "Autogenerated BSB by bsb2usfm"
      ]
    },
    {
      "type": "para",
      "marker": "h",
      "content": [
        "Romans"
      ]
    },
    {
      "type": "para",
      "marker": "toc1",
      "content": [
        "Romans"
      ]
    },
    {
      "type": "para",
      "marker": "toc2",
      "content": [
        "Romans"
      ]
    },
    {
      "type": "para",
      "marker": "toc3",
      "content": [
        "ROM"
      ]
    },
    {
      "type": "para",
      "marker": "mt1",
      "content": [
        "Romans"
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "1",
      "sid": "ROM 1"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Paul Greets the Saints in Rome"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "ROM 1:1"
        },
        "Paul, a servant of Christ Jesus, called ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to be"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "an"
          ]
        },
        " apostle, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " set apart for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " gospel of God— ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "ROM 1:2"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the gospel"
          ]
        },
        " He promised beforehand through His prophets in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Holy Scriptures, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "ROM 1:3"
        },
        "regarding His Son, who was a descendant of David according to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " flesh, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "ROM 1:4"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " who through ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Spirit of holiness was declared with power ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to be the"
          ]
        },
        " Son of God by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " resurrection ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "from the"
          ]
        },
        " dead: Jesus Christ our Lord."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "ROM 1:5"
        },
        "Through ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " on behalf of His name, we received grace and apostleship to call all ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "those"
          ]
        },
        " among the Gentiles ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to the"
          ]
        },
        " obedience that comes from faith. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "ROM 1:6"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "And"
          ]
        },
        " you also are among those who are called ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to belong to"
          ]
        },
        " Jesus Christ."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "ROM 1:7"
        },
        "To all in Rome who are loved by God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " called to be saints:"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Grace and peace to you from God our Father and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord Jesus Christ."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Unashamed of the Gospel"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "ROM 1:8"
        },
        "First, I thank my God through Jesus Christ for all of you, because your faith is being proclaimed all over the world. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "ROM 1:9"
        },
        "God, whom I serve with my spirit",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:9 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "in my spirit"
              ]
            }
          ]
        },
        " in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "preaching"
          ]
        },
        " the gospel of His Son, is my witness how constantly I remember you ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "ROM 1:10"
        },
        "in my prayers at all times, asking that now at last by God’s will I may succeed in coming to you. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "ROM 1:11"
        },
        "For I long to see you so that I may impart to you some spiritual gift to strengthen you, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "ROM 1:12"
        },
        "that is, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " you and I may be mutually encouraged by each other’s faith."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "ROM 1:13"
        },
        "I do not want you to be unaware, brothers, how often I planned to come to you (",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "but"
          ]
        },
        " have been prevented ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "from visiting"
          ]
        },
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:13 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "but have been prevented"
              ]
            }
          ]
        },
        " until now), in order that I might have a harvest among you, just as ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "I have had"
          ]
        },
        " among the other Gentiles. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "ROM 1:14"
        },
        "I am obligated both to Greeks and non-Greeks,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:14 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "to Greeks and barbarians"
              ]
            }
          ]
        },
        " both to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " wise and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " foolish. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "ROM 1:15"
        },
        "That is why I am ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "so"
          ]
        },
        " eager to preach the gospel also to you who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " in Rome."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "ROM 1:16"
        },
        "I am not ashamed of the gospel, because it is ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " power of God for salvation to everyone who believes, first to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Jew, then to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Greek. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "ROM 1:17"
        },
        "For ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the gospel"
          ]
        },
        " reveals ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " righteousness of God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that comes"
          ]
        },
        " by faith ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "from start"
          ]
        },
        " to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "finish"
          ]
        },
        ",",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:17 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "For in it is revealed the righteousness of God from faith to faith"
              ]
            }
          ]
        },
        " just as it is written: “The righteous will live by faith.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:17 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "HAB 2:4",
                  "content": [
                    "Habakkuk 2:4"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "God’s Wrath against Sin"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "ROM 1:18"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The"
          ]
        },
        " wrath of God is being revealed from heaven against all ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " godlessness and wickedness of men who suppress the truth by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their"
          ]
        },
        " wickedness. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "ROM 1:19"
        },
        "For ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "what may be"
          ]
        },
        " known ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "about"
          ]
        },
        " God is plain to them, because God has made ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " plain to them. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "ROM 1:20"
        },
        "For since ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " creation of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " world ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "God’s"
          ]
        },
        " invisible qualities, His eternal power and divine nature, have been clearly seen, being understood from His workmanship, so that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "men"
          ]
        },
        " are without excuse."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "ROM 1:21"
        },
        "For although they knew God, they neither glorified ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        " as God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "nor"
          ]
        },
        " gave thanks ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to Him"
          ]
        },
        ", but they became futile in their thinking and darkened in their foolish hearts. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "ROM 1:22"
        },
        "Although they claimed to be wise, they became fools, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "ROM 1:23"
        },
        "and exchanged the glory of the immortal God for images of mortal man and birds and animals and reptiles."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "ROM 1:24"
        },
        "Therefore God gave them over in the desires of their hearts to impurity for the dishonoring of their bodies with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one another"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "ROM 1:25"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "They"
          ]
        },
        " exchanged the truth of God for a lie, and worshiped and served the creature rather than the Creator, who is forever worthy of praise!",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "1:25 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "forever blessed"
              ]
            }
          ]
        },
        " Amen."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "ROM 1:26"
        },
        "For this reason God gave them over to dishonorable passions. Even their women exchanged natural relations for unnatural ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "ones"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "ROM 1:27"
        },
        "Likewise, the men abandoned natural relations with women ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " burned with lust for one another. Men committed indecent ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "acts"
          ]
        },
        " with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "other"
          ]
        },
        " men and received in themselves the due penalty for their error."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "ROM 1:28"
        },
        "Furthermore, since they did not see fit to acknowledge God, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "He"
          ]
        },
        " gave them up to a depraved mind, to do what ought not to be done. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "ROM 1:29"
        },
        "They have become filled with every kind of wickedness, evil, greed, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " depravity. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "They are"
          ]
        },
        " full of envy, murder, strife, deceit, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " malice. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "They are"
          ]
        },
        " gossips, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "ROM 1:30"
        },
        "slanderers, God-haters, insolent, arrogant, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " boastful. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "They"
          ]
        },
        " invent ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "new"
          ]
        },
        " forms of evil; they disobey ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their"
          ]
        },
        " parents. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "ROM 1:31"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "They are"
          ]
        },
        " senseless, faithless, heartless, merciless."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "32",
          "sid": "ROM 1:32"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Although they"
          ]
        },
        " know God’s righteous decree that those who do such things are worthy of death, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "they"
          ]
        },
        " not only continue to do these things, but also approve of those who practice ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        "."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "2",
      "sid": "ROM 2"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "God’s Righteous Judgment"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "PSA 75:1-10",
          "content": [
            "Psalm 75:1–10"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "ROM 2:1"
        },
        "You, therefore, have no excuse, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        " who pass judgment ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "on another"
          ]
        },
        ". For on whatever grounds you judge the other, you are condemning yourself, because ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you who"
          ]
        },
        " pass judgment do the same things. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "ROM 2:2"
        },
        "And we know that God’s judgment against those who do such things is based on truth. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "ROM 2:3"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So when"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        ", O man, pass judgment on ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "others"
          ]
        },
        ", yet do the same things, do you think you will escape God’s judgment? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "ROM 2:4"
        },
        "Or do you disregard the riches of His kindness, tolerance, and patience, not realizing that God’s kindness leads you to repentance?"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "ROM 2:5"
        },
        "But because of your hard and unrepentant heart, you are storing up wrath against yourself for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " day of wrath, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "when"
          ]
        },
        " God’s righteous judgment will be revealed. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "ROM 2:6"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "God"
          ]
        },
        " “will repay each one according to his deeds.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:6 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "PSA 62:12",
                  "content": [
                    "Psalm 62:12"
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "ROM 2:7"
        },
        "To those who by perseverance in doing good seek glory, honor, and immortality, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "He will give"
          ]
        },
        " eternal life. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "ROM 2:8"
        },
        "But for those who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " self-seeking and who reject the truth and follow wickedness, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "there will be"
          ]
        },
        " wrath and anger."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "ROM 2:9"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "There will be"
          ]
        },
        " trouble and distress for every human being who does evil, first for the Jew, then for the Greek; ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "ROM 2:10"
        },
        "but glory, honor, and peace for everyone who does good, first for the Jew, then for the Greek. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "ROM 2:11"
        },
        "For God does not show favoritism."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "ROM 2:12"
        },
        "All who sin apart from the law will also perish apart from the law, and all who sin under ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law will be judged by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "ROM 2:13"
        },
        "For ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it is"
          ]
        },
        " not the hearers of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who are"
          ]
        },
        " righteous before God, but ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it is"
          ]
        },
        " the doers of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who"
          ]
        },
        " will be declared righteous."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "ROM 2:14"
        },
        "Indeed, when Gentiles, who do not have ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law, do by nature what the law ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "requires"
          ]
        },
        ", they are a law to themselves, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "even though"
          ]
        },
        " they do not have ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "ROM 2:15"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "So"
          ]
        },
        " they show ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " the work of the law is written on their hearts, their consciences also bearing witness, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " their thoughts either accusing or defending ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "ROM 2:16"
        },
        "on the day when God will judge men’s secrets through Christ Jesus,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:16 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "through Jesus Christ"
              ]
            }
          ]
        },
        " as proclaimed by my gospel."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Jews and the Law"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "ROM 2:17"
        },
        "Now you, if you call ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "yourself"
          ]
        },
        " a Jew; ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "if you"
          ]
        },
        " rely on ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law and boast in God; ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "ROM 2:18"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "if you"
          ]
        },
        " know ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " will and approve of what is superior because you are instructed by the law; ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "ROM 2:19"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "if you"
          ]
        },
        " are convinced ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " you are a guide for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " blind, a light for those in darkness, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "ROM 2:20"
        },
        "an instructor of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " foolish, a teacher of infants, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "because"
          ]
        },
        " you have in the law the embodiment of knowledge and truth — ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "ROM 2:21"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you,"
          ]
        },
        " then, who teach others, do you not teach yourself? You who preach against stealing, do you steal? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "ROM 2:22"
        },
        "You who forbid adultery, do you commit adultery? You who abhor idols, do you rob temples? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "ROM 2:23"
        },
        "You who boast in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law, do you dishonor God by breaking the law? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "ROM 2:24"
        },
        "As it is written: “God’s name is blasphemed among the Gentiles because of you.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "2:24 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 52:5",
                  "content": [
                    "Isaiah 52:5"
                  ]
                },
                " (see also LXX)"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "ROM 2:25"
        },
        "Circumcision has value if you observe ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law, but if you break ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law, your circumcision has become uncircumcision. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "ROM 2:26"
        },
        "If a man who is not circumcised keeps the requirements of the law, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "will"
          ]
        },
        " not his uncircumcision be regarded as circumcision? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "ROM 2:27"
        },
        "The ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one who is"
          ]
        },
        " physically uncircumcised ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "yet"
          ]
        },
        " keeps the law will condemn you who, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "even though you have"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " written code and circumcision, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " a lawbreaker."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "ROM 2:28"
        },
        "A ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        " is not a Jew ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "because he is one "
          ]
        },
        " outwardly, nor ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " circumcision ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "only "
          ]
        },
        " outward ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " physical. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "ROM 2:29"
        },
        "No, a man ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " a Jew ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "because he is one "
          ]
        },
        " inwardly, and circumcision ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is a matter"
          ]
        },
        " of the heart, by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Spirit, not by the written code. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Such a man’s"
          ]
        },
        " praise ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "does"
          ]
        },
        " not ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "come"
          ]
        },
        " from men, but from God."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "3",
      "sid": "ROM 3"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "God Remains Faithful"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "ROM 3:1"
        },
        "What, then, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " the advantage of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "being"
          ]
        },
        " a Jew? Or what ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " the value of circumcision? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "ROM 3:2"
        },
        "Much in every way. First of all, they have been entrusted with the very words",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:2 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "the oracles"
              ]
            }
          ]
        },
        " of God."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "ROM 3:3"
        },
        "What if some did not have faith? ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Will"
          ]
        },
        " their lack of faith nullify God’s faithfulness? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "ROM 3:4"
        },
        "Certainly not! ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Let"
          ]
        },
        " God be true and every man a liar. As it is written:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“So that You may be proved right when You speak"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and victorious when You judge.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:4 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "when You are judged"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; ",
                {
                  "type": "ref",
                  "loc": "PSA 51:4",
                  "content": [
                    "Psalm 51:4"
                  ]
                },
                " (see also LXX)"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "ROM 3:5"
        },
        "But if our unrighteousness highlights the righteousness of God, what shall we say? ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "That"
          ]
        },
        " God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " unjust to inflict ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " wrath ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "on us"
          ]
        },
        "? I am speaking in human terms. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "ROM 3:6"
        },
        "Certainly not! In that case, how ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "could"
          ]
        },
        " God judge the world? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "ROM 3:7"
        },
        "However, if my falsehood accentuates God’s truthfulness, to the increase of His glory, why ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "am"
          ]
        },
        " I still condemned as a sinner? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "ROM 3:8"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Why"
          ]
        },
        " not ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "say"
          ]
        },
        ", as some slanderously claim ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " we say, “Let us do evil that good may result”? Their condemnation is deserved!"
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "There Is No One Righteous"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "PSA 14:1-7",
          "content": [
            "Psalm 14:1–7"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "PSA 53:1-6",
          "content": [
            "Psalm 53:1–6"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "ISA 59:1-17",
          "content": [
            "Isaiah 59:1–17"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "ROM 3:9"
        },
        "What then? Are we any better? Not at all. For we have already made the charge ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " Jews and Greeks alike are all under sin. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "ROM 3:10"
        },
        "As it is written:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“There is no one righteous,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "not even one."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "ROM 3:11"
        },
        "There is no one who understands,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "no one who seeks God."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "ROM 3:12"
        },
        "All have turned away,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "they have together become worthless;"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "there is no one who does good,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "not even one.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:12 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "PSA 14:1-3",
                  "content": [
                    "Psalm 14:1–3"
                  ]
                },
                " and Psalm 53:1–3 (see also LXX)"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "ROM 3:13"
        },
        "“Their throats ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " open graves;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "their tongues practice deceit.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:13 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "PSA 5:9",
                  "content": [
                    "Psalm 5:9"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "“",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The"
          ]
        },
        " venom of vipers ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " on their lips.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:13 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "PSA 140:3",
                  "content": [
                    "Psalm 140:3"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "ROM 3:14"
        },
        "“",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Their"
          ]
        },
        " mouths are full"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "of cursing and bitterness.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:14 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "PSA 10:7",
                  "content": [
                    "Psalm 10:7"
                  ]
                },
                " (see also LXX)"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "ROM 3:15"
        },
        "“Their feet ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " swift to shed blood;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "ROM 3:16"
        },
        "ruin and misery ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "lie"
          ]
        },
        " in their wake,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "ROM 3:17"
        },
        "and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " way of peace they have not known.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:17 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 59:7-8",
                  "content": [
                    "Isaiah 59:7–8"
                  ]
                },
                " (see also LXX)"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "ROM 3:18"
        },
        "“There is no fear of God"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "before their eyes.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:18 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "PSA 36:1",
                  "content": [
                    "Psalm 36:1"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "ROM 3:19"
        },
        "Now we know that whatever the law says, it says to those who are under the law, so that every mouth may be silenced and the whole world held accountable to God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "ROM 3:20"
        },
        "Therefore no one will be justified in His sight by works of the law. For ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law merely brings awareness of sin."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Righteousness through Faith in Christ"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "PHP 3:1-11",
          "content": [
            "Philippians 3:1–11"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "ROM 3:21"
        },
        "But now, apart from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " righteousness of God has been revealed, as attested by the Law and the Prophets. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "ROM 3:22"
        },
        "And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        " righteousness ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "from"
          ]
        },
        " God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "comes"
          ]
        },
        " through faith in Jesus Christ to all who believe. There is no distinction, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "ROM 3:23"
        },
        "for all have sinned and fall short of the glory of God, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "ROM 3:24"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and are"
          ]
        },
        " justified freely by His grace through the redemption that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " in Christ Jesus."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "ROM 3:25"
        },
        "God presented ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as an"
          ]
        },
        " atoning sacrifice",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "3:25 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "as a propitiation"
              ]
            }
          ]
        },
        " in His blood through faith, in order to demonstrate His righteousness, because in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " forbearance ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "He"
          ]
        },
        " had passed over the sins committed beforehand. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "ROM 3:26"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "He did this"
          ]
        },
        " to demonstrate His righteousness at the present time, so as to be just and to justify the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who has"
          ]
        },
        " faith in Jesus."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "ROM 3:27"
        },
        "Where, then, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " boasting? It is excluded. On what principle? ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "On"
          ]
        },
        " that of works? No, but on ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " of faith. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "ROM 3:28"
        },
        "For we maintain that a man is justified by faith apart from works of the law."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "ROM 3:29"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Is God"
          ]
        },
        " the God of Jews only? ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Is He"
          ]
        },
        " not ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the God"
          ]
        },
        " of Gentiles too? Yes, of Gentiles too, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "ROM 3:30"
        },
        "since ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "there is only"
          ]
        },
        " one God, who will justify ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " circumcised by faith and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " uncircumcised through that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "same"
          ]
        },
        " faith."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "ROM 3:31"
        },
        "Do we, then, nullify ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this"
          ]
        },
        " faith? Certainly not! Instead, we uphold ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "4",
      "sid": "ROM 4"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Abraham Justified by Faith"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "GEN 15:1-7",
          "content": [
            "Genesis 15:1–7"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "PSA 32:1-11",
          "content": [
            "Psalm 32:1–11"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "HEB 11:8-19",
          "content": [
            "Hebrews 11:8–19"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "ROM 4:1"
        },
        "What then shall we say ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " Abraham, our forefather according to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " flesh, has discovered? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "ROM 4:2"
        },
        "If Abraham was indeed justified by works, he had something to boast about, but not before God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "ROM 4:3"
        },
        "For what ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "does"
          ]
        },
        " the Scripture say? “Abraham believed God, and it was credited to him as righteousness.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "4:3 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "GEN 15:6",
                  "content": [
                    "Genesis 15:6"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "ROM 4:4"
        },
        "Now the wages of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " worker are not credited as a gift, but as an obligation. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "ROM 4:5"
        },
        "However, to the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one who"
          ]
        },
        " does not work, but believes in Him who justifies the ungodly, his faith is credited as righteousness. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "ROM 4:6"
        },
        "And David speaks likewise of the blessedness of the man to whom God credits righteousness apart from works:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "ROM 4:7"
        },
        "“Blessed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are they"
          ]
        },
        " whose lawless acts are forgiven,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "whose sins are covered."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "ROM 4:8"
        },
        "Blessed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " man"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "add",
          "content": [
            "whose"
          ]
        },
        " sin ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord will never count against him.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "4:8 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "PSA 32:1-2",
                  "content": [
                    "Psalm 32:1–2"
                  ]
                },
                " (see also LXX)"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "ROM 4:9"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Is"
          ]
        },
        " this blessing ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "only"
          ]
        },
        " on the circumcised, or also on the uncircumcised? We have been saying that Abraham’s faith was credited ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to him"
          ]
        },
        " as righteousness. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "ROM 4:10"
        },
        "In what context was it credited? ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Was it after"
          ]
        },
        " his circumcision, or ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "before"
          ]
        },
        "? ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "It was"
          ]
        },
        " not ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "after"
          ]
        },
        ", but ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "before"
          ]
        },
        ".",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "4:10 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "How then was it reckoned—being in circumcision, or in uncircumcision? Not in circumcision, but in uncircumcision."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "ROM 4:11"
        },
        "And he received ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " sign of circumcision ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as"
          ]
        },
        " a seal of the righteousness that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "he had"
          ]
        },
        " by faith ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "while"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "he was still"
          ]
        },
        " uncircumcised. So then, he is ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " father of all who believe ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "but"
          ]
        },
        " are not circumcised, in order that righteousness might be credited to them. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "ROM 4:12"
        },
        "And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "he is also the"
          ]
        },
        " father of the circumcised who not only are circumcised, but who also walk in the footsteps of the faith ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " our father Abraham had before he was circumcised."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Abraham Receives the Promise"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "GEN 15:8-21",
          "content": [
            "Genesis 15:8–21"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "ROM 4:13"
        },
        "For the promise to Abraham ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " his offspring that he would be heir ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of the"
          ]
        },
        " world was not ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "given"
          ]
        },
        " through ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law, but through ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " righteousness that comes by faith. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "ROM 4:14"
        },
        "For if those ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who live by"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " heirs, faith is useless and the promise is worthless, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "ROM 4:15"
        },
        "because the law brings wrath. And where there is no law, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "there is"
          ]
        },
        " no transgression."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "ROM 4:16"
        },
        "Therefore, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the promise comes"
          ]
        },
        " by faith, so that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " may rest on grace ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " may be guaranteed to all ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Abraham’s"
          ]
        },
        " offspring — not only to those who are of the law, but also to those who are of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " faith of Abraham. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "He"
          ]
        },
        " is ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " father of us all. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "ROM 4:17"
        },
        "As it is written: “I have made you a father of many nations.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "4:17 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "GEN 17:5",
                  "content": [
                    "Genesis 17:5"
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "He is our father"
          ]
        },
        " in the presence of God, in whom he believed, the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "God who"
          ]
        },
        " gives life to the dead and calls ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "into"
          ]
        },
        " being what ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "does"
          ]
        },
        " not yet exist."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "ROM 4:18"
        },
        "Against all hope, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Abraham"
          ]
        },
        " in hope believed and so became ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " father of many nations, just as he had been told, “So ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "shall"
          ]
        },
        " your offspring be.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "4:18 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "GEN 15:5",
                  "content": [
                    "Genesis 15:5"
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "ROM 4:19"
        },
        "Without weakening in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " faith, he acknowledged the decrepitness of his body (since he was about a hundred years old) and the lifelessness of Sarah’s womb. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "ROM 4:20"
        },
        "Yet he did not waver through disbelief in the promise of God, but was strengthened in his faith ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " gave glory to God, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "ROM 4:21"
        },
        "being fully persuaded that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "God"
          ]
        },
        " was able to do what He had promised. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "ROM 4:22"
        },
        "This is why “it was credited to him as righteousness.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "4:22 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "GEN 15:6",
                  "content": [
                    "Genesis 15:6"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "ROM 4:23"
        },
        "Now ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the words"
          ]
        },
        " “it was credited to him” were written not only for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Abraham"
          ]
        },
        ", ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "ROM 4:24"
        },
        "but also for us, to whom ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "righteousness"
          ]
        },
        " will be credited— for us who believe in Him who raised Jesus our Lord from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " dead. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "ROM 4:25"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "He"
          ]
        },
        " was delivered over to death for our trespasses and was raised to life for our justification."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "5",
      "sid": "ROM 5"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Triumph of Faith"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "ROM 5:1"
        },
        "Therefore, since we have been justified through faith, we have",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "5:1 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "let us have"
              ]
            }
          ]
        },
        " peace with God through our Lord Jesus Christ, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "ROM 5:2"
        },
        "through whom we have gained access by faith into this grace in which we stand. And we rejoice",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "5:2 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "exult"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; also in verses 3 and 11"
              ]
            }
          ]
        },
        " in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " hope of the glory of God."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "ROM 5:3"
        },
        "Not only ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        ", but we also rejoice in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "our"
          ]
        },
        " sufferings, because we know that suffering produces perseverance; ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "ROM 5:4"
        },
        "perseverance, character; and character, hope. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "ROM 5:5"
        },
        "And hope does not disappoint ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "us"
          ]
        },
        ", because God has poured out ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " love into our hearts through ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Holy Spirit, whom He has given us."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Christ’s Sacrifice for the Ungodly"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "JHN 3:1-21",
          "content": [
            "John 3:1–21"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "ROM 5:6"
        },
        "For at just ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " right time, while we were still powerless, Christ died for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " ungodly. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "ROM 5:7"
        },
        "Very rarely will anyone die for a righteous ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        ", though for a good ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        " someone ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "might"
          ]
        },
        " possibly dare to die. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "ROM 5:8"
        },
        "But God proves His love for us in this: While we were still sinners, Christ died for us."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "ROM 5:9"
        },
        "Therefore, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "since"
          ]
        },
        " we have now been justified by His blood, how much more shall we be saved from wrath through Him! ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "ROM 5:10"
        },
        "For if, when we were enemies ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of God"
          ]
        },
        ", we were reconciled to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        " through the death of His Son, how much more, having been reconciled, shall we be saved through His life! ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "ROM 5:11"
        },
        "Not only that, but we also rejoice in God through our Lord Jesus Christ, through whom we have now received reconciliation."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Death in Adam, Life in Christ"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "GEN 3:1-7",
          "content": [
            "Genesis 3:1–7"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "ROM 5:12"
        },
        "Therefore, just as sin entered the world through one man, and death through sin, so also death was passed on to all men, because all sinned. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "ROM 5:13"
        },
        "For sin was in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " world before ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was given"
          ]
        },
        "; but sin is not taken into account when there is no law. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "ROM 5:14"
        },
        "Nevertheless, death reigned from Adam until Moses, even over those who did not sin in the way that Adam transgressed. He is a pattern of the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "One"
          ]
        },
        " to come."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "ROM 5:15"
        },
        "But the gift ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " not like the trespass. For if the many died by the trespass of the one ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        ", how much more ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "did"
          ]
        },
        " God’s grace and the gift that came by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " grace of the one man, Jesus Christ, abound to the many! ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "ROM 5:16"
        },
        "Again, the gift ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " not like ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the result of"
          ]
        },
        " the one ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man’s"
          ]
        },
        " sin: The judgment ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that followed"
          ]
        },
        " one ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "sin"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "brought"
          ]
        },
        " condemnation, but the gift ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that followed"
          ]
        },
        " many trespasses ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "brought"
          ]
        },
        " justification. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "ROM 5:17"
        },
        "For if, by the trespass of the one ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        ", death reigned through ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " one ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        ", how much more ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "will"
          ]
        },
        " those who receive the abundance of grace and of the gift of righteousness reign in life through the one man, Jesus Christ!"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "ROM 5:18"
        },
        "So then, just as one trespass ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "brought"
          ]
        },
        " condemnation for all men, so also one act of righteousness ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "brought"
          ]
        },
        " justification ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " life for all men. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "ROM 5:19"
        },
        "For just as through the disobedience of the one man the many were made sinners, so also through the obedience of the one ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        " the many will be made righteous."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "ROM 5:20"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The"
          ]
        },
        " law came in so that the trespass would increase; but where sin increased, grace increased all the more, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "ROM 5:21"
        },
        "so that, just as sin reigned in death, so also grace might reign through righteousness to bring eternal life through Jesus Christ our Lord."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "6",
      "sid": "ROM 6"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Dead to Sin, Alive to God"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "2CO 4:7-18",
          "content": [
            "2 Corinthians 4:7–18"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "ROM 6:1"
        },
        "What then shall we say? Shall we continue in sin so that grace may increase? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "ROM 6:2"
        },
        "Certainly not! How ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "can we"
          ]
        },
        " who died to sin live in it any longer? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "ROM 6:3"
        },
        "Or aren’t you aware that all of us who were baptized into Christ Jesus were baptized into His death? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "ROM 6:4"
        },
        "We were therefore buried with Him through baptism into death, in order that, just as Christ was raised from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " dead through the glory of the Father, we too may walk in newness of life."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "ROM 6:5"
        },
        "For if we have been united with Him like this in His death, we will certainly also be ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "united with Him"
          ]
        },
        " in His resurrection. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "ROM 6:6"
        },
        "We know that our old self was crucified with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        " so that the body of sin might be rendered powerless, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " we ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "should"
          ]
        },
        " no longer be slaves to sin. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "ROM 6:7"
        },
        "For ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "anyone who"
          ]
        },
        " has died has been freed from sin."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "ROM 6:8"
        },
        "Now if we died with Christ, we believe that we will also live with Him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "ROM 6:9"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "For"
          ]
        },
        " we know that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "since"
          ]
        },
        " Christ was raised from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " dead, He cannot die again; death no longer has dominion over Him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "ROM 6:10"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The death"
          ]
        },
        " He died, He died to sin once for all; but ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the life"
          ]
        },
        " He lives, He lives to God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "ROM 6:11"
        },
        "So you too must count yourselves dead to sin, but alive to God in Christ Jesus."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "ROM 6:12"
        },
        "Therefore do not let sin reign in your mortal body so that you obey its desires. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "ROM 6:13"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Do"
          ]
        },
        " not present the parts of your ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "body"
          ]
        },
        " to sin as instruments of wickedness, but present yourselves to God as ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "those who have been"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "brought"
          ]
        },
        " from death to life; and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "present"
          ]
        },
        " the parts of your ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "body"
          ]
        },
        " to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        " as instruments of righteousness. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "ROM 6:14"
        },
        "For sin shall not be your master, because you are not under law, but under grace."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Wages of Sin"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "ROM 6:15"
        },
        "What then? Shall we sin because we are not under law, but under grace? Certainly not! ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "ROM 6:16"
        },
        "Do you not know that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "when"
          ]
        },
        " you offer yourselves ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as"
          ]
        },
        " obedient slaves, you are slaves to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the one"
          ]
        },
        " you obey, whether ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you are slaves"
          ]
        },
        " to sin ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "leading"
          ]
        },
        " to death, or to obedience ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "leading"
          ]
        },
        " to righteousness? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "ROM 6:17"
        },
        "But thanks ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " to God that, though you once were slaves to sin, you wholeheartedly obeyed the form of teaching to which you were committed. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "ROM 6:18"
        },
        "You have been set free from sin ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " have become slaves to righteousness."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "ROM 6:19"
        },
        "I am speaking in human terms because of the weakness of your flesh. Just as you used to offer the parts of your ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "body"
          ]
        },
        " in slavery to impurity and to escalating wickedness, so now offer ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        " in slavery to righteousness leading to holiness."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "ROM 6:20"
        },
        "For when you were slaves to sin, you were free of obligation to righteousness. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "ROM 6:21"
        },
        "What fruit did you reap at that time from the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "things"
          ]
        },
        " of which you are now ashamed? The outcome of those things ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " death. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "ROM 6:22"
        },
        "But now ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " you have been set free from sin and have become slaves to God, the fruit you reap ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "leads to"
          ]
        },
        " holiness, and the outcome ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " eternal life. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "ROM 6:23"
        },
        "For the wages of sin ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " death, but the gift of God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " eternal life in Christ Jesus our Lord."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "7",
      "sid": "ROM 7"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Release from the Law"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "GAL 3:15-25",
          "content": [
            "Galatians 3:15–25"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "ROM 7:1"
        },
        "Do you not know, brothers (for I am speaking to those who know ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law), that the law has authority over a man only as long as he lives? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "ROM 7:2"
        },
        "For instance, a married woman is bound by law to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "her"
          ]
        },
        " husband as long as he lives. But if ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "her"
          ]
        },
        " husband dies, she is released from the law of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "marriage"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "ROM 7:3"
        },
        "So then, if she is ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "joined"
          ]
        },
        " to another man ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "while her"
          ]
        },
        " husband is ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "still"
          ]
        },
        " alive, she is called an adulteress; but if ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "her"
          ]
        },
        " husband dies, she is free from that law ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " is not an adulteress ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "if she marries"
          ]
        },
        " another man."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "ROM 7:4"
        },
        "Therefore, my brothers, you also died to the law through the body of Christ, that you might belong to another, to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him who"
          ]
        },
        " was raised from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " dead, in order that we might bear fruit to God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "ROM 7:5"
        },
        "For when we ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "lived"
          ]
        },
        " according to the flesh, the sinful passions ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "aroused"
          ]
        },
        " by the law were at work in our bodies, bearing fruit for death. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "ROM 7:6"
        },
        "But now, having died to what bound us, we have been released from the law, so that we serve in the new way of the Spirit, and not in the old way of the written code."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "God’s Law Is Holy"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "ROM 7:7"
        },
        "What then shall we say? ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Is"
          ]
        },
        " the law sin? Certainly not! Indeed, I would not have been mindful of sin if not for the law. For I would not have been aware of coveting if the law ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "had"
          ]
        },
        " not said, “Do not covet.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "7:7 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "EXO 20:17",
                  "content": [
                    "Exodus 20:17"
                  ]
                },
                "; Deuteronomy 5:21"
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "ROM 7:8"
        },
        "But sin, seizing ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "its"
          ]
        },
        " opportunity through the commandment, produced in me every kind of covetous desire. For apart from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law, sin ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " dead."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "ROM 7:9"
        },
        "Once I was alive apart from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law; but ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "when"
          ]
        },
        " the commandment came, sin sprang to life and I died. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "ROM 7:10"
        },
        "So I discovered that the very commandment that was meant to bring life ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "actually brought"
          ]
        },
        " death. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "ROM 7:11"
        },
        "For sin, seizing ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "its"
          ]
        },
        " opportunity through the commandment, deceived me and through ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the commandment"
          ]
        },
        " put ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "me"
          ]
        },
        " to death."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "ROM 7:12"
        },
        "So then, the law ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " holy, and the commandment ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " holy, righteous, and good."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Struggling with Sin"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "ROM 7:13"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Did"
          ]
        },
        " that which ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " good, then, become death to me? Certainly not! But in order that sin might be exposed as sin, it produced death in me through what ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was"
          ]
        },
        " good, so that through the commandment sin might become utterly sinful."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "ROM 7:14"
        },
        "We know that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law is spiritual; but I am unspiritual, sold as a slave to sin. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "ROM 7:15"
        },
        "I do not understand what I do. For what I want ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to do"
          ]
        },
        ", I do not do. But what I hate, I do. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "ROM 7:16"
        },
        "And if I do what I do not want ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to do"
          ]
        },
        ", I admit that the law ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " good. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "ROM 7:17"
        },
        "In that case, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it is"
          ]
        },
        " no longer I who do it, but ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it is"
          ]
        },
        " sin living in me ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that does it "
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "ROM 7:18"
        },
        "I know that nothing good lives in me, that is, in my flesh; for I have the desire to do what is good, but ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "I"
          ]
        },
        " cannot ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "carry it out"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "ROM 7:19"
        },
        "For I do not do ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " good I want ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to do"
          ]
        },
        ". Instead, I keep on doing ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " evil I do not want ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to do"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "ROM 7:20"
        },
        "And if I do what I do not want, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it is"
          ]
        },
        " no longer I who do it, but ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it is"
          ]
        },
        " sin living in me ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that does it "
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "ROM 7:21"
        },
        "So ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "this is"
          ]
        },
        " the principle I have discovered: When I want to do good, evil is right there with me. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "ROM 7:22"
        },
        "For in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "my"
          ]
        },
        " inner being I delight in God’s law. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "ROM 7:23"
        },
        "But I see another law  ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "at work "
          ]
        },
        " in my body, warring against the law of my mind and holding me captive to the law of sin that dwells within ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "me"
          ]
        },
        ".",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "7:23 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "captive to the law of sin being in my members."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "ROM 7:24"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "What a"
          ]
        },
        " wretched man I am! Who will rescue me from this body of death? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "ROM 7:25"
        },
        "Thanks ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " to God, through Jesus Christ our Lord!"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "So then, with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "my"
          ]
        },
        " mind I serve ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law of God, but ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "with my"
          ]
        },
        " flesh ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "I serve the"
          ]
        },
        " law of sin."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "8",
      "sid": "ROM 8"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Walking by the Spirit"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "EZK 36:16-38",
          "content": [
            "Ezekiel 36:16–38"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "GAL 5:16-26",
          "content": [
            "Galatians 5:16–26"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "ROM 8:1"
        },
        "Therefore, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "there is"
          ]
        },
        " now no condemnation for those who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " in Christ Jesus.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "8:1 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "in Christ Jesus, who do not walk according to the flesh but according to the Spirit."
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "ROM 8:2"
        },
        "For in Christ Jesus the law of the Spirit of life ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "set"
          ]
        },
        " you",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "8:2 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "me"
              ]
            }
          ]
        },
        " free from the law of sin and death. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "ROM 8:3"
        },
        "For what the law was powerless to do in that it was weakened by the flesh, God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "did"
          ]
        },
        " by sending His ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "own"
          ]
        },
        " Son in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " likeness of sinful man, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as an offering "
          ]
        },
        " for sin.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "8:3 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "in the likeness of sinful flesh and for sin"
              ]
            }
          ]
        },
        " He ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "thus"
          ]
        },
        " condemned sin in the flesh, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "ROM 8:4"
        },
        "so that the righteous standard of the law might be fulfilled in us, who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do"
          ]
        },
        " not walk according to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " flesh but according to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Spirit."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "ROM 8:5"
        },
        "Those who live according to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " flesh set their minds on the things of the flesh; but those ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who live"
          ]
        },
        " according to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Spirit ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "set their minds on"
          ]
        },
        " the things of the Spirit. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "ROM 8:6"
        },
        "The mind of the flesh ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " death, but the mind of the Spirit ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " life and peace, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "ROM 8:7"
        },
        "because the mind of the flesh ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " hostile to God: It does not submit to God’s law, nor can it ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do so"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "ROM 8:8"
        },
        "Those controlled by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " flesh",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "8:8 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Those being in the flesh"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; similarly in verse 9"
              ]
            }
          ]
        },
        " cannot please God."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "ROM 8:9"
        },
        "You, however, are controlled not by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " flesh, but by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Spirit, if ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Spirit of God lives in you. And if anyone ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "does"
          ]
        },
        " not have ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Spirit of Christ, he ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "does"
          ]
        },
        " not belong to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Christ"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "ROM 8:10"
        },
        "But if Christ ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " in you, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " body ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " dead because of sin, yet ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " spirit ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " alive",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "8:10 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "yet the Spirit is life"
              ]
            }
          ]
        },
        " because of righteousness. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "ROM 8:11"
        },
        "And if the Spirit of Him who raised Jesus from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " dead is living in you, He who raised Christ Jesus from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " dead",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "8:11 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "NA, BYZ, and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "raised Christ from the dead"
              ]
            }
          ]
        },
        " will also give life to your mortal bodies through His Spirit, who lives in you."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Heirs with Christ"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "ROM 8:12"
        },
        "Therefore, brothers, we have ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "an"
          ]
        },
        " obligation, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "but it is"
          ]
        },
        " not to the flesh, to live according to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "ROM 8:13"
        },
        "For if you live according to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " flesh, you will die; but if by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Spirit you put to death the deeds of the body, you will live. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "ROM 8:14"
        },
        "For all who are led by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Spirit of God are sons of God."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "ROM 8:15"
        },
        "For you did not receive a spirit of slavery that returns you to fear, but you received ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Spirit of adoption to sonship, by whom we cry, “Abba! Father!” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "ROM 8:16"
        },
        "The Spirit Himself testifies with our spirit that we are God’s children. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "ROM 8:17"
        },
        "And if ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "we are"
          ]
        },
        " children, then ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "we are"
          ]
        },
        " heirs: heirs of God and co-heirs with Christ — if indeed we suffer with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        ", so that we may also be glorified with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Future Glory"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "2CO 5:1-10",
          "content": [
            "2 Corinthians 5:1–10"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "ROM 8:18"
        },
        "I consider that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "our"
          ]
        },
        " present sufferings ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " not comparable to the glory that will be revealed in us. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "ROM 8:19"
        },
        "The creation waits in eager expectation for the revelation of the sons of God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "ROM 8:20"
        },
        "For the creation was subjected to futility, not by its own will, but because of the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "One who"
          ]
        },
        " subjected ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        ", in hope ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "ROM 8:21"
        },
        "that the creation itself will be set free from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "its"
          ]
        },
        " bondage to decay ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and brought"
          ]
        },
        " into the glorious freedom of the children of God."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "ROM 8:22"
        },
        "We know that the whole creation has been groaning together in the pains of childbirth until the present time. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "ROM 8:23"
        },
        "Not only that, but we ourselves, who have the firstfruits of the Spirit, groan inwardly as we wait eagerly for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "our"
          ]
        },
        " adoption as sons, the redemption of our bodies. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "ROM 8:24"
        },
        "For in this hope we were saved; but hope that is seen is no hope ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "at all"
          ]
        },
        ". ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Who"
          ]
        },
        " hopes for what he can already see? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "ROM 8:25"
        },
        "But if we hope for what we do not yet see, we wait for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        " patiently."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "ROM 8:26"
        },
        "In the same way, the Spirit helps us in our weakness. For we do not know how we ought to pray, but the Spirit Himself intercedes ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "for us"
          ]
        },
        " with groans too deep for words. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "ROM 8:27"
        },
        "And He who searches ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "our"
          ]
        },
        " hearts knows the mind of the Spirit, because ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the Spirit"
          ]
        },
        " intercedes for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " saints according to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the will"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of"
          ]
        },
        " God."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "God Works in All Things"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "EPH 1:3-14",
          "content": [
            "Ephesians 1:3–14"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "ROM 8:28"
        },
        "And we know that God works all things together for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " good of those who love ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Him"
          ]
        },
        ", who are called according to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " purpose. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "ROM 8:29"
        },
        "For those ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "God"
          ]
        },
        " foreknew, He also predestined ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to be"
          ]
        },
        " conformed to the image of His Son, so that He would be ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " firstborn among many brothers. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "ROM 8:30"
        },
        "And those He predestined, He also called; ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "those"
          ]
        },
        " He called, He ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "also"
          ]
        },
        " justified; ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "those"
          ]
        },
        " He justified, He also glorified."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "ROM 8:31"
        },
        "What then shall we say in response to these things? If God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " for us, who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "can be"
          ]
        },
        " against us? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "32",
          "sid": "ROM 8:32"
        },
        "He who did not spare ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " own Son but gave Him up for us all, how ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "will He"
          ]
        },
        " not also, along with Him, freely give us all things? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "ROM 8:33"
        },
        "Who will bring any charge against God’s elect? ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "It is"
          ]
        },
        " God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who"
          ]
        },
        " justifies. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "34",
          "sid": "ROM 8:34"
        },
        "Who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " there to condemn ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "us"
          ]
        },
        "? ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "For"
          ]
        },
        " Christ Jesus, who died, and more than that was raised to life, is at ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " right hand of God— and He is interceding for us."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "More than Conquerors"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "PSA 44:1-26",
          "content": [
            "Psalm 44:1–26"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "35",
          "sid": "ROM 8:35"
        },
        "Who shall separate us from the love of Christ? ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Shall"
          ]
        },
        " trouble or distress or persecution or famine or nakedness or danger or sword? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "36",
          "sid": "ROM 8:36"
        },
        "As it is written:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“For Your sake we face death all day long;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "we are considered as sheep to be slaughtered.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "8:36 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "PSA 44:22",
                  "content": [
                    "Psalm 44:22"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "37",
          "sid": "ROM 8:37"
        },
        "No, in all these things we are more than conquerors through Him who loved us. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "38",
          "sid": "ROM 8:38"
        },
        "For I am convinced that neither death nor life, neither angels nor principalities, neither the present nor the future, nor any powers, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "39",
          "sid": "ROM 8:39"
        },
        "neither height nor depth, nor anything else in all creation, will be able to separate us from the love of God that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " in Christ Jesus our Lord."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "9",
      "sid": "ROM 9"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Paul’s Concern for the Jews"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "ROM 9:1"
        },
        "I speak ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " truth in Christ; I am not lying, as confirmed by my conscience in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Holy Spirit. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "ROM 9:2"
        },
        "I have deep sorrow and unceasing anguish in my heart. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "ROM 9:3"
        },
        "For I could wish that I myself were cursed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " cut off from Christ for the sake of my brothers, my own flesh and blood, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "ROM 9:4"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the people of"
          ]
        },
        " Israel. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Theirs is"
          ]
        },
        " the adoption as sons; ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "theirs"
          ]
        },
        " the divine glory and the covenants; ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "theirs"
          ]
        },
        " the giving of the law, the temple worship, and the promises. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "ROM 9:5"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Theirs are"
          ]
        },
        " the patriarchs, and from them ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "proceeds "
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " human ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "descent"
          ]
        },
        " of Christ, who is God over all, forever worthy of praise!",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "9:5 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "forever blessed"
              ]
            }
          ]
        },
        " Amen."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "God’s Sovereign Choice"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "GEN 25:19-28",
          "content": [
            "Genesis 25:19–28"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "MAL 1:1-5",
          "content": [
            "Malachi 1:1–5"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "ROM 9:6"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "It is"
          ]
        },
        " not as though God’s word has failed. For not all who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " descended from Israel ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " Israel. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "ROM 9:7"
        },
        "Nor because they are Abraham’s descendants ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " they all ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " children. On the contrary, “Through Isaac your offspring will be reckoned.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "9:7 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "GEN 21:12",
                  "content": [
                    "Genesis 21:12"
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "ROM 9:8"
        },
        "So it is not the children of the flesh ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who are"
          ]
        },
        " God’s children, but ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it is"
          ]
        },
        " the children of the promise who are regarded as offspring. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "ROM 9:9"
        },
        "For this ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " what ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " promise stated: “At the appointed time I will return, and Sarah will have a son.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "9:9 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "GEN 18:14",
                  "content": [
                    "Genesis 18:14"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "ROM 9:10"
        },
        "Not only that, but Rebecca’s ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "children"
          ]
        },
        " were conceived by one ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "man"
          ]
        },
        ", our father Isaac. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "ROM 9:11"
        },
        "Yet before ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the twins"
          ]
        },
        " were born ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " had done anything good or bad, in order that God’s plan of election might stand, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "ROM 9:12"
        },
        "not by works but by Him who calls, she was told, “The older will serve the younger.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "9:12 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "GEN 25:23",
                  "content": [
                    "Genesis 25:23"
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "ROM 9:13"
        },
        "So it is written: “Jacob I loved, but Esau I hated.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "9:13 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "MAL 1:2-3",
                  "content": [
                    "Malachi 1:2–3"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "ROM 9:14"
        },
        "What then shall we say? ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Is"
          ]
        },
        " God unjust? Certainly not! ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "ROM 9:15"
        },
        "For He says to Moses:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“I will have mercy on whom I have mercy,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and I will have compassion on whom I have compassion.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "9:15 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "EXO 33:19",
                  "content": [
                    "Exodus 33:19"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "ROM 9:16"
        },
        "So then, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it does"
          ]
        },
        " not ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "depend"
          ]
        },
        " on man’s desire ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " effort, but on God’s mercy. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "ROM 9:17"
        },
        "For the Scripture says to Pharaoh: “I raised you up for this very ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "purpose"
          ]
        },
        ", that I might display My power in you, and that My name might be proclaimed in all the earth.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "9:17 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "EXO 9:16",
                  "content": [
                    "Exodus 9:16"
                  ]
                },
                " (see also LXX)"
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "ROM 9:18"
        },
        "Therefore ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "God"
          ]
        },
        " has mercy on whom He wants ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to have mercy "
          ]
        },
        ", and He hardens whom He wants ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to harden "
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "ROM 9:19"
        },
        "One of you will say to me, “Then why does ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "God"
          ]
        },
        " still find fault? For who can resist His will?” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "ROM 9:20"
        },
        "But who are you, O man, to talk back to God? ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Shall"
          ]
        },
        " what is formed say to Him who formed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        ", “Why did You make me like this?”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "9:20 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 29:16",
                  "content": [
                    "Isaiah 29:16"
                  ]
                },
                "; Isaiah 45:9"
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "ROM 9:21"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Does"
          ]
        },
        " not the potter have the right to make from the same lump of clay one vessel for special occasions and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "another"
          ]
        },
        " for common use?"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "ROM 9:22"
        },
        "What if God, intending to show ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " wrath and make His power ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "known"
          ]
        },
        ", bore with great patience ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " vessels of His wrath, prepared for destruction? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "ROM 9:23"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "What if He did this"
          ]
        },
        " to make the riches of His glory ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "known"
          ]
        },
        " to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " vessels of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " mercy, whom He prepared in advance for glory — ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "ROM 9:24"
        },
        "including us, whom He has called not only from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Jews, but also from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Gentiles? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "ROM 9:25"
        },
        "As He says in Hosea:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“I will call ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "them"
          ]
        },
        " ‘My People’ who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " not My people,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "I will call her"
          ]
        },
        " ‘",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "My"
          ]
        },
        " Beloved’ who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " not ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "My"
          ]
        },
        " beloved,”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "9:25 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "HOS 2:23",
                  "content": [
                    "Hosea 2:23"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "ROM 9:26"
        },
        "and,"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“It will happen that in the very place where it was said to them,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "‘You ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " not My people,’"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "they will be called"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "‘sons of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " living God.’”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "9:26 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "HOS 1:10",
                  "content": [
                    "Hosea 1:10"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "ROM 9:27"
        },
        "Isaiah cries out concerning Israel:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Though the number of the Israelites is like the sand of the sea,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "add",
          "content": [
            "only"
          ]
        },
        " the remnant will be saved."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "ROM 9:28"
        },
        "For ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord will carry out ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " sentence on the earth"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "thoroughly and decisively.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "9:28 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 10:22-23",
                  "content": [
                    "Isaiah 10:22–23"
                  ]
                },
                " (see also LXX)"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "ROM 9:29"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "It is"
          ]
        },
        " just as Isaiah foretold:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Unless ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord of Hosts had left us descendants,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "we would have become like Sodom,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "we would have resembled Gomorrah.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "9:29 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 1:9",
                  "content": [
                    "Isaiah 1:9"
                  ]
                },
                " (see also LXX)"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Israel’s Unbelief"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "ROM 9:30"
        },
        "What then will we say? That ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Gentiles, who did not pursue righteousness, have obtained ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        ", a righteousness that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " by faith; ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "ROM 9:31"
        },
        "but Israel, who pursued a law of righteousness, has not attained ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "32",
          "sid": "ROM 9:32"
        },
        "Why ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "not"
          ]
        },
        "? Because ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their pursuit was"
          ]
        },
        " not by faith, but as if ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it were"
          ]
        },
        " by works. They stumbled over the stumbling stone, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "ROM 9:33"
        },
        "as it is written:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“See, I lay in Zion a stone of stumbling"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and a rock of offense;",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "9:33 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 8:14",
                  "content": [
                    "Isaiah 8:14"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "and the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one who"
          ]
        },
        " believes in Him"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "will never be put to shame.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "9:33 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 28:16",
                  "content": [
                    "Isaiah 28:16"
                  ]
                },
                " (see also LXX)"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "10",
      "sid": "ROM 10"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Word Brings Salvation"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ISA 65:1-16",
          "content": [
            "Isaiah 65:1–16"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "ROM 10:1"
        },
        "Brothers, my heart’s desire and prayer to God for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the Israelites"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their"
          ]
        },
        " salvation. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "ROM 10:2"
        },
        "For I testify about them that they are zealous for God, but not on the basis of knowledge. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "ROM 10:3"
        },
        "Because they were ignorant of God’s righteousness and sought to establish ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their"
          ]
        },
        " own, they did not submit to God’s righteousness. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "ROM 10:4"
        },
        "For Christ ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " end of the law, to bring righteousness to everyone who believes."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "ROM 10:5"
        },
        "For concerning the righteousness that is by the law, Moses writes: “The man ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who"
          ]
        },
        " does these things will live by them.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "10:5 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "LEV 18:5",
                  "content": [
                    "Leviticus 18:5"
                  ]
                },
                "; see also Ezekiel 20:11, 13, and 21."
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "ROM 10:6"
        },
        "But the righteousness that is by faith says: “Do not say in your heart, ‘Who will ascend into heaven?’",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "10:6 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "DEU 30:12",
                  "content": [
                    "Deuteronomy 30:12"
                  ]
                }
              ]
            }
          ]
        },
        " (that is, to bring Christ down) ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "ROM 10:7"
        },
        "or, ‘Who will descend into the Abyss?’",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "10:7 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "See ",
                {
                  "type": "ref",
                  "loc": "DEU 30:13",
                  "content": [
                    "Deuteronomy 30:13"
                  ]
                },
                "."
              ]
            }
          ]
        },
        " (that is, to bring Christ up from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " dead).”"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "ROM 10:8"
        },
        "But what does it say? “The word is near you; ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it is"
          ]
        },
        " in your mouth and in your heart,”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "10:8 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "DEU 30:14",
                  "content": [
                    "Deuteronomy 30:14"
                  ]
                }
              ]
            }
          ]
        },
        " that is, the word of faith we are proclaiming: ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "ROM 10:9"
        },
        "that if you confess with your mouth, “Jesus ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " Lord,” and believe in your heart that God raised Him from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " dead, you will be saved. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "ROM 10:10"
        },
        "For with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " heart ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        " believe ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and are"
          ]
        },
        " justified, and with ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " mouth ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        " confess ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and are"
          ]
        },
        " saved."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "ROM 10:11"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "It is"
          ]
        },
        " just as the Scripture says: “Anyone who believes in Him will never be put to shame.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "10:11 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 28:16",
                  "content": [
                    "Isaiah 28:16"
                  ]
                },
                " (see also LXX)"
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "ROM 10:12"
        },
        "For there is no difference between Jew and Greek: The same Lord ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is Lord"
          ]
        },
        " of all, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " gives richly to all who call on Him, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "ROM 10:13"
        },
        "for, “Everyone who calls on the name of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord will be saved.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "10:13 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "JOL 2:32",
                  "content": [
                    "Joel 2:32"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "ROM 10:14"
        },
        "How then can they call on ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the One"
          ]
        },
        " in whom they have not believed? And how can they believe in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the One"
          ]
        },
        " of whom they have not heard? And how can they hear without ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "someone"
          ]
        },
        " to preach? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "ROM 10:15"
        },
        "And how can they preach unless they are sent? As it is written: “How beautiful ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " the feet of those who bring good news!”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "10:15 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "good news of good things"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "How beautiful are the feet of those who bring good news of peace, who bring good news of good things"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; ",
                {
                  "type": "ref",
                  "loc": "ISA 52:7",
                  "content": [
                    "Isaiah 52:7"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "ROM 10:16"
        },
        "But not all of them welcomed the good news. For Isaiah says, “Lord, who has believed our message?”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "10:16 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 53:1",
                  "content": [
                    "Isaiah 53:1"
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "ROM 10:17"
        },
        "Consequently, faith ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "comes"
          ]
        },
        " by hearing, and hearing by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " word of Christ."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "ROM 10:18"
        },
        "But I ask, did they not hear? Indeed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "they did"
          ]
        },
        ":"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Their voice has gone out into all the earth,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "their words to the ends of the world.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "10:18 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "PSA 19:4",
                  "content": [
                    "Psalm 19:4"
                  ]
                },
                " (see also LXX)"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "ROM 10:19"
        },
        "I ask instead, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "did"
          ]
        },
        " Israel not understand? First, Moses says:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“I will make you jealous by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "those who are"
          ]
        },
        " not a nation;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "I will make you angry by a nation without understanding.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "10:19 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "DEU 32:21",
                  "content": [
                    "Deuteronomy 32:21"
                  ]
                },
                " (see also LXX)"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "ROM 10:20"
        },
        "And Isaiah boldly says:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“I was found by those who did not seek Me;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "I revealed Myself to those who did not ask for Me.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "10:20 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 65:1",
                  "content": [
                    "Isaiah 65:1"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "ROM 10:21"
        },
        "But as for Israel he says:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“All day long I have held out My hands"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "a"
          ]
        },
        " disobedient and obstinate people.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "10:21 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 65:2",
                  "content": [
                    "Isaiah 65:2"
                  ]
                },
                " (see also LXX)"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "11",
      "sid": "ROM 11"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "A Remnant Chosen by Grace"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "ROM 11:1"
        },
        "I ask then, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "did"
          ]
        },
        " God reject His people? Certainly not! I am an Israelite ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "myself"
          ]
        },
        ", a descendant of Abraham, from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " tribe of Benjamin. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "ROM 11:2"
        },
        "God did not reject His people, whom He foreknew. Do you not know what the Scripture says about Elijah, how he appealed to God against Israel: ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "ROM 11:3"
        },
        "“Lord, they have killed Your prophets ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " torn down Your altars. I ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "am"
          ]
        },
        " the only one left, and they are seeking my life ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as well "
          ]
        },
        "”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "11:3 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "1KI 19:10",
                  "content": [
                    "1 Kings 19:10"
                  ]
                },
                ", 14"
              ]
            }
          ]
        },
        "?"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "ROM 11:4"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "And"
          ]
        },
        " what ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was"
          ]
        },
        " the divine reply to him? “I have reserved for Myself seven thousand men who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "have"
          ]
        },
        " not bowed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " knee to Baal.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "11:4 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "1KI 19:18",
                  "content": [
                    "1 Kings 19:18"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "ROM 11:5"
        },
        "In the same way, at the present time there is a remnant chosen by grace. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "ROM 11:6"
        },
        "And if ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it is"
          ]
        },
        " by grace, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "then it is"
          ]
        },
        " no longer by works. Otherwise, grace ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "would"
          ]
        },
        " no longer be grace.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "11:6 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "But if it is by works, then it is no longer grace; otherwise work is no longer work."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "ROM 11:7"
        },
        "What then? What Israel was seeking, it failed to obtain, but the elect ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "did"
          ]
        },
        ". The others were hardened, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "ROM 11:8"
        },
        "as it is written:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“God gave them a spirit of stupor,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "eyes that could not see,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and ears that could not hear,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "to this very day.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "11:8 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "See ",
                {
                  "type": "ref",
                  "loc": "DEU 29:4",
                  "content": [
                    "Deuteronomy 29:4"
                  ]
                },
                " and Isaiah 29:10."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "ROM 11:9"
        },
        "And David says:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "May"
          ]
        },
        " their table become a snare and a trap,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "a stumbling block and a retribution to them."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "ROM 11:10"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "May"
          ]
        },
        " their eyes be darkened ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "so"
          ]
        },
        " they cannot see,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and their backs be bent forever.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "11:10 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "PSA 69:22-23",
                  "content": [
                    "Psalm 69:22–23"
                  ]
                },
                " (see also LXX)"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Ingrafting of the Gentiles"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "ROM 11:11"
        },
        "I ask then, did they stumble so as to fall beyond recovery?",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "11:11 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "did they stumble so as to lose their share? "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "did they stumble that they might fall?"
              ]
            }
          ]
        },
        " Certainly not! However, because of their trespass, salvation ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "has come"
          ]
        },
        " to the Gentiles to make ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Israel"
          ]
        },
        " jealous. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "ROM 11:12"
        },
        "But if their trespass ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "means"
          ]
        },
        " riches for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " world, and their failure ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "means"
          ]
        },
        " riches for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Gentiles, how much greater ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "riches "
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "will"
          ]
        },
        " their fullness ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "bring"
          ]
        },
        "!"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "ROM 11:13"
        },
        "I am speaking to you Gentiles. Inasmuch ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as"
          ]
        },
        " I am ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " apostle to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Gentiles, I magnify my ministry ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "ROM 11:14"
        },
        "in the hope that I may provoke my ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "own"
          ]
        },
        " people ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to jealousy"
          ]
        },
        " and save some of them. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "ROM 11:15"
        },
        "For if their rejection ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is the"
          ]
        },
        " reconciliation of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " world, what ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "will their"
          ]
        },
        " acceptance ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " but life from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " dead? ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "ROM 11:16"
        },
        "If the first part ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of the dough"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " holy, so ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " the whole batch; if the root ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " holy, so ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " the branches."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "ROM 11:17"
        },
        "Now if some branches have been broken off, and you, a wild olive shoot, have been grafted in among ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the others"
          ]
        },
        " to share in the nourishment of the olive root, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "ROM 11:18"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do"
          ]
        },
        " not boast over those branches. If ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you do, remember this"
          ]
        },
        ": You ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do"
          ]
        },
        " not support the root, but the root ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "supports "
          ]
        },
        " you."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "ROM 11:19"
        },
        "You will say then, “Branches were broken off so that I could be grafted in.” ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "ROM 11:20"
        },
        "That is correct: They were broken off because of unbelief, but you stand by faith. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Do"
          ]
        },
        " not be arrogant, but be afraid. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "ROM 11:21"
        },
        "For if God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "did"
          ]
        },
        " not spare the natural branches, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "He will"
          ]
        },
        " certainly not",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "11:21 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "He will perhaps not"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; SBL, NE, and WH "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "He will not"
              ]
            }
          ]
        },
        " spare you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "either"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "ROM 11:22"
        },
        "Take notice, therefore, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of the"
          ]
        },
        " kindness and severity of God: severity to those who fell, but kindness to you, if you continue in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " kindness. Otherwise you also will be cut off. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "ROM 11:23"
        },
        "And if they do not persist in unbelief, they will be grafted in, for God is able to graft them ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "in"
          ]
        },
        " again. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "ROM 11:24"
        },
        "For if you were cut from a wild olive tree, and contrary to nature were grafted into ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one that is"
          ]
        },
        " cultivated, how much more ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "readily "
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "will"
          ]
        },
        " these, the natural ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "branches"
          ]
        },
        ", be grafted into ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their"
          ]
        },
        " own olive tree!"
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "All Israel Will Be Saved"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "ROM 11:25"
        },
        "I do not want you to be ignorant of this mystery, brothers, so that you will not be conceited: A hardening in part has come to Israel, until the full number of the Gentiles has come in. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "ROM 11:26"
        },
        "And so all Israel will be saved, as it is written:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“The Deliverer will come from Zion;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "He will remove godlessness from Jacob."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "ROM 11:27"
        },
        "And this ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " My covenant with them"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "when I take away their sins.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "11:27 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 27:9",
                  "content": [
                    "Isaiah 27:9"
                  ]
                },
                " and Isaiah 59:20–21; see also LXX"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "ROM 11:28"
        },
        "Regarding the gospel, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "they are"
          ]
        },
        " enemies on your account; but regarding election, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "they are"
          ]
        },
        " loved on account of the patriarchs. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "ROM 11:29"
        },
        "For God’s gifts and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " call ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " irrevocable."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "ROM 11:30"
        },
        "Just as you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who"
          ]
        },
        " formerly disobeyed God have now received mercy through their disobedience, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "ROM 11:31"
        },
        "so they too have now disobeyed, in order that they too ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "may"
          ]
        },
        " now receive mercy through the mercy ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "shown to"
          ]
        },
        " you.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "11:31 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "may now receive mercy through your mercy"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; BYZ and TR "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "may receive mercy through your mercy"
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "32",
          "sid": "ROM 11:32"
        },
        "For God has consigned everyone to disobedience so that He may have mercy on everyone."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "A Hymn of Praise"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "ISA 40:9-31",
          "content": [
            "Isaiah 40:9–31"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "ROM 11:33"
        },
        "O, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " depth of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " riches"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " wisdom and knowledge of God!"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "How unsearchable ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " His judgments,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and untraceable His ways!"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "34",
          "sid": "ROM 11:34"
        },
        "“Who has known ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " mind of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord?"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "Or who has been His counselor?”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "11:34 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 40:13",
                  "content": [
                    "Isaiah 40:13"
                  ]
                },
                " (see also LXX)"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "35",
          "sid": "ROM 11:35"
        },
        "“Who has first given to God,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "that God should repay him?”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "11:35 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "JOB 41:11",
                  "content": [
                    "Job 41:11"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "36",
          "sid": "ROM 11:36"
        },
        "For from Him and through Him and to Him ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " all things."
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "To Him ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " the glory forever! Amen."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "12",
      "sid": "ROM 12"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Living Sacrifices"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "1CO 3:16-23",
          "content": [
            "1 Corinthians 3:16–23"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "1CO 6:18-20",
          "content": [
            "1 Corinthians 6:18–20"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "ROM 12:1"
        },
        "Therefore I urge you, brothers, on account of God’s mercy, to offer your bodies ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as"
          ]
        },
        " living sacrifices, holy ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " pleasing to God, which is your spiritual service of worship.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "12:1 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "your reasonable service"
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "ROM 12:2"
        },
        "Do not be conformed to this world, but be transformed by the renewing of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " mind. Then you will be able to test and approve what ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " the good, pleasing, and perfect will of God."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "ROM 12:3"
        },
        "For by the grace given me I say to every one of you: Do not think of yourself more highly than you ought, but think of yourself with sober judgment, according to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " measure of faith God has given ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "ROM 12:4"
        },
        "Just as each of us has one body with many members, and not all members have the same function, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "ROM 12:5"
        },
        "so in Christ we who are many ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " one body, and each member ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "belongs to"
          ]
        },
        " one another."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "ROM 12:6"
        },
        "We have different gifts according to the grace given us. If ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one’s gift is"
          ]
        },
        " prophecy, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "let him use"
          ]
        },
        " it in proportion to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " faith; ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "ROM 12:7"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "if it is"
          ]
        },
        " serving, let him serve; ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "if it is"
          ]
        },
        " teaching, let him teach; ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "ROM 12:8"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "if it is"
          ]
        },
        " encouraging, let him encourage; ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "if it is"
          ]
        },
        " giving, let him give generously; ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "if it is"
          ]
        },
        " leading, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "let him lead"
          ]
        },
        " with diligence; ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "if it is"
          ]
        },
        " showing mercy, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "let him do it"
          ]
        },
        " cheerfully."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Love, Zeal, Hope, Hospitality"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "JHN 13:31-35",
          "content": [
            "John 13:31–35"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "1JN 3:11-24",
          "content": [
            "1 John 3:11–24"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "ROM 12:9"
        },
        "Love must be sincere. Detest what ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " evil; cling to what ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " good. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "ROM 12:10"
        },
        "Be devoted to one another in brotherly love. Outdo yourselves in honoring one another."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "ROM 12:11"
        },
        "Do not let ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " zeal subside; keep your spiritual fervor, serving the Lord."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "ROM 12:12"
        },
        "Be joyful in hope, patient in affliction, persistent in prayer."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "ROM 12:13"
        },
        "Share with the saints who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " in need. Practice hospitality."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Forgiveness"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 18:21-35",
          "content": [
            "Matthew 18:21–35"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "ROM 12:14"
        },
        "Bless those who persecute you. Bless and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do"
          ]
        },
        " not curse. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "ROM 12:15"
        },
        "Rejoice with those who rejoice; weep with those who weep. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "ROM 12:16"
        },
        "Live in harmony with one another. Do not be proud, but associate with the lowly. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Do"
          ]
        },
        " not be conceited."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "ROM 12:17"
        },
        "Do not repay anyone evil for evil. Carefully consider what is right in the eyes of everybody. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "ROM 12:18"
        },
        "If ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it is"
          ]
        },
        " possible on your ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "part"
          ]
        },
        ", live at peace with everyone."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "ROM 12:19"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Do"
          ]
        },
        " not avenge yourselves, beloved, but leave room for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "God’s"
          ]
        },
        " wrath. For it is written: “Vengeance ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " Mine; I will repay, says ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "12:19 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "DEU 32:35",
                  "content": [
                    "Deuteronomy 32:35"
                  ]
                },
                " (see also LXX)"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "ROM 12:20"
        },
        "On the contrary,"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“If your enemy is hungry, feed him;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "if he is thirsty, give him a drink."
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "For in so doing,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "you will heap burning coals on his head.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "12:20 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "PRO 25:21-22",
                  "content": [
                    "Proverbs 25:21–22"
                  ]
                },
                " (see also LXX)"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "ROM 12:21"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Do"
          ]
        },
        " not be overcome by evil, but overcome evil with good."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "13",
      "sid": "ROM 13"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Submission to Authorities"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "1PE 2:13-20",
          "content": [
            "1 Peter 2:13–20"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "ROM 13:1"
        },
        "Everyone must submit himself to the governing authorities, for there is no authority except ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that which is from"
          ]
        },
        " God. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The authorities"
          ]
        },
        " that exist have been appointed by God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "ROM 13:2"
        },
        "Consequently, whoever resists authority is opposing what God has set in place, and those who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do so"
          ]
        },
        " will bring judgment on themselves."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "ROM 13:3"
        },
        "For rulers are not a terror to good conduct, but to bad. Do you want to be unafraid of the one in authority? ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Then"
          ]
        },
        " do what ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " right, and you will have his approval. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "ROM 13:4"
        },
        "For he is God’s servant for your good. But if you do wrong, be afraid, for he does not carry the sword in vain. He is God’s servant, an agent of retribution to the wrongdoer."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "ROM 13:5"
        },
        "Therefore ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it is"
          ]
        },
        " necessary to submit ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to authority "
          ]
        },
        ", not only to avoid punishment, but also as a matter of conscience. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "ROM 13:6"
        },
        "This is also why you pay taxes. For ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the authorities"
          ]
        },
        " are God’s servants, who devote themselves to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "their work"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "ROM 13:7"
        },
        "Pay everyone what you owe ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "him"
          ]
        },
        ": taxes to whom taxes ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are due"
          ]
        },
        ", revenue to whom revenue ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is due"
          ]
        },
        ", respect to whom respect ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is due"
          ]
        },
        ", honor to whom honor ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is due"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Love Fulfills the Law"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "LEV 19:9-18",
          "content": [
            "Leviticus 19:9–18"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "ROM 13:8"
        },
        "Be indebted to no one, except to one another ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "in"
          ]
        },
        " love. For he who loves ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " neighbor has fulfilled ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "ROM 13:9"
        },
        "The ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "commandments"
          ]
        },
        " “Do not commit adultery,” “Do not murder,” “Do not steal,” “Do not covet,”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "13:9 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "EXO 20:13-17",
                  "content": [
                    "Exodus 20:13–17"
                  ]
                },
                "; Deuteronomy 5:17–21"
              ]
            }
          ]
        },
        " and any other commandments, are summed up in this ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one"
          ]
        },
        " decree: “Love your neighbor as yourself.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "13:9 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "LEV 19:18",
                  "content": [
                    "Leviticus 19:18"
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "ROM 13:10"
        },
        "Love does no wrong to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "its"
          ]
        },
        " neighbor. Therefore love ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " fulfillment of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " law."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Day Is Near"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "ROM 13:11"
        },
        "And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do"
          ]
        },
        " this, understanding the occasion. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "The"
          ]
        },
        " hour has come for you to wake up from ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your"
          ]
        },
        " slumber, for our salvation ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " nearer now than when we ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "first"
          ]
        },
        " believed. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "ROM 13:12"
        },
        "The night is nearly over; the day has drawn near. So let us lay aside the deeds of darkness and put on the armor of light. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "ROM 13:13"
        },
        "Let us behave decently, as in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " daytime, not in carousing and drunkenness, not in sexual immorality and debauchery, not in dissension and jealousy. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "ROM 13:14"
        },
        "Instead, clothe yourselves with",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "13:14 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "put on"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; see verse 12."
              ]
            }
          ]
        },
        " the Lord Jesus Christ, and make no provision for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " desires of the flesh."
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "14",
      "sid": "ROM 14"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Law of Liberty"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "MAT 7:1-6",
          "content": [
            "Matthew 7:1–6"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "LUK 6:37-42",
          "content": [
            "Luke 6:37–42"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "ROM 14:1"
        },
        "Accept him whose faith is weak, without passing judgment on ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " opinions.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "14:1 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "without quarreling over disputable matters"
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "ROM 14:2"
        },
        "For one ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "person"
          ]
        },
        " has faith to eat all things, while another, who is weak, eats ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "only"
          ]
        },
        " vegetables. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "ROM 14:3"
        },
        "The ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one who"
          ]
        },
        " eats ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "everything"
          ]
        },
        " must not belittle the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one who"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "does not"
          ]
        },
        ", and the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one who"
          ]
        },
        " does not eat ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "everything"
          ]
        },
        " must not judge the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one who"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "does"
          ]
        },
        ", for God has accepted him. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "ROM 14:4"
        },
        "Who are you to judge someone else’s servant? To ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " own master he stands or falls. And he will stand, for the Lord is able to make him stand."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "ROM 14:5"
        },
        "One ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "person"
          ]
        },
        " regards ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "a certain"
          ]
        },
        " day above ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the others"
          ]
        },
        ", while someone ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "else"
          ]
        },
        " considers every day ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "alike"
          ]
        },
        ". Each ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one"
          ]
        },
        " should be fully convinced in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " own mind. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "ROM 14:6"
        },
        "He who observes ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "a special"
          ]
        },
        " day ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "does so"
          ]
        },
        " to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord;",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "14:6 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "BYZ and TR include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "he who does not regard the day, to the Lord he does not regard it;"
              ]
            }
          ]
        },
        " he who eats ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "does so"
          ]
        },
        " to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord, for he gives thanks to God; and he who abstains ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "does so"
          ]
        },
        " to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord and gives thanks to God."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "ROM 14:7"
        },
        "For none of us lives to himself ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "alone"
          ]
        },
        ", and none ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of us "
          ]
        },
        " dies to himself ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "alone"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "ROM 14:8"
        },
        "If we live, we live to the Lord, and if we die, we die to the Lord. So whether we live ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " die, we belong to the Lord. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "ROM 14:9"
        },
        "For this reason Christ died and returned to life, that He might be the Lord of both ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " dead and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " living."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "ROM 14:10"
        },
        "Why, then, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do"
          ]
        },
        " you judge your brother? Or why ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "do"
          ]
        },
        " you belittle your brother? For we will all stand before God’s judgment seat. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "ROM 14:11"
        },
        "It is written:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "As surely as"
          ]
        },
        " I live,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "says ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord,"
      ]
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "every knee will bow before Me;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "every tongue will confess to God.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "14:11 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "will give praise to God "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "will acknowledge God"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; ",
                {
                  "type": "ref",
                  "loc": "ISA 45:23",
                  "content": [
                    "Isaiah 45:23"
                  ]
                },
                " (see also LXX)"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "ROM 14:12"
        },
        "So then, each of us will give an account of himself to God."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "The Law of Love"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "EZK 14:1-11",
          "content": [
            "Ezekiel 14:1–11"
          ]
        },
        "; ",
        {
          "type": "ref",
          "loc": "1CO 8:1-13",
          "content": [
            "1 Corinthians 8:1–13"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "ROM 14:13"
        },
        "Therefore let us stop judging one another. Instead, make up your mind not to put ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "any"
          ]
        },
        " stumbling block or obstacle in your brother’s way."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "ROM 14:14"
        },
        "I am convinced and fully persuaded in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord Jesus that nothing ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " unclean in itself. But if ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "anyone"
          ]
        },
        " regards something as unclean, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "then"
          ]
        },
        " for him ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it is"
          ]
        },
        " unclean. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "ROM 14:15"
        },
        "If your brother is distressed by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "what you eat"
          ]
        },
        ", you are no longer acting in love. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Do"
          ]
        },
        " not by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "your eating"
          ]
        },
        " destroy your ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "brother"
          ]
        },
        ", for whom Christ died."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "ROM 14:16"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Do"
          ]
        },
        " not ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "allow"
          ]
        },
        " what you ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "consider"
          ]
        },
        " good, then, to be spoken of as evil. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "ROM 14:17"
        },
        "For the kingdom of God is not ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "a matter of"
          ]
        },
        " eating and drinking, but of righteousness, peace, and joy in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Holy Spirit. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "ROM 14:18"
        },
        "For whoever serves Christ in this way ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " pleasing to God and approved by men."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "ROM 14:19"
        },
        "So then, let us pursue what leads to peace and to mutual edification. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "ROM 14:20"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Do"
          ]
        },
        " not destroy the work of God for the sake of food. All ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "food is"
          ]
        },
        " clean, but ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "it is"
          ]
        },
        " wrong for a man to let his eating be a stumbling block. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "ROM 14:21"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "It is"
          ]
        },
        " better not to eat meat ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or"
          ]
        },
        " drink wine ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "or to do anything"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to cause"
          ]
        },
        " your brother to stumble.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "14:21 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "SBL, BYZ, and TR include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "or to be hindered or weakened"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "ROM 14:22"
        },
        "Keep your belief ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "about such matters"
          ]
        },
        " between yourself ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " God.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "14:22 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Keep the faith that you have to yourself before God"
              ]
            }
          ]
        },
        " Blessed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one who"
          ]
        },
        " does not condemn himself by what he approves. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "ROM 14:23"
        },
        "But the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "one who"
          ]
        },
        " has doubts is condemned if he eats, because ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his eating is"
          ]
        },
        " not from faith; and everything that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " not from faith is sin.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "14:23 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Some manuscripts place the text of ",
                {
                  "type": "ref",
                  "loc": "ROM 16:25-27",
                  "content": [
                    "Romans 16:25–27"
                  ]
                },
                " here."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "15",
      "sid": "ROM 15"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Accept One Another"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "ROM 15:1"
        },
        "We who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " strong ought to bear with the shortcomings of the weak and not to please ourselves. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "ROM 15:2"
        },
        "Each of us should please ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " neighbor for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "his"
          ]
        },
        " good, to build ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "him"
          ]
        },
        " up. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "ROM 15:3"
        },
        "For even Christ ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "did"
          ]
        },
        " not please Himself, but as it is written: “The insults of those who insult You have fallen on Me.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "15:3 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "PSA 69:9",
                  "content": [
                    "Psalm 69:9"
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "ROM 15:4"
        },
        "For everything that was written in the past was written for our instruction, so that through endurance and the encouragement of the Scriptures, we might have hope."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "ROM 15:5"
        },
        "Now ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "may"
          ]
        },
        " the God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who gives"
          ]
        },
        " endurance and encouragement grant you harmony with one another in Christ Jesus, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "ROM 15:6"
        },
        "so that with one mind ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " one voice you may glorify the God and Father of our Lord Jesus Christ."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Christ the Servant of Jews and Gentiles"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "ROM 15:7"
        },
        "Accept one another, then, just as Christ accepted you, in order to bring glory to God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "ROM 15:8"
        },
        "For I tell ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you that"
          ]
        },
        " Christ has become a servant of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " circumcised on behalf of God’s truth, to confirm the promises made to the patriarchs, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "ROM 15:9"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "so that"
          ]
        },
        " the Gentiles may glorify God for ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "His"
          ]
        },
        " mercy. As it is written:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Therefore I will praise You among ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Gentiles;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "I will sing hymns to Your name.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "15:9 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "2SA 22:50",
                  "content": [
                    "2 Samuel 22:50"
                  ]
                },
                "; Psalm 18:49"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "ROM 15:10"
        },
        "Again, it says:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Rejoice, O Gentiles, with His people.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "15:10 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "DEU 32:43",
                  "content": [
                    "Deuteronomy 32:43"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "ROM 15:11"
        },
        "And again:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Praise the Lord, all ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        " Gentiles,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and extol Him, all ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "you"
          ]
        },
        " peoples.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "15:11 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "PSA 117:1",
                  "content": [
                    "Psalm 117:1"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "ROM 15:12"
        },
        "And once more, Isaiah says:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“The Root of Jesse will appear,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        {
          "type": "char",
          "marker": "add",
          "content": [
            "One who"
          ]
        },
        " will arise to rule over ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Gentiles;"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "in Him ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Gentiles will put their hope.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "15:12 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 11:10",
                  "content": [
                    "Isaiah 11:10"
                  ]
                },
                " (see also LXX)"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "ROM 15:13"
        },
        "Now ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "may"
          ]
        },
        " the God of hope fill you with all joy and peace as you believe ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "in Him"
          ]
        },
        ", so that you may overflow with hope by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " power ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "of the"
          ]
        },
        " Holy Spirit."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Paul the Minister to the Gentiles"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "ROM 15:14"
        },
        "I myself am convinced, my brothers, that you yourselves are full of goodness, brimming with knowledge, and able to instruct one another. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "ROM 15:15"
        },
        "However, I have written you a bold reminder on some points, because of the grace God has given me ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "ROM 15:16"
        },
        "to be a minister of Christ Jesus to the Gentiles in the priestly service of the gospel of God, so that the Gentiles might become ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "an"
          ]
        },
        " offering acceptable ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to God"
          ]
        },
        ", sanctified by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Holy Spirit."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "ROM 15:17"
        },
        "Therefore I exult in Christ Jesus in  ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "my service "
          ]
        },
        " to God. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "ROM 15:18"
        },
        "I will not presume to speak of anything except what Christ has accomplished through me in leading ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Gentiles to obedience by word and deed, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "ROM 15:19"
        },
        "by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " power of signs and wonders, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " power of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Spirit of God.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "15:19 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "SBL "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "the power of the Spirit"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; NE and WH "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "the power of the Holy Spirit"
              ]
            }
          ]
        },
        " So from Jerusalem all the way around to Illyricum, I have fully proclaimed the gospel of Christ."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "ROM 15:20"
        },
        "In this way I have aspired to preach the gospel where Christ was not known, so that I would not be building on someone ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "else’s"
          ]
        },
        " foundation. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "ROM 15:21"
        },
        "Rather, as it is written:"
      ]
    },
    {
      "type": "para",
      "marker": "b"
    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        "“Those who were not told about Him will see,"
      ]
    },
    {
      "type": "para",
      "marker": "q2",
      "content": [
        "and those who have not heard will understand.”",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "15:21 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                {
                  "type": "ref",
                  "loc": "ISA 52:15",
                  "content": [
                    "Isaiah 52:15"
                  ]
                },
                " (see also LXX)"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "ROM 15:22"
        },
        "That is why I have often been hindered from coming to you."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Paul’s Travel Plans"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "1CO 16:5-9",
          "content": [
            "1 Corinthians 16:5–9"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "ROM 15:23"
        },
        "But now that ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "there are"
          ]
        },
        " no further opportunities for me in these regions, and since I have longed for many years to visit you, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "24",
          "sid": "ROM 15:24"
        },
        "I hope to see you on my way to Spain. And ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "after"
          ]
        },
        " I have enjoyed your company for a while, you can equip me ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "for my journey"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "ROM 15:25"
        },
        "Now, however, I am on my way to Jerusalem to serve the saints ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "there"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "ROM 15:26"
        },
        "For Macedonia and Achaia were pleased to make a contribution for the poor among the saints in Jerusalem. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "ROM 15:27"
        },
        "They were pleased ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to do it"
          ]
        },
        ", and indeed they owe it to them. For if the Gentiles have shared in their spiritual ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "blessings"
          ]
        },
        ", they are obligated to minister to them with material ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "blessings"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "28",
          "sid": "ROM 15:28"
        },
        "So after I have completed this ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "service"
          ]
        },
        " and have safely delivered this bounty to them, I will set off to Spain by way of you. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "29",
          "sid": "ROM 15:29"
        },
        "I know that when I come to you, I will come in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " fullness of the blessing",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "15:29 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "TR and BYZ include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "of the gospel"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "."
              ]
            }
          ]
        },
        " of Christ."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "30",
          "sid": "ROM 15:30"
        },
        "Now I urge you, brothers, by our Lord Jesus Christ and by the love of the Spirit, to join me in my struggle by praying to God for me. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "31",
          "sid": "ROM 15:31"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Pray"
          ]
        },
        " that I may be delivered from the unbelievers in Judea, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that"
          ]
        },
        " my service in Jerusalem may be acceptable to the saints ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "there"
          ]
        },
        ", ",
        {
          "type": "verse",
          "marker": "v",
          "number": "32",
          "sid": "ROM 15:32"
        },
        "so that by God’s will I may come to you with joy and together with you be refreshed."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "33",
          "sid": "ROM 15:33"
        },
        "The God of peace ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " with all of you. Amen.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "15:33 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Some manuscripts do not include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Amen."
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "One early manuscript places the text of ",
                {
                  "type": "ref",
                  "loc": "ROM 16:25-27",
                  "content": [
                    "Romans 16:25–27"
                  ]
                },
                " here."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "chapter",
      "marker": "c",
      "number": "16",
      "sid": "ROM 16"
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Personal Greetings and Love"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "1",
          "sid": "ROM 16:1"
        },
        "I commend to you our sister Phoebe, a servant",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "16:1 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Or "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "deaconess"
              ]
            }
          ]
        },
        " of the church in Cenchrea. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "2",
          "sid": "ROM 16:2"
        },
        "Welcome her in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord in a manner worthy of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " saints, and assist her with anything she may need from you. For she has been a great help to many ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "people"
          ]
        },
        ", including me."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "3",
          "sid": "ROM 16:3"
        },
        "Greet Prisca",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "16:3 "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Prisca "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "is a variant of "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Priscilla"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; see ",
                {
                  "type": "ref",
                  "loc": "ACT 18:2",
                  "content": [
                    "Acts 18:2"
                  ]
                },
                "."
              ]
            }
          ]
        },
        " and Aquila, my fellow workers in Christ Jesus, ",
        {
          "type": "verse",
          "marker": "v",
          "number": "4",
          "sid": "ROM 16:4"
        },
        "who have risked their ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "lives"
          ]
        },
        " for me. Not only I but all the churches of the Gentiles are grateful ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to them"
          ]
        },
        ". ",
        {
          "type": "verse",
          "marker": "v",
          "number": "5",
          "sid": "ROM 16:5"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "Greet also"
          ]
        },
        " the church ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that meets"
          ]
        },
        " at their house."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Greet my beloved Epenetus, who was the first ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "convert"
          ]
        },
        " to Christ in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the province of"
          ]
        },
        " Asia.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "16:5 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "in Asia"
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "; Asia was a Roman province in what is now western Turkey. "
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "6",
          "sid": "ROM 16:6"
        },
        "Greet Mary, who has worked very hard for you."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "7",
          "sid": "ROM 16:7"
        },
        "Greet Andronicus and Junia,",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "16:7 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Some translators "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Junias"
              ]
            }
          ]
        },
        " my fellow countrymen and fellow prisoners. ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "They"
          ]
        },
        " are outstanding among the apostles, and ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "they"
          ]
        },
        " were in Christ before I ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "was"
          ]
        },
        "."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "8",
          "sid": "ROM 16:8"
        },
        "Greet Ampliatus, my beloved in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "9",
          "sid": "ROM 16:9"
        },
        "Greet Urbanus, our fellow worker in Christ, and my beloved Stachys."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "10",
          "sid": "ROM 16:10"
        },
        "Greet Apelles, who ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " approved in Christ."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Greet those who belong to the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "household"
          ]
        },
        " of Aristobulus."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "11",
          "sid": "ROM 16:11"
        },
        "Greet Herodion, my fellow countryman."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Greet those from the ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "household"
          ]
        },
        " of Narcissus who are in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "12",
          "sid": "ROM 16:12"
        },
        "Greet Tryphena and Tryphosa,  ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "women "
          ]
        },
        " who have worked hard in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Greet ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "my"
          ]
        },
        " beloved Persis, who has worked very hard in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "13",
          "sid": "ROM 16:13"
        },
        "Greet Rufus, chosen in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord, and his mother, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "who has been a mother"
          ]
        },
        " to me as well."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "14",
          "sid": "ROM 16:14"
        },
        "Greet Asyncritus, Phlegon, Hermes, Patrobas, Hermas, and the brothers with them."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "15",
          "sid": "ROM 16:15"
        },
        "Greet Philologus and Julia, Nereus and his sister, and Olympas and all the saints with them."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "16",
          "sid": "ROM 16:16"
        },
        "Greet one another with a holy kiss."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "All the churches of Christ send you greetings."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Avoid Divisions"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "TIT 3:9-11",
          "content": [
            "Titus 3:9–11"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "17",
          "sid": "ROM 16:17"
        },
        "Now I urge you, brothers, to watch out for those who create divisions and obstacles ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that are"
          ]
        },
        " contrary to the teaching you have learned. Turn away from them. ",
        {
          "type": "verse",
          "marker": "v",
          "number": "18",
          "sid": "ROM 16:18"
        },
        "For such people ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "are"
          ]
        },
        " not serving our Lord Christ, but their ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "own"
          ]
        },
        " appetites. By smooth talk and flattery they deceive the hearts of the naive."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "19",
          "sid": "ROM 16:19"
        },
        "Everyone ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "has heard"
          ]
        },
        " about your obedience, so I rejoice over you. But I want you to be wise about what ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " good and innocent about what ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "is"
          ]
        },
        " evil."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "20",
          "sid": "ROM 16:20"
        },
        "The God of peace will soon crush Satan under your feet. The grace of our Lord Jesus Christ",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "16:20 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "NA, NE, and WH "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "Lord Jesus"
              ]
            }
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " with you."
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Greetings from Paul’s Fellow Workers"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "COL 4:7-14",
          "content": [
            "Colossians 4:7–14"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "21",
          "sid": "ROM 16:21"
        },
        "Timothy, my fellow worker, sends you greetings, as do Lucius, Jason, and Sosipater, my fellow countrymen."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "22",
          "sid": "ROM 16:22"
        },
        "I, Tertius, who wrote down this letter, greet you in ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " Lord."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "23",
          "sid": "ROM 16:23"
        },
        "Gaius, who has hosted me and all the church, sends you greetings."
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        "Erastus, the city treasurer, sends you greetings, ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "as does"
          ]
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "our"
          ]
        },
        " brother Quartus.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "16:23 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "SBL, BYZ, and TR include "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                {
                  "type": "char",
                  "marker": "fv",
                  "content": [
                    "24"
                  ]
                },
                "May the grace of our Lord Jesus Christ be with you all. Amen."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "para",
      "marker": "s1",
      "content": [
        "Doxology"
      ]
    },
    {
      "type": "para",
      "marker": "r",
      "content": [
        "(",
        {
          "type": "ref",
          "loc": "JUD 24-25",
          "content": [
            "Jude 1:24–25"
          ]
        },
        ")"
      ]
    },
    {
      "type": "para",
      "marker": "p",
      "content": [
        " ",
        {
          "type": "verse",
          "marker": "v",
          "number": "25",
          "sid": "ROM 16:25"
        },
        "Now to Him who is able to strengthen you by my gospel and by the proclamation of Jesus Christ, according to ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " revelation of ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " mystery concealed for ages past ",
        {
          "type": "verse",
          "marker": "v",
          "number": "26",
          "sid": "ROM 16:26"
        },
        "but now revealed ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "and"
          ]
        },
        " made known through the writings of the prophets by ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "the"
          ]
        },
        " command of the eternal God, in order to lead all nations to the obedience ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "that comes from"
          ]
        },
        " faith",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "16:26 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Literally "
              ]
            },
            {
              "type": "char",
              "marker": "fqa",
              "content": [
                "the obedience of faith"
              ]
            }
          ]
        },
        " — ",
        {
          "type": "verse",
          "marker": "v",
          "number": "27",
          "sid": "ROM 16:27"
        },
        {
          "type": "char",
          "marker": "add",
          "content": [
            "to the"
          ]
        },
        " only wise God ",
        {
          "type": "char",
          "marker": "add",
          "content": [
            "be"
          ]
        },
        " glory forever through Jesus Christ! Amen.",
        {
          "type": "note",
          "marker": "f",
          "caller": "+",
          "content": [
            {
              "type": "char",
              "marker": "fr",
              "content": [
                "16:27 "
              ]
            },
            {
              "type": "char",
              "marker": "ft",
              "content": [
                "Some manuscripts place the text of verses 25–27 after ",
                {
                  "type": "ref",
                  "loc": "ROM 14:23",
                  "content": [
                    "Romans 14:23"
                  ]
                },
                " or after Romans 15:33."
              ]
            }
          ]
        }
      ]
    }
  ]
}